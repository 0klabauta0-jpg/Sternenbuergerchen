extends "res://tests/product_flow_test.gd"
## New career, real GUI actions and shared production commands; no reward injection.

func _run() -> void:
	_start_ms=Time.get_ticks_msec()
	root.size=Vector2i(1440,900)
	var menu:Node=load("res://scenes/main_menu.tscn").instantiate()
	root.add_child(menu)
	current_scene=menu
	await process_frame
	await process_frame
	await _click(menu._continue.get_global_rect().get_center())
	game=current_scene
	if not game.has_method("send_command"):
		printerr("FAIL: Main menu did not open the real career")
		quit(1)
		return
	game.save_path="res://output/n3-product-save.json"
	game.simulation.auto_tick=false
	_check(int(game.simulation.snapshot().schema_version)==3,"Main menu opens schema-v3 career")
	await _object("workbench")
	await _action("armor")
	await _step(25)
	_check(int(game.simulation.snapshot().inventory.armor)==1,"Tier-one worker crafts actual armor")
	game.hud.choose_unit("ida",true)
	await _action("equip_armor")
	_check(game.simulation.snapshot().crew.ida.equipment.armor=="armor","Crew sheet equips armor from inventory")
	await _capture("n3-armor-profile")
	await _object("contracts")
	await _action("accept_contract")
	await _travel("rust")
	await _exp_action("launch")
	await _step(8)
	await _exp_action("radar_scan")
	await _exp_action("contact_signal_01")
	await _step(28)
	await _exp_action("land")
	await _step(1)
	await _object("satellite")
	await _action("salvage")
	await _step(20)
	_check(game.simulation.snapshot().contract.status=="recovered","Radar search and satellite blackbox still work")
	await _travel("base")
	await _object("contracts")
	await _action("claim_contract")
	_check(int(game.simulation.snapshot().credits)>=440,"Mission funds the new progression honestly")
	await _travel("rust")
	await _exp_action("launch")
	await _step(8)
	await _exp_action("contact_signal_02")
	await _step(28)
	await _exp_action("land")
	await _step(1)
	await _object("mining_site")
	for i in range(2):
		await _action("gather")
		await _step(18)
	_check(int(game.simulation.snapshot().cargo.ore)==6,"Two actual mining jobs put six ore in cargo")
	await _capture("n3-mining")
	await _exp_action("launch")
	await _step(8)
	await _exp_action("contact_signal_03")
	await _step(30)
	await _exp_action("land")
	await _step(1)
	await _object("derelict")
	for i in range(2):
		await _action("gather")
		await _step(18)
	_check(int(game.simulation.snapshot().cargo.alloy)==4,"Separate shipwreck provides alloy")
	await _capture("n3-derelict")
	await _travel("station")
	await _object("market")
	for i in range(6):await _action("sell_ore")
	for i in range(4):await _action("sell_alloy")
	_check(int(game.simulation.snapshot().credits)>=1130,"Exploration earnings make rental attainable")
	await _action("rent_ship")
	_check(game.simulation.snapshot().rental.active and game.simulation.snapshot().ship.model=="vulture","Station rents Geier through real market action")
	await _action("buy_armor")
	_check(int(game.simulation.snapshot().cargo.armor)==1,"Armor can also be bought")
	await _capture("n3-geier-rental")
	await _travel("base")
	game.hud.choose_unit("jaro",true)
	await _action("equip_armor")
	_check(game.simulation.snapshot().crew.jaro.equipment.armor=="armor","Bought armor reaches the second crew member")
	game.hud.choose_unit("ida",false)
	await _travel("rust")
	await _exp_action("launch")
	await _step(8)
	await _exp_action("contact_signal_03")
	await _step(30)
	await _exp_action("land")
	await _step(1)
	await _object("derelict")
	await _action("gather")
	await _step(18)
	_check(int(game.simulation.snapshot().cargo.alloy)==6,"Rented salvage ship triples the actual wreck batch")
	await _travel("base")
	await _object("shuttle")
	await _action("return_rental")
	_check(not game.simulation.snapshot().rental.active and int(game.simulation.snapshot().ship.capacity)==12,"Rental returns safely to owned shuttle")
	await _travel("bunker_surface")
	await _capture("n3-bunker-surface")
	await _attack_pair("aa_turret")
	await _attack_pair("surface_guard")
	_check(game.simulation.snapshot().ground.enemies.bunker_surface.aa_turret.defeated,"Crew can defeat bunker anti-air turret")
	await _lift("bunker_entry")
	_check(game.simulation.snapshot().region=="bunker_depths","Actual lift loads a separate underground map")
	await _capture("n3-bunker-depths")
	await _attack_pair("depth_guard")
	await _object("bunker_cache")
	var alloy:int=int(game.simulation.snapshot().inventory.alloy)
	await _action("gather")
	await _step(30)
	_check(int(game.simulation.snapshot().inventory.alloy)>alloy,"Bunker room loot is reachable through the door route")
	await _lift("elevator")
	_check(game.simulation.snapshot().region=="bunker_surface","Lift returns to surface with parked ship")
	await _travel("distribution")
	_check(game.simulation.snapshot().region=="distribution","Independent distribution center is accessible")
	game.world.focus_home()
	await _capture("n3-distribution")
	await _travel("tradepost")
	_check(game.simulation.snapshot().region=="tradepost","Independent ground trading post is accessible")
	game.world.focus_home()
	await _capture("n3-tradepost")
	await _object("tradepost_cache")
	await _action("gather")
	await _step(70)
	_check(int(game.simulation.snapshot().cargo.parts)>0,"Off-market exploration yields a real outpost find")
	await _key(KEY_F5)
	await _key(KEY_F9)
	_check(game.simulation.snapshot().crew.ida.equipment.armor=="armor" and game.simulation.snapshot().region=="tradepost","Extended career saves and restores gear and region")
	game.hud.open_network(true)
	await process_frame
	_check(game.hud._network_window.visible,"Internet cooperation window is reachable in game")
	game.hud._network_window.hide()
	var report:Dictionary={"checks":checks,"failed":failed,"wall_ms":Time.get_ticks_msec()-_start_ms,"evidence":evidence,"input":"real menu, GUI clicks, world ray picks and authoritative simulation time"}
	var file:=FileAccess.open("res://output/n3-product-result.json",FileAccess.WRITE)
	file.store_string(JSON.stringify(report,"\t"));file.close()
	print("N3 PRODUCT WINDOW: %d checks, %d failures" % [checks,failed])
	quit(0 if failed==0 else 1)

func _travel(destination:String)->void:
	await _object("shuttle")
	await _action(destination)
	await _step(45)
	if game.simulation.snapshot().region=="space":
		await _exp_action("fire_turret")
		await _step(15)
	_check(game.simulation.snapshot().region==destination,"Travel arrives at "+destination)

func _attack_pair(id:String)->void:
	for unit:String in ["jaro","ida"]:
		game.hud.choose_unit(unit,false)
		await _object(id)
		await _action("attack")
	await _step(35)

func _lift(id:String)->void:
	await _object(id)
	await _click(game.hud._context_actions.get_child(0).get_global_rect().get_center())
	await _step(35)
	await _action("use_elevator")
	await _step(1)
