+
+const GUARD = preload("res://scripts/tests/review2_isolated_user_guard.gd")
+const MISSION_SCENE = preload("res://scenes/tests/mission_reactivity_test.tscn")
+
+var _passed: int = 0
+var _failed: int = 0
+
+
+func _init() -> void:
+	if not GUARD.require_isolated_user_data():
+		return
+	call_deferred("_run")
+
+
+func _run() -> void:
+	root.size = Vector2i(1920, 1080)
+	var server_peer := ENetMultiplayerPeer.new()
+	var port_used: int = -1
+	for port in range(19880, 19900):
+		if server_peer.create_server(port, 2) == OK:
+			port_used = port
+			break
+	_check(port_used >= 0, "Local ENet camera fixture can listen")
+	if port_used < 0:
+		_finish()
+		return
+	var server_api: MultiplayerAPI = MultiplayerAPI.create_default_interface()
+	var client_api: MultiplayerAPI = MultiplayerAPI.create_default_interface()
+	var server_root := Node.new()
+	server_root.name = "Review7CameraServer"
+	root.add_child(server_root)
+	set_multiplayer(server_api, server_root.get_path())
+	server_api.multiplayer_peer = server_peer
+	var client_root := Node.new()
+	client_root.name = "Review7CameraClient"
+	root.add_child(client_root)
+	set_multiplayer(client_api, client_root.get_path())
+	var client_peer := ENetMultiplayerPeer.new()
+	var connect_error: Error = client_peer.create_client("127.0.0.1", port_used)
+	_check(connect_error == OK, "Local ENet camera client can connect")
+	if connect_error != OK:
+		server_peer.close()
+		server_root.free()
+		client_root.free()
+		_finish()
+		return
+	client_api.multiplayer_peer = client_peer
+	for _frame in range(240):
+		server_api.poll()
+		client_api.poll()
+		await process_frame
+		if client_peer.get_connection_status() == MultiplayerPeer.CONNECTION_CONNECTED and server_api.get_peers().size() == 1:
+			break
+	_check(client_peer.get_connection_status() == MultiplayerPeer.CONNECTION_CONNECTED and not client_api.is_server(), "Camera regression runs in a real connected client subtree")
+	if client_peer.get_connection_status() == MultiplayerPeer.CONNECTION_CONNECTED:
+		var mission: Node = await _make_client_mission(client_root, server_api, client_api)
+		_test_same_contact_and_new_focus(mission)
+		mission.free()
+		await process_frame
+		# The real next-mission lifecycle creates a fresh controller. It must
+		# still frame the same identity, without resetting private camera caches.
+		var next_mission: Node = await _make_client_mission(client_root, server_api, client_api)
+		var next_controller: Node = next_mission.get_node("TacticalController")
+		var next_view: Node = next_mission.get_node("Primary3DView")
+		_check(String(next_controller.get("_connected_first_contact_world_frame_signature")).is_empty(), "A fresh mission starts with no first-contact frame")
+		next_controller.call("_set_selected_fireteams", PackedStringArray(["blue"]), false)
+		_pan_and_zoom(next_view)
+		var before_first: Dictionary = _camera_state(next_view)
+		next_controller.call("_on_multiplayer_authority_snapshot_applied", _snapshot(20000, "enemy_delta", Vector2(228.0, 130.0)))
+		_check(not _same_camera(before_first, _camera_state(next_view)), "A new mission can frame the same contact identity again")
+		_check(not String(next_controller.get("_connected_first_contact_world_frame_signature")).is_empty(), "New-mission framing records its own one-shot context")
+		next_mission.free()
+	client_peer.close()
+	server_peer.close()
+	client_root.free()
+	server_root.free()
+	await process_frame
+	_finish()
+
+
+func _make_client_mission(client_root: Node, server_api: MultiplayerAPI, client_api: MultiplayerAPI) -> Node:
+	var mission: Node = MISSION_SCENE.instantiate()
+	# Match lobby launch ordering: authority is configured BEFORE _ready.
+	mission.get_node("SimulationRoot").set("is_server_authoritative", true)
+	client_root.add_child(mission)
+	for _frame in range(12):
+		server_api.poll()
+		client_api.poll()
+		await process_frame
+	# Freeze unrelated fixture work, retaining the real snapshot consumer,
+	# CombatLoopDriver, contact cache, primary bridge and camera implementation.
+	mission.process_mode = Node.PROCESS_MODE_DISABLED
+	return mission
+
+
+func _test_same_contact_and_new_focus(mission: Node) -> void:
+	var controller: Node = mission.get_node("TacticalController")
+	var view: Node = mission.get_node("Primary3DView")
+	var driver: Node = mission.get_node("CombatLoopDriver")
+	_check(bool(controller.call("_is_connected_network_snapshot_client")) and not bool(driver.get("_runs_local_authority")), "Fixture consumes remote snapshots instead of running local combat authority")
+	_check(Array(controller.call("_get_fireteam_units", "blue", true)).size() > 0 and Array(controller.call("_get_fireteam_units", "gold", true)).size() > 0, "Real mission supplies members for both focus contexts")
+	controller.call("_set_selected_fireteams", PackedStringArray(["blue"]), false)
+	_pan_and_zoom(view)
+	var before_first: Dictionary = _camera_state(view)
+	controller.call("_on_multiplayer_authority_snapshot_applied", _snapshot(10000, "enemy_delta", Vector2(228.0, 130.0)))
+	_check(Array(controller.call("get_contact_snapshot")).size() == 1, "Normal authority snapshot consumer publishes the first contact")
+	_check(not _same_camera(before_first, _camera_state(view)), "First connected contact frames local members and target")
+	var first_signature: String = String(controller.get("_connected_first_contact_world_frame_signature"))
+	_check(not first_signature.is_empty(), "Successful first frame records its context")
+	_pan_and_zoom(view)
+	var manual: Dictionary = _camera_state(view)
+	controller.call("_on_multiplayer_authority_snapshot_applied", _snapshot(10001, "enemy_delta", Vector2(228.0, 130.0)))
+	_check(_same_camera(manual, _camera_state(view)), "Unchanged same-ID contact preserves manual pan and zoom")
+	controller.call("_on_multiplayer_authority_snapshot_applied", _snapshot(10002, "enemy_delta", Vector2(292.0, 130.0)))
+	_check(_same_camera(manual, _camera_state(view)), "Moving same-ID contact preserves manual pan and zoom through normal snapshot refresh")
+	var moved_contacts: Array = Array(controller.call("get_contact_snapshot"))
+	_check(not moved_contacts.is_empty() and Vector2(Dictionary(moved_contacts[0]).get("approximate_position", Vector2.ZERO)).is_equal_approx(Vector2(292.0, 130.0)), "Moving-contact snapshot is still consumed for current contact visuals")
+	_check(String(controller.get("_connected_first_contact_world_frame_signature")) == first_signature, "Position changes retain the original first-contact context")
+	controller.call("_on_multiplayer_authority_snapshot_applied", _snapshot(10003, "enemy_echo", Vector2(180.0, 195.0)))
+	_check(not _same_camera(manual, _camera_state(view)), "A different target identity can receive a new initial frame")
+	_check(String(controller.get("_connected_first_contact_world_frame_signature")) != first_signature, "New target records a distinct first-contact context")
+	controller.call("_on_multiplayer_authority_snapshot_applied", _snapshot(10004, "enemy_echo", Vector2(180.0, 195.0), "gold"))
+	_pan_and_zoom(view)
+	var before_selection: Dictionary = _camera_state(view)
+	controller.call("_set_selected_fireteams", PackedStringArray(["gold"]), false)
+	_check(not _same_camera(before_selection, _camera_state(view)), "Changing the selected local fireteam still permits initial contact framing")
+	_pan_and_zoom(view)
+	var gold_manual: Dictionary = _camera_state(view)
+	controller.call("_on_multiplayer_authority_snapshot_applied", _snapshot(10005, "enemy_echo", Vector2(240.0, 195.0), "gold"))
+	_check(_same_camera(gold_manual, _camera_state(view)), "Moving same-ID GOLD contact also preserves manual camera")
+
+
+func _snapshot(tick: int, target_id: String, position: Vector2, fireteam_id: String = "blue") -> Dictionary:
+	return {
+		"tick": tick,
+		"contacts": [{
+			"fireteam_id": fireteam_id, "unit_id": target_id, "target_id": target_id,
+			"team_id": "team_bravo", "last_known_position": position,
+			"approximate_position": position, "detection_state": "confirmed",
+			"report_state": "current", "confidence": 1.0,
+		}],
+		"fire_events": [], "tactical_rules": [], "dropship": {}, "mission_interactions": {},
+	}
+
+
+func _pan_and_zoom(view: Node) -> void:
+	view.call("pan_camera", Vector2(1.0, 0.0), 0.75)
+	view.call("zoom_camera", 2.0)
+
+
+func _camera_state(view: Node) -> Dictionary:
+	return {"focus": Vector2(view.call("get_camera_focus_grid_position")), "size": float(view.call("get_camera_size"))}
+
+
+func _same_camera(first: Dictionary, second: Dictionary) -> bool:
+	return Vector2(first["focus"]).is_equal_approx(Vector2(second["focus"])) and is_equal_approx(float(first["size"]), float(second["size"]))
+
+
+func _check(ok: bool, label: String) -> void:
+	if ok:
+		_passed += 1
+		print("PASS: ", label)
+	else:
+		_failed += 1
+		print("FAIL: ", label)
+
+
+func _finish() -> void:
+	print("REVIEW7_CAMERA_RESULT passed=%d failed=%d" % [_passed, _failed])
+	quit(0 if _failed == 0 else 1)
diff --git a/scripts/tests/review7_fow_motion_verifier.gd b/scripts/tests/review7_fow_motion_verifier.gd
new file mode 100644
index 000000000..17eb99449
--- /dev/null
+++ b/scripts/tests/review7_fow_motion_verifier.gd
@@ -0,0 +1,88 @@
+extends "res://scripts/tests/review7_fow_verifier.gd"
+
+# Reuse the guarded real MissionTestSetup/FogOfWarSystem fixture. Only the
+# workload differs: an observer keeps walking while bounded jobs finish.
+func _run() -> void:
+	for side in [32, 128, 256]:
+		var stationary: Dictionary = _continuous_case(side, false)
+		var walking: Dictionary = _continuous_case(side, true)
+		_check(int(walking.first_commit) == int(stationary.first_commit), "%d continuous observer motion preserves initial scan completion frame" % side)
+	print("REVIEW7_FOW_MOTION_RESULT %d passed, %d failed" % [passed, failed])
+	quit(1 if failed else 0)
+
+
+func _continuous_case(side: int, walking: bool) -> Dictionary:
+	var f: Dictionary = _fixture(side)
+	var setup = f.setup
+	var origin: Vector2 = f.observer.position
+	var label: String = "%d %s" % [side, "walking" if walking else "stationary"]
+	setup.call("_sync_fog_of_war_visual_state", true)
+	var initial_sample_signature: String = String(setup.get("_fog_requested_runtime_signature"))
+	var first_commit: int = -1
+	var first_commit_sample_matches: bool = false
+	var first_commit_enumerations: int = -1
+	var conservative_while_pending: bool = _pending_is_atomic(f)
+	var dynamic_samples_correct: bool = true
+	var final_revision_while_walking: int = 0
+	var frames: int = ceili(float(side * side) / 512.0) + 90
+	for frame in range(frames):
+		if walking:
+			f.observer.position += Vector2(80.0 / 60.0, 0.0)
+		# Two genuine target visibility changes occur before the 128/256 full
+		# scan can complete. They must use the regular 100-ms dynamic cadence.
+		if frame < 2 or (frame >= 11 and frame < 31):
+			f.enemies[0].position = f.observer.position + Vector2(20.0, 0.0)
+		else:
+			f.enemies[0].position = f.observer.position + Vector2(1000.0, 0.0)
+		setup.call("_process", 1.0 / 60.0)
+		if frame in [8, 20, 40]:
+			var should_be_visible: bool = frame == 20
+			dynamic_samples_correct = dynamic_samples_correct and f.fog.is_visible("team_alpha", "enemy_0") == should_be_visible
+		var revision: int = int(f.fog.build_team_state_snapshot("team_alpha").get("visibility_revision", 0))
+		if first_commit == -1 and revision > 0:
+			first_commit = frame
+			# A finished request may be sampled in the past; it must keep that
+			# precise identity instead of claiming it used the latest position.
+			first_commit_sample_matches = String(setup.get("_fog_runtime_signature")) == initial_sample_signature
+			first_commit_sample_matches = first_commit_sample_matches and _visible_tiles(f.fog) == _oracle_at(f, origin)
+			first_commit_enumerations = int(f.registry.enumerations)
+		conservative_while_pending = conservative_while_pending and _pending_is_atomic(f)
+		final_revision_while_walking = revision
+	_check(first_commit >= 0, label + " initial scan completes while the workload is still running")
+	_check(first_commit_sample_matches, label + " first atomic result retains its frozen request sample and matches the full oracle")
+	_check(conservative_while_pending, label + " pending terrain retains only the last complete published sample")
+	_check(dynamic_samples_correct, label + " targets enter and leave visibility at the normal cadence even during pending terrain work")
+	if walking:
+		_check(final_revision_while_walking > 1, label + " coalesced motion produces follow-up revisions without stopping")
+	else:
+		_check(final_revision_while_walking == 1, label + " stationary observer creates only its initial terrain revision")
+	var settled: bool = false
+	for _frame in range(120):
+		setup.call("_process", 1.0 / 60.0)
+		var current_signature: String = setup.call("_build_fog_runtime_signature", "unexplored_blackout")
+		if String(setup.get("_fog_requested_runtime_signature")).is_empty() and String(setup.get("_fog_runtime_signature")) == current_signature:
+			settled = true
+			break
+	_check(settled, label + " stopping coalesces the latest position within bounded normal frames")
+	_check(first_commit_enumerations >= 0 and int(f.registry.enumerations) == first_commit_enumerations, label + " follow-up motion and target refreshes never enumerate the full map again")
+	_check(_visible_tiles(f.fog) == _oracle_at(f, f.observer.position), label + " final committed terrain exactly matches the latest-position full oracle")
+	print("REVIEW7_FOW_MOTION_WORKLOAD ", JSON.stringify({"side": side, "walking": walking, "frames": frames, "first_commit": first_commit, "revisions_before_stop": final_revision_while_walking, "enumerations": f.registry.enumerations}))
+	f.holder.free()
+	return {"first_commit": first_commit}
+
+
+func _pending_is_atomic(f: Dictionary) -> bool:
+	if String(f.setup.get("_fog_requested_runtime_signature")).is_empty():
+		return true
+	var committed: Dictionary = f.fog.build_team_state_snapshot("team_alpha")
+	return bool(f.sink.last_state.get("visibility_pending", false)) and Dictionary(f.sink.last_state.get("terrain_knowledge", {})) == Dictionary(committed.get("terrain_knowledge", {})) and int(f.sink.last_state.get("visibility_revision", -1)) == int(committed.get("visibility_revision", 0))
+
+
+func _oracle_at(f: Dictionary, position: Vector2) -> PackedStringArray:
+	var observer = _unit(f.holder, "oracle_observer", "team_alpha", position)
+	var oracle = FOW.new()
+	oracle.set_mode_for_team("team_alpha", "unexplored_blackout")
+	oracle.update_tile_visibility_for_team("team_alpha", [observer], f.registry, LOS.new(), 160.0)
+	var visible: PackedStringArray = _visible_tiles(oracle)
+	observer.free()
+	return visible
diff --git a/scripts/tests/review7_fow_moving_view_verifier.gd b/scripts/tests/review7_fow_moving_view_verifier.gd
new file mode 100644
index 000000000..0f955ab08
--- /dev/null
+++ b/scripts/tests/review7_fow_moving_view_verifier.gd
@@ -0,0 +1,235 @@
+extends "res://scripts/tests/review7_fow_verifier.gd"
+
+const REAL_VIEW = preload("res://scripts/terrain/terrain_map_3d_view.gd")
+const MAP_DATA = preload("res://scripts/terrain/terrain_map_data.gd")
+
+var _gpu_readback_available: bool = false
+
+
+func _run() -> void:
+	await _characterize_multimesh_readback()
+	if OS.get_environment("SB_REVIEW7_REQUIRE_GPU_READBACK") == "1":
+		_check(_gpu_readback_available, "Required native renderer supports actual MultiMesh color and transform readback")
+	await _moving_real_view_case(128, 512)
+	await _moving_real_view_case(256, 512)
+	# A supported larger terrain slice publishes the first revision while the
+	# actual streamed overlay is still being built. Deltas must retain its work.
+	await _moving_real_view_case(128, 2048)
+	await _skipped_revision_rebuild_case()
+	print("REVIEW7_FOW_MOVING_VIEW_RESULT %d passed, %d failed" % [passed, failed])
+	quit(1 if failed else 0)
+
+
+func _moving_real_view_case(side: int, work_budget: int) -> void:
+	var f: Dictionary = _fixture(side)
+	var view: Node = REAL_VIEW.new()
+	f.holder.add_child(view)
+	view.set_process(false)
+	var map_data = MAP_DATA.create_empty("review7_walking_real_view_%d" % side, Vector2i(side, side), Vector2.ZERO, 64.0, 32.0, 3)
+	view.call("configure_from_map", map_data)
+	view.call("set_unit_nodes", Array(f.setup.get("_fog_unit_nodes")))
+	f.setup.set("_terrain_3d_view", view)
+	f.setup.fog_of_war_work_budget_tiles = work_budget
+	# Finish ordinary deferred layout/streaming setup before measuring one fixed
+	# map/camera context. Neither camera nor render caches are patched here.
+	await process_frame
+	await process_frame
+	var label: String = "%d real moving view budget%d" % [side, work_budget]
+	var rendered_tile_ids: PackedStringArray = PackedStringArray(view.get("_fow_overlay_render_tile_ids"))
+	_check(bool(view.get("_visual_streaming_active")) and rendered_tile_ids.size() > 512 and rendered_tile_ids.size() < side * side, label + " uses the normal streamed map subset larger than one overlay slice")
+	var full_rebuilds_before: int = int(view.get("_fow_overlay_full_rebuild_count"))
+	f.setup.call("_sync_fog_of_war_visual_state", true)
+	var initial_mesh_id: int = _mesh_id(view)
+	_check(initial_mesh_id != 0 and bool(view.get("_fow_overlay_full_rebuild_pending")), label + " starts one actual FoW MultiMesh behind its initial safety cover")
+	var mesh_stable: bool = true
+	var first_commit: int = -1
+	var first_commit_during_overlay: bool = false
+	var first_visible_overlay: int = -1
+	var max_terrain_revision: int = 0
+	var frames: int = ceili(float(side * side) / float(work_budget)) + 100
+	for frame in range(frames):
+		f.observer.position += Vector2(80.0 / 60.0, 0.0)
+		# Execute both normal consumers in normal frame order. The terrain job
+		# keeps walking throughout; rendering is never replaced with VisualSink.
+		f.setup.call("_process", 1.0 / 60.0)
+		var terrain_revision: int = int(f.fog.build_team_state_snapshot("team_alpha").get("visibility_revision", 0))
+		if first_commit == -1 and terrain_revision > 0:
+			first_commit = frame
+			first_commit_during_overlay = bool(view.get("_fow_overlay_full_rebuild_pending"))
+		view.call("_process", 1.0 / 60.0)
+		mesh_stable = mesh_stable and _mesh_id(view) == initial_mesh_id
+		max_terrain_revision = maxi(max_terrain_revision, terrain_revision)
+		if first_visible_overlay == -1 and terrain_revision > 0 and not bool(view.get("_fow_overlay_full_rebuild_pending")) and _safety_id(view) == 0 and int(view.get("_fow_overlay_visibility_revision")) == terrain_revision and int(view.get("_fow_visible_tile_count")) > 0:
+			first_visible_overlay = frame
+		await process_frame
+	_check(first_commit >= 0 and max_terrain_revision > 1, label + " publishes initial and follow-up terrain revisions without stopping the observer")
+	_check(first_visible_overlay >= 0, label + " completes a real visible revision and removes the safety blackout while the observer is still walking")
+	_check(mesh_stable, label + " retains the exact MultiMesh instance throughout one map/mode/team/terrain context")
+	_check(int(view.get("_fow_overlay_full_rebuild_count")) == full_rebuilds_before + 1, label + " performs exactly one full overlay build despite ongoing terrain revisions")
+	if work_budget == 2048:
+		_check(first_commit_during_overlay, label + " exercises a sequential terrain delta before the initial overlay finishes")
+	# Stop by ceasing normal runtime movement, then let both real consumers
+	# settle naturally. No force refresh, dirty mutation or direct tile setter.
+	var settled: bool = false
+	for _frame in range(180):
+		f.setup.call("_process", 1.0 / 60.0)
+		view.call("_process", 1.0 / 60.0)
+		var latest_signature: String = f.setup.call("_build_fog_runtime_signature", "unexplored_blackout")
+		if String(f.setup.get("_fog_requested_runtime_signature")).is_empty() and String(f.setup.get("_fog_runtime_signature")) == latest_signature and not bool(view.get("_fow_overlay_full_rebuild_pending")):
+			settled = true
+			break
+		await process_frame
+	_check(settled and _safety_id(view) == 0, label + " settles the latest stopped position without a remaining safety blackout")
+	_check(_mesh_id(view) == initial_mesh_id and int(view.get("_fow_overlay_full_rebuild_count")) == full_rebuilds_before + 1, label + " settling also retains the original completed overlay")
+	var state: Dictionary = Dictionary(f.fog.build_team_state_snapshot("team_alpha"))
+	_check(int(view.get("_fow_overlay_visibility_revision")) == int(state.get("visibility_revision", 0)), label + " renders the final committed terrain revision")
+	_check(_rendered_tile_states_match(view, state), label + " every rendered tile state and supported overlay readback match final authoritative FoW knowledge")
+	var capture: Dictionary = await _capture_native_view(view, "walking_%d_budget%d" % [side, work_budget])
+	print("REVIEW7_FOW_MOVING_VIEW_WORKLOAD ", JSON.stringify({"side": side, "work_budget": work_budget, "walking_frames": frames, "rendered_tiles": rendered_tile_ids.size(), "first_terrain_commit_frame": first_commit, "first_visible_overlay_frame": first_visible_overlay, "first_commit_during_overlay": first_commit_during_overlay, "revisions_while_walking": max_terrain_revision, "full_overlay_builds": int(view.get("_fow_overlay_full_rebuild_count")) - full_rebuilds_before, "mesh_stable": mesh_stable, "gpu_readback_available": _gpu_readback_available, "capture": capture, "headless_is_not_pixel_capture": true}))
+	f.holder.free()
+	await process_frame
+
+
+func _skipped_revision_rebuild_case() -> void:
+	var f: Dictionary = _fixture(32)
+	var view: Node = REAL_VIEW.new()
+	f.holder.add_child(view)
+	view.set_process(false)
+	view.call("configure_from_map", MAP_DATA.create_empty("review7_skipped_fow_view", Vector2i(32, 32), Vector2.ZERO, 64.0, 32.0, 3))
+	f.setup.set("_terrain_3d_view", view)
+	f.setup.call("_sync_fog_of_war_visual_state", true)
+	_drain(f)
+	for _frame in range(8):
+		view.call("_process", 1.0 / 60.0)
+		await process_frame
+	var before_mesh: int = _mesh_id(view)
+	var before_revision: int = int(view.get("_fow_overlay_visibility_revision"))
+	var before_delta_applies: int = int(view.get("_fow_overlay_delta_apply_count"))
+	_check(before_mesh != 0 and before_revision == 1 and not bool(view.get("_fow_overlay_full_rebuild_pending")), "Skipped-revision fixture starts from a complete real revision-one overlay")
+	# Produce two genuine authoritative updates. The first removes origin-side
+	# visibility; the second's last-only delta cannot describe that first loss.
+	# Deliberately deliver only the second publication to the view boundary.
+	f.observer.position += Vector2(192.0, 0.0)
+	f.fog.update_tile_visibility_for_team("team_alpha", [f.observer], f.registry, LOS.new(), 160.0)
+	f.observer.position += Vector2(192.0, 0.0)
+	f.fog.update_tile_visibility_for_team("team_alpha", [f.observer], f.registry, LOS.new(), 160.0)
+	var latest_state: Dictionary = Dictionary(f.fog.build_team_state_snapshot("team_alpha"))
+	_check(int(latest_state.get("visibility_revision", 0)) == before_revision + 2, "Two real FoW updates create an intentionally skipped visual revision")
+	view.call("set_fog_of_war_state", latest_state)
+	_check(_mesh_id(view) != before_mesh and bool(view.get("_fow_overlay_full_rebuild_pending")), "A revision gap replaces the old terrain mesh through a full overlay rebuild")
+	_check(int(view.get("_fow_overlay_delta_apply_count")) == before_delta_applies, "A revision gap never applies the incomplete last-only visibility delta")
+	for _frame in range(8):
+		view.call("_process", 1.0 / 60.0)
+		await process_frame
+	_check(not bool(view.get("_fow_overlay_full_rebuild_pending")) and _safety_id(view) == 0, "Revision-gap full rebuild finishes and removes its safety blackout")
+	_check(_rendered_tile_states_match(view, latest_state), "Revision-gap rebuild renders all latest visible/explored tiles including the skipped delta's changes")
+	var oracle = FOW.new()
+	oracle.set_mode_for_team("team_alpha", "unexplored_blackout")
+	oracle.update_tile_visibility_for_team("team_alpha", [f.observer], f.registry, LOS.new(), 160.0)
+	_check(_visible_tiles(f.fog) == _visible_tiles(oracle), "Revision-gap final visibility equals an independent current-position full oracle")
+	f.holder.free()
+	await process_frame
+
+
+func _mesh_id(view: Node) -> int:
+	var mesh: Node = view.get("_fow_overlay_multimesh_instance") as Node
+	return mesh.get_instance_id() if mesh != null and is_instance_valid(mesh) else 0
+
+
+func _safety_id(view: Node) -> int:
+	var safety: Node = view.get("_fow_overlay_safety_cover") as Node
+	return safety.get_instance_id() if safety != null and is_instance_valid(safety) else 0
+
+
+func _rendered_tile_states_match(view: Node, state: Dictionary) -> bool:
+	var knowledge: Dictionary = Dictionary(state.get("terrain_knowledge", {}))
+	var visible: PackedStringArray = PackedStringArray(knowledge.get("visible_tile_ids", []))
+	var explored: PackedStringArray = PackedStringArray(knowledge.get("explored_tile_ids", []))
+	var tile_states: Dictionary = Dictionary(view.get("_fow_overlay_tile_states_by_id"))
+	var rendered_tile_ids: PackedStringArray = PackedStringArray(view.get("_fow_overlay_render_tile_ids"))
+	var slots: Dictionary = Dictionary(view.get("_fow_overlay_slot_by_tile_id"))
+	var mesh: MultiMesh = view.get("_fow_overlay_multimesh") as MultiMesh
+	if rendered_tile_ids.is_empty() or tile_states.size() != rendered_tile_ids.size() or slots.size() != rendered_tile_ids.size() or mesh == null:
+		print("REVIEW7_FOW_VIEW_TILE_MISMATCH ", JSON.stringify({"reason": "incomplete_overlay_state", "rendered_tiles": rendered_tile_ids.size(), "tile_states": tile_states.size(), "mesh_present": mesh != null, "renderer": _renderer_facts()}))
+		return false
+	var seen_slots: Dictionary = {}
+	for tile_id in rendered_tile_ids:
+		var expected: String = "visible" if visible.has(tile_id) else ("explored" if explored.has(tile_id) else "unknown")
+		if String(tile_states.get(tile_id, "")) != expected:
+			_report_first_tile_mismatch(tile_id, expected, String(tile_states.get(tile_id, "")), mesh, int(slots.get(tile_id, -1)), "tile_state")
+			return false
+		if not slots.has(tile_id):
+			_report_first_tile_mismatch(tile_id, expected, String(tile_states.get(tile_id, "")), mesh, -1, "missing_slot")
+			return false
+		var slot: int = int(slots[tile_id])
+		if slot < 0 or slot >= mesh.instance_count or seen_slots.has(slot):
+			_report_first_tile_mismatch(tile_id, expected, String(tile_states.get(tile_id, "")), mesh, -1, "invalid_or_duplicate_slot")
+			return false
+		seen_slots[slot] = true
+		# Dummy RenderingServer cannot round-trip even a standalone MultiMesh.
+		# CPU tile-state and exact one-to-one slot coverage remain mandatory;
+		# the same gate requires these buffer checks on a capable native backend.
+		if not _gpu_readback_available:
+			continue
+		var color: Color = mesh.get_instance_color(int(slots[tile_id]))
+		if expected == "visible" and not is_zero_approx(color.a):
+			_report_first_tile_mismatch(tile_id, expected, String(tile_states.get(tile_id, "")), mesh, int(slots[tile_id]), "visible_alpha")
+			return false
+		if expected != "visible" and color.a <= 0.0:
+			_report_first_tile_mismatch(tile_id, expected, String(tile_states.get(tile_id, "")), mesh, int(slots[tile_id]), "covered_alpha")
+			return false
+	return true
+
+
+func _report_first_tile_mismatch(tile_id: String, expected: String, actual: String, mesh: MultiMesh, slot: int, reason: String) -> void:
+	var facts: Dictionary = {"reason": reason, "tile_id": tile_id, "slot": slot, "expected_state": expected, "actual_state": actual, "renderer": _renderer_facts()}
+	if slot >= 0:
+		var color: Color = mesh.get_instance_color(slot)
+		var transform: Transform3D = mesh.get_instance_transform(slot)
+		facts["readback_color"] = [color.r, color.g, color.b, color.a]
+		facts["readback_transform_origin"] = [transform.origin.x, transform.origin.y, transform.origin.z]
+	print("REVIEW7_FOW_VIEW_TILE_MISMATCH ", JSON.stringify(facts))
+
+
+func _characterize_multimesh_readback() -> void:
+	# Characterize the current backend independently of FoW and the view. Keep
+	# the product-state and alpha assertions above intact until this is known.
+	var mesh := MultiMesh.new()
+	mesh.transform_format = MultiMesh.TRANSFORM_3D
+	mesh.use_colors = true
+	mesh.mesh = BoxMesh.new()
+	mesh.instance_count = 1
+	var expected_color := Color(0.25, 0.5, 0.75, 0.0)
+	var expected_transform := Transform3D(Basis(), Vector3(5.0, 7.0, 11.0))
+	mesh.set_instance_color(0, expected_color)
+	mesh.set_instance_transform(0, expected_transform)
+	await process_frame
+	var actual_color: Color = mesh.get_instance_color(0)
+	var actual_transform: Transform3D = mesh.get_instance_transform(0)
+	_gpu_readback_available = actual_color.is_equal_approx(expected_color) and actual_transform.is_equal_approx(expected_transform)
+	print("REVIEW7_MULTIMESH_READBACK_CHARACTERIZATION ", JSON.stringify({"renderer": _renderer_facts(), "expected_color": [expected_color.r, expected_color.g, expected_color.b, expected_color.a], "actual_color": [actual_color.r, actual_color.g, actual_color.b, actual_color.a], "color_roundtrip_matches": actual_color.is_equal_approx(expected_color), "expected_transform_origin": [5.0, 7.0, 11.0], "actual_transform_origin": [actual_transform.origin.x, actual_transform.origin.y, actual_transform.origin.z], "transform_roundtrip_matches": actual_transform.is_equal_approx(expected_transform), "gpu_readback_available": _gpu_readback_available, "gpu_readback_required": OS.get_environment("SB_REVIEW7_REQUIRE_GPU_READBACK") == "1"}))
+
+
+func _capture_native_view(view: Node, file_name: String) -> Dictionary:
+	if DisplayServer.get_name().to_lower() == "headless":
+		return {"captured": false, "reason": "headless_has_no_pixel_capture"}
+	var viewport: SubViewport = view.get("_subviewport") as SubViewport
+	if viewport == null:
+		return {"captured": false, "reason": "subviewport_missing"}
+	view.call("_process", 1.0 / 60.0)
+	await process_frame
+	await RenderingServer.frame_post_draw
+	var captured_image: Image = viewport.get_texture().get_image()
+	if captured_image == null or captured_image.is_empty():
+		return {"captured": false, "reason": "empty_viewport_image"}
+	var output_directory: String = "user://review7_rendered"
+	var directory_error: Error = DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(output_directory))
+	if directory_error != OK:
+		return {"captured": false, "reason": "capture_directory_failed", "error": directory_error}
+	var output_path: String = "%s/%s.png" % [output_directory, file_name]
+	var save_error: Error = captured_image.save_png(output_path)
+	return {"captured": save_error == OK, "path": output_path, "absolute_path": ProjectSettings.globalize_path(output_path), "size": [captured_image.get_width(), captured_image.get_height()], "error": save_error}
+
+
+func _renderer_facts() -> Dictionary:
+	return {"display": DisplayServer.get_name(), "method": RenderingServer.get_current_rendering_method(), "driver": RenderingServer.get_current_rendering_driver_name(), "adapter": RenderingServer.get_video_adapter_name()}
diff --git a/scripts/tests/review7_fow_verifier.gd b/scripts/tests/review7_fow_verifier.gd
new file mode 100644
index 000000000..c115c52d4
--- /dev/null
+++ b/scripts/tests/review7_fow_verifier.gd
@@ -0,0 +1,237 @@
+extends SceneTree
+
+const GUARD = preload("res://scripts/tests/review2_isolated_user_guard.gd")
+const SETUP = preload("res://scripts/tests/mission_test_setup.gd")
+const FOW = preload("res://scripts/core/fog_of_war_system.gd")
+const LOS = preload("res://scripts/core/los_system.gd")
+const TILE = preload("res://scripts/terrain/terrain_tile_data.gd")
+const UNIT = preload("res://scripts/npc/test_unit.gd")
+
+# Only observe resource enumeration and the visual boundary; calculations remain real.
+class CountingRegistry:
+	extends "res://scripts/terrain/terrain_registry.gd"
+	var enumerations: int = 0
+	func get_sorted_tiles() -> Array:
+		enumerations += 1
+		return super.get_sorted_tiles()
+	func get_all_tiles() -> Array:
+		enumerations += 1
+		return super.get_all_tiles()
+
+class VisualSink extends Node:
+	var last_state: Dictionary = {}
+	func set_fog_of_war_state(state: Dictionary) -> void:
+		last_state = state.duplicate(true)
+
+var passed: int = 0
+var failed: int = 0
+
+func _init() -> void:
+	if not GUARD.require_isolated_user_data(): return
+	call_deferred("_run")
+
+func _run() -> void:
+	for side in [128, 256]:
+		var control := _large_case(side, false)
+		var moving := _large_case(side, true)
+		_check(int(moving.first_commit) == int(control.first_commit), "%d enemy movement retains initial scan progress" % side)
+	_test_dynamic_targets_and_invalidation()
+	_test_pending_inputs_change_before_normal_process()
+	print("REVIEW7_FOW_RESULT %d passed, %d failed" % [passed, failed])
+	quit(1 if failed else 0)
+
+func _fixture(side: int) -> Dictionary:
+	var holder := Node.new()
+	root.add_child(holder)
+	var registry := CountingRegistry.new()
+	holder.add_child(registry)
+	registry.configure_iso_grid(Vector2.ZERO, 64.0, 32.0)
+	for x in range(side):
+		for y in range(side):
+			registry.register_tile(TILE.new({"tile_id": "tile_%d_%d" % [x, y], "type_id": "ground_flat", "grid_position": Vector2i(x,y), "world_position": registry.grid_to_world(Vector2i(x,y)), "walkable": true}))
+	var center := Vector2i(side / 2, side / 2)
+	var observer = _unit(holder, "observer", "team_alpha", registry.grid_to_world(center))
+	var enemies: Array = []
+	var units: Array = [observer]
+	for i in range(4):
+		var enemy = _unit(holder, "enemy_%d" % i, "team_bravo", observer.position + Vector2(80.0 + 16.0 * i, 0.0))
+		enemies.append(enemy)
+		units.append(enemy)
+	var sink := VisualSink.new()
+	holder.add_child(sink)
+	var fog = FOW.new()
+	var setup = SETUP.new()
+	setup.set("_is_initialized", true)
+	setup.set("_fog_of_war_system", fog)
+	setup.set("_fog_of_war_los_system", LOS.new())
+	setup.set("_fog_terrain_registry", registry)
+	setup.set("_fog_unit_nodes", units)
+	setup.set("_fog_observer_unit_nodes", [observer])
+	setup.set("_terrain_3d_view", sink)
+	setup.fog_of_war_mode = "unexplored_blackout"
+	setup.fog_of_war_sight_range_world = 160.0
+	holder.add_child(setup)
+	setup.set_process(false)
+	return {"holder":holder, "registry":registry, "observer":observer, "enemies":enemies, "sink":sink, "fog":fog, "setup":setup}
+
+func _large_case(side: int, moving: bool) -> Dictionary:
+	var f := _fixture(side)
+	var setup = f.setup
+	# Match the reviewed workload's default sight and 512 tiles per slice.
+	setup.fog_of_war_sight_range_world = 640.0
+	setup.call("_sync_fog_of_war_visual_state", true)
+	var first_commit := -1
+	var safely_pending := true
+	for frame in range(240):
+		if moving:
+			for enemy in f.enemies:
+				enemy.position += Vector2(80.0 / 60.0, 0.0)
+		setup.call("_process", 1.0 / 60.0)
+		var revision := int(f.fog.build_team_state_snapshot("team_alpha").get("visibility_revision", 0))
+		if first_commit == -1 and revision > 0: first_commit = frame
+		if first_commit == -1:
+			safely_pending = safely_pending and bool(f.sink.last_state.get("visibility_pending", false))
+	_check(safely_pending, "Incomplete initial scan remains conservatively pending")
+	_check(first_commit >= 0, "%d scan publishes within 240 frames (moving=%s)" % [side, moving])
+	_check(int(f.fog.build_team_state_snapshot("team_alpha").get("visibility_revision", 0)) == 1, "Target motion creates no terrain revisions")
+	_check(not bool(f.sink.last_state.get("visibility_pending", false)), "Completed scan clears pending visual")
+	# A stationary observer's tile result is independent of target positions.
+	var oracle = FOW.new()
+	oracle.set_mode_for_team("team_alpha", "unexplored_blackout")
+	oracle.update_tile_visibility_for_team("team_alpha", [f.observer], f.registry, LOS.new(), 640.0)
+	_check(_visible_tiles(f.fog) == _visible_tiles(oracle), "Terrain result equals independent full-scan oracle")
+	print("REVIEW7_FOW_WORKLOAD ", JSON.stringify({"side":side,"moving":moving,"frames":240,"first_commit":first_commit,"enumerations":f.registry.enumerations}))
+	f.holder.free()
+	return {"first_commit":first_commit}
+
+func _test_dynamic_targets_and_invalidation() -> void:
+	var f := _fixture(32)
+	var setup = f.setup
+	setup.call("_sync_fog_of_war_visual_state", true)
+	_drain(f)
+	_check(f.fog.is_visible("team_alpha", "enemy_0"), "Nearby enemy initially visible")
+	var before_revision := int(f.fog.build_team_state_snapshot("team_alpha").visibility_revision)
+	var before_enumerations: int = f.registry.enumerations
+	f.enemies[0].position = f.observer.position + Vector2(500.0, 0.0)
+	for i in range(8): setup.call("_process", 1.0 / 60.0)
+	_check(not f.fog.is_visible("team_alpha", "enemy_0"), "Target moving out of LOS/range is hidden at normal cadence")
+	_check(not PackedStringArray(Dictionary(f.sink.last_state.get("current_visibility", {})).get("visible_target_ids", [])).has("enemy_0"), "Visual consumer receives target removal")
+	f.enemies[0].position = f.observer.position + Vector2(20.0, 0.0)
+	for i in range(8): setup.call("_process", 1.0 / 60.0)
+	_check(f.fog.is_visible("team_alpha", "enemy_0"), "Target returning to range becomes visible")
+	_check(int(f.fog.build_team_state_snapshot("team_alpha").visibility_revision) == before_revision, "Target-only refresh does not publish new terrain revision")
+	_check(f.registry.enumerations == before_enumerations, "Target-only refresh never enumerates terrain")
+	# An observer moving away and back while work is pending must not publish the away state.
+	var origin: Vector2 = f.observer.position
+	f.observer.position += Vector2(128.0, 0.0)
+	setup.fog_of_war_work_budget_tiles = 16
+	setup.call("_sync_fog_of_war_visual_state", false)
+	_check(not String(setup.get("_fog_requested_runtime_signature")).is_empty(), "Observer movement creates pending work")
+	f.observer.position = origin
+	setup.call("_sync_fog_of_war_visual_state", false)
+	_settle_latest(f)
+	var oracle = FOW.new()
+	oracle.set_mode_for_team("team_alpha", "unexplored_blackout")
+	oracle.update_tile_visibility_for_team("team_alpha", [f.observer], f.registry, LOS.new(), 160.0)
+	_check(_visible_tiles(f.fog) == _visible_tiles(oracle), "Returning observer does not publish obsolete pending position")
+	var sig: String = setup.call("_build_fog_runtime_signature", "unexplored_blackout")
+	setup.fog_of_war_sight_range_world = 80.0
+	_check(String(setup.call("_build_fog_runtime_signature", "unexplored_blackout")) != sig, "Base sight range invalidates terrain work")
+	setup.call("_sync_fog_of_war_visual_state", false)
+	_drain(f)
+	oracle.update_tile_visibility_for_team("team_alpha", [f.observer], f.registry, LOS.new(), 80.0)
+	_check(_visible_tiles(f.fog) == _visible_tiles(oracle), "Changed sight matches full-scan oracle")
+	sig = setup.call("_build_fog_runtime_signature", "unexplored_blackout")
+	f.observer.get_vital_status().state = "down"
+	_check(String(setup.call("_build_fog_runtime_signature", "unexplored_blackout")) != sig, "Downed observer changes terrain visibility input")
+	setup.call("_sync_fog_of_war_visual_state", false)
+	_drain(f)
+	_check(_visible_tiles(f.fog).is_empty(), "Downed observer reveals no terrain")
+	f.observer.get_vital_status().state = "fit"
+	f.observer.visible = false
+	setup.call("_sync_fog_of_war_visual_state", false)
+	_drain(f)
+	_check(_visible_tiles(f.fog).is_empty(), "Hidden observer reveals no terrain")
+	f.observer.visible = true
+	setup.call("_sync_fog_of_war_visual_state", false)
+	_drain(f)
+	_check(not _visible_tiles(f.fog).is_empty(), "Observer reactivation restores visibility")
+	sig = setup.call("_build_fog_runtime_signature", "unexplored_blackout")
+	var tile = f.registry.get_tile_at_grid(Vector2i(17, 16))
+	tile.blocks_los = true
+	tile.object_height = 3
+	f.registry.register_tile(tile)
+	_check(String(setup.call("_build_fog_runtime_signature", "unexplored_blackout")) != sig, "Terrain revision invalidates visibility input")
+	setup.call("_sync_fog_of_war_visual_state", false)
+	_drain(f)
+	oracle.update_tile_visibility_for_team("team_alpha", [f.observer], f.registry, LOS.new(), 80.0)
+	_check(_visible_tiles(f.fog) == _visible_tiles(oracle), "Terrain change matches LOS oracle")
+	setup.set_fog_of_war_mode("off")
+	_check(String(f.sink.last_state.get("mode", "")) == "off", "Mode off publishes immediately")
+	setup.set_fog_of_war_mode("unexplored_blackout")
+	_drain(f)
+	_check(_visible_tiles(f.fog) == _visible_tiles(oracle), "Mode reenable restores correct terrain")
+	f.holder.free()
+
+func _test_pending_inputs_change_before_normal_process() -> void:
+	for change in ["down", "position", "subtile_position", "sight", "terrain"]:
+		var f := _fixture(32)
+		var setup = f.setup
+		setup.call("_sync_fog_of_war_visual_state", true)
+		var requested_sample: String = setup.get("_fog_requested_runtime_signature")
+		_check(int(f.fog.build_team_state_snapshot("team_alpha").visibility_revision) == 0, "%s fixture begins with half a full scan pending" % change)
+		match change:
+			"down": f.observer.get_vital_status().state = "down"
+			"position": f.observer.position += Vector2(128.0, 0.0)
+			"subtile_position": f.observer.position += Vector2(8.0, 0.0)
+			"sight": setup.fog_of_war_sight_range_world = 80.0
+			"terrain":
+				var tile = f.registry.get_tile_at_grid(Vector2i(17, 16))
+				tile.blocks_los = true
+				tile.object_height = 3
+				f.registry.register_tile(tile)
+		# Normal frame, before the 100-ms refresh is due. Do not invoke _sync manually.
+		setup.call("_process", 1.0 / 60.0)
+		if change in ["position", "subtile_position"]:
+			_check(String(setup.get("_fog_runtime_signature")) == requested_sample, "%s completed atomic sample retains its original request identity" % change)
+			_check(String(setup.get("_fog_runtime_signature")) != String(setup.call("_build_fog_runtime_signature", "unexplored_blackout")), "%s sampled result never claims the newer observer position" % change)
+		else:
+			_check(int(f.fog.build_team_state_snapshot("team_alpha").visibility_revision) == 0, "%s hard input change cannot publish the obsolete pending scan" % change)
+			_check(bool(f.sink.last_state.get("visibility_pending", false)), "%s visual stays conservative until replacement completes" % change)
+		_settle_latest(f)
+		var oracle = FOW.new()
+		oracle.set_mode_for_team("team_alpha", "unexplored_blackout")
+		oracle.update_tile_visibility_for_team("team_alpha", [f.observer], f.registry, LOS.new(), setup.fog_of_war_sight_range_world)
+		_check(_visible_tiles(f.fog) == _visible_tiles(oracle), "%s replacement matches current-input oracle" % change)
+		f.holder.free()
+
+func _settle_latest(f: Dictionary) -> void:
+	for i in range(2048):
+		f.setup.call("_process", 1.0 / 60.0)
+		if String(f.setup.get("_fog_requested_runtime_signature")).is_empty() and String(f.setup.get("_fog_runtime_signature")) == String(f.setup.call("_build_fog_runtime_signature", "unexplored_blackout")):
+			return
+	_check(false, "Latest observer sample finishes within bounded normal frames")
+
+func _drain(f: Dictionary) -> void:
+	for i in range(2048):
+		if String(f.setup.get("_fog_requested_runtime_signature")).is_empty(): return
+		f.setup.call("_advance_fog_of_war_visibility_work")
+	_check(false, "Pending work finishes within bounded slices")
+
+func _visible_tiles(fog) -> PackedStringArray:
+	return PackedStringArray(Dictionary(fog.build_team_state_snapshot("team_alpha").get("terrain_knowledge", {})).get("visible_tile_ids", []))
+
+func _unit(holder: Node, id: String, team: String, position: Vector2):
+	var unit = UNIT.new()
+	unit.unit_id = id
+	unit.team_id = team
+	holder.add_child(unit)
+	unit.set_process(false)
+	unit.position = position
+	return unit
+
+func _check(condition: bool, message: String) -> void:
+	if condition: passed += 1
+	else:
+		failed += 1
+		print("FAIL: ", message)
