+extends SceneTree
+
+const ISOLATION_GUARD: GDScript = preload("res://scripts/tests/review2_isolated_user_guard.gd")
+const SESSION_SCRIPT: GDScript = preload("res://scripts/multiplayer/multiplayer_session.gd")
+const MAP_SCRIPT: GDScript = preload("res://scripts/multiplayer/multiplayer_map_manifest.gd")
+const TERRAIN_SCRIPT: GDScript = preload("res://scripts/terrain/terrain_map_data.gd")
+const MAP_PATH: String = "user://review7_session_map.json"
+const CACHE_ROOT: String = "user://review7_session_downloads"
+const ASSIGNMENTS: Dictionary = {"peer_teams": {1: "team_alpha", 2: "team_bravo"}, "peer_roles": {1: "host", 2: "commander"}, "peer_fireteams": {1: ["blue", "gold"], 2: ["red"]}}
+
+var _passed: int = 0
+var _failed: int = 0
+
+
+func _init() -> void:
+	if not ISOLATION_GUARD.require_isolated_user_data():
+		return
+	call_deferred("_run_tests")
+
+
+func _run_tests() -> void:
+	var map_data = TERRAIN_SCRIPT.call("create_empty", "review7_session_map", Vector2i(3, 3), Vector2.ZERO, 64.0, 32.0, 3)
+	_assert(map_data.call("save_to_file", MAP_PATH) == OK, "Map fixture saves only in isolated user data")
+	var map_text: String = FileAccess.get_file_as_string(MAP_PATH)
+	var manifest: Dictionary = Dictionary(MAP_SCRIPT.call("build_manifest_for_map", MAP_PATH))
+	_assert(bool(manifest.get("valid", false)), "Map fixture has a valid manifest")
+	await _test_empty_compatibility()
+	await _test_missing_and_rejected(manifest)
+	await _test_invalid_manifest(manifest)
+	await _test_accepted_and_replacement(manifest, map_text)
+	await _test_stale_offer_actions(manifest, map_text)
+	await _test_local_host_setter_cannot_replace_offer(manifest)
+	await _test_known_map(manifest)
+	print("=== REVIEW7 SESSION MAP RESULTS: %d passed, %d failed ===" % [_passed, _failed])
+	if _failed == 0:
+		print("REVIEW7_SESSION_MAP_ALL_PASSED")
+	quit(1 if _failed > 0 else 0)
+
+
+func _test_empty_compatibility() -> void:
+	var client: Node = _make_client()
+	var starts: Array = _capture_starts(client)
+	client.call("_receive_session_snapshot", _snapshot({}))
+	client.call("_receive_start_mission", ASSIGNMENTS)
+	_assert(starts.size() == 1 and _mission_started(client), "Sessions without editor-map manifests retain mission start compatibility")
+	client.queue_free()
+	await process_frame
+
+
+func _test_missing_and_rejected(manifest: Dictionary) -> void:
+	var client: Node = _make_client()
+	var starts: Array = _capture_starts(client)
+	client.call("_receive_session_snapshot", _snapshot(manifest))
+	_assert(_transfer_state(client) == "missing", "Incoming host manifest is checked against local maps")
+	_assert(not _can_start_client(client), "Missing map requires local consent even if host publishes an allowed transfer state")
+	client.call("_receive_start_mission", ASSIGNMENTS)
+	_assert(starts.is_empty() and not _mission_started(client), "Missing map blocks the incoming mission-start RPC")
+	client.call("reject_map_download", manifest)
+	client.call("_receive_session_snapshot", _snapshot(manifest, true))
+	_assert(_transfer_state(client) == "rejected" and not _can_start_client(client), "Repeated host manifest preserves the client's rejection")
+	_assert(not _mission_started(client), "Host mission snapshot cannot bypass client rejection")
+	client.call("_receive_start_mission", ASSIGNMENTS)
+	_assert(starts.is_empty() and not _mission_started(client), "Rejected download leaves client in lobby without start events")
+	_assert(String(Dictionary(client.call("get_session_snapshot")).get("connection_state", "")) == "joined", "Blocked mission remains a joined lobby session")
+	client.queue_free()
+	await process_frame
+
+
+func _test_invalid_manifest(manifest: Dictionary) -> void:
+	for invalid in [manifest.merged({"map_id": "../review7_session_map"}, true), manifest.merged({"map_hash": "wrong"}, true), {"map_manifest_is_malformed": true}]:
+		var client: Node = _make_client()
+		var starts: Array = _capture_starts(client)
+		client.call("_receive_session_snapshot", _snapshot(invalid, true))
+		_assert(_transfer_state(client) == "invalid_manifest" and not _can_start_client(client), "Malformed or unsafe inbound manifest is rejected before normalization")
+		client.call("_receive_start_mission", ASSIGNMENTS)
+		_assert(starts.is_empty() and not _mission_started(client), "Invalid manifest never starts a client mission")
+		client.queue_free()
+		await process_frame
+
+
+func _test_accepted_and_replacement(manifest: Dictionary, map_text: String) -> void:
+	var client: Node = _make_client()
+	var starts: Array = _capture_starts(client)
+	client.call("_receive_session_snapshot", _snapshot(manifest))
+	var accepted: Dictionary = Dictionary(client.call("accept_map_download", manifest, map_text, CACHE_ROOT))
+	_assert(bool(accepted.get("accepted", false)) and FileAccess.file_exists(String(accepted.get("cache_path", ""))), "Explicit download acceptance validates and caches the map")
+	client.call("_receive_session_snapshot", _snapshot(manifest))
+	_assert(_transfer_state(client) == "accepted" and _can_start_client(client), "Duplicate incoming manifest retains accepted consent")
+	client.call("_receive_start_mission", ASSIGNMENTS)
+	_assert(starts.size() == 1 and _mission_started(client), "Accepted map allows the mission-start RPC")
+	client.call("complete_mission")
+	var replacement: Dictionary = manifest.merged({"map_hash": "b".repeat(64)}, true)
+	client.call("_receive_session_snapshot", _snapshot(replacement, true))
+	_assert(not _can_start_client(client), "Host replacement hash invalidates approval for the previous map")
+	_assert(String(Dictionary(Dictionary(client.call("get_session_snapshot")).get("map_manifest", {})).get("map_hash", "")) == "b".repeat(64), "Client records the replacement manifest as the active offer")
+	client.call("_receive_start_mission", ASSIGNMENTS)
+	_assert(starts.size() == 1 and not _mission_started(client), "Previous acceptance cannot start a replaced map")
+	client.call("reject_map_download", replacement)
+	client.call("_receive_session_snapshot", _snapshot(replacement))
+	_assert(_transfer_state(client) == "rejected", "Duplicate replacement manifest preserves its rejection")
+	client.queue_free()
+	await process_frame
+
+
+func _test_known_map(manifest: Dictionary) -> void:
+	var client: Node = _make_client()
+	var starts: Array = _capture_starts(client)
+	client.call("set_lobby_player_setup", {"map_path": MAP_PATH})
+	client.call("_receive_session_snapshot", _snapshot(manifest))
+	_assert(_transfer_state(client) == "known" and _can_start_client(client), "Incoming manifest recognizes the client's selected local map with matching hash")
+	client.call("_receive_session_snapshot", _snapshot(manifest))
+	_assert(_transfer_state(client) == "known" and _can_start_client(client), "Duplicate known manifest stays ready without a new prompt")
+	client.call("_receive_start_mission", ASSIGNMENTS)
+	_assert(starts.size() == 1 and _mission_started(client), "Known map starts without download consent")
+	client.call("complete_mission")
+	var replacement: Dictionary = manifest.merged({"map_hash": "c".repeat(64)}, true)
+	client.call("_receive_session_snapshot", _snapshot(replacement))
+	_assert(_transfer_state(client) == "hash_mismatch" and not _can_start_client(client), "Same local map ID with changed host content requires fresh consent")
+	client.queue_free()
+	await process_frame
+
+
+func _test_stale_offer_actions(manifest: Dictionary, map_text: String) -> void:
+	var client: Node = _make_client()
+	var starts: Array = _capture_starts(client)
+	client.call("_receive_session_snapshot", _snapshot(manifest))
+	client.call("accept_map_download", manifest, map_text, CACHE_ROOT)
+	var replacement: Dictionary = manifest.merged({"map_hash": "d".repeat(64)}, true)
+	client.call("_receive_session_snapshot", _snapshot(replacement))
+	var stale_cache_root: String = "user://review7_stale_downloads"
+	var stale_result: Dictionary = Dictionary(client.call("accept_map_download", manifest, map_text, stale_cache_root))
+	_assert(not bool(stale_result.get("accepted", true)), "Delayed acceptance for old offer A is refused after host selects B")
+	_assert(not DirAccess.dir_exists_absolute(ProjectSettings.globalize_path(stale_cache_root)), "Stale acceptance does not create a download directory or write the old payload")
+	_assert(String(Dictionary(Dictionary(client.call("get_session_snapshot")).get("map_manifest", {})).get("map_hash", "")) == "d".repeat(64) and not _can_start_client(client), "Stale acceptance cannot replace active B or authorize its mission")
+	client.call("reject_map_download", manifest)
+	_assert(String(Dictionary(Dictionary(client.call("get_session_snapshot")).get("map_manifest", {})).get("map_hash", "")) == "d".repeat(64) and _transfer_state(client) == "hash_mismatch", "Delayed rejection for A leaves B's pending mismatch state unchanged")
+	client.call("reject_map_download", replacement)
+	client.call("evaluate_client_map_manifest", manifest, [MAP_PATH])
+	_assert(String(Dictionary(Dictionary(client.call("get_session_snapshot")).get("map_manifest", {})).get("map_hash", "")) == "d".repeat(64) and _transfer_state(client) == "rejected" and not _can_start_client(client), "Delayed local evaluation of known A cannot replace or reset rejected B")
+	client.call("_receive_start_mission", ASSIGNMENTS)
+	_assert(starts.is_empty() and not _mission_started(client), "Stale local actions never authorize a mission for the current host offer")
+	client.queue_free()
+	await process_frame
+
+
+func _test_local_host_setter_cannot_replace_offer(manifest: Dictionary) -> void:
+	var client: Node = _make_client()
+	var starts: Array = _capture_starts(client)
+	var replacement: Dictionary = manifest.merged({"map_hash": "e".repeat(64)}, true)
+	client.call("_receive_session_snapshot", _snapshot(replacement))
+	client.call("set_host_map_manifest", manifest)
+	_assert(String(Dictionary(Dictionary(client.call("get_session_snapshot")).get("map_manifest", {})).get("map_hash", "")) == "e".repeat(64) and not _can_start_client(client), "Client setup host-setter cannot overwrite the authoritative offer with a local map")
+	client.call("set_host_map_manifest", replacement)
+	_assert(not _can_start_client(client), "Client host-setter cannot authorize the current unknown host map without consent")
+	client.call("_receive_start_mission", ASSIGNMENTS)
+	_assert(starts.is_empty() and not _mission_started(client), "Local setup host-setter cannot bypass client mission consent")
+	client.queue_free()
+	await process_frame
+
+
+func _make_client() -> Node:
+	var client: Node = SESSION_SCRIPT.new()
+	root.add_child(client)
+	client.call("configure_client_state_for_test", [1, 2])
+	return client
+
+
+func _capture_starts(client: Node) -> Array:
+	var starts: Array = []
+	client.connect("mission_start_requested", func(assignments: Dictionary) -> void: starts.append(assignments.duplicate(true)))
+	return starts
+
+
+func _snapshot(manifest: Dictionary, running: bool = false) -> Dictionary:
+	return {"mission_started": running, "map_manifest": manifest, "map_transfer": {"can_start_client": true, "state": "host_manifest_ready"}, "assignments": ASSIGNMENTS, "peers": [{"peer_id": 1, "is_host": true, "team_id": "team_alpha", "fireteam_ids": ["blue", "gold"]}, {"peer_id": 2, "is_host": false, "team_id": "team_bravo", "fireteam_ids": ["red"]}]}
+
+
+func _transfer_state(client: Node) -> String:
+	return String(Dictionary(Dictionary(client.call("get_session_snapshot")).get("map_transfer", {})).get("state", ""))
+
+
+func _can_start_client(client: Node) -> bool:
+	return bool(Dictionary(Dictionary(client.call("get_session_snapshot")).get("map_transfer", {})).get("can_start_client", false))
+
+
+func _mission_started(client: Node) -> bool:
+	return bool(Dictionary(client.call("get_session_snapshot")).get("mission_started", false))
+
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_passed += 1
+		print("PASS: %s" % message)
+	else:
+		_failed += 1
+		push_error("FAIL: %s" % message)
diff --git a/scripts/tests/review7_session_rejoin_after_completion_verifier.gd b/scripts/tests/review7_session_rejoin_after_completion_verifier.gd
new file mode 100644
index 000000000..f955efd5c
--- /dev/null
+++ b/scripts/tests/review7_session_rejoin_after_completion_verifier.gd
@@ -0,0 +1,161 @@
+extends SceneTree
+
+const ISOLATION_GUARD: GDScript = preload("res://scripts/tests/review2_isolated_user_guard.gd")
+const SESSION_SCRIPT: GDScript = preload("res://scripts/multiplayer/multiplayer_session.gd")
+const PORT_START: int = 19780
+const PORT_END: int = 19790
+
+var _passed: int = 0
+var _failed: int = 0
+
+
+func _init() -> void:
+	if not ISOLATION_GUARD.require_isolated_user_data():
+		return
+	call_deferred("_run_tests")
+
+
+func _run_tests() -> void:
+	await _run_case(false)
+	await _run_case(true)
+	print("=== REVIEW7 SESSION REJOIN RESULTS: %d passed, %d failed ===" % [_passed, _failed])
+	if _failed == 0:
+		print("REVIEW7_SESSION_REJOIN_ALL_PASSED")
+	quit(1 if _failed > 0 else 0)
+
+
+func _run_case(after_completion: bool) -> void:
+	var label: String = "second mission" if after_completion else "first mission control"
+	var fixture: Dictionary = await _create_pair(after_completion)
+	_assert(bool(fixture.get("connected", false)), "%s: host/client complete real ENet setup" % label)
+	if not bool(fixture.get("connected", false)):
+		return
+	var host: Node = fixture["host"]
+	var client: Node = fixture["client"]
+	var host_api: MultiplayerAPI = fixture["host_api"]
+	var client_api: MultiplayerAPI = fixture["client_api"]
+	var initial_peer_id: int = client_api.get_unique_id()
+	var reconnect_token: String = String(client.get("_local_reconnect_token"))
+	var starts: Array = []
+	var blocks: Dictionary = {}
+	client.connect("mission_start_requested", func(assignments: Dictionary) -> void: starts.append(assignments.duplicate(true)))
+	host.connect("mission_rejoin_peer_block_changed", func(peer_id: int, blocked: bool) -> void: blocks[peer_id] = blocked)
+	_assert(not JSON.stringify(host.call("get_session_snapshot")).contains(reconnect_token), "%s: reconnect secret stays out of public session snapshots" % label)
+	await _ready_and_start(fixture, label + " initial start")
+	if after_completion:
+		# Normal lifecycle: no manual token rebinding or setup RPC is injected between missions.
+		host.call("complete_mission")
+		await _poll_pair(host_api, client_api, 25)
+		var completed_host: Dictionary = Dictionary(host.call("get_session_snapshot"))
+		var completed_client: Dictionary = Dictionary(client.call("get_session_snapshot"))
+		_assert(not bool(completed_host.get("mission_started", true)) and not bool(completed_client.get("mission_started", true)), "Completion returns both connected peers to lobby")
+		_assert(int(completed_host.get("connected_count", 0)) == 2 and int(completed_host.get("ready_count", -1)) == 0, "Completion keeps both connections and resets Ready")
+		_assert(Dictionary(host.get("_reconnect_tokens_by_peer_id")).has(initial_peer_id), "Completion retains the connected client's authenticated rejoin identity")
+		_assert(Dictionary(host.get("_pending_rejoin_identities_by_token")).is_empty(), "Completion leaves no stale disconnected mission identities")
+		await _ready_and_start(fixture, label + " next start")
+		_assert(starts.size() == 2, "Second mission begins through normal Ready and host Start")
+	var starts_before_rejoin: int = starts.size()
+	var old_assignment: Dictionary = Dictionary(host.call("build_session_assignments"))
+	var old_team: String = String(Dictionary(old_assignment.get("peer_teams", {})).get(initial_peer_id, ""))
+	var old_fireteams: PackedStringArray = PackedStringArray(Dictionary(old_assignment.get("peer_fireteams", {})).get(initial_peer_id, []))
+	client.call("disconnect_session")
+	await _poll_pair(host_api, client_api, 30)
+	_assert(bool(Dictionary(host.call("get_session_snapshot")).get("mission_started", false)), "%s: host mission survives client disconnect" % label)
+	_assert(Dictionary(host.get("_pending_rejoin_identities_by_token")).size() == 1, "%s: disconnect reserves the authenticated mission identity" % label)
+	_assert(bool(client.call("join_session", "127.0.0.1", int(fixture["port"]))), "%s: client starts a real ENet rejoin" % label)
+	await _poll_pair(host_api, client_api, 100)
+	var new_peer_id: int = client_api.get_unique_id() if client_api.multiplayer_peer != null else 0
+	_assert(new_peer_id > 1 and new_peer_id != initial_peer_id, "%s: rejoin uses a new ENet peer ID" % label)
+	_assert(starts.size() == starts_before_rejoin + 1 and bool(Dictionary(client.call("get_session_snapshot")).get("mission_started", false)), "%s: authenticated rejoin receives a mission handoff" % label)
+	var new_assignment: Dictionary = Dictionary(host.call("build_session_assignments"))
+	var new_teams: Dictionary = Dictionary(new_assignment.get("peer_teams", {}))
+	_assert(not new_teams.has(initial_peer_id) and String(new_teams.get(new_peer_id, "")) == old_team, "%s: new peer inherits the old authorized team without leaving an old peer assignment" % label)
+	_assert(PackedStringArray(Dictionary(new_assignment.get("peer_fireteams", {})).get(new_peer_id, [])) == old_fireteams, "%s: new peer inherits the authorized Fireteams" % label)
+	_assert(Dictionary(host.get("_pending_rejoin_identities_by_token")).is_empty(), "%s: authenticated handoff consumes the reserved identity" % label)
+	if new_peer_id > 1 and client_api.multiplayer_peer != null and bool(Dictionary(client.call("get_session_snapshot")).get("mission_started", false)):
+		_assert(bool(blocks.get(new_peer_id, false)), "%s: rejoin remains snapshot-blocked until mission runtime ACK" % label)
+		client.rpc_id(1, "notify_mission_runtime_ready")
+		await _poll_pair(host_api, client_api, 20)
+		_assert(not bool(blocks.get(new_peer_id, true)), "%s: reliable runtime-ready ACK releases only the authenticated peer" % label)
+	# Leave a pending mission identity, then test the explicit whole-session boundary.
+	client.call("disconnect_session")
+	await _poll_pair(host_api, client_api, 25)
+	host.call("disconnect_session")
+	_assert(Dictionary(host.get("_pending_rejoin_identities_by_token")).is_empty() and Dictionary(host.get("_reconnect_tokens_by_peer_id")).is_empty(), "%s: explicit session reset clears bound and pending reconnect credentials" % label)
+	_assert(int(Dictionary(host.call("get_session_snapshot")).get("connected_count", -1)) == 0 and not bool(Dictionary(host.call("get_session_snapshot")).get("mission_started", true)), "%s: session reset leaves no connected peer or active mission" % label)
+	await _cleanup_pair(fixture)
+
+
+func _ready_and_start(fixture: Dictionary, label: String) -> void:
+	var host: Node = fixture["host"]
+	var client: Node = fixture["client"]
+	var host_api: MultiplayerAPI = fixture["host_api"]
+	var client_api: MultiplayerAPI = fixture["client_api"]
+	_assert(bool(host.call("set_local_ready", true)) and bool(client.call("set_local_ready", true)), "%s: both peers submit normal Ready commands" % label)
+	await _poll_pair(host_api, client_api, 25)
+	_assert(bool(host.call("can_start_mission")) and bool(host.call("request_start_mission")), "%s: ready host starts mission" % label)
+	await _poll_pair(host_api, client_api, 25)
+	_assert(bool(Dictionary(client.call("get_session_snapshot")).get("mission_started", false)), "%s: client receives normal mission start" % label)
+
+
+func _create_pair(second_case: bool) -> Dictionary:
+	for port in range(PORT_START, PORT_END + 1):
+		var host_api: MultiplayerAPI = MultiplayerAPI.create_default_interface()
+		var client_api: MultiplayerAPI = MultiplayerAPI.create_default_interface()
+		var host_root := Node.new()
+		var client_root := Node.new()
+		host_root.name = "Review7HostSecond" if second_case else "Review7HostFirst"
+		client_root.name = "Review7ClientSecond" if second_case else "Review7ClientFirst"
+		root.add_child(host_root)
+		root.add_child(client_root)
+		set_multiplayer(host_api, host_root.get_path())
+		set_multiplayer(client_api, client_root.get_path())
+		var host: Node = SESSION_SCRIPT.new()
+		var client: Node = SESSION_SCRIPT.new()
+		host.name = "Session"
+		client.name = "Session"
+		host_root.add_child(host)
+		client_root.add_child(client)
+		var fixture: Dictionary = {"host_api": host_api, "client_api": client_api, "host_root": host_root, "client_root": client_root, "host": host, "client": client, "port": port}
+		if not bool(host.call("start_host", port)) or not bool(client.call("join_session", "127.0.0.1", port)):
+			await _cleanup_pair(fixture)
+			continue
+		for _index in range(180):
+			await _poll_pair(host_api, client_api, 1)
+			if int(Dictionary(host.call("get_session_snapshot")).get("connected_count", 0)) == 2 and not Dictionary(host.get("_reconnect_tokens_by_peer_id")).is_empty():
+				fixture["connected"] = true
+				return fixture
+		await _cleanup_pair(fixture)
+	return {"connected": false}
+
+
+func _poll_pair(host_api: MultiplayerAPI, client_api: MultiplayerAPI, frames: int) -> void:
+	for _index in range(frames):
+		host_api.poll()
+		client_api.poll()
+		await create_timer(0.01).timeout
+
+
+func _cleanup_pair(fixture: Dictionary) -> void:
+	var host: Node = fixture.get("host", null)
+	var client: Node = fixture.get("client", null)
+	if client != null:
+		client.call("disconnect_session")
+	if host != null:
+		host.call("disconnect_session")
+	var host_root: Node = fixture.get("host_root", null)
+	var client_root: Node = fixture.get("client_root", null)
+	if host_root != null:
+		host_root.queue_free()
+	if client_root != null:
+		client_root.queue_free()
+	await process_frame
+
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_passed += 1
+		print("PASS: %s" % message)
+	else:
+		_failed += 1
+		push_error("FAIL: %s" % message)
diff --git a/scripts/tests/review7_session_versus_assignment_verifier.gd b/scripts/tests/review7_session_versus_assignment_verifier.gd
new file mode 100644
index 000000000..f84b07337
--- /dev/null
+++ b/scripts/tests/review7_session_versus_assignment_verifier.gd
@@ -0,0 +1,92 @@
+extends SceneTree
+
+const ISOLATION_GUARD: GDScript = preload("res://scripts/tests/review2_isolated_user_guard.gd")
+const SESSION_SCRIPT: GDScript = preload("res://scripts/multiplayer/multiplayer_session.gd")
+
+var _passed: int = 0
+var _failed: int = 0
+
+
+func _init() -> void:
+	if not ISOLATION_GUARD.require_isolated_user_data():
+		return
+	call_deferred("_run_tests")
+
+
+func _run_tests() -> void:
+	for case in [{"host": "team_alpha", "client": "team_bravo"}, {"host": "team_bravo", "client": "team_alpha"}]:
+		await _test_versus(case)
+		await _test_coop(String(case["host"]))
+	await _test_same_side_rejected()
+	print("=== REVIEW7 SESSION VERSUS RESULTS: %d passed, %d failed ===" % [_passed, _failed])
+	if _failed == 0:
+		print("REVIEW7_SESSION_VERSUS_ALL_PASSED")
+	quit(1 if _failed > 0 else 0)
+
+
+func _test_versus(case: Dictionary) -> void:
+	var host: Node = _make_host()
+	host.call("set_lobby_player_setup", {"team_play_mode": "versus", "team_slot": case["host"]})
+	var assignments: Dictionary = Dictionary(host.call("build_session_assignments"))
+	_assert(String(Dictionary(assignments.get("peer_teams", {})).get(1, "")) == String(case["host"]), "Versus preserves the selected host side %s" % case["host"])
+	_assert(String(Dictionary(assignments.get("peer_teams", {})).get(2, "")) == String(case["client"]), "Versus assigns the client opposite host side %s" % case["host"])
+	_assert(PackedStringArray(Dictionary(assignments.get("peer_fireteams", {})).get(1, [])) == PackedStringArray(["blue", "gold"]), "Versus preserves host Fireteam control")
+	_assert(PackedStringArray(Dictionary(assignments.get("peer_fireteams", {})).get(2, [])) == PackedStringArray(["red"]), "Versus preserves client Fireteam control")
+	host.call("set_peer_ready_for_test", 1, true)
+	host.call("set_peer_ready_for_test", 2, true)
+	_assert(bool(host.call("can_start_mission")), "Opposite ready sides allow versus mission start")
+	host.queue_free()
+	await process_frame
+
+
+func _test_coop(side: String) -> void:
+	var host: Node = _make_host()
+	host.call("set_lobby_player_setup", {"team_play_mode": "coop", "team_slot": side})
+	var assignments: Dictionary = Dictionary(host.call("build_session_assignments"))
+	var teams: Dictionary = Dictionary(assignments.get("peer_teams", {}))
+	_assert(String(teams.get(1, "")) == side and String(teams.get(2, "")) == side, "Coop keeps both peers on selected side %s" % side)
+	var fireteams: Dictionary = Dictionary(assignments.get("peer_fireteams", {}))
+	_assert(PackedStringArray(fireteams.get(1, [])) == PackedStringArray(["blue"]) and PackedStringArray(fireteams.get(2, [])) == PackedStringArray(["gold"]), "Coop keeps split non-overlapping Fireteams")
+	host.call("set_peer_ready_for_test", 1, true)
+	host.call("set_peer_ready_for_test", 2, true)
+	_assert(bool(host.call("can_start_mission")), "Ready same-side coop session remains startable")
+	host.call("set_lobby_player_setup", {"team_play_mode": "versus", "team_slot": side})
+	teams = Dictionary(Dictionary(host.call("build_session_assignments")).get("peer_teams", {}))
+	_assert(String(teams.get(1, "")) == side and String(teams.get(2, "")) != side, "Switching coop back to versus restores opposite client side")
+	host.queue_free()
+	await process_frame
+
+
+func _test_same_side_rejected() -> void:
+	var host: Node = _make_host()
+	host.call("set_lobby_player_setup", {"team_play_mode": "versus", "team_slot": "team_alpha"})
+	host.call("set_peer_ready_for_test", 1, true)
+	host.call("set_peer_ready_for_test", 2, true)
+	# Corrupt only the assignment boundary to exercise the start guard independently of rebalance.
+	var peers: Dictionary = Dictionary(host.get("_peers_by_id")).duplicate(true)
+	var peer_data: Dictionary = Dictionary(peers[2]).duplicate(true)
+	peer_data["team_id"] = "team_alpha"
+	peers[2] = peer_data
+	host.set("_peers_by_id", peers)
+	var starts: Array = []
+	host.connect("mission_start_requested", func(assignments: Dictionary) -> void: starts.append(assignments))
+	_assert(not bool(host.call("can_start_mission")), "Versus start guard rejects equal active peer sides")
+	_assert(not bool(host.call("request_start_mission")) and starts.is_empty(), "Invalid same-side versus cannot emit a mission-start request")
+	host.queue_free()
+	await process_frame
+
+
+func _make_host() -> Node:
+	var host: Node = SESSION_SCRIPT.new()
+	root.add_child(host)
+	host.call("configure_host_state_for_test", [2])
+	return host
+
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_passed += 1
+		print("PASS: %s" % message)
+	else:
+		_failed += 1
+		push_error("FAIL: %s" % message)
diff --git a/scripts/tests/review7_spacing_verifier.gd b/scripts/tests/review7_spacing_verifier.gd
new file mode 100644
index 000000000..4b284d5b4
--- /dev/null
+++ b/scripts/tests/review7_spacing_verifier.gd
@@ -0,0 +1,203 @@
+extends SceneTree
+
+const GUARD = preload("res://scripts/tests/review2_isolated_user_guard.gd")
+const SIMULATION = preload("res://scripts/core/simulation_root.gd")
+const UNIT_REGISTRY = preload("res://scripts/registries/unit_registry.gd")
+const TERRAIN = preload("res://scripts/terrain/terrain_registry.gd")
+const TILE = preload("res://scripts/terrain/terrain_tile_data.gd")
+const UNIT = preload("res://scripts/npc/test_unit.gd")
+const PATHFINDER = preload("res://scripts/terrain/terrain_pathfinder.gd")
+
+var _passed: int = 0
+var _failed: int = 0
+
+
+func _init() -> void:
+	if not GUARD.require_isolated_user_data():
+		return
+	call_deferred("_run")
+
+
+func _run() -> void:
+	for topology in ["square8", "hex_axial_v1"]:
+		for height in [1, 2]:
+			for descending in [false, true]:
+				for edge in ["cliff", "none"]:
+					_test_half_correction(String(topology), height, descending, String(edge), false)
+					_test_full_correction(String(topology), height, descending, String(edge), false)
+				_test_half_correction(String(topology), height, descending, "slope", true)
+				_test_full_correction(String(topology), height, descending, "slope", true)
+		_test_half_correction(String(topology), 0, false, "none", true)
+		_test_full_correction(String(topology), 0, false, "none", true)
+		_test_intermediate_hole(String(topology))
+	_test_square_diagonal(false)
+	_test_square_diagonal(true)
+	_test_offset_square_segment()
+	_test_terrainless()
+	print("REVIEW7_SPACING_RESULT passed=%d failed=%d" % [_passed, _failed])
+	quit(0 if _failed == 0 else 1)
+
+
+func _test_half_correction(topology: String, height: int, descending: bool, edge: String, legal: bool) -> void:
+	var context: Dictionary = _context(topology, 64.0, 32.0)
+	var terrain: Node = context["terrain"]
+	_tile(terrain, Vector2i.ZERO, height if descending else 0, edge if descending else "none")
+	_tile(terrain, Vector2i.RIGHT, 0 if descending else height, "none" if descending else edge)
+	var direction: Vector2 = Vector2(terrain.grid_to_world(Vector2i.RIGHT)).normalized()
+	var boundary: float = Vector2(terrain.grid_to_world(Vector2i.RIGHT)).length() * 0.5
+	var before_a: Vector2 = direction * (boundary - 3.0)
+	var before_b: Vector2 = direction * (boundary - 1.0)
+	_add_units(context, before_a, before_b)
+	var label: String = "%s half H%d %s %s" % [topology, height, "down" if descending else "up", edge]
+	_assert(PATHFINDER.new().can_traverse_step(Vector2i.ZERO, Vector2i.RIGHT, terrain) == legal, label + " fixture agrees with authoritative traversal")
+	_tick(context, label)
+	var alpha: Node2D = context["alpha"]
+	var bravo: Node2D = context["bravo"]
+	if legal:
+		_assert(alpha.position.is_equal_approx(before_a - direction * 17.0) and bravo.position.is_equal_approx(before_b + direction * 17.0), label + " preserves balanced legal half pushes")
+		_assert(terrain.world_to_grid(bravo.position) == Vector2i.RIGHT, label + " crosses the permitted edge")
+	else:
+		_assert(bravo.position.is_equal_approx(before_b), label + " rejects the half push across the forbidden edge")
+		_assert(alpha.position.is_equal_approx(before_a - direction * 34.0), label + " retains the legal opposite full fallback")
+	_assert(is_equal_approx(alpha.position.distance_to(bravo.position), 36.0), label + " resolves spacing without an illegal crossing")
+	context["scene"].free()
+
+
+func _test_full_correction(topology: String, height: int, descending: bool, edge: String, legal: bool) -> void:
+	# The negative side is absent; both half pushes cannot be committed. The
+	# positive full push crosses TWO transitions, including the tested edge.
+	var context: Dictionary = _context(topology, 16.0, 8.0)
+	var terrain: Node = context["terrain"]
+	for grid in [Vector2i.ZERO, Vector2i.RIGHT, Vector2i(2, 0)]:
+		var source: bool = grid != Vector2i(2, 0)
+		_tile(terrain, grid, (height if source else 0) if descending else (0 if source else height), (edge if source else "none") if descending else ("none" if source else edge))
+	var direction: Vector2 = Vector2(terrain.grid_to_world(Vector2i.RIGHT)).normalized()
+	var before_b: Vector2 = direction * 2.0
+	_add_units(context, Vector2.ZERO, before_b)
+	var label: String = "%s full H%d %s %s" % [topology, height, "down" if descending else "up", edge]
+	_assert(terrain.world_to_grid(direction * 36.0) == Vector2i(2, 0), label + " full correction spans two cells")
+	_assert(PATHFINDER.new().can_traverse_step(Vector2i.RIGHT, Vector2i(2, 0), terrain) == legal, label + " fixture edge agrees with authoritative traversal")
+	_tick(context, label)
+	_assert(context["alpha"].position.is_equal_approx(Vector2.ZERO), label + " absent negative terrain blocks alpha")
+	if legal:
+		_assert(context["bravo"].position.is_equal_approx(direction * 36.0), label + " retains the legal multi-cell full fallback")
+	else:
+		_assert(context["bravo"].position.is_equal_approx(before_b), label + " rejects the forbidden full fallback")
+		_assert(int(context["simulation"].get_unit_minimum_spacing_debug_snapshot().get("blocked_pair_count", 0)) == 1, label + " reports the unresolved blocked pair")
+	context["scene"].free()
+
+
+func _test_intermediate_hole(topology: String) -> void:
+	var context: Dictionary = _context(topology, 16.0, 8.0)
+	var terrain: Node = context["terrain"]
+	_tile(terrain, Vector2i.ZERO)
+	_tile(terrain, Vector2i(2, 0))
+	var direction: Vector2 = Vector2(terrain.grid_to_world(Vector2i.RIGHT)).normalized()
+	_add_units(context, Vector2.ZERO, direction * 2.0)
+	var label: String = topology + " missing intermediate tile"
+	_assert(terrain.is_walkable(terrain.world_to_grid(direction * 36.0)), label + " destination itself is walkable")
+	_tick(context, label)
+	_assert(context["alpha"].position == Vector2.ZERO and context["bravo"].position.is_equal_approx(direction * 2.0), label + " cannot teleport to the disconnected walkable destination")
+	context["scene"].free()
+
+
+func _test_square_diagonal(legal: bool) -> void:
+	var context: Dictionary = _context("square8", 16.0, 8.0)
+	var terrain: Node = context["terrain"]
+	for x in range(3):
+		for y in range(3):
+			_tile(terrain, Vector2i(x, y), 0, "none", legal or x == y)
+	_add_units(context, Vector2.ZERO, Vector2(0.0, 2.0))
+	var label: String = "square diagonal " + ("legal" if legal else "forbidden corner")
+	_assert(PATHFINDER.new().can_traverse_step(Vector2i.ZERO, Vector2i.ONE, terrain) == legal, label + " fixture agrees with pathfinder corner rule")
+	_tick(context, label)
+	_assert(context["bravo"].position.is_equal_approx(Vector2(0.0, 36.0) if legal else Vector2(0.0, 2.0)), label + " full push respects both intermediate diagonal steps")
+	context["scene"].free()
+
+
+func _test_offset_square_segment() -> void:
+	var context: Dictionary = _context("square8", 8.0, 4.0)
+	var terrain: Node = context["terrain"]
+	for x in range(4):
+		for y in range(-1, 2):
+			_tile(terrain, Vector2i(x, y), 0, "none", Vector2i(x, y) != Vector2i(3, 0))
+	var start: Vector2 = _world_at(terrain, Vector2(0.49, -0.49))
+	var finish: Vector2 = _world_at(terrain, Vector2(3.49, 0.51))
+	var direction: Vector2 = (finish - start).normalized()
+	_add_units(context, start - direction * 2.0, start)
+	context["simulation"].unit_minimum_spacing_distance = start.distance_to(finish) + 2.0
+	var center_line: Array = terrain.get_grid_line(terrain.world_to_grid(start), terrain.world_to_grid(finish))
+	var center_line_legal: bool = true
+	for index in range(1, center_line.size()):
+		center_line_legal = center_line_legal and PATHFINDER.new().can_traverse_step(center_line[index - 1], center_line[index], terrain)
+	_assert(center_line_legal, "Offset fixture center-to-center path incorrectly misses the touched blocked tile")
+	_assert(terrain.world_to_grid(start.lerp(finish, 0.9)) == Vector2i(3, 0), "Offset actual segment enters the blocked intermediate tile")
+	_tick(context, "offset square segment")
+	_assert(context["bravo"].position.is_equal_approx(start), "Actual correction segment cannot cross a blocker omitted by the cell-center line")
+	context["scene"].free()
+
+
+func _test_terrainless() -> void:
+	var context: Dictionary = _context("square8", 64.0, 32.0, false)
+	_add_units(context, Vector2.ZERO, Vector2(2.0, 0.0))
+	_tick(context, "terrainless")
+	_assert(context["alpha"].position.is_equal_approx(Vector2(-17.0, 0.0)) and context["bravo"].position.is_equal_approx(Vector2(19.0, 0.0)), "Terrainless authority keeps the existing balanced spacing behavior")
+	context["scene"].free()
+
+
+func _context(topology: String, half_width: float, half_height: float, with_terrain: bool = true) -> Dictionary:
+	var scene := Node.new()
+	root.add_child(scene)
+	var registry = UNIT_REGISTRY.new()
+	registry.name = "UnitRegistry"
+	scene.add_child(registry)
+	var terrain = TERRAIN.new()
+	terrain.name = "TerrainRegistry"
+	terrain.configure_iso_grid(Vector2.ZERO, half_width, half_height, topology)
+	scene.add_child(terrain)
+	var simulation = SIMULATION.new()
+	simulation.name = "SimulationRoot"
+	simulation.unit_registry_path = NodePath("../UnitRegistry")
+	simulation.terrain_registry_path = NodePath("../TerrainRegistry") if with_terrain else NodePath()
+	simulation.unit_minimum_spacing_debug_enabled = true
+	simulation.unit_minimum_spacing_solver_iterations = 1
+	scene.add_child(simulation)
+	simulation.set_physics_process(false)
+	return {"scene": scene, "registry": registry, "terrain": terrain, "simulation": simulation}
+
+
+func _tile(terrain: Node, grid: Vector2i, height: int = 0, edge: String = "none", walkable: bool = true) -> void:
+	terrain.register_tile(TILE.new({"tile_id": str(grid), "grid_position": grid, "world_position": terrain.grid_to_world(grid), "height_level": height, "edge_type": edge, "walkable": walkable, "surface_type": "ground"}))
+
+
+func _add_units(context: Dictionary, position_a: Vector2, position_b: Vector2) -> void:
+	for id in ["alpha", "bravo"]:
+		var unit = UNIT.new()
+		unit.unit_id = id
+		unit.team_id = "team_alpha"
+		unit.fireteam_id = "blue"
+		unit.position = position_a if id == "alpha" else position_b
+		context["scene"].add_child(unit)
+		context["registry"].register_unit(id, unit)
+		context[id] = unit
+
+
+func _world_at(terrain: Node, grid: Vector2) -> Vector2:
+	var origin: Vector2 = terrain.grid_to_world(Vector2i.ZERO)
+	return origin + (Vector2(terrain.grid_to_world(Vector2i.RIGHT)) - origin) * grid.x + (Vector2(terrain.grid_to_world(Vector2i.DOWN)) - origin) * grid.y
+
+
+func _tick(context: Dictionary, label: String) -> void:
+	var simulation: Node = context["simulation"]
+	simulation.call("_physics_process", 1.0 / 60.0)
+	_assert(simulation.get_tick() == 1, label + " executes a real authoritative tick")
+	_assert(simulation.command_queue.is_empty() and simulation.effects_queue.is_empty(), label + " spacing does not invent commands or effects")
+
+
+func _assert(condition: bool, message: String) -> void:
+	if condition:
+		_passed += 1
+		print("PASS: " + message)
+	else:
+		_failed += 1
+		print("FAIL: " + message)
