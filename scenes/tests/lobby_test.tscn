[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/tests/lobby_test_screen.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/meta/debrief_test_screen.tscn" id="2_debrief"]

[node name="LobbyTest" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -150.0
offset_right = 220.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Multiplayer Lobby Test"

[node name="StatusLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Ready. Host or join a local test session."
autowrap_mode = 3

[node name="TeamReadabilityLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "PvP: Alpha -> Host Peer 1 | Bravo -> Peer 2"
autowrap_mode = 3

[node name="ButtonRow" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HostButton" type="Button" parent="Panel/Margin/VBox/ButtonRow"]
layout_mode = 2
text = "Host"

[node name="JoinButton" type="Button" parent="Panel/Margin/VBox/ButtonRow"]
layout_mode = 2
text = "Join"

[node name="StartMissionButton" type="Button" parent="Panel/Margin/VBox/ButtonRow"]
visible = false
layout_mode = 2
text = "Start Mission"

[node name="SessionRow" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ReadyButton" type="Button" parent="Panel/Margin/VBox/SessionRow"]
visible = false
layout_mode = 2
text = "Ready"

[node name="DisconnectButton" type="Button" parent="Panel/Margin/VBox/SessionRow"]
visible = false
layout_mode = 2
text = "Disconnect"

[node name="HintLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Join connects to localhost:7777. Mission start stays on the host; commands are validated by peer role."
autowrap_mode = 3

[node name="DebriefScreen" parent="." instance=ExtResource("2_debrief")]

[node name="MissionHost" type="Node" parent="."]
