{
  "schema_version": 1,
  "preset_name": "Windows Desktop",
  "export_preset_path": "export_presets.cfg",
  "runtime_export_path": "builds/Sternenbuergerchen_rel.exe",
  "export_preset_tracked": true,
  "runtime_provenance_file": "release_build_provenance.json",
  "exclude_filter_patterns": [
    "addons/asset_placer/**",
    "addons/godot_mcp/**",
    "addons/godot_open_rts_reference/**",
    "addons/map_builder_workbench/**",
    "docs/**",
    "export_credentials.cfg",
    "scripts/tests/**",
    "scripts/tools/**",
    "tmp/**"
  ],
  "runtime_addon_allowlist": [
    "addons/limboai",
    "addons/terrain_3d",
    "addons/netfox",
    "addons/netfox.internals"
  ],
  "runtime_script_dependency_roots": [],
  "restore_local_export_preset_after_run": false,
  "release_workflow_script": "scripts/tools/export_runtime_release.ps1",
  "notes": "The sanitized export_presets.cfg is tracked. Credentials remain local; the release workflow validates the preset against this contract before exporting."
}
