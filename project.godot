; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sternenbuergerchen"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GlobalEscapeMenu="*res://scripts/ui/global_escape_menu.gd"
NetworkTime="*uid://cnqdxyjptkfvp"
NetworkTimeSynchronizer="*uid://5rmn2ik3kjo8"
NetworkRollback="*uid://gas743comroj"
NetworkEvents="*uid://bdmobxxptryj0"
NetworkPerformance="*uid://cqgf7aqmjfoa3"
RollbackSimulationServer="*uid://d5vx6blln3jr"
NetworkHistoryServer="*uid://c554fbsy6yos3"
NetworkSynchronizationServer="*uid://yrhqsbd5ubhs"
NetworkIdentityServer="*uid://pc8gwg1lbusp"
NetworkCommandServer="*uid://mkgjb8gdl0fp"
RollbackLivenessServer="*uid://beo1554xbapmy"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[dotnet]

project/assembly_name="Sternenbuergerchen"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/netfox.internals/plugin.cfg", "res://addons/netfox/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/asset_placer/plugin.cfg", "res://addons/map_builder_workbench/plugin.cfg")

[input]

show_npc_thoughts={
"deadzone": 0.2,
"events": []
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
