static func variant(region:String) -> int:return int(region.right(1))-1 if "_v" in region else 0
static func family(region:String) -> String:return region.get_slice("_v",0)
static func archetype(region: String) -> String:
	region=family(region)
	if region in ["bunker_medium","bunker_hard"]:return "bunker_surface"
	if region in ["bunker_medium_depths","bunker_hard_depths"]:return "bunker_depths"
	if region=="distribution_friendly":return "distribution"
	return region
static func underground(region: String) -> bool:return archetype(region)=="bunker_depths"
static func bunker(region: String) -> bool:return archetype(region) in ["bunker_surface","bunker_depths"]
static func depth_scale(region: String) -> float:return {"bunker_depths":2.0,"bunker_medium_depths":2.5,"bunker_hard_depths":3.0}.get(family(region),1.0)
static func difficulty(region: String) -> int:return 3 if region.begins_with("bunker_hard") else 2 if region.begins_with("bunker_medium") else 1
static func surface(region: String) -> String:
	return {"bunker_depths":"bunker_surface","bunker_medium_depths":"bunker_medium","bunker_hard_depths":"bunker_hard"}.get(family(region),family(region))+("_v%d"%(variant(region)+1) if variant(region)>0 else "")
static func elevator_target(region: String) -> String:
	return surface(region) if underground(region) else {"bunker_surface":"bunker_depths","bunker_medium":"bunker_medium_depths","bunker_hard":"bunker_hard_depths"}.get(family(region),"")+("_v%d"%(variant(region)+1) if variant(region)>0 else "")
static func object_base(id: String) -> String:return id.split("__")[0]
static func object_id(region: String,id: String) -> String:
	if archetype(region)!=region and id in ["surface_cache","bunker_cache","bunker_terminal","distribution_cache","distribution_wreck","mining_site","derelict","tradepost_cache"]:return id+"__"+region
	return id
static func risk(region: String) -> int:return {"base":0,"rust":20,"station":35,"bunker_surface":25,"bunker_medium":30,"bunker_hard":40,"distribution_friendly":15,"distribution":35,"tradepost":25}.get(family(region),0)
