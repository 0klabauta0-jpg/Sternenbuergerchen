extends SceneTree
## Fixture generated by the unmodified Main 639a49d65 in a private profile.
const STORE = preload("res://scripts/meta/campaign_checkpoint_store.gd")
const FIXTURE := "res://scripts/tests/fixtures/main_639a49d65_checkpoint.json"

func _initialize() -> void: call_deferred("_run")

func _run() -> void:
	var isolated := OS.get_environment("POLISA_TEST_PROFILE").simplify_path().replace("\\", "/").to_lower()
	var user_dir := OS.get_user_data_dir().simplify_path().replace("\\", "/").to_lower()
	if isolated.is_empty() or not user_dir.begins_with(isolated + "/"):
		printerr("FAIL: isolated POLISA_TEST_PROFILE required"); quit(1); return
	var fixture: Variant = JSON.parse_string(FileAccess.get_file_as_string(FIXTURE))
	if not fixture is Dictionary or not STORE.validate_payload(fixture).get("ok", false):
		printerr("FAIL: authentic Main checkpoint rejected"); quit(1); return
	var tampered: Dictionary = fixture.duplicate(true)
	# Der Anzeigename ist seit Abschnitt SB (21.11.2026) kein Vergleichsfeld mehr (campaign_location_definitions_tolerance_verifier);
	# geprueft wird ein Feld, an dem gespeicherter Zustand haengt: die Dienste des Ortes.
	tampered.campaign.locations.homebase.services = ["personnel", "jobs"]
	if STORE.validate_payload(tampered).get("ok", false):
		printerr("FAIL: altered existing location accepted"); quit(1); return
	var saved: Dictionary = STORE.save_checkpoint(fixture)
	if not saved.get("ok", false):
		printerr("FAIL: could not install isolated checkpoint: ",saved); quit(1); return
	load("res://scripts/meta/game_start_contract.gd").request_start(self, "campaign", "continue")
	var flow: Node = load("res://scenes/meta/meta_layer_test.tscn").instantiate(); root.add_child(flow)
	await process_frame
	var runtime: Node = flow.get("_singleplayer_runtime")
	var snapshot: Dictionary = runtime.get_snapshot()
	var people: Array = runtime.get_base_personnel_runtime().get_snapshot().get("units", [])
	var loadouts: Dictionary = flow.get_node("HomebaseScreen").get("_member_loadout_by_unit_id")
	var crafts: Array = flow.get("_homebase_aircraft_definitions")
	var starter: Dictionary = crafts[0] if not crafts.is_empty() else {}
	var visual: Dictionary = load("res://scripts/terrain/frontier_ship_visuals.gd").get_ui_identity(starter)
	var ok: bool = snapshot.mode == "campaign" and snapshot.space_travel.phase == "grounded" and people.size() == 2 and flow.get("_homebase_staged_fireteam_ids") == PackedStringArray(["ft2"]) and Dictionary(loadouts.get("campaign_leader", {})).get("armor") == "light" and Dictionary(loadouts.get("campaign_pilot", {})).get("armor") == "light" and starter.get("model_id") == "cutlass" and visual.get("sha256") == "21484195affa66a1bc503f34b20ae561312057e46e077250e8a772b6881e6daf"
	if ok:
		var resaved: Dictionary = flow.get("_campaign_start").call("save_home_checkpoint", flow, runtime)
		ok = bool(resaved.get("ok", false)) and bool(STORE.load_checkpoint().get("ok", false))
	flow.queue_free(); await process_frame
	if ok: print("MAIN_LEGACY_CHECKPOINT_PASS")
	else: printerr("FAIL: original Main checkpoint did not preserve campaign state")
	quit(0 if ok else 1)
