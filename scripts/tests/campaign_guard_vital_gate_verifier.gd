extends SceneTree
var failures:=0
func _initialize() -> void:
	var driver=load("res://scripts/tests/mission_combat_loop_driver.gd").new()
	var unit=load("res://scripts/npc/test_unit.gd").new()
	var fixture:=Node.new()
	unit.name="Guard"; driver.name="Driver"
	fixture.add_child(unit); fixture.add_child(driver)
	unit.set("unit_id","guard_01"); unit.set("team_id","team_bravo")
	driver.set("enemy_unit_paths",[NodePath("../Guard")])
	driver.set("_hotpath_unit_cache_active",true)
	driver.set("_hotpath_enemy_units",[unit])
	driver.set("_enemy_team_tactics_states_by_group_id",{"outpost_guards":{"unit_ids":["guard_01"]}})
	check(int(driver.call("_build_enemy_group_fit_counts").get("outpost_guards",-1))==1,"actual fit guard indexed")
	check(bool(driver.call("_is_unit_fit_for_gate_count",unit)),"fit guard blocks objective")
	unit.call("apply_damage",1000,{})
	check(unit.call("get_vital_state")=="down","actual damage downs guard")
	check(not bool(driver.call("_is_unit_fit_for_gate_count",unit)),"down guard no longer blocks objective")
	driver.set("_enemy_team_tactics_states_by_group_id",{})
	check(driver.call("_build_enemy_group_fit_counts")=={"outpost_guards":0},"defeated last guard retains known zero group")
	var gates=load("res://scripts/mission/mission_scenario_runtime_gates.gd").new()
	gates.configure_from_file("res://data/mission_scenarios/outpost_recovery.json")
	var observed:Dictionary=gates.update({"enemy_group_fit_counts":driver.call("_build_enemy_group_fit_counts")})
	check(Array(observed.completed_step_ids).has("clear_outpost"),"actual defeated guard completes authored outpost gate")
	unit.call("advance_bleedout")
	check(not bool(driver.call("_is_unit_fit_for_gate_count",unit)),"bleeding guard no longer blocks objective")
	unit.call("begin_respawn")
	check(not bool(driver.call("_is_unit_fit_for_gate_count",unit)),"respawning guard no longer blocks objective")
	var setup=load("res://scripts/tests/mission_test_setup.gd").new()
	check(setup.has_method("_apply_authored_enemy_loadout"),"authored enemy weapon applied to actual unit")
	if setup.has_method("_apply_authored_enemy_loadout"):
		setup.set("_mission_scenario",load("res://scripts/mission/mission_scenario_data.gd").load_from_file("res://data/mission_scenarios/outpost_recovery.json"))
		setup.call("_apply_authored_enemy_loadout",unit,"outpost_recovery_guard_01","team_bravo")
		check(unit.call("get_weapon_1_id")=="pistol","first guard actually equips pistol")
	setup.free()
	fixture.free()
	print("GUARD_VITAL_GATE failures=",failures);quit(1 if failures else 0)
func check(value:bool,label:String) -> void:
	if not value:failures+=1;printerr("FAIL: ",label)
