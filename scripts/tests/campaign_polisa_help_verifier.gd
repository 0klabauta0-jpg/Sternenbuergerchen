extends SceneTree

func _init() -> void:
	call_deferred("_run")

func _run() -> void:
	var service = load("res://scripts/ui/contextual_help_service.gd").new()
	assert(service.load_catalog() == OK)
	for id in ["polisa.weapons", "polisa.armor", "polisa.cargo", "polisa.ship", "polisa.fuel", "campaign.equip", "campaign.transfer"]:
		assert(not service.get_entry(id).is_empty(), "Missing help: " + id)
	service.set_help_mode("off")
	assert(service.request_help("polisa.cargo", 1.0).level == "none")
	service.set_help_mode("compact")
	assert(service.request_help("polisa.cargo", 1.0).level == "compact")
	var helper = load("res://scripts/ui/campaign_context_help.gd").new()
	root.add_child(helper)
	var target := Button.new()
	root.add_child(target)
	helper.bind_target(target, "polisa.cargo")
	helper._service.set_help_mode("compact")
	helper._enter(target, "polisa.cargo")
	helper._show_compact()
	assert(helper._popup.visible, "Hover should show help")
	helper._leave(target)
	assert(not helper._popup.visible, "Leaving hides help")
	helper._service.set_help_mode("off")
	helper._enter(target, "polisa.cargo")
	helper._show_compact()
	assert(not helper._popup.visible, "Disabled help must stay hidden")
	assert(helper.category_help_id("infantry") == "polisa.weapons")
	assert(helper.category_help_id("armor") == "polisa.armor")
	assert(helper.category_help_id("commodities") == "polisa.cargo")
	target.free()
	helper.free()
	var inventory = load("res://scripts/ui/components/personnel_inventory_panel.gd").new()
	root.add_child(inventory)
	assert(inventory._equip.get_meta("help_id") == "campaign.equip")
	assert(inventory._transfer.get_meta("help_id") == "campaign.transfer")
	inventory.free()
	var screen = load("res://scripts/ui/polisa_station_screen.gd").new()
	root.add_child(screen)
	var adapter := Node.new()
	root.add_child(adapter)
	screen.configure(adapter)
	assert(screen._refuel_button.get_meta("help_id") == "polisa.fuel")
	screen.free()
	adapter.free()
	print("PASS: Polisa contextual help catalog and bindings")
	quit(0)
