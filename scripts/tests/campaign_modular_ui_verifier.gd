extends SceneTree
const START = preload("res://scripts/meta/game_start_contract.gd")
var failed := 0
func _init() -> void: call_deferred("run")
func check(value: bool, message: String) -> void:
	print(("PASS: " if value else "FAIL: ") + message)
	if not value: failed += 1
func run() -> void:
	START.request_start(self, "campaign", "new")
	var flow: Node = load("res://scenes/meta/meta_layer_test.tscn").instantiate()
	root.add_child(flow); await process_frame
	var adapter: Node = flow.get("_singleplayer_runtime")
	var base: Node = adapter.get_base_personnel_runtime()
	var home: Node = flow.get_node("HomebaseScreen")
	var ops: Node = home.get("_operations_presenter")
	var services: Node = ops.get("_services_view")
	services.call("refresh", adapter.get_snapshot())
	services.call("set_section", "build")
	var builder: Node = services.get("_modular_builder")
	check(builder != null and builder.visible, "real campaign construction menu shows room builder")
	var initial: Dictionary = adapter._supply.get_supply_snapshot()
	var initial_capacity: int = base.get_recruitment_bed_capacity().beds
	var button: Button = builder.get_node("BuildModularRoom")
	button.pressed.emit()
	var after_room: Dictionary = adapter._supply.get_supply_snapshot()
	check(after_room.modular_base.rooms.size()==1 and after_room.credits==initial.credits-300, "actual UI builds paid sleeping room")
	check(base.get_recruitment_bed_capacity().beds==initial_capacity, "empty sleeping room adds no phantom bed")
	button.pressed.emit()
	check(adapter._supply.get_supply_snapshot().modular_base.rooms.size()==1 and adapter._supply.get_supply_snapshot().credits==after_room.credits, "overlapping UI request rejected without payment")
	services.call("refresh", adapter.get_snapshot())
	var room: OptionButton = builder.get("_room")
	check(room.item_count>=2, "new sleeping room appears in bed selector")
	if room.item_count >= 2:
		room.select(1)
		builder.get_node("BuildRoomBed").pressed.emit()
		var after_bed: Dictionary = adapter._supply.get_supply_snapshot()
		check(after_bed.modular_base.beds.size()==1 and after_bed.credits==after_room.credits-100, "actual UI purchases single bed")
		check(base.get_recruitment_bed_capacity().beds==initial_capacity+1, "placed bed increases real recruitment capacity")
		builder.get_node("BuildRoomBed").pressed.emit()
		check(adapter._supply.get_supply_snapshot().credits==after_bed.credits, "occupied bed slot rejected without second charge")
		var replay: Dictionary = home.call("request_operation", "campaign_build_room", {"type":"sleep","x":0,"y":0,"rotation":0,"request_id":"modular-base:%d:1" % builder.get_instance_id()})
		check(replay.get("replayed",false) and adapter._supply.get_supply_snapshot().credits==after_bed.credits, "actual UI request replay does not charge twice")
		services.call("refresh", adapter.get_snapshot())
		var door_room: OptionButton = builder.get("_door_room")
		var door_side: OptionButton = builder.get("_door_side")
		door_room.select(1); door_side.select(1)
		builder.find_child("OpenRoomDoor", true, false).pressed.emit()
		check(bool(adapter.get_snapshot().supply.modular_base.rooms[0].doors[1]), "UI builds a door opening")
		builder.find_child("CloseRoomDoor", true, false).pressed.emit()
		check(not bool(adapter.get_snapshot().supply.modular_base.rooms[0].doors[1]), "UI removes the door opening")
	var low: Dictionary = home.call("request_operation", "campaign_build_room", {"type":"storage","x":1,"y":0,"rotation":0,"request_id":"ui-storage-no-credits"})
	check(not low.get("ok",false) and adapter._supply.get_supply_snapshot().credits==100, "insufficient funds rejects additional room")
	flow.queue_free(); await process_frame
	if failed==0: print("CAMPAIGN_MODULAR_UI_PASS")
	quit(0 if failed==0 else 1)
