extends SceneTree
const PROFILE = preload("res://scripts/terrain/frontier_art_profile.gd")
const BATCH = preload("res://scripts/terrain/hex_ground_batch.gd")
const DRESSING = preload("res://scripts/terrain/frontier_art_dressing.gd")
const VIEW = preload("res://scripts/terrain/terrain_map_3d_view.gd")
const ROCK = preload("res://scripts/terrain/homebase_rock_visual.gd")
var failed := 0
func check(value: bool, label: String) -> void:
	print(("PASS " if value else "FAIL ")+label)
	if not value: failed += 1
func _init() -> void: call_deferred("run")
func run() -> void:
	var profile = PROFILE.new()
	check(not profile.homebase_palette,"default profile retains other locations")
	check(not profile.material_for(Color("a65c40")).get_shader_parameter("homebase_palette"),"default material has no home palette")
	var view := VIEW.new()
	view.set_homebase_visuals_enabled(true)
	check(view._frontier_art_profile.homebase_palette,"home view opts in explicitly")
	check(float(view._make_hex_grid_material(false).get_shader_parameter("minimum_pixel_width"))==1.8,"home hex pixel coverage")
	view.set_homebase_visuals_enabled(false)
	check(not view._frontier_art_profile.homebase_palette,"leaving profile restores default flag")
	check(view._make_hex_grid_material(false).get_shader_parameter("minimum_pixel_width")==null,"other view keeps original shader grid default")
	view.free()
	var parent := Node3D.new()
	var batch = BATCH.new()
	var material := StandardMaterial3D.new()
	batch.queue_tile(Vector3.ZERO,Color.WHITE,1.0,material)
	batch.queue_tile(Vector3(1,1,0),Color.WHITE,1.0,material)
	batch.flush(parent,false)
	check(parent.get_child(0).cast_shadow==GeometryInstance3D.SHADOW_CASTING_SETTING_OFF,"flat caps no longer self shadow")
	check(parent.get_child(1).cast_shadow==GeometryInstance3D.SHADOW_CASTING_SETTING_ON,"raised terrain keeps its shadow")
	parent.free()
	var layout: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://maps/base_interior_navigation.json")).homebase_exploration
	var before := JSON.stringify(layout)
	var dressing := DRESSING.new()
	dressing.build_homebase_paths(layout,profile)
	check(JSON.stringify(layout)==before,"dressing never mutates layout facts")
	check(dressing.get_children().filter(func(child): return child.has_meta("path_layer")).size()==3,"joined asphalt has three fixed mesh layers")
	check(dressing.get_meta("path_shoulder_stone_count",0)>0,"small shoulder stones exist")
	check(dressing.find_children("*","CollisionObject3D",true,false).is_empty(),"path props add no colliders")
	check(dressing.get_meta("visual_only",false),"path assembly is a read-only projection")
	print("PATH_COUNTS ",dressing.get_meta("homebase_path_count")," / ",dressing.get_meta("path_shoulder_stone_count"))
	dressing.free()
	var rock_scene: PackedScene = load("res://Assets/kenney_space-kit/Models/GLTF format/rock_largeA.glb")
	for height in [0.84,0.32]:
		var rock: Node3D = ROCK.build(rock_scene,profile,height,1.0)
		var bounds: AABB = ROCK._bounds(rock,Transform3D.IDENTITY)
		check(is_equal_approx(bounds.size.y,height),"original rock projects owner height "+str(height))
		check(absf(bounds.get_center().x)<0.00001 and absf(bounds.get_center().z)<0.00001 and absf(bounds.position.y)<0.00001,"rock is centered and grounded")
		var extent := maxf(bounds.size.x*0.5,bounds.size.x*0.25+bounds.size.z*sqrt(3.0)*0.25)
		check(extent<=0.48001,"original mesh remains inside its hex")
		check(rock.get_meta("source_geometry_unchanged",false) and not rock.find_children("*","MeshInstance3D",true,false).is_empty(),"original detailed model is reused")
		rock.free()
	print("HOMEBASE_VISUAL_COHERENCE ",failed," failures")
	quit(0 if failed==0 else 1)
