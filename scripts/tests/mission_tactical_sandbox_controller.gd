func _refresh_selected_fireteam_cards() -> void:
	var card_row := get_node_or_null(FIRETEAM_SELECTED_CARDS_ROW_PATH) as HBoxContainer
	if card_row == null:
		return
	var runtime_signature: String = _build_selected_fireteam_cards_runtime_signature()
	if runtime_signature == _last_selected_fireteam_cards_runtime_signature:
		_increment_mission_hud_runtime_surface_guard_count(_mission_hud_runtime_surface_guard_skip_counts, "selected_cards")
		return
	_last_selected_fireteam_cards_runtime_signature = runtime_signature
	_increment_mission_hud_runtime_surface_guard_count(_mission_hud_runtime_surface_guard_apply_counts, "selected_cards")

	for child in card_row.get_children():
		child.queue_free()

	var selected_cards_fireteam_id: String = _get_selected_member_cards_fireteam_id()
	var units: Array = []
	if not selected_cards_fireteam_id.is_empty():
		# The selected roster also shows embarked members read-only (TASK_628).
		# Ground filtering belongs to ground selection/commands, not this list.
		units = _get_fireteam_units(selected_cards_fireteam_id, true)
	else:
		units = _get_selected_friendly_units(not _use_visible_units_for_fireteam_ui())
		units = _filter_ground_fireteam_card_units(units)
	card_row.set_meta("selected_member_cards_fireteam_id", selected_cards_fireteam_id)
	if units.is_empty():
		var empty_label := Label.new()
		empty_label.text = "Fireteam im Dropship." if _selected_fireteams_have_embarked_payload() else "Kein aktives Fireteam im Sichtbereich."
		empty_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		empty_label.size_flags_horizontal = Control.SIZE_SHRINK_END
		empty_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		empty_label.custom_minimum_size = Vector2(280.0, 44.0)
		META_UI_SKIN_SCRIPT.style_body_label(empty_label, 11)
		card_row.add_child(empty_label)
		return

	var hud_embarked_unit_state: Dictionary = _build_hud_embarked_unit_state()
	for unit in units:
		var card = NPC_COMPACT_CARD_SCENE.instantiate()
		var unit_id: String = String(unit.call("get_unit_id")).strip_edges() if unit != null and unit.has_method("get_unit_id") else ""
		var in_drop_transit: bool = not unit_id.is_empty() and hud_embarked_unit_state.has(unit_id) and not _deployed_unit_ids.has(unit_id)
		card.custom_minimum_size = Vector2(196.0, 88.0)
		card.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		card.call(
			"setup_from_profile",
			_build_fireteam_card_profile(unit),
			{
				"source_context": "mission_selected_fireteam_member",
				"compact_mode": true,
				"drag_enabled": false,
				"show_lead_indicator": true,
				"show_badges": false,
				"is_lead": _is_unit_current_fireteam_lead(unit),
				"selected": _is_selected_member_card_unit(unit, selected_cards_fireteam_id),
				"disabled": in_drop_transit,
				"fixed_size": true,
				"fixed_card_size": Vector2(196.0, 88.0),
				"compact_wrap_text": true,
				"compact_data_a_max_lines": 1,
				"compact_data_b_max_lines": 2,
				"compact_text_min_width": 108.0,
				"compact_name_font_size": 15,
				"compact_data_font_size": 12,
				"compact_line_height": 14.0,
				"compact_portrait_size": 42.0,
				"card_tooltip_override": _build_live_fireteam_card_technical_tooltip(unit) if not preview_mode else "",
			}
		)
		card.set_meta("mission_selected_fireteam_member_in_drop_transit", in_drop_transit)
		card.set_meta("mission_selected_fireteam_member_fireteam_id", selected_cards_fireteam_id)
		if not card.card_open_requested.is_connected(_on_fireteam_card_open_requested):
			card.card_open_requested.connect(_on_fireteam_card_open_requested)
		card_row.add_child(card)


func _filter_ground_fireteam_card_units(units: Array) -> Array:
