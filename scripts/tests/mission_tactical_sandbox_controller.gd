func _apply_command_matrix_player_icons() -> void:
	var icons_by_path: Dictionary = {
		"../TacticalUI/BottomDock/BottomMargin/BottomRow/CommandPanel/CommandMargin/CommandScroll/CommandVBox/CommandGrid/MoveButton": COMMAND_MOVE_ICON,
		"../TacticalUI/BottomDock/BottomMargin/BottomRow/CommandPanel/CommandMargin/CommandScroll/CommandVBox/CommandGrid/HoldButton": COMMAND_HOLD_ICON,
		"../TacticalUI/BottomDock/BottomMargin/BottomRow/CommandPanel/CommandMargin/CommandScroll/CommandVBox/CommandGrid/FlankButton": COMMAND_FLANK_ICON,
		"../TacticalUI/BottomDock/BottomMargin/BottomRow/CommandPanel/CommandMargin/CommandScroll/CommandVBox/CommandGrid/TakeButton": COMMAND_TAKE_ICON,
		"../TacticalUI/BottomDock/BottomMargin/BottomRow/CommandPanel/CommandMargin/CommandScroll/CommandVBox/CommandGrid/TargetButton": COMMAND_TARGET_ICON,
		FIRE_RULE_HOLD_BUTTON_PATH: FIRE_RULE_HOLD_ICON,
		FIRE_RULE_RETURN_BUTTON_PATH: FIRE_RULE_RETURN_ICON,
		FIRE_RULE_FREE_BUTTON_PATH: FIRE_RULE_FREE_ICON,
		FIRE_RULE_SUPPRESS_BUTTON_PATH: FIRE_RULE_SUPPRESS_ICON,
	}
	for path_variant in icons_by_path:
		var button := get_node_or_null(String(path_variant)) as Button
		if button == null:
			continue
		var native_a5: bool = bool(get_meta("native_a5_legacy_setup_complete", false))
		var button_name := String(button.name)
		if native_a5 and (NATIVE_A5_HUD_LAYOUT_SCRIPT.ICON_IDS.has(button_name) or NATIVE_A5_HUD_LAYOUT_SCRIPT.RULES.has(button_name)):
			continue
		button.icon = _get_compact_command_matrix_icon(String(path_variant), icons_by_path[path_variant] as Texture2D)
		# A5 Target can still use this legacy texture until its native presenter
		# owns an icon; its final typography and expansion already belong to A5.
		if not _native_a5_owns_primary_command_presentation(button):
			button.expand_icon = false
			button.add_theme_font_size_override("font_size", RELEASE_FIREFIGHT_COMMAND_MATRIX_PRIMARY_FONT_SIZE)


func _get_compact_command_matrix_icon(cache_key: String, source: Texture2D) -> Texture2D:
	if _command_matrix_icon_cache.has(cache_key):
		return _command_matrix_icon_cache[cache_key] as Texture2D
	if source == null:
		return null
	var image: Image = source.get_image()
	if image == null or image.is_empty():
		return source
	image.resize(COMMAND_MATRIX_1280_ICON_SIZE, COMMAND_MATRIX_1280_ICON_SIZE, Image.INTERPOLATE_LANCZOS)
	var compact_texture := ImageTexture.create_from_image(image)
	_command_matrix_icon_cache[cache_key] = compact_texture
	return compact_texture


func _apply_command_matrix_1280_readability() -> void:
	if bool(get_meta("native_a5_legacy_setup_complete", false)):
		_apply_native_a5_hud_layout()
		return
	var command_grid := get_node_or_null(COMMAND_GRID_PATH) as GridContainer
	if command_grid == null:
		return
	command_grid.set_meta("command_matrix_1280_readability_style_id", COMMAND_MATRIX_1280_READABILITY_STYLE_ID)
	command_grid.set_meta("command_matrix_1280_ui_sets_gameplay_truth", false)
	for child_variant in command_grid.get_children():
		var button := child_variant as Button
		if button == null:
			continue
		var marker := button.get_node_or_null("TinyButtonMarker") as Label
		if marker != null:
			marker.visible = false
			marker.set_meta("command_matrix_player_hidden", true)
		if bool(button.get_meta("drop_light_command_placeholder", false)):
			continue
		var font_size := COMMAND_MATRIX_1280_SECONDARY_FONT_SIZE
		if button.name == "GoCommandMatrixButton":
			font_size = RELEASE_FIREFIGHT_COMMAND_MATRIX_GO_FONT_SIZE
		elif bool(button.get_meta("fire_rule_control", false)):
			font_size = RELEASE_FIREFIGHT_COMMAND_MATRIX_FIRE_RULE_FONT_SIZE
		elif ["MoveButton", "TakeButton", "HoldButton", "FlankButton", "TargetButton"].has(String(button.name)):
			font_size = RELEASE_FIREFIGHT_COMMAND_MATRIX_PRIMARY_FONT_SIZE
		button.add_theme_font_size_override("font_size", font_size)
		button.add_theme_constant_override("icon_max_width", COMMAND_MATRIX_1280_ICON_SIZE)
		button.add_theme_constant_override("h_separation", 3)
		_apply_command_matrix_compact_content_margins(button)
		button.set_meta("command_matrix_1280_font_size", font_size)
		button.set_meta("command_matrix_1280_readability_style_id", COMMAND_MATRIX_1280_READABILITY_STYLE_ID)
	_apply_native_a5_hud_layout()


func _apply_command_matrix_compact_content_margins(button: Button) -> void:
	if button == null:
		return
	for state in ["normal", "hover", "pressed", "disabled", "focus"]:
		var source := button.get_theme_stylebox(state)
		if source == null:
			continue
		var compact := source.duplicate() as StyleBox
		compact.content_margin_left = COMMAND_MATRIX_1280_HORIZONTAL_CONTENT_MARGIN
		compact.content_margin_right = COMMAND_MATRIX_1280_HORIZONTAL_CONTENT_MARGIN
		button.add_theme_stylebox_override(state, compact)


func _apply_mission_control_1280_readability() -> void:
	var header := get_node_or_null("../TacticalUI/BottomDock/BottomMargin/BottomRow/StrategicPanel/StrategicMargin/StrategicScroll/StrategicVBox/StrategicHeaderLabel") as Label
	if header != null:
		header.add_theme_font_size_override("font_size", MISSION_CONTROL_1280_HEADER_FONT_SIZE)
		header.add_theme_color_override("font_color", Color(0.82, 1.0, 0.94, 1.0))
		header.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.9))
		header.add_theme_constant_override("outline_size", 2)
		header.set_meta("mission_control_1280_readability_style_id", MISSION_CONTROL_1280_READABILITY_STYLE_ID)
		header.set_meta("mission_control_1280_ui_sets_gameplay_truth", false)
	var status_label := get_node_or_null(STRATEGIC_STATUS_LABEL_PATH) as Label
	if status_label == null:
		return
	var original_text: String = String(status_label.text).strip_edges()
	var previous_full_text: String = String(status_label.get_meta("mission_control_1280_full_status_text", "")).strip_edges()
	var previous_visible_text: String = _build_mission_control_1280_visible_text(previous_full_text)
	var original_is_new_source: bool = not original_text.is_empty() \
		and original_text != previous_full_text \
		and original_text != previous_visible_text
	if not original_text.is_empty() and (not bool(status_label.get_meta("mission_control_1280_visible_trimmed", false)) or previous_full_text.is_empty() or original_is_new_source):
		status_label.set_meta("mission_control_1280_full_status_text", original_text)
	var source_text: String = String(status_label.get_meta("mission_control_1280_full_status_text", original_text)).strip_edges()
	if source_text.is_empty():
		source_text = original_text
	var visible_lines: PackedStringArray = source_text.split("\n", false)
	var trimmed: bool = visible_lines.size() > MISSION_CONTROL_1280_MAX_VISIBLE_LINES
	if trimmed:
		var capped_lines := PackedStringArray()
		for index in range(MISSION_CONTROL_1280_MAX_VISIBLE_LINES):
			capped_lines.append(String(visible_lines[index]).strip_edges())
		status_label.text = "\n".join(capped_lines)
		status_label.set_meta("mission_control_1280_visible_trimmed", true)
	else:
		status_label.text = source_text
		status_label.set_meta("mission_control_1280_visible_trimmed", false)
	status_label.tooltip_text = _merge_mission_control_1280_tooltip(status_label.tooltip_text, source_text)
	status_label.visible = get_node_or_null("%s/A5TransportState" % (NATIVE_A5_HUD_LAYOUT_SCRIPT.BASE + "StrategicPanel")) == null
	status_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	status_label.clip_text = false
	status_label.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	status_label.add_theme_color_override("font_color", Color(0.82, 1.0, 0.94, 1.0))
	status_label.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.94))
	status_label.add_theme_font_size_override("font_size", MISSION_CONTROL_1280_STATUS_FONT_SIZE)
	status_label.add_theme_constant_override("outline_size", MISSION_CONTROL_1280_OUTLINE_SIZE)
	status_label.custom_minimum_size = Vector2(
		maxf(status_label.custom_minimum_size.x, 0.0),
		maxf(status_label.custom_minimum_size.y, MISSION_CONTROL_1280_MIN_STATUS_HEIGHT)
	)
	status_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	status_label.mouse_filter = Control.MOUSE_FILTER_STOP
	status_label.mouse_default_cursor_shape = Control.CURSOR_HELP
	status_label.set_meta("mission_control_1280_readability_style_id", MISSION_CONTROL_1280_READABILITY_STYLE_ID)
	status_label.set_meta("mission_control_1280_font_size", MISSION_CONTROL_1280_STATUS_FONT_SIZE)
	status_label.set_meta("mission_control_1280_visible_line_count", min(visible_lines.size(), MISSION_CONTROL_1280_MAX_VISIBLE_LINES))
	status_label.set_meta("mission_control_1280_ui_sets_gameplay_truth", false)


func _build_mission_control_1280_visible_text(source_text: String) -> String:
	var text: String = source_text.strip_edges()
	if text.is_empty():
		return ""
	var lines: PackedStringArray = text.split("\n", false)
	if lines.size() <= MISSION_CONTROL_1280_MAX_VISIBLE_LINES:
		return text
	var capped_lines := PackedStringArray()
	for index in range(MISSION_CONTROL_1280_MAX_VISIBLE_LINES):
		capped_lines.append(String(lines[index]).strip_edges())
	return "\n".join(capped_lines)


func _merge_mission_control_1280_tooltip(existing_tooltip: String, full_status_text: String) -> String:
	var normalized_tooltip: String = existing_tooltip.strip_edges()
	var normalized_status: String = full_status_text.strip_edges()
	if normalized_status.is_empty():
		return normalized_tooltip
	if normalized_tooltip.contains(normalized_status):
		return normalized_tooltip
	if normalized_tooltip.is_empty():
		return normalized_status
	return "%s\n\n%s" % [normalized_tooltip, normalized_status]


