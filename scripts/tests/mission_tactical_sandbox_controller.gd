func _build_mission_interaction_runtime_use_context_for_readability() -> Dictionary:
	var local_team_id: String = get_local_command_team_id()
	return {
		"current_team_id": local_team_id,
		"fireteam_positions": _build_mission_interaction_fireteam_positions_for_readability(),
		"interaction_states": _get_mission_interaction_states_for_readability(),
	}


func _build_mission_interaction_fireteam_positions_for_readability() -> Array:
	var entries: Array = []
	var local_team_id: String = get_local_command_team_id()
	for fireteam_id_variant in _get_available_fireteam_ids():
		var fireteam_id: String = String(fireteam_id_variant).strip_edges().to_lower()
		if fireteam_id.is_empty() or not _is_fireteam_runtime_active(fireteam_id):
			continue
		var anchor_position: Variant = _resolve_fireteam_visual_anchor_position(fireteam_id)
		if typeof(anchor_position) != TYPE_VECTOR2:
			continue
		entries.append({
			"fireteam_id": fireteam_id,
			"team_id": local_team_id,
			"position": Vector2(anchor_position),
			"active": true,
			"selected": _selected_fireteam_ids.has(fireteam_id),
		})
	return entries


func _get_mission_interaction_states_for_readability() -> Dictionary:
	var combat_driver = _get_combat_loop_driver()
	if combat_driver == null:
		return {}
	if combat_driver.has_method("get_mission_interaction_runtime_states"):
		return Dictionary(combat_driver.call("get_mission_interaction_runtime_states")).duplicate(true)
	if combat_driver.has_method("get_mission_interaction_runtime_state_snapshot"):
		var snapshot: Dictionary = Dictionary(combat_driver.call("get_mission_interaction_runtime_state_snapshot")).duplicate(true)
		return Dictionary(snapshot.get("interaction_states", snapshot))
	return {}


func _get_active_mission_scenario_path_for_readability() -> String:
	var mission_setup: Node = get_node_or_null("../MissionSetup")
	if mission_setup != null:
		var scenario_path: String = String(mission_setup.get("scenario_file_path")).strip_edges()
		if not scenario_path.is_empty():
			return scenario_path
	return "res://data/mission_scenarios/frontier_probe_vertical_slice.json" if _should_sync_frontier_probe_route_callouts() else ""


func _get_active_mission_terrain_map_data_for_readability():
	var mission_setup: Node = get_node_or_null("../MissionSetup")
	if mission_setup == null:
		return null
	return mission_setup.get("_loaded_terrain_map_data")


func _find_runtime_gate_by_objective_type(gate_entries: Array, objective_type: String) -> Dictionary:
	var normalized_type: String = objective_type.strip_edges()
	for gate_variant in gate_entries:
		var gate: Dictionary = Dictionary(gate_variant)
		if String(gate.get("objective_type", "")).strip_edges() == normalized_type:
			return gate
	return {}


func _is_selected_tile_close_to_objective(selected_tile: Dictionary, objective_state: Dictionary) -> bool:
	if not bool(selected_tile.get("has_selected_tile", false)) or objective_state.is_empty():
		return false
	var tile_position: Vector2 = Vector2(selected_tile.get("world_position", Vector2.ZERO))
	var objective_position: Vector2 = Vector2(objective_state.get("position", Vector2.ZERO))
	var capture_radius: float = maxf(float(objective_state.get("capture_radius", 0.0)), 1.0)
	return tile_position.distance_to(objective_position) <= capture_radius + 1.0


func get_combat_hud_visual_detail_tooltip_snapshot() -> Dictionary:
	var hud_snapshot: Dictionary = get_mission_combat_feedback_hud_density_snapshot()
	var combat_hud_density: Dictionary = Dictionary(hud_snapshot.get("combat_hud_density", {}))
	var detail_tooltip: Dictionary = Dictionary(combat_hud_density.get("detail_tooltip", {}))
	var compact_line: String = String(hud_snapshot.get("compact_line", "")).strip_edges()
	var tooltip_text: String = String(detail_tooltip.get("tooltip_text", "")).strip_edges()
	var fireteam_label := get_node_or_null(FIRETEAM_STATUS_LABEL_PATH) as Label
	var strategic_label := get_node_or_null(STRATEGIC_STATUS_LABEL_PATH) as Label
	var fireteam_tooltip: String = String(fireteam_label.tooltip_text if fireteam_label != null else "").strip_edges()
	var mission_control_tooltip: String = String(strategic_label.tooltip_text if strategic_label != null else "").strip_edges()
	if fireteam_tooltip.is_empty() and not tooltip_text.is_empty():
		fireteam_tooltip = tooltip_text
	if mission_control_tooltip.is_empty() and not tooltip_text.is_empty():
		mission_control_tooltip = tooltip_text
	var checks: Array = [
		_build_mission_first_move_readability_check(
			"combat_hud_density_gate_passes",
			String(hud_snapshot.get("gate", "")) == "pass",
			"Detail tooltip builds on the existing compact combat HUD density snapshot."
		),
		_build_mission_first_move_readability_check(
			"compact_line_stays_short",
			bool(combat_hud_density.get("line_within_limit", false)) and not compact_line.is_empty(),
			"Detail tooltip does not lengthen the compact HUD line."
		),
		_build_mission_first_move_readability_check(
			"tooltip_text_available",
			bool(detail_tooltip.get("active", false)) and not tooltip_text.is_empty(),
			"Combat HUD detail tooltip text is available."
		),
		_build_mission_first_move_readability_check(
			"tooltip_within_limit",
			bool(detail_tooltip.get("tooltip_within_limit", false)),
			"Tooltip detail lines stay within the HUD text budget."
		),
		_build_mission_first_move_readability_check(
			"tooltip_explains_fire_cover_los_range",
			bool(detail_tooltip.get("contains_fire_state", false))
				and bool(detail_tooltip.get("contains_cover_detail", false))
				and bool(detail_tooltip.get("contains_range_detail", false))
				and bool(detail_tooltip.get("contains_los_detail", false))
				and bool(detail_tooltip.get("contains_flank_detail", false)),
			"Tooltip explains fire state, cover, range, LOS and flank context."
		),
		_build_mission_first_move_readability_check(
			"selected_fireteam_tooltip_matches",
			not tooltip_text.is_empty() and fireteam_tooltip == tooltip_text,
			"Selected Fireteam label exposes the same combat detail tooltip."
		),
		_build_mission_first_move_readability_check(
			"mission_control_tooltip_matches",
			not tooltip_text.is_empty() and mission_control_tooltip == tooltip_text,
			"Mission Control label exposes the same combat detail tooltip."
		),
		_build_mission_first_move_readability_check(
			"read_only",
			bool(detail_tooltip.get("read_only", false)) and not bool(detail_tooltip.get("ui_sets_gameplay_truth", true)),
			"Detail tooltip reports existing combat data without mutating gameplay state."
		),
	]
	var failed_checks: Array = []
	for check_variant in checks:
		var check: Dictionary = Dictionary(check_variant)
		if not bool(check.get("passed", false)):
			failed_checks.append(String(check.get("id", "")))
	return {
		"task_id": "TASK_548",
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"compact_line": compact_line,
		"tooltip_text": tooltip_text,
		"detail_tooltip": detail_tooltip,
		"selected_fireteam_tooltip_text": fireteam_tooltip,
		"mission_control_tooltip_text": mission_control_tooltip,
		"combat_hud_density": hud_snapshot,
		"checks": checks,
		"failed_checks": failed_checks,
		"gate": "pass" if failed_checks.is_empty() else "review",
	}


func get_combat_hud_f6_visual_audit_snapshot() -> Dictionary:
	var detail_snapshot: Dictionary = get_combat_hud_visual_detail_tooltip_snapshot()
	var detail_tooltip: Dictionary = Dictionary(detail_snapshot.get("detail_tooltip", {}))
	var tooltip_text: String = String(detail_snapshot.get("tooltip_text", "")).strip_edges()
	var tooltip_lines: PackedStringArray = tooltip_text.split("\n", false)
	var viewport_size: Vector2 = _get_current_viewport_size()
	var viewport_rect: Rect2 = Rect2(Vector2.ZERO, viewport_size)
	var fireteam_panel := get_node_or_null(FIRETEAM_PANEL_PATH) as Control
	var mission_panel := get_node_or_null("../TacticalUI/BottomDock/BottomMargin/BottomRow/StrategicPanel") as Control
	var fireteam_label := get_node_or_null(FIRETEAM_STATUS_LABEL_PATH) as Label
	var mission_label := get_node_or_null(STRATEGIC_STATUS_LABEL_PATH) as Label
	var fireteam_panel_rect: Rect2 = _get_control_global_rect_or_empty(fireteam_panel)
	var mission_panel_rect: Rect2 = _get_control_global_rect_or_empty(mission_panel)
	var fireteam_label_rect: Rect2 = _get_control_global_rect_or_empty(fireteam_label)
	var mission_label_rect: Rect2 = _get_control_global_rect_or_empty(mission_label)
	var fireteam_tooltip_rect: Rect2 = _estimate_combat_hud_tooltip_preview_rect(fireteam_label_rect, tooltip_lines, viewport_size)
	var mission_tooltip_rect: Rect2 = _estimate_combat_hud_tooltip_preview_rect(mission_label_rect, tooltip_lines, viewport_size)
	var max_tooltip_line_length: int = _max_string_length(Array(tooltip_lines))
	var fireteam_label_style: Dictionary = _get_combat_hud_tooltip_label_style_snapshot(fireteam_label)
	var mission_label_style: Dictionary = _get_combat_hud_tooltip_label_style_snapshot(mission_label)
	var checks: Array = [
		_build_mission_first_move_readability_check(
			"task_548_tooltip_gate_passes",
			String(detail_snapshot.get("gate", "")) == "pass",
			"F6 visual audit builds on the green TASK_548 tooltip snapshot."
		),
		_build_mission_first_move_readability_check(
			"hud_controls_present",
			fireteam_panel != null and mission_panel != null and fireteam_label != null and mission_label != null,
			"Selected Fireteam and Mission Control panels plus their combat labels exist."
		),
		_build_mission_first_move_readability_check(
			"labels_visible_and_hoverable",
			fireteam_label_rect.size.x > 0.0
				and fireteam_label_rect.size.y > 0.0
				and mission_label_rect.size.x > 0.0
				and mission_label_rect.size.y > 0.0
				and fireteam_label.mouse_filter != Control.MOUSE_FILTER_IGNORE
				and mission_label.mouse_filter != Control.MOUSE_FILTER_IGNORE
				and not fireteam_label.tooltip_text.strip_edges().is_empty()
				and not mission_label.tooltip_text.strip_edges().is_empty(),
			"Combat HUD labels are visible and can receive tooltip hover."
		),
		_build_mission_first_move_readability_check(
			"labels_inside_panels",
			_rect_contains_rect_with_margin(fireteam_panel_rect, fireteam_label_rect, 2.0)
				and _rect_contains_rect_with_margin(mission_panel_rect, mission_label_rect, 2.0),
			"Combat HUD labels stay inside their parent panels."
		),
		_build_mission_first_move_readability_check(
			"panels_inside_fullhd_bounds",
			_rect_inside_rect_with_margin(viewport_rect, fireteam_panel_rect, 0.0)
				and _rect_inside_rect_with_margin(viewport_rect, mission_panel_rect, 0.0),
			"Selected Fireteam and Mission Control panels stay inside the FullHD viewport."
		),
		_build_mission_first_move_readability_check(
			"selected_and_mission_panels_do_not_overlap",
			not fireteam_panel_rect.intersects(mission_panel_rect, true),
			"Selected Fireteam and Mission Control panels do not overlap."
		),
		_build_mission_first_move_readability_check(
			"tooltip_payload_matches_both_labels",
			not tooltip_text.is_empty()
				and String(detail_snapshot.get("selected_fireteam_tooltip_text", "")).strip_edges() == tooltip_text
				and String(detail_snapshot.get("mission_control_tooltip_text", "")).strip_edges() == tooltip_text,
			"Both HUD panels expose the same detail tooltip payload."
		),
		_build_mission_first_move_readability_check(
			"tooltip_lines_short_and_scannable",
			tooltip_lines.size() > 0
				and tooltip_lines.size() <= 4
				and bool(detail_tooltip.get("tooltip_within_limit", false))
				and max_tooltip_line_length <= int(detail_tooltip.get("tooltip_line_limit", 112)),
			"Tooltip line count and line length stay scannable."
		),
		_build_mission_first_move_readability_check(
			"tooltip_preview_fits_fullhd",
			_rect_inside_rect_with_margin(viewport_rect, fireteam_tooltip_rect, 0.0)
				and _rect_inside_rect_with_margin(viewport_rect, mission_tooltip_rect, 0.0),
			"Estimated native tooltip preview areas fit inside FullHD bounds."
		),
		_build_mission_first_move_readability_check(
			"tooltip_labels_share_style_hint",
			String(fireteam_label_style.get("style_id", "")) == COMBAT_HUD_TOOLTIP_STYLE_ID
				and String(mission_label_style.get("style_id", "")) == COMBAT_HUD_TOOLTIP_STYLE_ID
				and String(fireteam_label_style.get("font_color", "")) == String(mission_label_style.get("font_color", "")),
			"Both Combat HUD labels expose the same hover style hint."
		),
		_build_mission_first_move_readability_check(
			"read_only",
			not bool(detail_snapshot.get("ui_sets_gameplay_truth", true)),
			"F6 visual audit summarizes existing HUD state without mutating gameplay state."
		),
	]
	var failed_checks: Array = []
	for check_variant in checks:
		var check: Dictionary = Dictionary(check_variant)
		if not bool(check.get("passed", false)):
			failed_checks.append(String(check.get("id", "")))
	return {
		"task_id": "TASK_549",
		"audit_id": "combat_hud_f6_visual_audit_v1",
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"automated_visual_gate": "pass" if failed_checks.is_empty() else "review",
