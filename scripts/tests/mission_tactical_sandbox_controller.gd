func _on_multiplayer_authority_snapshot_applied(snapshot: Dictionary) -> void:
	apply_authoritative_fire_rule_snapshot(snapshot.get("tactical_rules", []))
	var dropship_snapshot_changed: bool = apply_authoritative_mission_dropship_snapshot(Dictionary(snapshot.get("dropship", {})))
	var mission_interactions: Dictionary = Dictionary(snapshot.get("mission_interactions", {}))
	mission_interactions["source_tick"] = maxi(int(snapshot.get("tick", -1)), -1)
	var combat_driver = _get_combat_loop_driver()
	if combat_driver != null and combat_driver.has_method("apply_multiplayer_combat_snapshot"):
		combat_driver.call("apply_multiplayer_combat_snapshot", snapshot)
		var contact_snapshot: Array = get_contact_snapshot()
		var contact_signature: String = JSON.stringify(contact_snapshot)
		if contact_signature != _last_network_contact_visual_signature:
			_last_network_contact_visual_signature = contact_signature
			refresh_contact_overlay()
		var contact_focus_active: bool = _is_mission_contact_focus_active()
		if _should_refresh_dropship_panel_for_contact_focus(contact_focus_active, dropship_snapshot_changed):
			_refresh_mission_dropship_panel()
	if combat_driver != null and combat_driver.has_method("apply_multiplayer_interaction_snapshot"):
		combat_driver.call("apply_multiplayer_interaction_snapshot", mission_interactions)
	_apply_network_mission_interaction_progress_surface(mission_interactions)


func apply_authoritative_mission_dropship_snapshot(dropship_snapshot: Dictionary) -> bool:
	if dropship_snapshot.is_empty() or not dropship_snapshot.has("mission_drop_cards"):
		return false
	var snapshot_signature: String = JSON.stringify(dropship_snapshot)
	if snapshot_signature == _last_authoritative_dropship_snapshot_signature:
		_authoritative_dropship_snapshot_dedupe_count += 1
		return false
	var incoming_cards: Array = _sanitize_mission_dropship_cards(Array(dropship_snapshot.get("mission_drop_cards", [])))
	if incoming_cards.is_empty():
		return false
	var local_craft_id: String = _mission_drop_craft_id.strip_edges()
	var local_selected_fireteams: PackedStringArray = _selected_fireteam_ids.duplicate()
	_mission_drop_cards = _merge_authoritative_mission_dropship_cards(incoming_cards)
	_deployed_unit_ids = _build_drop_unit_state_dict(Array(dropship_snapshot.get("deployed_unit_ids", [])))
	_embarked_unit_ids = _build_drop_unit_state_dict(Array(dropship_snapshot.get("embarked_unit_ids", [])))
	var local_card: Dictionary = _find_raw_mission_dropship_card_entry(local_craft_id)
	if local_card.is_empty():
		local_card = Dictionary(_mission_drop_cards[0]).duplicate(true)
		local_craft_id = String(local_card.get("craft_id", "")).strip_edges()
	if not local_card.is_empty():
		_apply_mission_dropship_card_selection(local_card)
	var available_fireteams: PackedStringArray = _get_available_fireteam_ids()
	var preserved_selection := PackedStringArray()
	for fireteam_id_variant in local_selected_fireteams:
		var fireteam_id: String = String(fireteam_id_variant).strip_edges().to_lower()
		if available_fireteams.has(fireteam_id):
			preserved_selection.append(fireteam_id)
	if not preserved_selection.is_empty():
		_set_selected_fireteams(preserved_selection, false)
	_apply_drop_presence_state_to_units()
	_apply_authoritative_dropship_pending_snapshot(incoming_cards)
	_refresh_button_state()
	_refresh_selection_visuals()
	_refresh_world_overlays()
	_update_ui(true, false)
	_last_authoritative_dropship_snapshot_signature = snapshot_signature
	_authoritative_dropship_snapshot_apply_count += 1
	return not local_craft_id.is_empty()


func get_authoritative_dropship_snapshot_apply_debug_snapshot() -> Dictionary:
	return {
		"apply_count": _authoritative_dropship_snapshot_apply_count,
		"dedupe_count": _authoritative_dropship_snapshot_dedupe_count,
		"has_signature": not _last_authoritative_dropship_snapshot_signature.is_empty(),
		"read_only": true,
		"ui_sets_gameplay_truth": false,
	}


func _merge_authoritative_mission_dropship_cards(incoming_cards: Array) -> Array:
	var local_by_craft_id: Dictionary = {}
	for local_variant in _mission_drop_cards:
		if typeof(local_variant) != TYPE_DICTIONARY:
			continue
		var local_card: Dictionary = Dictionary(local_variant).duplicate(true)
		var craft_id: String = String(local_card.get("craft_id", "")).strip_edges()
		if not craft_id.is_empty():
			local_by_craft_id[craft_id] = local_card
	var merged: Array = []
	for incoming_variant in incoming_cards:
		if typeof(incoming_variant) != TYPE_DICTIONARY:
			continue
		var incoming: Dictionary = Dictionary(incoming_variant).duplicate(true)
		var craft_id: String = String(incoming.get("craft_id", "")).strip_edges()
		var card: Dictionary = Dictionary(local_by_craft_id.get(craft_id, {})).duplicate(true)
		for key_variant in incoming.keys():
			card[key_variant] = incoming[key_variant]
		merged.append(card)
	return _sanitize_mission_dropship_cards(merged)


func _on_network_command_result_received(result: Dictionary) -> void:
	if String(result.get("source_context", "")).strip_edges() == "mission_dropship_ui":
		_apply_network_dropship_command_result(result)
		return
	if String(result.get("source_context", "")).strip_edges() == "mission_interaction_use_intent_command":
		_apply_network_mission_interaction_result(result)
		return
	if String(result.get("source_context", "")).strip_edges() == "mission_fireteam_go":
		_apply_network_fireteam_command_result(result)
		return
	if String(result.get("command_type", "")).strip_edges().to_lower() != "set_fire_rule":
		return
	var accepted: bool = bool(result.get("accepted", false))
	var reason: String = String(result.get("reason", "")).strip_edges()
	var fireteam_id: String = String(result.get("fireteam_id", "")).strip_edges().to_lower()
	var fire_rule: String = String(result.get("fire_rule", "")).strip_edges().to_upper()
	var compact_line: String = "ROE %s %s HOST OK" % [fireteam_id.to_upper(), fire_rule] if accepted else "ROE BLOCKED %s" % reason
	_fire_rule_authority_feedback = {
		"schema": "sternenbuergerchen.fire_rule_authority_feedback.v1",
		"status": "accepted" if accepted else "blocked",
		"accepted": accepted,
		"reason": reason,
		"fireteam_id": fireteam_id,
		"fire_rule": String(result.get("fire_rule", "")).strip_edges().to_lower(),
		"compact_line": compact_line,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
	}
	_last_command_text = compact_line
	_update_ui()


func _apply_network_dropship_command_result(result: Dictionary) -> void:
	var accepted: bool = bool(result.get("accepted", false))
	var command_type: String = String(result.get("command_type", "")).strip_edges().to_lower()
	var craft_id: String = String(result.get("craft_id", "")).strip_edges()
	var reason: String = String(result.get("reason", "")).strip_edges()
	var action_label: String = _build_dropship_command_action_label(command_type)
	var command_id: String = String(result.get("command_id", "")).strip_edges()
	var pending: Dictionary = Dictionary(_pending_network_dropship_commands_by_craft.get(craft_id, {}))
	if not pending.is_empty() and (command_id.is_empty() or String(pending.get("command_id", "")) == command_id):
		if accepted:
			pending["phase"] = "accepted_waiting_snapshot"
			pending["compact_line"] = "%s %s HOST OK" % [action_label, craft_id]
			_pending_network_dropship_commands_by_craft[craft_id] = pending
		else:
			_pending_network_dropship_commands_by_craft.erase(craft_id)
	_last_command_text = "%s %s HOST OK" % [action_label, craft_id] if accepted else "%s BLOCKIERT | %s" % [action_label, _build_network_mission_interaction_reason_label(reason)]
	if not accepted and not craft_id.is_empty():
		_set_network_dropship_result_feedback(craft_id, _last_command_text, "blocked")
	_update_ui()


func _is_network_dropship_command_pending(craft_id: String) -> bool:
	return _pending_network_dropship_commands_by_craft.has(craft_id.strip_edges())


func get_network_dropship_pending_debug_snapshot() -> Dictionary:
	return {
		"pending_count": _pending_network_dropship_commands_by_craft.size(),
		"entries": _pending_network_dropship_commands_by_craft.duplicate(true),
		"timeout_count": _network_dropship_pending_timeout_count,
		"blocked_submit_count": _network_dropship_pending_blocked_submit_count,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
	}


func _advance_network_dropship_pending(delta: float) -> void:
	if delta <= 0.0:
		return
	var expired_craft_ids: Array[String] = []
	for craft_id_variant in _pending_network_dropship_commands_by_craft.keys():
		var craft_id: String = String(craft_id_variant)
		var pending: Dictionary = Dictionary(_pending_network_dropship_commands_by_craft.get(craft_id, {}))
		pending["remaining_seconds"] = maxf(float(pending.get("remaining_seconds", NETWORK_DROPSHIP_PENDING_TIMEOUT_SECONDS)) - delta, 0.0)
		if float(pending.get("remaining_seconds", 0.0)) <= 0.0:
			expired_craft_ids.append(craft_id)
		else:
			_pending_network_dropship_commands_by_craft[craft_id] = pending
	for craft_id in expired_craft_ids:
		_pending_network_dropship_commands_by_craft.erase(craft_id)
		_network_dropship_pending_timeout_count += 1
		_last_command_text = "DROPSHIP %s HOST TIMEOUT" % craft_id
		_set_network_dropship_result_feedback(craft_id, _last_command_text, "blocked")
	var expired_feedback_craft_ids: Array[String] = []
	for craft_id_variant in _network_dropship_feedback_by_craft.keys():
		var craft_id: String = String(craft_id_variant)
		var feedback: Dictionary = Dictionary(_network_dropship_feedback_by_craft.get(craft_id, {}))
		feedback["remaining_seconds"] = maxf(float(feedback.get("remaining_seconds", NETWORK_DROPSHIP_RESULT_FEEDBACK_SECONDS)) - delta, 0.0)
		if float(feedback.get("remaining_seconds", 0.0)) <= 0.0:
			expired_feedback_craft_ids.append(craft_id)
		else:
			_network_dropship_feedback_by_craft[craft_id] = feedback
	for craft_id in expired_feedback_craft_ids:
		_network_dropship_feedback_by_craft.erase(craft_id)
	if not expired_craft_ids.is_empty() or not expired_feedback_craft_ids.is_empty():
		_update_ui()


func _set_network_dropship_result_feedback(craft_id: String, compact_line: String, tone: String) -> void:
	var normalized_craft_id: String = craft_id.strip_edges()
	if normalized_craft_id.is_empty() or compact_line.strip_edges().is_empty():
		return
	_network_dropship_feedback_by_craft[normalized_craft_id] = {
		"compact_line": compact_line.strip_edges(),
		"tone": tone.strip_edges().to_lower(),
		"remaining_seconds": NETWORK_DROPSHIP_RESULT_FEEDBACK_SECONDS,
		"read_only": true,
	}


func _apply_authoritative_dropship_pending_snapshot(incoming_cards: Array) -> void:
	if _pending_network_dropship_commands_by_craft.is_empty():
		return
	var incoming_by_craft: Dictionary = {}
	for card_variant in incoming_cards:
		if typeof(card_variant) != TYPE_DICTIONARY:
			continue
		var card: Dictionary = Dictionary(card_variant)
		var craft_id: String = String(card.get("craft_id", "")).strip_edges()
		if not craft_id.is_empty():
			incoming_by_craft[craft_id] = card
	for craft_id_variant in _pending_network_dropship_commands_by_craft.keys():
		var craft_id: String = String(craft_id_variant)
		if not incoming_by_craft.has(craft_id):
			continue
		var pending: Dictionary = Dictionary(_pending_network_dropship_commands_by_craft.get(craft_id, {}))
		if _does_authoritative_dropship_card_satisfy_pending(Dictionary(incoming_by_craft[craft_id]), pending):
			var action_label: String = _build_dropship_command_action_label(String(pending.get("command_type", "")))
			_set_network_dropship_result_feedback(craft_id, "%s %s HOST OK" % [action_label, craft_id], "success")
			_pending_network_dropship_commands_by_craft.erase(craft_id)


func _does_authoritative_dropship_card_satisfy_pending(card: Dictionary, pending: Dictionary) -> bool:
	var command_type: String = String(pending.get("command_type", "")).strip_edges().to_lower()
	var payload: Dictionary = Dictionary(pending.get("payload", {}))
	match command_type:
		"set_lz":
			var expected_position: Vector2 = Vector2(payload.get("lz_position", payload.get("target_position", Vector2.ZERO)))
			return bool(card.get("has_lz_position", false)) and Vector2(card.get("lz_position", Vector2.ZERO)).is_equal_approx(expected_position)
		"clear_lz":
			return not bool(card.get("has_lz_position", false))
		"set_dropship_approach":
			return _sanitize_approach_angle_name(String(card.get("approach_angle", ""))) == _sanitize_approach_angle_name(String(payload.get("approach_angle", "")))
		"call_dropship":
			return String(card.get("state", "")).strip_edges().to_lower() != "waiting"
		"return_dropship":
			return String(card.get("state", "")).strip_edges().to_lower().begins_with("to_")
	return false


func _build_dropship_command_action_label(command_type: String) -> String:
	match command_type.strip_edges().to_lower():
		"set_lz":
			return "LZ"
		"set_dropship_approach":
			return "APPROACH"
		"call_dropship":
			return "DROP"
		"return_dropship":
			return "RETURN"
	return "DROPSHIP"


func _on_authoritative_dropship_command_committed(command: Dictionary) -> void:
	apply_authoritative_dropship_command(command)


func apply_authoritative_dropship_command(command: Dictionary) -> bool:
	var command_type: String = String(command.get("command_type", "")).strip_edges().to_lower()
	var craft_id: String = String(command.get("craft_id", "")).strip_edges()
	var fireteam_id: String = String(command.get("fireteam_id", "")).strip_edges().to_lower()
	var card: Dictionary = _find_mission_dropship_card_entry(craft_id)
	if card.is_empty() or not _extract_mission_dropship_card_fireteam_ids(card).has(fireteam_id):
		return false
	if not _select_mission_dropship_craft(craft_id, false):
		return false
	match command_type:
		"set_lz":
			var lz_variant: Variant = command.get("lz_position", command.get("target_position", null))
			if typeof(lz_variant) != TYPE_VECTOR2 and typeof(lz_variant) != TYPE_VECTOR3:
				return false
			_lz_position = Vector2(lz_variant.x, lz_variant.z) if typeof(lz_variant) == TYPE_VECTOR3 else Vector2(lz_variant.x, lz_variant.y)
			_has_lz_position = true
			if command.has("approach_angle"):
				_current_approach_index = maxi(APPROACH_ANGLES.find(_sanitize_approach_angle_name(String(command.get("approach_angle", "NW")))), 0)
			_last_command_text = "%s SET %s @ %s" % [_build_mission_dropship_lz_name(craft_id, _mission_drop_display_name, _get_mission_dropship_card_order_number(craft_id)), _get_approach_angle_name(), _format_world_position(_lz_position)]
			_store_selected_mission_dropship_plan()
		"clear_lz":
			_has_lz_position = false
			_lz_position = Vector2.ZERO
			_last_command_text = "%s LZ CLEARED" % _mission_drop_display_name
			_store_selected_mission_dropship_plan()
		"set_dropship_approach":
			_select_approach_angle(String(command.get("approach_angle", "NW")))
			return true
		"call_dropship":
			_request_selected_mission_dropship_drop(true, true)
			return true
		"return_dropship":
			return _apply_selected_mission_dropship_return(craft_id)
		_:
			return false
	_refresh_button_state()
	_refresh_world_overlays()
	_update_ui()
	_emit_planning_state_changed()
	return true


func _should_route_dropship_command_through_network_authority() -> bool:
	var simulation_root := get_node_or_null("../SimulationRoot")
	if simulation_root == null or simulation_root.get("is_server_authoritative") != true:
		return false
	var peer: MultiplayerPeer = multiplayer.multiplayer_peer
	return peer != null and peer.get_connection_status() != MultiplayerPeer.CONNECTION_DISCONNECTED


func request_network_authoritative_dropship_command(command_type: String, craft_id: String, fireteam_id: String, payload: Dictionary = {}) -> bool:
	var simulation_root := get_node_or_null("../SimulationRoot")
	if simulation_root == null:
		return false
	var normalized_craft_id: String = craft_id.strip_edges()
	var normalized_fireteam_id: String = fireteam_id.strip_edges().to_lower()
	if normalized_craft_id.is_empty() or normalized_fireteam_id.is_empty():
		return false
	if _is_network_dropship_command_pending(normalized_craft_id):
		_network_dropship_pending_blocked_submit_count += 1
		_last_command_text = "%s %s | WARTE AUF HOST" % [_build_dropship_command_action_label(command_type), normalized_craft_id]
		_update_ui()
		return false
	_network_dropship_feedback_by_craft.erase(normalized_craft_id)
	var peer_id: int = multiplayer.get_unique_id()
	var team_id: String = String(simulation_root.call("get_peer_team", peer_id)).strip_edges() if simulation_root.has_method("get_peer_team") else ""
	if team_id.is_empty():
		team_id = FRIENDLY_TEAM_ID
	var command: Dictionary = {
		"contract_category": "dropship_command",
		"command_type": command_type.strip_edges().to_lower(),
		"team_id": team_id,
		"fireteam_id": normalized_fireteam_id,
		"craft_id": normalized_craft_id,
		"source_context": "mission_dropship_ui",
	}
	_network_dropship_command_sequence += 1
	command["command_id"] = "dropship:%d:%d:%s:%s" % [peer_id, _network_dropship_command_sequence, normalized_craft_id, command_type.strip_edges().to_lower()]
	command.merge(payload, true)
	_pending_network_dropship_commands_by_craft[normalized_craft_id] = {
		"command_id": String(command.get("command_id", "")),
		"command_type": String(command.get("command_type", "")),
		"phase": "request_sent",
		"remaining_seconds": NETWORK_DROPSHIP_PENDING_TIMEOUT_SECONDS,
		"payload": payload.duplicate(true),
		"compact_line": "%s %s -> HOST" % [_build_dropship_command_action_label(command_type), normalized_craft_id],
	}
	if multiplayer.is_server():
		var result: Dictionary = Dictionary(simulation_root.call("submit_network_command_for_peer", command, peer_id))
		if not bool(result.get("accepted", false)):
			_apply_network_dropship_command_result(result.merged({"source_context": "mission_dropship_ui", "craft_id": normalized_craft_id, "command_id": String(command.get("command_id", ""))}, true))
			return false
	else:
		simulation_root.rpc_id(1, "request_command", command)
	_last_command_text = "%s %s -> HOST" % [_build_dropship_command_action_label(command_type), normalized_craft_id]
	_update_ui()
	return true


func request_network_authoritative_fireteam_intent(fireteam_id: String, command_type: String, target_position: Vector2, phase_index: int = LIVE_ORDER_PHASE_INDEX) -> bool:
	var simulation_root := get_node_or_null("../SimulationRoot")
	if simulation_root == null:
		return false
	var normalized_fireteam_id: String = fireteam_id.strip_edges().to_lower()
	var normalized_command_type: String = command_type.strip_edges().to_lower()
	if normalized_fireteam_id.is_empty() or not normalized_command_type in ["move", "defend", "take", "flank", "engage", "hold"]:
		return false
	if _pending_network_fireteam_commands.has(normalized_fireteam_id):
		_last_command_text = "%s %s | WARTE AUF HOST" % [normalized_command_type.to_upper(), normalized_fireteam_id.to_upper()]
		_update_ui()
		return false
	var peer_id: int = multiplayer.get_unique_id()
	var team_id: String = String(simulation_root.call("get_peer_team", peer_id)).strip_edges() if simulation_root.has_method("get_peer_team") else ""
	if team_id.is_empty():
		team_id = FRIENDLY_TEAM_ID
	_network_fireteam_command_sequence += 1
	var command_id: String = "fireteam:%d:%d:%s:%s" % [peer_id, _network_fireteam_command_sequence, normalized_fireteam_id, normalized_command_type]
	var command: Dictionary = {
		"contract_category": "commander_intent",
		"command_type": normalized_command_type,
		"command_id": command_id,
		"verb": normalized_command_type,
		"team_id": team_id,
		"fireteam_id": normalized_fireteam_id,
		"target_position": target_position,
		"phase": phase_index,
		"source_context": "mission_fireteam_go",
	}
	_pending_network_fireteam_commands[normalized_fireteam_id] = command.duplicate(true)
	if multiplayer.is_server():
		var result: Dictionary = Dictionary(simulation_root.call("submit_network_command_for_peer", command, peer_id))
		_apply_network_fireteam_command_result(result.merged({"source_context": "mission_fireteam_go", "command_id": command_id, "fireteam_id": normalized_fireteam_id, "command_type": normalized_command_type}, true))
		if not bool(result.get("accepted", false)):
			return false
	else:
		simulation_root.rpc_id(1, "request_command", command)
	_last_command_text = "%s %s -> HOST" % [normalized_command_type.to_upper(), normalized_fireteam_id.to_upper()]
	_update_ui()
	return true


func _apply_network_fireteam_command_result(result: Dictionary) -> void:
	var fireteam_id: String = String(result.get("fireteam_id", "")).strip_edges().to_lower()
	var command_id: String = String(result.get("command_id", "")).strip_edges()
	var pending: Dictionary = Dictionary(_pending_network_fireteam_commands.get(fireteam_id, {}))
	if not pending.is_empty() and (command_id.is_empty() or String(pending.get("command_id", "")) == command_id):
		_pending_network_fireteam_commands.erase(fireteam_id)
	var accepted: bool = bool(result.get("accepted", false))
	var command_type: String = String(result.get("command_type", pending.get("command_type", "move"))).strip_edges().to_lower()
	var reason: String = String(result.get("reason", "")).strip_edges()
	var compact_line: String = "%s %s HOST OK" % [command_type.to_upper(), fireteam_id.to_upper()] if accepted else "%s %s BLOCKIERT | %s" % [command_type.to_upper(), fireteam_id.to_upper(), _build_network_mission_interaction_reason_label(reason)]
	_network_fireteam_command_feedback = {
		"status": "accepted" if accepted else "blocked",
		"accepted": accepted,
		"fireteam_id": fireteam_id,
		"command_type": command_type,
		"reason": reason,
		"compact_line": compact_line,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
	}
	_last_command_text = compact_line
	_update_ui()


func get_network_fireteam_command_feedback_snapshot() -> Dictionary:
	return _network_fireteam_command_feedback.duplicate(true)


func _on_authoritative_commander_intent_committed(command: Dictionary) -> void:
	if String(command.get("source_context", "")).strip_edges() != "mission_fireteam_go":
		return
	_apply_authoritative_fireteam_intent(command)


func _apply_authoritative_fireteam_intent(command: Dictionary) -> bool:
	var fireteam_id: String = String(command.get("fireteam_id", "")).strip_edges().to_lower()
	var command_type: String = String(command.get("verb", command.get("command_type", "move"))).strip_edges().to_lower()
	var target_variant: Variant = command.get("target_position", null)
	if fireteam_id.is_empty() or typeof(target_variant) != TYPE_VECTOR2 or not _is_fireteam_runtime_active(fireteam_id):
		return false
	var target_position := Vector2(target_variant)
	_post_drop_security_pending_fireteam_ids.erase(fireteam_id)
	var phase_index: int = int(command.get("phase", LIVE_ORDER_PHASE_INDEX))
	var waypoint = FIRETEAM_WAYPOINT_SCRIPT.new({
		"waypoint_id": String(command.get("command_id", "")),
		"command_type": command_type,
		"status": FIRETEAM_WAYPOINT_SCRIPT.STATUS_ACTIVE,
		"target_position": target_position,
	})
	var behavior_profile = _resolve_fireteam_behavior_profile(fireteam_id, command_type, target_position)
	if behavior_profile != null:
		var metadata: Dictionary = Dictionary(behavior_profile.metadata).duplicate(true)
		metadata["origin"] = "network_commander_intent"
		metadata["phase"] = phase_index
		behavior_profile.metadata = metadata
	_set_active_behavior_profile(fireteam_id, behavior_profile)
	_phase_execution_by_fireteam[fireteam_id] = {
		"phase": phase_index,
		"waypoint_index": 0,
		"hold_elapsed": 0.0,
		"resolved_target_position": target_position,
		"started_msec": Time.get_ticks_msec(),
		"execution_owner": "standalone_network_intent",
		"standalone_network_intent": true,
	}
	var started: bool = _issue_waypoint_for_fireteam(fireteam_id, waypoint, phase_index, behavior_profile)
	if not started:
		_phase_execution_by_fireteam.erase(fireteam_id)
	return started


func _get_dropship_command_fireteam_id(craft_id: String) -> String:
	var card: Dictionary = _find_mission_dropship_card_entry(craft_id)
	var fireteam_ids: PackedStringArray = _extract_mission_dropship_card_fireteam_ids(card)
	if fireteam_ids.is_empty():
		return ""
	for selected_fireteam_id_variant in _selected_fireteam_ids:
		var selected_fireteam_id: String = String(selected_fireteam_id_variant).strip_edges().to_lower()
		if fireteam_ids.has(selected_fireteam_id):
			return selected_fireteam_id
	return String(fireteam_ids[0]).strip_edges().to_lower()


func get_network_mission_interaction_feedback_snapshot() -> Dictionary:
	var snapshot: Dictionary = _network_mission_interaction_feedback.duplicate(true)
	snapshot["progress_update_count"] = _network_mission_interaction_progress_update_count
	snapshot["progress_fingerprint"] = _network_mission_interaction_progress_fingerprint
	return snapshot


func _apply_network_mission_interaction_progress_surface(snapshot: Dictionary) -> bool:
	var states: Dictionary = Dictionary(snapshot.get("interaction_states", {}))
	if states.is_empty():
		return false
	var preferred_id: String = String(_network_mission_interaction_feedback.get("interaction_id", "")).strip_edges()
	var interaction_id: String = ""
	var ids: Array = states.keys()
	ids.sort()
	if states.has(preferred_id):
		var preferred_state: Dictionary = Dictionary(states.get(preferred_id, {}))
		var preferred_state_name: String = String(preferred_state.get("state", "")).strip_edges().to_lower()
		if not bool(preferred_state.get("complete", false)) and (float(preferred_state.get("hold_seconds", 0.0)) > 0.0 or ["active", "holding", "operating", "in_progress"].has(preferred_state_name)):
			interaction_id = preferred_id
	for id_variant in ids if interaction_id.is_empty() else []:
		var candidate: Dictionary = Dictionary(states.get(id_variant, {}))
		var candidate_state: String = String(candidate.get("state", "")).strip_edges().to_lower()
		if not bool(candidate.get("complete", false)) and (float(candidate.get("hold_seconds", 0.0)) > 0.0 or ["active", "holding", "operating", "in_progress"].has(candidate_state)):
			interaction_id = String(id_variant)
			break
	if interaction_id.is_empty() and states.has(preferred_id):
		interaction_id = preferred_id
	if interaction_id.is_empty():
		for id_variant in ids:
			if bool(Dictionary(states.get(id_variant, {})).get("complete", false)):
				interaction_id = String(id_variant)
				break
	if interaction_id.is_empty():
		return false
	var state: Dictionary = Dictionary(states.get(interaction_id, {}))
	var progress: float = clampf(float(state.get("progress", 0.0)), 0.0, 1.0)
	var hold_seconds: float = maxf(float(state.get("hold_seconds", 0.0)), 0.0)
	var duration_seconds: float = maxf(float(state.get("duration_seconds", 0.0)), 0.0)
	var complete: bool = bool(state.get("complete", false))
	var source_tick: int = maxi(int(snapshot.get("source_tick", -1)), -1)
	var interaction_type: String = String(state.get("interaction_type", "")).strip_edges().to_lower()
	var owner_fireteam_id: String = String(state.get("fireteam_id", "")).strip_edges().to_lower()
	var owner_fireteam_token: String = _network_interaction_owner_token(owner_fireteam_id)
	var display_token: String = _build_network_mission_interaction_display_token(interaction_id, interaction_type)
	var parallel_owner_entries: Array = _build_parallel_network_interaction_owner_entries(states, interaction_id)
	var parallel_signature_parts: PackedStringArray = PackedStringArray()
	for entry_variant in parallel_owner_entries.slice(0, 2):
		var entry: Dictionary = Dictionary(entry_variant)
		parallel_signature_parts.append("%s:%s:%s:%d:%d:%d" % [String(entry.get("interaction_id", "")), String(entry.get("display_token", "")), String(entry.get("fireteam_id", "")), int(round(float(entry.get("progress", 0.0)) * 100.0)), int(floor(float(entry.get("hold_seconds", 0.0)))), int(ceil(float(entry.get("duration_seconds", 0.0))))])
	var fingerprint: String = "%s|%s|%s|%s|%d|%d|%d|%s|%s" % [interaction_id, display_token, interaction_type, owner_fireteam_id, int(round(progress * 100.0)), int(floor(hold_seconds)), int(ceil(duration_seconds)), str(complete), ";".join(parallel_signature_parts)]
	if fingerprint == _network_mission_interaction_progress_fingerprint:
		if source_tick >= 0:
			_network_mission_interaction_feedback["source_tick"] = source_tick
		return false
	_network_mission_interaction_progress_fingerprint = fingerprint
	_network_mission_interaction_progress_update_count += 1
	var compact_line: String
	if parallel_owner_entries.size() > 1:
		var owner_parts: PackedStringArray = PackedStringArray()
		for entry_variant in parallel_owner_entries.slice(0, 2):
			var entry: Dictionary = Dictionary(entry_variant)
			owner_parts.append("%s %d%% %s" % [String(entry.get("display_token", "ACTION")), int(round(float(entry.get("progress", 0.0)) * 100.0)), String(entry.get("fireteam_token", "FT?"))])
		compact_line = " | ".join(owner_parts)
	elif complete:
		compact_line = "%s FERTIG%s" % [display_token, " " + owner_fireteam_token if not owner_fireteam_token.is_empty() else ""]
	elif interaction_type == "hold_zone":
		compact_line = "%s HALTEN | %d/%ds%s" % [display_token, int(floor(hold_seconds)), int(ceil(duration_seconds)), " " + owner_fireteam_token if not owner_fireteam_token.is_empty() else ""]
	else:
		compact_line = "%s %d%% | %d/%ds%s" % [display_token, int(round(progress * 100.0)), int(floor(hold_seconds)), int(ceil(duration_seconds)), " " + owner_fireteam_token if not owner_fireteam_token.is_empty() else ""]
	if compact_line.length() > 72:
		compact_line = compact_line.substr(0, 69).strip_edges() + "..."
	_network_mission_interaction_feedback = {
		"status": "complete" if complete else "in_progress",
		"interaction_id": interaction_id,
		"display_token": display_token,
		"fireteam_id": owner_fireteam_id,
		"owner_fireteam_id": owner_fireteam_id,
		"parallel_owner_count": parallel_owner_entries.size(),
		"parallel_owner_entries": parallel_owner_entries.slice(0, 2),
		"compact_line": compact_line,
		"progress": progress,
		"hold_seconds": hold_seconds,
		"source_tick": source_tick,
		"duration_seconds": duration_seconds,
		"tone": "success" if complete else "progress",
		"read_only": true,
		"ui_sets_gameplay_truth": false,
	}
	_last_command_text = compact_line
	_refresh_network_interaction_command_feedback_label(compact_line, String(_network_mission_interaction_feedback.get("tone", "progress")))
	return true


func _build_parallel_network_interaction_owner_entries(states: Dictionary, preferred_id: String) -> Array:
	var active_ids: Array = []
	for id_variant in states.keys():
		var candidate: Dictionary = Dictionary(states.get(id_variant, {}))
		var state_name: String = String(candidate.get("state", "")).strip_edges().to_lower()
		if not bool(candidate.get("complete", false)) and (float(candidate.get("hold_seconds", 0.0)) > 0.0 or ["active", "holding", "operating", "in_progress"].has(state_name)):
			active_ids.append(String(id_variant))
	active_ids.sort()
	if active_ids.has(preferred_id):
		active_ids.erase(preferred_id)
		active_ids.push_front(preferred_id)
	var entries: Array = []
	for interaction_id_variant in active_ids:
		var interaction_id: String = String(interaction_id_variant)
		var state: Dictionary = Dictionary(states.get(interaction_id, {}))
		var fireteam_id: String = String(state.get("fireteam_id", "")).strip_edges().to_lower()
		entries.append({
			"interaction_id": interaction_id,
			"display_token": _build_network_mission_interaction_display_token(interaction_id, String(state.get("interaction_type", ""))),
			"fireteam_id": fireteam_id,
			"fireteam_token": _network_interaction_owner_token(fireteam_id) if not fireteam_id.is_empty() else "FT?",
			"progress": clampf(float(state.get("progress", 0.0)), 0.0, 1.0),
			"hold_seconds": maxf(float(state.get("hold_seconds", 0.0)), 0.0),
			"duration_seconds": maxf(float(state.get("duration_seconds", 0.0)), 0.0),
			"read_only": true,
		})
	return entries


func _network_interaction_owner_token(fireteam_id: String) -> String:
	return fireteam_id.strip_edges().to_upper()


func _refresh_network_interaction_command_feedback_label(compact_line: String, tone: String = "progress") -> void:
	var label := get_node_or_null(command_feedback_label_path) as Label
	if label == null:
		return
	var lines: PackedStringArray = label.text.split("\n")
	var replaced: bool = false
	for index in range(lines.size()):
		if lines[index].begins_with("LAST "):
			lines[index] = "LAST %s" % compact_line
			replaced = true
			break
	if not replaced:
		lines.append("LAST %s" % compact_line)
	_set_mission_label_text_delta(label, "\n".join(lines))
	var style_key: String = _build_network_mission_interaction_tone_style_key(tone)
	var tone_color: Color = TACTICAL_UI_THEME_SCRIPT.call("status_color", style_key)
	label.add_theme_color_override("font_color", tone_color)
	label.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.9))
	label.add_theme_constant_override("outline_size", 2)
	label.set_meta("network_interaction_tone", tone.strip_edges().to_lower())
	label.set_meta("network_interaction_style_key", style_key)
	label.set_meta("network_interaction_font_color", tone_color.to_html(true))


func _build_network_mission_interaction_tone_style_key(tone: String) -> String:
	match tone.strip_edges().to_lower():
		"pending":
			return "warning"
		"progress":
			return "accent"
		"success", "complete":
			return "success"
		"blocked", "danger":
			return "danger"
	return "neutral"


func _try_submit_connected_client_mission_interaction() -> Dictionary:
	var simulation_root := get_node_or_null("../SimulationRoot")
	var multiplayer_api: MultiplayerAPI = multiplayer
	var peer: MultiplayerPeer = multiplayer_api.multiplayer_peer if multiplayer_api != null else null
	if simulation_root == null or simulation_root.get("is_server_authoritative") != true or peer == null or peer is OfflineMultiplayerPeer or peer.get_connection_status() == MultiplayerPeer.CONNECTION_DISCONNECTED or multiplayer_api.is_server():
		return {"handled": false, "accepted": false}
	var intent: Dictionary = get_mission_interaction_use_intent_snapshot()
	if not bool(intent.get("accepted", false)) or not bool(intent.get("requires_go", false)):
		return {"handled": false, "accepted": false}
	if _network_mission_interaction_request_pending:
		_last_command_text = String(_network_mission_interaction_feedback.get("compact_line", "HOST PENDING"))
		_update_ui()
		return {"handled": true, "accepted": false}
	var fireteam_id: String = String(intent.get("fireteam_id", "")).strip_edges().to_lower()
	var units: Array = _get_fireteam_units(fireteam_id, true)
	var unit_id: String = ""
	for unit in units:
		if unit != null and unit.has_method("get_unit_id"):
			unit_id = String(unit.call("get_unit_id")).strip_edges()
			if not unit_id.is_empty():
				break
	var command: Dictionary = build_mission_interaction_multiplayer_network_command(intent, unit_id, get_local_command_team_id(), intent.get("target_position", null))
	if command.is_empty():
		_last_command_text = "INTERACTION NETWORK BLOCKED"
		_update_ui()
		return {"handled": true, "accepted": false}
	_network_mission_interaction_request_pending = true
	var display_token: String = _build_network_mission_interaction_display_token(String(intent.get("interaction_id", "")), String(intent.get("interaction_type", "")))
	var pending_line: String = "%s -> HOST" % display_token
	_network_mission_interaction_feedback = {
		"status": "pending",
		"interaction_id": String(intent.get("interaction_id", "")),
		"fireteam_id": fireteam_id,
		"display_token": display_token,
		"compact_line": pending_line,
		"detail_line": "Warte auf Host-Bestaetigung.",
		"tone": "pending",
		"read_only": true,
		"ui_sets_gameplay_truth": false,
	}
	_replace_next_orders_for_fireteams(PackedStringArray([fireteam_id]), int(intent.get("phase", _get_live_order_phase_index())))
	simulation_root.rpc_id(1, "request_command", command)
	_last_command_text = pending_line
	_refresh_order_visuals()
	_update_ui()
	return {"handled": true, "accepted": true}


func _apply_network_mission_interaction_result(result: Dictionary) -> void:
	_network_mission_interaction_request_pending = false
	var accepted: bool = bool(result.get("accepted", false))
	var interaction_id: String = String(result.get("interaction_id", "")).strip_edges()
	var reason: String = String(result.get("reason", "")).strip_edges()
	var fireteam_id: String = String(result.get("fireteam_id", _network_mission_interaction_feedback.get("fireteam_id", ""))).strip_edges().to_lower()
	var fireteam_token: String = _network_interaction_owner_token(fireteam_id)
	var display_token: String = String(_network_mission_interaction_feedback.get("display_token", "")).strip_edges().to_upper()
	if display_token.is_empty():
		display_token = _build_network_mission_interaction_display_token(interaction_id, "")
	var reason_label: String = _build_network_mission_interaction_reason_label(reason)
	var subject: String = "%s %s" % [display_token, fireteam_token] if not fireteam_token.is_empty() else display_token
	var line: String = "%s HOST OK | LAEUFT" % subject if accepted else "%s BLOCKIERT | %s" % [subject, reason_label]
	_network_mission_interaction_feedback = {
		"status": "accepted" if accepted else "blocked",
		"accepted": accepted,
		"interaction_id": interaction_id,
		"fireteam_id": fireteam_id,
		"reason": reason,
		"reason_label": reason_label,
		"display_token": display_token,
		"compact_line": line,
		"detail_line": "Host hat den Befehl angenommen." if accepted else "Host lehnt den Befehl ab: %s." % reason_label,
		"tone": "success" if accepted else "blocked",
		"read_only": true,
		"ui_sets_gameplay_truth": false,
	}
	_last_command_text = line
	_update_ui()


func _build_network_mission_interaction_display_token(interaction_id: String, interaction_type: String) -> String:
	var normalized_id: String = interaction_id.strip_edges().to_lower()
	if normalized_id.contains("aa_") or normalized_id.contains("air_defense"):
		return "AA"
	if normalized_id.contains("cargo"):
		return "CARGO"
	if normalized_id.contains("computer") or interaction_type.strip_edges().to_lower() == "computer":
		return "COM"
	if normalized_id.contains("door") or interaction_type.strip_edges().to_lower() == "door":
		return "DOOR"
	return "ACTION"


func _build_network_mission_interaction_reason_label(reason: String) -> String:
	var normalized_reason: String = reason.strip_edges().to_lower()
	match normalized_reason:
		"peer_team_mismatch", "unit_team_mismatch":
			return "FALSCHES TEAM"
		"fireteam_not_assigned_to_peer":
			return "FIRETEAM NICHT ZUGEWIESEN"
		"interaction_reserved_by_other_fireteam":
			return "ANDERES FIRETEAM AKTIV"
		"spectator_cannot_command":
			return "ZUSCHAUER KANN NICHT BEFEHLEN"
		"request_on_non_authority", "host_required":
			return "HOST ERFORDERLICH"
		"command_not_whitelisted":
			return "BEFEHL NICHT ERLAUBT"
	if normalized_reason.begins_with("state_mutation_key:"):
		return "UNGUELTIGE DATEN"
	if normalized_reason.is_empty():
		return "UNBEKANNT"
	return normalized_reason.replace("_", " ").to_upper()


