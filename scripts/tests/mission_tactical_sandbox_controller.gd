func _get_tactical_stance_effect_tooltip(stance_id: String) -> String:
	match stance_id.strip_edges().to_lower():
		"cautious":
			return "Vorsichtig: langsameres Tempo, Waffen im Anschlag, mehr Sicht."
		"aggressive":
