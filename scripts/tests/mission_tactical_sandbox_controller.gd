			scope_started_usec = Time.get_ticks_usec()
		strategic_status_raw = _build_strategic_status_text()
		strategic_status_label.set_meta("mission_hud_raw_status_text", strategic_status_raw)
		_set_mission_label_text_delta(strategic_status_label, strategic_status_raw)
		if profile_enabled:
			scopes_usec["secondary_strategic_text_usec"] = Time.get_ticks_usec() - scope_started_usec
			scope_started_usec = Time.get_ticks_usec()
		strategic_status_label.tooltip_text = _build_mission_combat_hud_detail_tooltip_text()
		var strategic_decision_tooltip: String = _build_selected_fireteam_live_decision_detail_tooltip()
		if not strategic_decision_tooltip.is_empty():
			strategic_status_label.tooltip_text = "%s\n\n%s" % [strategic_status_label.tooltip_text, strategic_decision_tooltip] if not strategic_status_label.tooltip_text.is_empty() else strategic_decision_tooltip
		var mission_state_tooltip: String = String(_mission_control_state_snapshot.get("tooltip_text", "")).strip_edges()
		if not mission_state_tooltip.is_empty():
			strategic_status_label.tooltip_text = "%s\n\n%s" % [strategic_status_label.tooltip_text, mission_state_tooltip] if not strategic_status_label.tooltip_text.is_empty() else mission_state_tooltip
		_apply_combat_hud_detail_tooltip_label_contract(strategic_status_label)
		_apply_mission_control_1280_readability()
		if profile_enabled:
			scopes_usec["secondary_tooltip_usec"] = Time.get_ticks_usec() - scope_started_usec
			scope_started_usec = Time.get_ticks_usec()
		_apply_frontier_probe_one_screen_visual_polish_label_contract(strategic_status_label)
		_apply_mission_control_1280_readability()
		if profile_enabled:
			scopes_usec["secondary_frontier_contract_usec"] = Time.get_ticks_usec() - scope_started_usec
			scope_started_usec = Time.get_ticks_usec()
		_apply_order_preview_threat_overlay_label_contract(strategic_status_label)
		if profile_enabled:
			scopes_usec["secondary_preview_contract_usec"] = Time.get_ticks_usec() - scope_started_usec
			scope_started_usec = Time.get_ticks_usec()
		_apply_decision_overlay_f6_visual_polish_label_contract(strategic_status_label)
		if profile_enabled:
			scopes_usec["secondary_decision_contract_usec"] = Time.get_ticks_usec() - scope_started_usec
			scope_started_usec = Time.get_ticks_usec()
		_apply_release_firefight_bottom_dock_density_label_contract(strategic_status_label)
		if profile_enabled:
			scopes_usec["secondary_density_contract_usec"] = Time.get_ticks_usec() - scope_started_usec
			scope_started_usec = Time.get_ticks_usec()
	elif strategic_status_label != null:
		_increment_mission_hud_runtime_surface_guard_count(_mission_hud_runtime_surface_guard_skip_counts, "strategic_status")
		if profile_enabled:
			scopes_usec["secondary_strategic_text_usec"] = 0
			scopes_usec["secondary_tooltip_usec"] = 0
			scopes_usec["secondary_frontier_contract_usec"] = 0
			scopes_usec["secondary_preview_contract_usec"] = 0
			scopes_usec["secondary_decision_contract_usec"] = 0
			scopes_usec["secondary_density_contract_usec"] = 0
	# Rendering consumes the already assembled RAW owner readouts. Legacy
	# acceptance adapters must not rebuild other panels while drawing buttons.
	var matrix_started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
	_apply_release_firefight_command_matrix_visual_polish(fireteam_status_raw, strategic_status_raw)
	if profile_enabled:
		scopes_usec["command_matrix_usec"] = Time.get_ticks_usec() - matrix_started_usec
		scopes_usec["runtime_surfaces_usec"] = int(scopes_usec.get("runtime_surfaces_usec", 0)) + int(scopes_usec["command_matrix_usec"])
		scope_started_usec = Time.get_ticks_usec()
	_apply_release_first_exchange_real_window_hud_source_sync_to_labels()
	if profile_enabled:
		scopes_usec["secondary_release_sync_usec"] = Time.get_ticks_usec() - scope_started_usec
		scope_started_usec = Time.get_ticks_usec()

	var phase_status_label := get_node_or_null("../TacticalUI/BottomDock/BottomMargin/BottomRow/StrategicPanel/StrategicMargin/StrategicScroll/StrategicVBox/PhaseControlPanel/PhaseControlMargin/PhaseControlVBox/PhaseStatusLabel") as Label
	if phase_status_label != null:
		_set_mission_label_text_delta(phase_status_label, _build_phase_status_text())

	var phase_list_label := get_node_or_null("../TacticalUI/BottomDock/BottomMargin/BottomRow/StrategicPanel/StrategicMargin/StrategicScroll/StrategicVBox/PhaseControlPanel/PhaseControlMargin/PhaseControlVBox/PhaseListLabel") as Label
	if phase_list_label != null:
		_set_mission_label_text_delta(phase_list_label, _build_phase_list_text())
	if profile_enabled:
		scopes_usec["secondary_phase_labels_usec"] = Time.get_ticks_usec() - scope_started_usec
		scope_started_usec = Time.get_ticks_usec()

	var set_lz_button := get_node_or_null("../TacticalUI/BottomDock/BottomMargin/BottomRow/StrategicPanel/StrategicMargin/StrategicScroll/StrategicVBox/StrategicActionRow/SetLZButton") as Button
	if set_lz_button != null:
		set_lz_button.text = "Click Map..." if _is_lz_placement_armed else "Set LZ"

	var target_button := get_node_or_null("../TacticalUI/BottomDock/BottomMargin/BottomRow/CommandPanel/CommandMargin/CommandScroll/CommandVBox/CommandGrid/TargetButton") as Button
	if target_button != null and not _native_a5_owns_primary_command_presentation(target_button):
		target_button.text = "ST" if _is_target_placement_armed else "ZL"

	var call_dropship_button := get_node_or_null("../TacticalUI/BottomDock/BottomMargin/BottomRow/StrategicPanel/StrategicMargin/StrategicScroll/StrategicVBox/StrategicActionRow/CallDropshipButton") as Button
	if call_dropship_button != null:
		if not preview_mode and _drop_ship_cooldown_remaining > 0.0 and not _is_drop_sequence_active():
			call_dropship_button.text = "Cooldown %ds" % int(ceil(_drop_ship_cooldown_remaining))
		else:
			match _drop_sequence_phase:
				DROP_SEQUENCE_INBOUND:
					call_dropship_button.text = "Inbound"
				DROP_SEQUENCE_LANDED:
					call_dropship_button.text = "Landed"
				DROP_SEQUENCE_UNLOADING:
					call_dropship_button.text = "Deboarding"
				DROP_SEQUENCE_OUTBOUND:
					call_dropship_button.text = "Outbound"
				DROP_SEQUENCE_COMPLETE:
					call_dropship_button.text = "Drop Complete"
				_:
					call_dropship_button.text = "Drop"

	_apply_compact_mission_control_layout()
	if profile_enabled:
		scopes_usec["secondary_buttons_layout_usec"] = Time.get_ticks_usec() - scope_started_usec
		scopes_usec["secondary_labels_usec"] = Time.get_ticks_usec() - scope_started_usec
		var secondary_total_usec: int = 0
		for scope_name_variant in scopes_usec.keys():
			var scope_name: String = String(scope_name_variant)
			if scope_name.begins_with("secondary_") and scope_name != "secondary_labels_usec":
				secondary_total_usec += int(scopes_usec.get(scope_name, 0))
		scopes_usec["secondary_labels_usec"] = secondary_total_usec
		_record_mission_ui_refresh_timing_snapshot(refresh_started_usec, scopes_usec)
	if projection_read_model != null:
		projection_read_model.call("end_projection_pass")


func _refresh_tactical_event_log_panel() -> Dictionary:
	var panel := get_node_or_null(TACTICAL_EVENT_LOG_PANEL_PATH) as Control
	if panel == null or not panel.has_method("set_feedback_snapshot"):
		return {}
	var feedback_snapshot: Dictionary = get_live_tactical_event_log_feedback_snapshot()
	panel.call("set_feedback_snapshot", feedback_snapshot)
	return feedback_snapshot


func _refresh_runtime_mission_hud_surfaces(force_refresh: bool = true) -> void:
	_refresh_runtime_mission_hud_surfaces_for_phase(force_refresh, "")


func _refresh_runtime_mission_hud_surfaces_for_phase(force_refresh: bool, phase_key: String) -> void:
	var profile_enabled: bool = _mission_visible_frame_timing_debug_enabled
	var refresh_started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
	var scopes_usec: Dictionary = {}
	var scope_started_usec: int = 0
	if profile_enabled:
		scope_started_usec = Time.get_ticks_usec()
	if phase_key.is_empty() or phase_key == "craft":
		var craft_controls_signature: String = _build_periodic_craft_controls_signature()
		if force_refresh or craft_controls_signature != _last_periodic_craft_controls_signature:
			_last_periodic_craft_controls_signature = craft_controls_signature
			_increment_mission_hud_runtime_surface_guard_count(_mission_hud_runtime_surface_guard_apply_counts, "craft_controls")
			var craft_summary_started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
			_refresh_mission_control_craft_summary()
			if profile_enabled:
				scopes_usec["craft_summary_usec"] = Time.get_ticks_usec() - craft_summary_started_usec
			var craft_evacuation_started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
			_refresh_mission_evacuation_button()
			if profile_enabled:
				scopes_usec["craft_evacuation_usec"] = Time.get_ticks_usec() - craft_evacuation_started_usec
			var craft_button_styles_started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
			_refresh_dynamic_button_styles()
			if profile_enabled:
				scopes_usec["craft_button_styles_usec"] = Time.get_ticks_usec() - craft_button_styles_started_usec
			var craft_button_labels_started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
			_apply_drop_light_hud_button_labels()
			if profile_enabled:
				scopes_usec["craft_button_labels_usec"] = Time.get_ticks_usec() - craft_button_labels_started_usec
			var craft_hierarchy_started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
			_apply_command_hierarchy_metadata()
			if profile_enabled:
				scopes_usec["craft_hierarchy_usec"] = Time.get_ticks_usec() - craft_hierarchy_started_usec
			var craft_layout_started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
			_enforce_drop_light_fixed_hud_layout()
			if profile_enabled:
				scopes_usec["craft_layout_usec"] = Time.get_ticks_usec() - craft_layout_started_usec
		else:
			_increment_mission_hud_runtime_surface_guard_count(_mission_hud_runtime_surface_guard_skip_counts, "craft_controls")
		if profile_enabled:
			scopes_usec["craft_controls_usec"] = Time.get_ticks_usec() - scope_started_usec
			scope_started_usec = Time.get_ticks_usec()
	if phase_key.is_empty() or phase_key == "world_status":
		_refresh_world_overlays()
		if profile_enabled:
			scopes_usec["world_overlays_usec"] = Time.get_ticks_usec() - scope_started_usec
			scope_started_usec = Time.get_ticks_usec()
		_sync_primary_3d_mission_status_visuals()
		_suppress_legacy_2d_readability_overlays(true)
		if profile_enabled:
			scopes_usec["primary_status_usec"] = Time.get_ticks_usec() - scope_started_usec
			scope_started_usec = Time.get_ticks_usec()
	if phase_key.is_empty() or phase_key == "cards":
		var fireteam_cards_signature: String = _build_periodic_fireteam_cards_signature()
		if force_refresh or fireteam_cards_signature != _last_periodic_fireteam_cards_signature:
			_last_periodic_fireteam_cards_signature = fireteam_cards_signature
			_increment_mission_hud_runtime_surface_guard_count(_mission_hud_runtime_surface_guard_apply_counts, "fireteam_card_group")
			var cards_part_started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
			_refresh_ad_hoc_panel_visibility()
			if profile_enabled:
				scopes_usec["ad_hoc_panel_usec"] = Time.get_ticks_usec() - cards_part_started_usec
				cards_part_started_usec = Time.get_ticks_usec()
			var selected_card_row := get_node_or_null(FIRETEAM_SELECTED_CARDS_ROW_PATH) as Control
			var hidden_a5_member_cards: bool = bool(get_meta("native_a5_legacy_setup_complete", false)) and selected_card_row != null and not selected_card_row.is_visible_in_tree()
			# A5 presents identities in mini cards. Explicit diagnostics still call
			# the existing selected-card builder directly when its hidden data is needed.
			if not hidden_a5_member_cards:
				_refresh_selected_fireteam_cards()
			if profile_enabled:
				scopes_usec["selected_member_cards_usec"] = Time.get_ticks_usec() - cards_part_started_usec
				cards_part_started_usec = Time.get_ticks_usec()
			_refresh_fireteam_mini_cards()
			if profile_enabled:
				scopes_usec["fireteam_mini_cards_usec"] = Time.get_ticks_usec() - cards_part_started_usec
				cards_part_started_usec = Time.get_ticks_usec()
			if _character_overlay_open:
				_update_character_overlay()
			if profile_enabled:
				scopes_usec["character_overlay_usec"] = Time.get_ticks_usec() - cards_part_started_usec
		else:
			_increment_mission_hud_runtime_surface_guard_count(_mission_hud_runtime_surface_guard_skip_counts, "fireteam_card_group")
		if profile_enabled:
			scopes_usec["fireteam_cards_usec"] = Time.get_ticks_usec() - scope_started_usec
			scope_started_usec = Time.get_ticks_usec()
	if not _tactical_ui_visible:
		set_tactical_ui_visible(false)
	if profile_enabled:
		scopes_usec["visibility_usec"] = Time.get_ticks_usec() - scope_started_usec
		_record_mission_runtime_surface_timing_snapshot(refresh_started_usec, scopes_usec)

	if profile_enabled:
		_mission_runtime_surface_timing_debug_snapshot["engine_frame"] = Engine.get_process_frames()
		_mission_runtime_surface_timing_debug_snapshot["timing_owner"] = "controller_synchronous_update_ui" if phase_key.is_empty() else "UpdateManager.refresh_hud"
		_mission_runtime_surface_timing_debug_snapshot["periodic_phase_key"] = phase_key


func _ensure_ad_hoc_panel() -> Control:
	var existing_panel := get_node_or_null("../TacticalUI/BottomDock/BottomMargin/BottomRow/CommandPanel/AdHocOrderPanel") as PanelContainer
