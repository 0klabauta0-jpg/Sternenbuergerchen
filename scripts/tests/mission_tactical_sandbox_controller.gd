func _get_release_first_exchange_fire_visual_event_dicts() -> Array:
	var fire_events: Array = get_fire_event_snapshot()
	var status_source: Dictionary = _get_release_first_exchange_visible_status_source_evidence()
	if not bool(status_source.get("active", false)):
		return _select_connected_first_contact_fire_visual_events(fire_events, _selected_fireteam_ids, _is_connected_multiplayer_hud_session())
	var persisted_fire_event: Dictionary = Dictionary(status_source.get("fire_event", {})).duplicate(true)
	if persisted_fire_event.is_empty():
		return _select_connected_first_contact_fire_visual_events(fire_events, _selected_fireteam_ids, _is_connected_multiplayer_hud_session())
	var persisted_event_id: String = String(persisted_fire_event.get("event_id", "")).strip_edges()
	if persisted_event_id.is_empty():
		return _select_connected_first_contact_fire_visual_events(fire_events, _selected_fireteam_ids, _is_connected_multiplayer_hud_session())
	for event_variant in fire_events:
		var event: Dictionary = Dictionary(event_variant)
		if String(event.get("event_id", "")).strip_edges() == persisted_event_id:
			return _select_connected_first_contact_fire_visual_events(fire_events, _selected_fireteam_ids, _is_connected_multiplayer_hud_session())
	persisted_fire_event["presentation_history_only"] = true
	fire_events.append(persisted_fire_event)
	return _select_connected_first_contact_fire_visual_events(fire_events, _selected_fireteam_ids, _is_connected_multiplayer_hud_session())


func _select_connected_first_contact_fire_visual_events(fire_events: Array, selected_fireteam_ids: PackedStringArray, connected_session: bool) -> Array:
	var sanitized_events: Array = []
	for event_variant in fire_events:
		if typeof(event_variant) == TYPE_DICTIONARY:
			sanitized_events.append(Dictionary(event_variant).duplicate(true))
	if not connected_session or selected_fireteam_ids.is_empty():
		return sanitized_events
	var selected_lookup: Dictionary = {}
	for fireteam_id_variant in selected_fireteam_ids:
		selected_lookup[String(fireteam_id_variant).strip_edges().to_lower()] = true
	var latest_by_fireteam: Dictionary = {}
	for event_variant in sanitized_events:
		var event: Dictionary = Dictionary(event_variant)
		var fireteam_id: String = String(event.get("attacker_fireteam_id", event.get("fireteam_id", ""))).strip_edges().to_lower()
		if not selected_lookup.has(fireteam_id):
			continue
		var existing: Dictionary = Dictionary(latest_by_fireteam.get(fireteam_id, {}))
		var event_time: int = int(event.get("created_msec", event.get("tick", 0)))
		var existing_time: int = int(existing.get("created_msec", existing.get("tick", -1)))
		if existing.is_empty() or event_time >= existing_time:
			var selected_event: Dictionary = event.duplicate(true)
			selected_event["suppress_world_status_label"] = true
			latest_by_fireteam[fireteam_id] = selected_event
	var result: Array = []
	for fireteam_id_variant in selected_fireteam_ids:
		var fireteam_id: String = String(fireteam_id_variant).strip_edges().to_lower()
		if latest_by_fireteam.has(fireteam_id):
			result.append(Dictionary(latest_by_fireteam[fireteam_id]).duplicate(true))
	return result


func _build_release_fire_exchange_visibility_compact_line(diagnostics: Dictionary, cover_readout: Dictionary, fire_event: Dictionary) -> String:
	var attacker_id: String = String(fire_event.get("attacker_unit_id", diagnostics.get("attacker_unit_id", ""))).strip_edges()
	var target_id: String = String(fire_event.get("target_unit_id", diagnostics.get("target_unit_id", diagnostics.get("actual_target_id", "")))).strip_edges()
	var pair_text: String = "%s>%s" % [_compact_unit_id_for_diagnostics(attacker_id), _compact_unit_id_for_diagnostics(target_id)]
	var weapon_id: String = String(fire_event.get("weapon_id", diagnostics.get("weapon_id", ""))).strip_edges().to_upper()
	var outcome: String = String(fire_event.get("combat_outcome", diagnostics.get("combat_outcome", ""))).strip_edges().to_upper()
	var bits: PackedStringArray = PackedStringArray(["FIRE", pair_text])
	if not weapon_id.is_empty():
		bits.append(weapon_id)
	if not outcome.is_empty():
		bits.append(outcome)
	return "%s | %s" % [" ".join(bits), _build_mission_combat_cover_token_text(cover_readout)]


func _find_unit_world_position_for_release_fire_visual(unit_id: String) -> Variant:
	var normalized_unit_id: String = unit_id.strip_edges()
	if normalized_unit_id.is_empty():
		return null
	var units: Array = []
	units.append_array(_get_all_friendly_units(true))
	units.append_array(_get_all_enemy_units(true))
	for unit in units:
		if unit == null or not (unit is Node2D):
			continue
		if unit.has_method("get_unit_id") and String(unit.call("get_unit_id")).strip_edges() == normalized_unit_id:
			return (unit as Node2D).global_position
	return null


func record_release_fire_exchange_visibility_evidence(source_snapshot: Dictionary) -> Dictionary:
	if String(source_snapshot.get("schema", "")) != "sternenbuergerchen.release_first_exchange_tension_tuning.v1":
		return {}
	if not bool(source_snapshot.get("first_exchange_visible", false)):
		return {}
	var diagnostics: Dictionary = Dictionary(source_snapshot.get("contact_decision_diagnostics", get_contact_decision_diagnostics_snapshot())).duplicate(true)
	diagnostics["status"] = "fired"
	diagnostics["reason"] = "fired"
	var fire_event_id: String = String(source_snapshot.get("first_fire_event_id", diagnostics.get("fire_event_id", ""))).strip_edges()
	var fire_event: Dictionary = {
		"event_id": fire_event_id,
		"attacker_unit_id": String(diagnostics.get("attacker_unit_id", "")),
		"target_unit_id": String(diagnostics.get("target_unit_id", diagnostics.get("actual_target_id", ""))),
		"weapon_id": String(diagnostics.get("weapon_id", "")),
		"combat_outcome": String(diagnostics.get("combat_outcome", "fired")),
	}
	var attacker_position_variant: Variant = _find_unit_world_position_for_release_fire_visual(String(fire_event.get("attacker_unit_id", "")))
	var target_position_variant: Variant = _find_unit_world_position_for_release_fire_visual(String(fire_event.get("target_unit_id", "")))
	if typeof(attacker_position_variant) == TYPE_VECTOR2:
		fire_event["attacker_position"] = attacker_position_variant
	if typeof(target_position_variant) == TYPE_VECTOR2:
		fire_event["target_position"] = target_position_variant
	var cover_readout: Dictionary = get_cover_effectiveness_readout_snapshot()
	var compact_line: String = _build_release_fire_exchange_visibility_compact_line(diagnostics, cover_readout, fire_event)
	var detail_snapshot: Dictionary = _build_mission_combat_hud_detail_tooltip_snapshot_from_data(diagnostics, cover_readout, fire_event, compact_line)
	_release_fire_exchange_visibility_last_seed_event_id = fire_event_id
	_release_fire_exchange_visibility_persistence_evidence = _build_release_fire_exchange_visibility_evidence(
		diagnostics,
		cover_readout,
		fire_event,
		compact_line,
		detail_snapshot,
		_release_fire_exchange_visibility_clock_msec()
	)
	return _release_fire_exchange_visibility_persistence_evidence.duplicate(true)


