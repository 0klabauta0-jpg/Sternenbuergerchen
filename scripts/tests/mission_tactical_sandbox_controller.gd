		route_readout,
		objective_gate,
		use_feedback,
		progress_readability
	)).duplicate(true)


func _station_route_token_for_kind(entries: Array, object_kind: String) -> String:
	var normalized_kind: String = object_kind.strip_edges().to_lower()
	var prefix: String = _station_route_prefix_for_kind(normalized_kind)
	for entry_variant in entries:
		if typeof(entry_variant) != TYPE_DICTIONARY:
			continue
		var entry: Dictionary = Dictionary(entry_variant)
		if String(entry.get("object_kind", "")).strip_edges().to_lower() != normalized_kind:
			continue
		return "%s %s" % [prefix, _station_route_state_token(normalized_kind, entry)]
	return "%s -" % prefix


func _station_route_prefix_for_kind(object_kind: String) -> String:
	match object_kind:
		"computer":
			return "COM"
		_:
			return object_kind.strip_edges().to_upper()


func _station_route_state_token(object_kind: String, entry: Dictionary) -> String:
	var reaction_state: String = String(entry.get("reaction_state", "")).strip_edges().to_lower()
	var runtime_visual_state: String = String(entry.get("runtime_visual_state", "")).strip_edges().to_lower()
	var is_next: bool = bool(entry.get("is_next", false))
	match object_kind:
		"door":
			if runtime_visual_state == "open" or reaction_state == "open":
				return "OPEN"
			if runtime_visual_state == "half" or reaction_state == "active":
				return "OPENING"
			if ["locked", "blocked"].has(reaction_state):
				return "LOCK"
			if reaction_state == "ready" or is_next:
				return "READY"
			return "CLOSED"
		"computer":
			if runtime_visual_state == "controlled" or reaction_state == "controlled":
				return "CTRL"
			if runtime_visual_state == "active" or reaction_state == "active":
				return "LINK"
			if ["locked", "blocked"].has(reaction_state):
				return "BLOCK"
			if reaction_state == "ready" or is_next:
				return "READY"
			return "WAIT"
		"cargo":
			if reaction_state == "departed":
				return "DEPARTED"
			if reaction_state == "active":
				return "HOLD"
			if ["locked", "blocked"].has(reaction_state):
				return "BLOCK"
			if reaction_state == "ready" or is_next:
				return "READY"
			return "WAIT"
		"aa":
			if reaction_state == "disabled":
				return "OK"
			if reaction_state == "active":
				return "ACTIVE"
			if ["locked", "blocked"].has(reaction_state):
				return "BLOCK"
			if reaction_state == "ready" or is_next:
				return "READY"
			return "WAIT"
		_:
			if reaction_state.is_empty():
				return "WAIT"
			return reaction_state.to_upper()


func _station_route_next_token(gate_snapshot: Dictionary) -> String:
	if bool(gate_snapshot.get("all_gates_complete", false)):
		return "DONE"
	var step_id: String = String(gate_snapshot.get("next_step_id", "")).strip_edges().to_lower()
	match step_id:
		"disable_air_defense":
			return "AA"
		"open_station_door":
			return "DOOR"
		"occupy_station_computer":
			return "COM"
		"cargo_touchdown_extract":
			return "CARGO"
		_:
			if step_id.contains("door"):
				return "DOOR"
			if step_id.contains("computer"):
				return "COM"
			if step_id.contains("cargo"):
				return "CARGO"
			if step_id.contains("air") or step_id.contains("aa"):
				return "AA"
			return "WAIT"


func _build_host_client_f6_compact_act_line(interaction_density: Dictionary, fallback_line: String) -> String:
	var compact_parts: PackedStringArray = PackedStringArray()
	var objective_token: String = _compact_host_client_f6_objective_token(String(interaction_density.get("objective_line", "")))
	var cargo_token: String = _compact_host_client_f6_cargo_token(String(interaction_density.get("cargo_line", "")))
	var fire_rule_text: String = String(interaction_density.get("fire_rule_consequence_token", interaction_density.get("fire_rule_text", ""))).strip_edges().to_upper()
	var combat_source: String = String(interaction_density.get("combat_line", "")).strip_edges()
	if combat_source.is_empty():
		combat_source = String(interaction_density.get("contact_line", "")).strip_edges()
	var combat_token: String = _compact_host_client_f6_combat_token(combat_source)
	for token in [objective_token, cargo_token]:
		if not token.is_empty():
			compact_parts.append(token)
	if not fire_rule_text.is_empty():
		compact_parts.append("ROE %s" % fire_rule_text)
	if not combat_token.is_empty():
		compact_parts.append(combat_token)
	if compact_parts.is_empty():
		return fallback_line.strip_edges()
	return "ACT %s" % " | ".join(compact_parts)


func _compact_host_client_f6_objective_token(objective_line: String) -> String:
	var line: String = objective_line.strip_edges()
	if line.is_empty():
		return ""
	var percent_token: String = _first_percent_token(line)
	if not percent_token.is_empty():
		return "OBJ %s" % percent_token
	return "OBJ"


func _compact_host_client_f6_cargo_token(cargo_line: String) -> String:
	var line: String = cargo_line.strip_edges()
	if line.is_empty():
		return ""
	var upper_line: String = line.to_upper()
	for state in ["READY", "BLOCKED", "LANDED", "INBOUND", "DEPARTING", "DEPARTED"]:
		if upper_line.contains(state):
			return "CARGO %s" % state
	return "CARGO"


func _compact_host_client_f6_combat_token(combat_line: String) -> String:
	var line: String = combat_line.strip_edges()
	if line.is_empty():
		return ""
	var upper_line: String = line.to_upper()
	var tokens: PackedStringArray = PackedStringArray()
	for state in ["NO FIRE", "FIRE", "WAIT", "CONTACT"]:
		if upper_line.contains(state):
			tokens.append(state)
			break
	for token in ["SUP", "COV OPEN", "COV PART", "COV FULL", "LOS CLR", "LOS BLK"]:
		if upper_line.contains(token):
			tokens.append(token)
	return " ".join(tokens) if not tokens.is_empty() else "CONTACT"


func _first_percent_token(text: String) -> String:
	for raw_token in text.split(" "):
		var token: String = String(raw_token).strip_edges()
		if token.ends_with("%"):
			return token
	return ""


func _join_unique_nonempty_lines(lines: Array) -> String:
	var result: PackedStringArray = PackedStringArray()
	var seen: Dictionary = {}
	for line_variant in lines:
		var raw_line: String = String(line_variant).strip_edges()
		if raw_line.is_empty():
			continue
		for raw_subline in raw_line.split("\n"):
			var subline: String = String(raw_subline).strip_edges()
			if subline.is_empty() or seen.has(subline):
				continue
			seen[subline] = true
			result.append(subline)
	return "\n".join(result)


func _count_nonempty_status_lines(text: String) -> int:
	var count: int = 0
	for raw_line in text.split("\n"):
		if not String(raw_line).strip_edges().is_empty():
			count += 1
	return count


func _count_substring_occurrences(text: String, needle: String) -> int:
	if needle.is_empty():
		return 0
	var count: int = 0
	var offset: int = 0
	while true:
		var found_at: int = text.find(needle, offset)
		if found_at < 0:
			break
		count += 1
		offset = found_at + needle.length()
	return count


func _compact_fire_rule_for_hud(fire_rule: String) -> String:
	match fire_rule.strip_edges().to_lower():
		TACTICAL_COMMAND_RULES_SCRIPT.FIRE_RULE_HOLD:
			return "HF"
		TACTICAL_COMMAND_RULES_SCRIPT.FIRE_RULE_RETURN:
			return "RF"
		TACTICAL_COMMAND_RULES_SCRIPT.FIRE_RULE_FREE:
			return "FW"
		TACTICAL_COMMAND_RULES_SCRIPT.FIRE_RULE_SUPPRESS:
			return "SUP"
		"mixed":
			return "MIX"
		_:
			return ""


func _build_mission_cargo_extract_line() -> String:
	var cargo_snapshot: Dictionary = _get_mission_cargo_touchdown_snapshot_for_readability()
	if cargo_snapshot.is_empty() or not bool(cargo_snapshot.get("configured", false)):
		return ""
	var cargo_state: String = String(cargo_snapshot.get("cargo_state", cargo_snapshot.get("state", ""))).strip_edges().to_lower()
	if cargo_state.is_empty() or cargo_state == "unconfigured":
		return ""
	var gate_snapshot: Dictionary = _get_mission_scenario_runtime_gate_snapshot_for_readability()
	var cargo_gate: Dictionary = _find_runtime_gate_by_objective_type(Array(gate_snapshot.get("gates", [])), "cargo_touchdown_extract")
	var gate_status: String = _compact_runtime_gate_status(String(cargo_gate.get("status", "")))
	if bool(cargo_snapshot.get("blocked", false)):
		var blocker: String = String(cargo_snapshot.get("blocked_by_step_id", "")).strip_edges()
		return "CARGO BLOCKED %s" % (blocker if not blocker.is_empty() else gate_status)
	var hold_seconds: int = int(round(float(cargo_snapshot.get("hold_seconds", 0.0))))
	var required_seconds: int = int(round(float(cargo_snapshot.get("required_hold_seconds", cargo_gate.get("hold_required_seconds", 0.0)))))
	var progress_percent: int = int(round(clampf(float(cargo_snapshot.get("progress", 0.0)), 0.0, 1.0) * 100.0))
	match cargo_state:
		"inbound":
			return "CARGO INBOUND %d%%" % progress_percent
		"landed":
			if bool(cargo_snapshot.get("ready_to_depart", false)):
				return "CARGO READY %d/%ds" % [mini(hold_seconds, required_seconds), required_seconds]
			return "CARGO HOLD %d/%ds" % [mini(hold_seconds, required_seconds), required_seconds]
		"departing":
			return "CARGO DEPARTING %d%%" % progress_percent
		"departed":
			return "CARGO DEPARTED %s" % gate_status
		_:
			return "CARGO %s %s" % [cargo_state.to_upper(), gate_status]


func _build_mission_objective_interaction_line() -> String:
	var objective_state: Dictionary = _build_mission_objective_state_snapshot()
	var gate_snapshot: Dictionary = _get_mission_scenario_runtime_gate_snapshot_for_readability()
	var gate_entries: Array = Array(gate_snapshot.get("gates", []))
	if objective_state.is_empty() and gate_entries.is_empty():
		return ""

	var parts: PackedStringArray = PackedStringArray()
	var aa_gate: Dictionary = _find_runtime_gate_by_objective_type(gate_entries, "air_defense_shutdown")
	if not aa_gate.is_empty():
		parts.append("AA %s" % _compact_runtime_gate_status(String(aa_gate.get("status", ""))))

	var computer_gate: Dictionary = _find_runtime_gate_by_objective_type(gate_entries, "computer_hold")
	if not computer_gate.is_empty():
		var computer_status: String = _compact_runtime_gate_status(String(computer_gate.get("status", "")))
		var elapsed_seconds: int = int(round(float(computer_gate.get("hold_elapsed_seconds", 0.0))))
		var required_seconds: int = int(round(float(computer_gate.get("hold_required_seconds", 0.0))))
		if required_seconds > 0:
			parts.append("COM %s %d/%ds" % [computer_status, mini(elapsed_seconds, required_seconds), required_seconds])
		else:
			parts.append("COM %s" % computer_status)

	if not objective_state.is_empty():
		var owner_text: String = String(objective_state.get("owning_team_id", "")).strip_edges()
		if owner_text.is_empty():
			owner_text = "neutral"
		var progress_percent: int = int(round(clampf(float(objective_state.get("capture_progress", 0.0)), 0.0, 1.0) * 100.0))
		parts.append("OBJ %s %d%%" % [owner_text, progress_percent])

	if parts.is_empty():
		return ""
	return " | ".join(parts)


func _compact_runtime_gate_status(status: String) -> String:
	match status.strip_edges().to_lower():
		"complete":
			return "OK"
		"active":
			return "ACTIVE"
		"blocked":
			return "BLOCKED"
		"pending":
			return "PENDING"
		_:
			return "UNKNOWN"


func _build_mission_control_contact_diagnostics_text() -> String:
	var diagnostics: Dictionary = get_contact_decision_diagnostics_snapshot()
	if diagnostics.is_empty():
		return ""
	var reason: String = String(diagnostics.get("reason", "")).strip_edges().to_lower()
	var attacker_id: String = String(diagnostics.get("attacker_unit_id", "")).strip_edges()
	var target_id: String = String(diagnostics.get("target_unit_id", "")).strip_edges()
	var pair_text: String = "%s->%s" % [_compact_unit_id_for_diagnostics(attacker_id), _compact_unit_id_for_diagnostics(target_id)]
	var los_text: String = String(diagnostics.get("los_state", "")).strip_edges()
	var range_text: String = String(diagnostics.get("range_state", "")).strip_edges()
	var contact_state: String = String(diagnostics.get("contact_state", "")).strip_edges()
	var fire_rule_token: String = " SUP" if bool(diagnostics.get("suppress_intent_active", false)) else ""
	if reason == "fired":
		var fire_text: String = "CONTACT FIRE%s" % fire_rule_token
		return "%s %s | %s | LOS %s | RNG %s" % [fire_text, pair_text, contact_state.to_upper(), los_text.to_upper(), range_text.to_upper()]
	if reason == "cooldown":
		return "CONTACT WAIT%s %st | %s | LOS %s | RNG %s" % [fire_rule_token, int(diagnostics.get("cooldown_ticks_remaining", 0)), pair_text, los_text.to_upper(), range_text.to_upper()]
	if reason == "no_contact_pair":
		var candidate: Dictionary = Dictionary(diagnostics.get("candidate", {}))
		var candidate_reason: String = String(candidate.get("candidate_reason", reason)).strip_edges()
		return "NO FIRE %s | F%d/E%d | DET %d" % [
			candidate_reason.to_upper(),
			int(diagnostics.get("active_friendly_count", 0)),
			int(diagnostics.get("active_enemy_count", 0)),
			int(diagnostics.get("detection_pending_count", 0)),
		]
	if reason == "no_damage_effect" or reason == "invalid_contact_pair":
		return "NO FIRE %s | %s | LOS %s | RNG %s" % [reason.to_upper(), pair_text, los_text.to_upper(), range_text.to_upper()]
	return "CONTACT %s | F%d/E%d" % [
		reason.to_upper(),
		int(diagnostics.get("active_friendly_count", 0)),
		int(diagnostics.get("active_enemy_count", 0)),
	]


func _compact_unit_id_for_diagnostics(unit_id: String) -> String:
	var normalized: String = unit_id.strip_edges()
	if normalized.is_empty():
		return "?"
	if normalized.length() <= 10:
		return normalized
	return normalized.substr(0, 10)


func _build_mission_combat_hud_density_snapshot() -> Dictionary:
	if _mission_hud_read_model != null:
		return Dictionary(_mission_hud_read_model.call("project", "combat_density", Callable(self, "_build_mission_combat_hud_density_snapshot_uncached")))
	return _build_mission_combat_hud_density_snapshot_uncached()


func _build_mission_combat_hud_density_snapshot_uncached() -> Dictionary:
	_note_hud_projection_build_call("_build_mission_combat_hud_density_snapshot")
	var diagnostics: Dictionary = get_contact_decision_diagnostics_snapshot()
	var cover_readout: Dictionary = get_cover_effectiveness_readout_snapshot()
	var fire_events: Array = get_fire_event_snapshot()
	var first_fire_event: Dictionary = _find_first_relevant_fire_event_for_fireteams(Array(_selected_fireteam_ids), fire_events, diagnostics)
	var compact_line: String = _build_mission_combat_hud_compact_line(diagnostics, cover_readout, first_fire_event)
	var connected_perspective: Dictionary = get_connected_first_contact_hud_perspective_snapshot()
	if not connected_perspective.is_empty():
		compact_line = String(connected_perspective.get("primary_line", compact_line)).strip_edges()
	var detail_snapshot: Dictionary = _build_mission_combat_hud_detail_tooltip_snapshot_from_data(diagnostics, cover_readout, first_fire_event, compact_line)
	var visibility_persistence: Dictionary = _update_release_fire_exchange_visibility_persistence(
		diagnostics,
		cover_readout,
		first_fire_event,
		compact_line,
		detail_snapshot
	)
	if bool(visibility_persistence.get("active", false)):
		compact_line = String(visibility_persistence.get("compact_line", compact_line)).strip_edges()
		detail_snapshot = Dictionary(visibility_persistence.get("detail_tooltip", detail_snapshot)).duplicate(true)
	else:
		var first_exchange_status_source: Dictionary = _get_release_first_exchange_visible_status_source_evidence()
		if bool(first_exchange_status_source.get("active", false)):
			visibility_persistence = first_exchange_status_source
			compact_line = String(first_exchange_status_source.get("compact_line", compact_line)).strip_edges()
			detail_snapshot = Dictionary(first_exchange_status_source.get("detail_tooltip", detail_snapshot)).duplicate(true)
	if not connected_perspective.is_empty():
		compact_line = String(connected_perspective.get("primary_line", compact_line)).strip_edges()
	var selected_line: String = compact_line if not connected_perspective.is_empty() else ("Kampf %s" % compact_line if not compact_line.is_empty() else "")
	var line_limit: int = 96
	var snapshot: Dictionary = {
		"active": not compact_line.is_empty(),
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"source": "contact_decision_cover_fireevent_snapshot",
		"compact_line": compact_line,
		"mission_control_line": compact_line,
		"selected_fireteam_line": selected_line,
		"line_count": 1 if not compact_line.is_empty() else 0,
		"max_line_length": compact_line.length(),
		"line_char_limit": line_limit,
		"line_within_limit": compact_line.length() <= line_limit,
		"status": String(diagnostics.get("status", "")).strip_edges().to_lower(),
		"reason": String(diagnostics.get("reason", "")).strip_edges().to_lower(),
		"fire_event_id": String(first_fire_event.get("event_id", diagnostics.get("fire_event_id", ""))).strip_edges(),
		"cover_text": _build_mission_combat_cover_token_text(cover_readout),
		"contact_decision_diagnostics": diagnostics.duplicate(true),
		"detail_tooltip": detail_snapshot,
		"tooltip_text": String(detail_snapshot.get("tooltip_text", "")),
		"contains_fire_state": _combat_hud_line_contains_any(compact_line, ["FIRE", "WAIT", "NO FIRE", "CONTACT"]),
		"contains_cover_context": compact_line.contains("COV"),
		"contains_los_context": compact_line.contains("LOS"),
		"contains_range_context": compact_line.contains("RNG"),
		"visibility_persistence": visibility_persistence,
		"visibility_persistence_active": bool(visibility_persistence.get("active", false)),
		"connected_first_contact_perspective": connected_perspective,
	}
	if bool(visibility_persistence.get("active", false)):
		snapshot["source"] = "contact_decision_cover_fireevent_snapshot_visibility_persistence"
		snapshot["status"] = "fired"
		snapshot["reason"] = "fired"
		snapshot["fire_event_id"] = String(visibility_persistence.get("fire_event_id", snapshot.get("fire_event_id", ""))).strip_edges()
		snapshot["release_fire_exchange_visibility_persistence_style_id"] = RELEASE_FIRE_EXCHANGE_VISIBILITY_PERSISTENCE_STYLE_ID
		snapshot["release_first_exchange_visible_status_source_active"] = String(visibility_persistence.get("task_id", "")) == "TASK_876"
		snapshot["release_first_exchange_visible_status_source_style_id"] = String(visibility_persistence.get("style_id", ""))
		snapshot["line_within_limit"] = compact_line.length() <= line_limit
	return snapshot


func _update_release_fire_exchange_visibility_persistence(
	diagnostics: Dictionary,
	cover_readout: Dictionary,
	fire_event: Dictionary,
	compact_line: String,
	detail_snapshot: Dictionary
) -> Dictionary:
	var now_msec: int = _release_fire_exchange_visibility_clock_msec()
	var reason: String = String(diagnostics.get("reason", "")).strip_edges().to_lower()
	var status: String = String(diagnostics.get("status", "")).strip_edges().to_lower()
	var event_id: String = String(fire_event.get("event_id", diagnostics.get("fire_event_id", ""))).strip_edges()
	var has_current_fire_line: bool = compact_line.strip_edges().to_upper().begins_with("FIRE")
	var has_fire_evidence: bool = reason == "fired" or status == "fired" or has_current_fire_line or not event_id.is_empty()
	if has_fire_evidence:
		var previous_event_id: String = String(_release_fire_exchange_visibility_persistence_evidence.get("fire_event_id", "")).strip_edges()
		var previous_expires_msec: int = int(_release_fire_exchange_visibility_persistence_evidence.get("expires_msec", 0))
		var new_event_id: bool = not event_id.is_empty() and event_id != _release_fire_exchange_visibility_last_seed_event_id
		var should_seed: bool = has_current_fire_line or reason == "fired" or status == "fired" or new_event_id or (event_id == previous_event_id and now_msec <= previous_expires_msec)
		if should_seed:
			var persisted_compact_line: String = compact_line.strip_edges()
			if not persisted_compact_line.to_upper().begins_with("FIRE"):
				persisted_compact_line = _build_release_fire_exchange_visibility_compact_line(diagnostics, cover_readout, fire_event)
			if not persisted_compact_line.is_empty():
				if not event_id.is_empty():
					_release_fire_exchange_visibility_last_seed_event_id = event_id
				_release_fire_exchange_visibility_persistence_evidence = _build_release_fire_exchange_visibility_evidence(
					diagnostics,
					cover_readout,
					fire_event,
					persisted_compact_line,
					detail_snapshot,
					now_msec
				)
	if not _release_fire_exchange_visibility_persistence_evidence.is_empty():
		var evidence_expires_msec: int = int(_release_fire_exchange_visibility_persistence_evidence.get("expires_msec", 0))
		if now_msec <= evidence_expires_msec:
			var active_evidence: Dictionary = _release_fire_exchange_visibility_persistence_evidence.duplicate(true)
			active_evidence["active"] = true
			active_evidence["remaining_msec"] = maxi(evidence_expires_msec - now_msec, 0)
			return active_evidence
	_release_fire_exchange_visibility_persistence_evidence = {}
	return {
		"active": false,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"creates_command": false,
		"creates_fire_event": false,
		"creates_damage_event": false,
		"sets_multiplayer_truth": false,
		"style_id": RELEASE_FIRE_EXCHANGE_VISIBILITY_PERSISTENCE_STYLE_ID,
	}


func _build_release_fire_exchange_visibility_evidence(
	diagnostics: Dictionary,
	cover_readout: Dictionary,
	fire_event: Dictionary,
	compact_line: String,
	detail_snapshot: Dictionary,
	now_msec: int
) -> Dictionary:
	var event_id: String = String(fire_event.get("event_id", diagnostics.get("fire_event_id", ""))).strip_edges()
	var tooltip: Dictionary = detail_snapshot.duplicate(true)
	var tooltip_text: String = String(tooltip.get("tooltip_text", "")).strip_edges()
	var persistence_detail: PackedStringArray = PackedStringArray()
	persistence_detail.append("Fire-Exchange sichtbar gehalten")
	if not event_id.is_empty():
		persistence_detail.append("Event %s" % event_id)
	if not tooltip_text.is_empty():
		persistence_detail.append(tooltip_text)
	tooltip["tooltip_text"] = " | ".join(persistence_detail)
	tooltip["style_id"] = RELEASE_FIRE_EXCHANGE_VISIBILITY_PERSISTENCE_STYLE_ID
	return {
		"active": true,
		"schema": "sternenbuergerchen.release_fire_exchange_visibility_persistence.evidence.v1",
