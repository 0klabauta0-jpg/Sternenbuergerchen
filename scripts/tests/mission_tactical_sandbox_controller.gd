func _merge_non_empty_rects(rects: Array) -> Rect2:
	var merged := Rect2()
	var has_rect: bool = false
	for rect_variant in rects:
		var rect: Rect2 = rect_variant
		if rect.size == Vector2.ZERO:
			continue
		if not has_rect:
			merged = rect
			has_rect = true
		else:
			merged = merged.merge(rect)
	return merged


func _snapshot_check_passed(snapshot: Dictionary, check_id: String) -> bool:
	for check_variant in Array(snapshot.get("checks", [])):
		var check: Dictionary = Dictionary(check_variant)
		if String(check.get("id", "")) == check_id:
			return bool(check.get("passed", false))
	return false


func _load_frontier_probe_scenario_snapshot() -> Dictionary:
	var scenario_path: String = "res://data/mission_scenarios/frontier_probe_vertical_slice.json"
	if not FileAccess.file_exists(scenario_path):
		return {}
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(scenario_path))
	if typeof(parsed) != TYPE_DICTIONARY:
		return {}
	return Dictionary(parsed).duplicate(true)


func _find_team_slot_in_slice(slice: Dictionary, team_id: String) -> Dictionary:
	var normalized_team_id: String = team_id.strip_edges()
	for slot_variant in Array(slice.get("team_slots", [])):
		var slot: Dictionary = Dictionary(slot_variant)
		if String(slot.get("team_id", "")).strip_edges() == normalized_team_id:
			return slot.duplicate(true)
	return {}


func _find_scenario_enemy_group(scenario: Dictionary, group_id: String) -> Dictionary:
	var normalized_group_id: String = group_id.strip_edges()
	for group_variant in Array(scenario.get("enemy_groups", [])):
		var group: Dictionary = Dictionary(group_variant)
		if String(group.get("group_id", "")).strip_edges() == normalized_group_id:
			return group.duplicate(true)
	return {}


func _variant_string_array_has(value: Variant, expected_value: String) -> bool:
	var normalized_expected: String = expected_value.strip_edges()
	for entry_variant in Array(value):
		if String(entry_variant).strip_edges() == normalized_expected:
			return true
	return false


func _build_mission_objective_state_snapshot() -> Dictionary:
	var simulation_root := get_node_or_null("../SimulationRoot")
	if simulation_root == null or not simulation_root.has_method("get_objective_status"):
		return {}
	var objective_status = simulation_root.call("get_objective_status")
	if objective_status == null:
		return {}
	var result: Dictionary = {}
	if objective_status.has_method("to_dict"):
		result = Dictionary(objective_status.call("to_dict")).duplicate(true)
	else:
		result = {
			"objective_id": String(objective_status.objective_id),
			"position": objective_status.position,
			"capture_radius": float(objective_status.capture_radius),
			"owning_team_id": String(objective_status.owning_team_id),
			"capture_progress": float(objective_status.capture_progress),
			"capturing_team_id": String(objective_status.capturing_team_id),
			"contested": bool(objective_status.call("is_contested")) if objective_status.has_method("is_contested") else false,
		}
	result["available"] = true
	result["capture_progress"] = clampf(float(result.get("capture_progress", 0.0)), 0.0, 1.0)
	result["capture_radius"] = maxf(float(result.get("capture_radius", 0.0)), 0.0)
	return result


