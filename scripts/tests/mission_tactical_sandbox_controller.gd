		_ad_hoc_resume_state_by_fireteam.clear()
		_area_defense_execution_by_fireteam.clear()
		_area_attack_execution_by_fireteam.clear()
		_active_coordination_by_id.clear()
		_initialize_fireteam_suppression_state()
