func _apply_fireteam_mini_overlay_style() -> void:
	var panel := get_node_or_null(FIRETEAM_MINI_PANEL_PATH) as PanelContainer
	if panel == null:
		return
	panel.add_theme_stylebox_override("panel", StyleBoxEmpty.new())
	panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	panel.clip_contents = false
	panel.z_as_relative = false
	panel.z_index = FIRETEAM_MINI_PANEL_Z_INDEX
	panel.set_meta("mission_fireteam_mini_backgroundless", true)
	panel.set_meta("mission_fireteam_mini_panel_z_index", FIRETEAM_MINI_PANEL_Z_INDEX)
	panel.set_meta("station_route_hud_visual_polish_task", "TASK_722")
	panel.set_meta("station_route_hud_map_safe_margin_enabled", true)
	var event_log_panel := get_node_or_null(TACTICAL_EVENT_LOG_PANEL_PATH) as Control
	if event_log_panel != null:
		event_log_panel.z_as_relative = false
		event_log_panel.z_index = TACTICAL_EVENT_LOG_Z_INDEX
	for path in [
		"../TacticalUI/FireteamMiniPanel/MiniMargin",
		"../TacticalUI/FireteamMiniPanel/MiniMargin/MiniVBox",
		"../TacticalUI/FireteamMiniPanel/MiniMargin/MiniVBox/MiniCardsScroll",
		"../TacticalUI/FireteamMiniPanel/MiniMargin/MiniVBox/MiniCardsScroll/MiniCardsVBox",
	]:
		var passive_control := get_node_or_null(path) as Control
		if passive_control != null:
			passive_control.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_apply_left_tactical_stack_1280_air_anchor_polish()


func _apply_left_tactical_stack_1280_air_anchor_polish() -> void:
	var mini_panel := get_node_or_null(FIRETEAM_MINI_PANEL_PATH) as Control
	var event_log_panel := get_node_or_null(TACTICAL_EVENT_LOG_PANEL_PATH) as Control
	if mini_panel != null and bool(mini_panel.get_meta("native_a5_layout", false)):
		return
	var card_host := get_node_or_null(FIRETEAM_MINI_CARDS_VBOX_PATH) as VBoxContainer
	if card_host != null:
		card_host.add_theme_constant_override("separation", LEFT_TACTICAL_STACK_1280_MIN_CARD_SEPARATION)
		card_host.set_meta("left_tactical_stack_1280_air_anchor_style_id", LEFT_TACTICAL_STACK_1280_AIR_ANCHOR_STYLE_ID)
		card_host.set_meta("left_tactical_stack_1280_card_separation_px", LEFT_TACTICAL_STACK_1280_MIN_CARD_SEPARATION)
		card_host.set_meta("left_tactical_stack_1280_ui_sets_gameplay_truth", false)
	if mini_panel == null or event_log_panel == null:
		return
	var shared_left: float = maxf(mini_panel.position.x, LEFT_TACTICAL_STACK_1280_MIN_LEFT_ANCHOR)
	var mini_position := Vector2(shared_left, mini_panel.position.y)
	var event_position := Vector2(shared_left, maxf(event_log_panel.position.y, mini_panel.position.y + mini_panel.size.y + LEFT_TACTICAL_STACK_1280_MIN_EVENT_GAP))
	mini_panel.position = mini_position
	event_log_panel.position = event_position
	mini_panel.set_deferred("position", mini_position)
	event_log_panel.set_deferred("position", event_position)
	for panel_variant in [mini_panel, event_log_panel]:
		var panel := panel_variant as Control
		panel.set_meta("left_tactical_stack_1280_air_anchor_style_id", LEFT_TACTICAL_STACK_1280_AIR_ANCHOR_STYLE_ID)
		panel.set_meta("left_tactical_stack_1280_air_anchor_applied", true)
		panel.set_meta("left_tactical_stack_1280_left_anchor_px", shared_left)
		panel.set_meta("left_tactical_stack_1280_ui_sets_gameplay_truth", false)
	event_log_panel.set_meta("left_tactical_stack_1280_event_gap_px", event_log_panel.position.y - (mini_panel.position.y + mini_panel.size.y))
	mini_panel.set_meta("left_tactical_stack_1280_event_gap_px", event_log_panel.position.y - (mini_panel.position.y + mini_panel.size.y))


func get_station_route_hud_visual_polish_snapshot() -> Dictionary:
	var layout: Dictionary = DROP_LIGHT_LAYOUT_CONTRACT_SCRIPT.call("get_mission_hud_layout")
	var viewport_rect: Rect2i = layout.get("viewport", Rect2i())
	var mini_rect: Rect2i = layout.get("fireteam_mini", Rect2i())
	var event_rect: Rect2i = layout.get("event_log", Rect2i())
	var top_nav_rect: Rect2i = layout.get("top_nav", Rect2i())
	var mini_panel := get_node_or_null(FIRETEAM_MINI_PANEL_PATH) as Control
	var mini_scroll := get_node_or_null("../TacticalUI/FireteamMiniPanel/MiniMargin/MiniVBox/MiniCardsScroll") as ScrollContainer
	var timer_label := get_node_or_null("../TacticalUI/TopNavPanel/NavMargin/NavRow/MissionTimerLabel") as Label
	var primary_3d_view = _get_primary_3d_view()
	var render_snapshot: Dictionary = {}
	if primary_3d_view != null and primary_3d_view.has_method("get_render_snapshot"):
		render_snapshot = Dictionary(primary_3d_view.call("get_render_snapshot"))
	var prior_fireteam_area: float = 280.0 * 360.0
	var fireteam_area: float = float(mini_rect.size.x * mini_rect.size.y)
	var map_safe_margin_enabled: bool = (
		mini_rect.size.x <= 240
		and mini_rect.size.y <= 312
		and fireteam_area <= prior_fireteam_area * 0.75
		and mini_panel != null
		and bool(mini_panel.get_meta("station_route_hud_map_safe_margin_enabled", false))
	)
	var station_label_readable: bool = (
		int(render_snapshot.get("mission_interaction_visual_state_label_font_size", 0)) >= 18
		and float(render_snapshot.get("mission_interaction_visual_state_label_pixel_size", 0.0)) >= 0.024
		and int(render_snapshot.get("mission_interaction_visual_state_label_outline_size", 0)) >= 8
		and not String(render_snapshot.get("mission_interaction_visual_state_label_backplate_style_id", "")).strip_edges().is_empty()
	)
	var route_labels_uncrowded: bool = (
		float(render_snapshot.get("route_callout_label_pixel_size", 0.0)) >= 0.023
		and int(render_snapshot.get("route_callout_label_outline_size", 0)) >= 7
		and not String(render_snapshot.get("route_callout_label_backplate_style_id", "")).strip_edges().is_empty()
	)
	var nav_placeholder_removed: bool = timer_label == null or bool(timer_label.get_meta("station_route_nav_placeholder_removed", false))
	var checks: Array = [
		_build_mission_first_move_readability_check("fireteam_cards_map_safe_margin", map_safe_margin_enabled, "Left Fireteam cards use the smaller TASK_722 map-safe contract."),
		_build_mission_first_move_readability_check("fireteam_mini_scroll_preserved", mini_scroll != null and mini_scroll.vertical_scroll_mode != ScrollContainer.SCROLL_MODE_DISABLED, "Compact Fireteam mini panel keeps scrolling for more teams."),
		_build_mission_first_move_readability_check("station_labels_readable", station_label_readable, "Station interaction labels have larger text, outline and backplate metadata."),
		_build_mission_first_move_readability_check("route_labels_uncrowded", route_labels_uncrowded, "Route/Door callouts expose backplate and high-contrast label metadata."),
		_build_mission_first_move_readability_check("nav_placeholder_removed", nav_placeholder_removed, "Top nav timer hides empty placeholder state instead of showing filler."),
	]
	var failed_checks: Array = []
	for check_variant in checks:
		var check: Dictionary = Dictionary(check_variant)
		if not bool(check.get("passed", false)):
			failed_checks.append(String(check.get("id", "")))
	return {
		"schema": "sternenbuergerchen.station_route_hud_visual_polish.v1",
		"task_id": "TASK_722",
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"viewport_rect": _rect_to_audit_dictionary(Rect2(viewport_rect.position, viewport_rect.size)),
		"fireteam_mini_rect": _rect_to_audit_dictionary(Rect2(mini_rect.position, mini_rect.size)),
		"event_log_rect": _rect_to_audit_dictionary(Rect2(event_rect.position, event_rect.size)),
		"top_nav_rect": _rect_to_audit_dictionary(Rect2(top_nav_rect.position, top_nav_rect.size)),
		"fireteam_mini_area_ratio_vs_task627": fireteam_area / prior_fireteam_area,
		"fireteam_mini_map_safe_margin_enabled": map_safe_margin_enabled,
		"fireteam_mini_scroll_preserved": mini_scroll != null and mini_scroll.vertical_scroll_mode != ScrollContainer.SCROLL_MODE_DISABLED,
		"station_label_readable": station_label_readable,
		"route_labels_uncrowded": route_labels_uncrowded,
		"nav_placeholder_removed": nav_placeholder_removed,
		"mission_interaction_visual_state_label_font_size": int(render_snapshot.get("mission_interaction_visual_state_label_font_size", 0)),
		"mission_interaction_visual_state_label_pixel_size": float(render_snapshot.get("mission_interaction_visual_state_label_pixel_size", 0.0)),
		"mission_interaction_visual_state_label_outline_size": int(render_snapshot.get("mission_interaction_visual_state_label_outline_size", 0)),
		"mission_interaction_visual_state_label_backplate_style_id": String(render_snapshot.get("mission_interaction_visual_state_label_backplate_style_id", "")),
		"route_callout_label_backplate_style_id": String(render_snapshot.get("route_callout_label_backplate_style_id", "")),
		"checks": checks,
		"failed_checks": failed_checks,
		"gate": "ready_for_recapture" if failed_checks.is_empty() else "review",
	}


func get_station_route_recapture_visual_followup_snapshot() -> Dictionary:
	var layout: Dictionary = DROP_LIGHT_LAYOUT_CONTRACT_SCRIPT.call("get_mission_hud_layout")
	var viewport_rect: Rect2i = layout.get("viewport", Rect2i())
	var mini_rect: Rect2i = layout.get("fireteam_mini", Rect2i())
	var event_rect: Rect2i = layout.get("event_log", Rect2i())
	var top_nav_rect: Rect2i = layout.get("top_nav", Rect2i())
	var primary_3d_view = _get_primary_3d_view()
	var render_snapshot: Dictionary = {}
	if primary_3d_view != null and primary_3d_view.has_method("get_render_snapshot"):
		render_snapshot = Dictionary(primary_3d_view.call("get_render_snapshot"))
	var prior_task722_top_nav_width: int = 480
	var prior_task722_fireteam_height: int = 288
	var top_nav_tighter: bool = top_nav_rect.size.x <= 384 and top_nav_rect.size.y <= 56
	var fireteam_mini_tighter: bool = mini_rect.size.x <= 240 and mini_rect.size.y <= 248
	var eventlog_tracks_mini: bool = event_rect.position.y >= mini_rect.end.y + 16 and event_rect.size.x == mini_rect.size.x
	var station_labels_more_spaced: bool = (
		int(render_snapshot.get("mission_interaction_visual_state_label_font_size", 0)) >= 19
		and float(render_snapshot.get("mission_interaction_visual_state_label_pixel_size", 0.0)) >= 0.026
		and float(render_snapshot.get("mission_interaction_visual_state_label_height_step", 0.0)) >= 0.26
	)
	var route_labels_more_spaced: bool = (
		int(render_snapshot.get("route_callout_label_font_size", 0)) >= 19
		and float(render_snapshot.get("route_callout_label_pixel_size", 0.0)) >= 0.025
		and int(render_snapshot.get("route_callout_label_outline_size", 0)) >= 8
		and float(render_snapshot.get("route_callout_label_height_step", 0.0)) >= 0.26
	)
	var checks: Array = [
		_build_mission_first_move_readability_check("top_nav_tighter", top_nav_tighter, "Top navigation is narrower than the TASK_723 recapture bar while staying on the fixed HUD grid."),
		_build_mission_first_move_readability_check("fireteam_mini_tighter", fireteam_mini_tighter, "Left Fireteam mini panel keeps less map covered."),
		_build_mission_first_move_readability_check("eventlog_tracks_mini", eventlog_tracks_mini, "Event log remains below the tighter Fireteam mini panel."),
		_build_mission_first_move_readability_check("station_labels_more_spaced", station_labels_more_spaced, "Station labels gain size and vertical spacing for the next recapture."),
		_build_mission_first_move_readability_check("route_labels_more_spaced", route_labels_more_spaced, "Route labels gain size, outline and spacing for the next recapture."),
	]
	var failed_checks: Array = []
	for check_variant in checks:
		var check: Dictionary = Dictionary(check_variant)
		if not bool(check.get("passed", false)):
			failed_checks.append(String(check.get("id", "")))
	return {
		"schema": "sternenbuergerchen.station_route_recapture_visual_followup.v1",
		"task_id": "TASK_724",
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"viewport_rect": _rect_to_audit_dictionary(Rect2(viewport_rect.position, viewport_rect.size)),
		"fireteam_mini_rect": _rect_to_audit_dictionary(Rect2(mini_rect.position, mini_rect.size)),
		"event_log_rect": _rect_to_audit_dictionary(Rect2(event_rect.position, event_rect.size)),
		"top_nav_rect": _rect_to_audit_dictionary(Rect2(top_nav_rect.position, top_nav_rect.size)),
		"top_nav_width_delta_vs_task722": top_nav_rect.size.x - prior_task722_top_nav_width,
		"fireteam_mini_height_delta_vs_task722": mini_rect.size.y - prior_task722_fireteam_height,
		"top_nav_tighter": top_nav_tighter,
		"fireteam_mini_tighter": fireteam_mini_tighter,
		"eventlog_tracks_mini": eventlog_tracks_mini,
		"station_labels_more_spaced": station_labels_more_spaced,
		"route_labels_more_spaced": route_labels_more_spaced,
		"mission_interaction_visual_state_label_font_size": int(render_snapshot.get("mission_interaction_visual_state_label_font_size", 0)),
		"mission_interaction_visual_state_label_pixel_size": float(render_snapshot.get("mission_interaction_visual_state_label_pixel_size", 0.0)),
		"mission_interaction_visual_state_label_height_step": float(render_snapshot.get("mission_interaction_visual_state_label_height_step", 0.0)),
		"route_callout_label_font_size": int(render_snapshot.get("route_callout_label_font_size", 0)),
		"route_callout_label_pixel_size": float(render_snapshot.get("route_callout_label_pixel_size", 0.0)),
		"route_callout_label_outline_size": int(render_snapshot.get("route_callout_label_outline_size", 0)),
		"route_callout_label_height_step": float(render_snapshot.get("route_callout_label_height_step", 0.0)),
		"checks": checks,
		"failed_checks": failed_checks,
		"gate": "ready_for_recapture" if failed_checks.is_empty() else "review",
		"recommended_next_task": "TASK_725 - Station Route Host/Client Recapture Acceptance Review",
	}


