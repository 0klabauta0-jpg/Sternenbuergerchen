func _build_selected_fireteam_live_decision_detail_tooltip() -> String:
	_note_hud_projection_build_call("_build_selected_fireteam_live_decision_detail_tooltip")
	return _build_selected_fireteam_decision_detail_tooltip(_selected_fireteam_player_decision_snapshot)


func _build_mission_insertion_next_step_cue_snapshot(selected_card: Dictionary = {}, card_ui: Dictionary = {}) -> Dictionary:
	var resolved_card: Dictionary = selected_card.duplicate(true)
	var selected_craft_id: String = String(resolved_card.get("craft_id", _mission_drop_craft_id)).strip_edges()
	if resolved_card.is_empty():
		resolved_card = _find_mission_dropship_card_entry(selected_craft_id)
		if resolved_card.is_empty() and _mission_drop_cards.size() == 1:
			resolved_card = Dictionary(_mission_drop_cards[0]).duplicate(true)
	if selected_craft_id.is_empty():
		selected_craft_id = String(resolved_card.get("craft_id", _mission_drop_craft_id)).strip_edges()
	var has_lz: bool = bool(resolved_card.get("has_lz_position", _has_lz_position))
	var payload_ids: Array = _sanitize_drop_payload_ids(Array(resolved_card.get("embarked_unit_ids", [])))
	var payload_count: int = maxi(payload_ids.size(), int(resolved_card.get("passenger_count", _mission_drop_passenger_count)))
	var deployed_selected_ids: Array = _build_deployed_selected_fireteam_unit_ids()
	var has_selected_embarked_payload: bool = _selected_fireteams_have_embarked_payload()
	var has_insertion_context: bool = payload_count > 0 \
		or has_selected_embarked_payload \
		or _drop_ship_requested \
		or _is_drop_sequence_active()
	var next_step_id: String = ""
	var next_step_text: String = ""
	var blocker_reason: String = ""
	if not deployed_selected_ids.is_empty():
		next_step_id = "plan_move"
		next_step_text = "Naechster Griff: Move-Ziel setzen | Preview lesen | danach GO"
	elif has_insertion_context and not has_lz:
		next_step_id = "set_lz"
		next_step_text = "Naechster Griff: LZ auf der Karte setzen | danach Drop"
		blocker_reason = "fireteam_in_dropship_until_lz"
	elif _drop_sequence_phase == DROP_SEQUENCE_INBOUND or _mission_drop_state == "to_mission":
		next_step_id = "wait_arrival"
		next_step_text = "Naechster Griff: Dropship ankommen lassen | danach aussteigen"
		blocker_reason = "dropship_inbound"
	elif _drop_sequence_phase == DROP_SEQUENCE_LANDED or _drop_sequence_phase == DROP_SEQUENCE_UNLOADING:
		next_step_id = "wait_deboarding"
		next_step_text = "Naechster Griff: Deboarding abwarten | Fireteam wird aktiv"
		blocker_reason = "deboarding"
	elif has_insertion_context and has_lz and _drop_ship_cooldown_remaining > 0.0 and _drop_sequence_phase.is_empty():
		next_step_id = "wait_drop_ready"
		next_step_text = "Naechster Griff: Drop bereit in %.1fs" % _drop_ship_cooldown_remaining
		blocker_reason = "drop_cooldown"
	elif has_insertion_context and has_lz:
		next_step_id = "drop_fireteam"
		next_step_text = "Naechster Griff: Drop ausloesen | Fireteam aussteigen lassen"
		blocker_reason = "fireteam_in_dropship_until_drop"
	var card_commands: Dictionary = Dictionary(card_ui.get("commands", {}))
	return {
		"schema": "sternenbuergerchen.mission_insertion_next_step_cue.v1",
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"source": "mission_dropship_card_and_selected_fireteam_state",
		"craft_id": selected_craft_id,
		"active": not next_step_id.is_empty(),
		"next_step_id": next_step_id,
		"next_step_text": next_step_text,
		"status_line": next_step_text,
		"command_matrix_blocked_reason": blocker_reason,
		"has_lz": has_lz,
		"payload_count": payload_count,
		"payload_ids": payload_ids,
		"selected_embarked_payload": has_selected_embarked_payload,
		"deployed_selected_unit_ids": deployed_selected_ids,
		"drop_button_present": bool(card_ui.get("drop_button_present", false)),
		"drop_button_disabled": bool(card_ui.get("drop_button_disabled", true)),
		"set_lz_button_present": bool(card_ui.get("set_lz_button_present", false)),
		"set_lz_command": Dictionary(card_commands.get("set_lz", {})).duplicate(true),
		"drop_command": Dictionary(card_commands.get("drop", {})).duplicate(true),
	}


func _format_selected_status_segment(text: String) -> String:
	var result: String = text.strip_edges()
	if result.is_empty() or result == "-":
		return "-"
	result = result.replace("EXEC ", "")
	result = result.replace("STEADY", "stabil")
	result = result.replace("LOW", "niedrig")
	result = result.replace("MOVE", "Move")
	result = result.replace("ENGAGE", "Engage")
	result = result.replace("TAKE", "Take")
	result = result.replace("DEFEND", "Defend")
	result = result.replace("DEF ", "Defend ")
	result = result.replace("CMD ", "")
	result = result.replace("FAW", "Feuer frei")
	result = result.replace("SEC", "Feuer gehemmt")
	return result


func _build_selected_tactical_stance_display_text() -> String:
	match _build_selected_tactical_stance_text().strip_edges().to_upper():
		"C":
			return "vorsichtig"
		"N":
			return "normal"
		"A":
			return "aggressiv"
		"MIXED":
			return "gemischt"
		_:
			return "-"


func _build_selected_security_display_text() -> String:
	var raw: String = _build_selected_security_text().strip_edges()
	if raw == "-" or raw == "SEC -":
		return "-"
	raw = raw.replace("DEF 360", "Defend 360")
	raw = raw.replace("DEF", "Defend")
	raw = raw.replace("MOV", "Sicherung in Bewegung")
	raw = raw.replace("DIR", "Richtung")
	return raw


func _build_selected_flank_display_text() -> String:
	var raw: String = _build_selected_flank_vulnerability_text().strip_edges()
	if raw.is_empty() or raw == "-":
		return "aus"
	return raw.replace("FLK", "Flank")


func _build_selected_waypoint_info_text() -> String:
	if _selected_fireteam_ids.is_empty():
		return "WP -"
	var tactical_text: String = _build_selected_tactical_communication_text()
	var multi_plan_text: String = _build_selected_multi_fireteam_plan_info_text()
	if not multi_plan_text.is_empty():
		return "%s\n%s" % [tactical_text, multi_plan_text] if not tactical_text.is_empty() else multi_plan_text
	var info_lines: PackedStringArray = []
	for fireteam_id_variant in _selected_fireteam_ids:
		var fireteam_id: String = String(fireteam_id_variant).strip_edges().to_lower()
		if fireteam_id.is_empty():
			continue
		var info_text: String = _build_fireteam_waypoint_info_text(fireteam_id)
		if info_text.is_empty():
			continue
		if _selected_fireteam_ids.size() > 1:
			info_lines.append("%s %s" % [fireteam_id.to_upper(), info_text])
		else:
			info_lines.append(info_text)
	if info_lines.is_empty():
		return "%s\nWP -" % tactical_text if not tactical_text.is_empty() else "WP -"
	var base_text: String = "\n".join(info_lines)
	return "%s\n%s" % [tactical_text, base_text] if not tactical_text.is_empty() else base_text


func _build_selected_multi_fireteam_plan_info_text() -> String:
	if _selected_fireteam_ids.is_empty():
		return ""
	var lines: PackedStringArray = PackedStringArray()
	for fireteam_id_variant in _selected_fireteam_ids:
		var fireteam_id: String = String(fireteam_id_variant).strip_edges().to_lower()
		var assignment: Dictionary = _find_multi_fireteam_assignment_for_fireteam(fireteam_id)
		if assignment.is_empty():
			continue
		lines.append("%s %s P%d | %s | %s" % [
			_get_fireteam_display_label(fireteam_id),
			String(assignment.get("role_label", "")).to_upper(),
			int(assignment.get("plan_phase_index", 0)),
			String(assignment.get("next_step", "")),
			String(assignment.get("status", "")),
		])
	if lines.is_empty():
		return ""
	return "\n".join(lines)


func _build_mission_control_multi_fireteam_plan_text() -> String:
	var selected_plan: Dictionary = _find_multi_fireteam_plan_for_selected_fireteams()
	var tactical_text: String = _build_mission_control_tactical_communication_text()
	if selected_plan.is_empty():
		return tactical_text
	var plan_text: String = String(selected_plan.get("mission_control_text", ""))
	if tactical_text.is_empty():
		return plan_text
	if plan_text.is_empty():
		return tactical_text
	return "%s | %s" % [tactical_text, plan_text]


func _find_multi_fireteam_plan_for_selected_fireteams() -> Dictionary:
	for fireteam_id_variant in _selected_fireteam_ids:
		var plan: Dictionary = _find_multi_fireteam_plan_for_fireteam(String(fireteam_id_variant))
		if not plan.is_empty():
			return plan
	return {}


func _find_multi_fireteam_plan_for_fireteam(fireteam_id: String) -> Dictionary:
	var normalized_fireteam_id: String = fireteam_id.strip_edges().to_lower()
	if normalized_fireteam_id.is_empty():
		return {}
	for plan_variant in _multi_fireteam_plans_by_id.values():
		if typeof(plan_variant) != TYPE_DICTIONARY:
			continue
		var plan: Dictionary = Dictionary(plan_variant)
		for assignment_variant in Array(plan.get("role_assignments", [])):
			if typeof(assignment_variant) != TYPE_DICTIONARY:
				continue
			if String(Dictionary(assignment_variant).get("fireteam_id", "")).strip_edges().to_lower() == normalized_fireteam_id:
				return plan.duplicate(true)
	return {}


func _find_multi_fireteam_assignment_for_fireteam(fireteam_id: String) -> Dictionary:
	var normalized_fireteam_id: String = fireteam_id.strip_edges().to_lower()
	var plan: Dictionary = _find_multi_fireteam_plan_for_fireteam(normalized_fireteam_id)
	if plan.is_empty():
		return {}
	for assignment_variant in Array(plan.get("role_assignments", [])):
		if typeof(assignment_variant) != TYPE_DICTIONARY:
			continue
		var assignment: Dictionary = Dictionary(assignment_variant)
		if String(assignment.get("fireteam_id", "")).strip_edges().to_lower() == normalized_fireteam_id:
			return assignment.duplicate(true)
	return {}


func _build_fireteam_waypoint_info_text(fireteam_id: String) -> String:
	var normalized_fireteam_id: String = fireteam_id.strip_edges().to_lower()
	if normalized_fireteam_id.is_empty():
		return ""
	var area_defense_text: String = _build_fireteam_area_defense_info_text(normalized_fireteam_id)
	if not area_defense_text.is_empty():
		return area_defense_text
	var area_attack_text: String = _build_fireteam_area_attack_info_text(normalized_fireteam_id)
	if not area_attack_text.is_empty():
		return area_attack_text
	var phase_index: int = _get_live_order_phase_index()
	var execution_state: Dictionary = Dictionary(_phase_execution_by_fireteam.get(normalized_fireteam_id, {}))
	if not execution_state.is_empty():
		phase_index = int(execution_state.get("phase", phase_index))
	var plan = _order_plans_by_key.get(_build_order_plan_key(normalized_fireteam_id, phase_index), null)
	if plan == null or plan.waypoints.is_empty():
		return "WP keine geplanten Befehle"
	var waypoint_index: int = int(execution_state.get("waypoint_index", -1))
	if waypoint_index < 0:
		waypoint_index = _find_next_executable_waypoint_index(plan)
	if waypoint_index < 0 or waypoint_index >= plan.waypoints.size():
		return "WP abgeschlossen"
	var waypoint = plan.waypoints[waypoint_index]
	if waypoint == null:
		return "WP -"
	var command_text: String = _get_waypoint_command_display_name(String(waypoint.command_type))
	var status_text: String = String(waypoint.status).strip_edges().to_upper()
	if bool(execution_state.get("waiting_for_go", false)) or _should_display_waypoint_waiting_for_go(normalized_fireteam_id, waypoint, execution_state):
		status_text = "WARTET AUF GO"
	var movement_text: String = _build_waypoint_movement_description(get_fireteam_movement_state(normalized_fireteam_id))
	var target_text: String = _format_world_position(Vector2(waypoint.target_position)) if typeof(waypoint.target_position) == TYPE_VECTOR2 else "--"
	var text: String = "WP %d/%d %s | %s | Ziel %s" % [waypoint_index + 1, plan.waypoints.size(), command_text, status_text, target_text]
	var intent_preview_text: String = _build_waypoint_intent_preview_text(normalized_fireteam_id)
	if not intent_preview_text.is_empty():
		text = "%s | %s" % [text, intent_preview_text]
	if not movement_text.is_empty():
		text = "%s | %s" % [text, movement_text]
	return text


func _build_waypoint_intent_preview_text(fireteam_id: String) -> String:
	var normalized_fireteam_id: String = fireteam_id.strip_edges().to_lower()
	if normalized_fireteam_id.is_empty():
		return ""
	for entry_variant in _build_waypoint_intent_preview_entries():
		if typeof(entry_variant) != TYPE_DICTIONARY:
			continue
		var entry: Dictionary = Dictionary(entry_variant)
		if String(entry.get("fireteam_id", "")).strip_edges().to_lower() != normalized_fireteam_id:
			continue
		var distance_eta_text: String = "PREVIEW Dist %dm | ETA~%ds" % [
			int(round(float(entry.get("distance_world", 0.0)))),
			maxi(int(ceil(float(entry.get("eta_seconds_estimate", 0.0)))), 0),
		]
		var risk_text: String = _build_waypoint_intent_threat_preview_text(entry)
		var parts: PackedStringArray = PackedStringArray([distance_eta_text])
		if not risk_text.is_empty():
			parts.append(risk_text)
		var suppress_preview_text: String = _build_waypoint_suppress_fire_preview_text(normalized_fireteam_id, entry)
		if not suppress_preview_text.is_empty():
			parts.append(suppress_preview_text)
		return " | ".join(parts)
	return ""


func _build_waypoint_intent_threat_preview_text(entry: Dictionary) -> String:
	var risk_state: String = String(entry.get("risk_state", "unknown")).strip_edges().to_lower()
	var risk_label: String = _format_waypoint_intent_risk_label(risk_state)
	if risk_label.is_empty():
		return ""
	var parts: PackedStringArray = PackedStringArray([risk_label])
	var exposure_count: int = int(entry.get("enemy_exposure_count", 0))
	var friendly_fire_count: int = int(entry.get("friendly_fire_risk_count", 0))
	var cover_state: String = String(entry.get("cover_state", "unknown")).strip_edges().to_lower()
	var risk_reason: String = String(entry.get("risk_reason", "")).strip_edges()
	if risk_state == "unknown":
		var reason_label: String = _compact_waypoint_intent_risk_reason(risk_reason)
		if not reason_label.is_empty():
			parts.append(reason_label)
		return " ".join(parts)
	parts.append("E%d" % exposure_count)
	if friendly_fire_count > 0:
		parts.append("FF%d" % friendly_fire_count)
	if not cover_state.is_empty() and cover_state != "unknown":
		parts.append("COV %s" % _compact_waypoint_intent_cover_label(cover_state))
	return " ".join(parts)


func _format_waypoint_intent_risk_label(risk_state: String) -> String:
	match risk_state.strip_edges().to_lower():
		"safe":
			return "SAFE"
		"risky":
			return "RISKY"
		"suicidal":
			return "SUICIDAL"
		_:
			return "RISK ?"


func _compact_waypoint_intent_risk_reason(reason: String) -> String:
	match reason.strip_edges().to_lower():
		"no_threat_context", "":
			return "no intel"
		"no_clear_enemy_los":
			return "no LOS"
		_:
			var compact_reason: String = reason.replace("_", " ")
			return compact_reason.substr(0, mini(compact_reason.length(), 24))


func _compact_waypoint_intent_cover_label(cover_state: String) -> String:
	match cover_state.strip_edges().to_lower():
		"full":
			return "FULL"
		"partial":
			return "PART"
		"none":
			return "OPEN"
		_:
			return cover_state.to_upper()


func _build_waypoint_suppress_fire_preview_text(fireteam_id: String, entry: Dictionary) -> String:
	var preview: Dictionary = _build_suppress_fire_preview_entry(fireteam_id, entry)
	if not bool(preview.get("enabled", false)):
		return ""
	return String(preview.get("preview_text", "")).strip_edges()


func _build_suppress_fire_preview_entry(fireteam_id: String, entry: Dictionary) -> Dictionary:
	var normalized_fireteam_id: String = fireteam_id.strip_edges().to_lower()
	var fire_rule: String = get_fireteam_fire_rule(normalized_fireteam_id)
	var target_variant: Variant = entry.get("ghost_ftl_position", null)
	var has_target: bool = typeof(target_variant) == TYPE_VECTOR2
	var enabled: bool = fire_rule == TACTICAL_COMMAND_RULES_SCRIPT.FIRE_RULE_SUPPRESS and has_target
	var distance_world: float = float(entry.get("distance_world", 0.0))
	var eta_seconds: float = float(entry.get("eta_seconds_estimate", 0.0))
	var exposure_count: int = int(entry.get("enemy_exposure_count", 0))
	var line_count: int = Array(entry.get("line_of_fire_entries", [])).size()
	var pressure_state: String = "inactive"
	var reason: String = "fire_rule_not_suppress"
	if fire_rule == TACTICAL_COMMAND_RULES_SCRIPT.FIRE_RULE_SUPPRESS and not has_target:
		pressure_state = "blocked"
		reason = "missing_preview_target"
	elif enabled and exposure_count > 0:
		pressure_state = "pressure_contact"
		reason = "known_contact_in_preview_area"
	elif enabled and line_count > 0:
		pressure_state = "pressure_lanes"
		reason = "known_lines_in_preview_area"
	elif enabled:
		pressure_state = "area_ready"
		reason = "area_pressure_ready_no_known_contact"
	var target_position: Vector2 = Vector2(target_variant) if has_target else Vector2.ZERO
	var preview_text: String = ""
	if enabled:
		preview_text = "SUP AREA %dm | ETA~%ds | %s" % [
			int(round(SUPPRESS_FIRE_PREVIEW_RADIUS_WORLD)),
			maxi(int(ceil(eta_seconds)), 0),
			pressure_state.to_upper(),
		]
	return {
		"schema": "sternenbuergerchen.suppress_fire_preview.v1",
		"source": "MissionTacticalSandboxController",
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"fireteam_id": normalized_fireteam_id,
		"fire_rule": fire_rule,
		"enabled": enabled,
		"has_target": has_target,
		"target_position": target_position,
		"radius_world": SUPPRESS_FIRE_PREVIEW_RADIUS_WORLD,
		"distance_world": distance_world,
		"eta_seconds_estimate": eta_seconds,
		"enemy_exposure_count": exposure_count,
		"line_of_fire_entry_count": line_count,
		"pressure_state": pressure_state,
		"reason": reason,
		"preview_text": preview_text,
	}


func _build_fireteam_area_defense_info_text(fireteam_id: String) -> String:
	var state: Dictionary = Dictionary(_area_defense_execution_by_fireteam.get(fireteam_id, {})).duplicate(true)
	if not state.is_empty():
		return _build_area_order_feedback_line(fireteam_id, AREA_ORDER_SCRIPT.COMMAND_TYPE_DEFEND, state, _area_orders_by_id.get(String(state.get("area_order_id", "")), null))
	var area_order = _find_next_defend_area_order(fireteam_id)
	if area_order == null:
		return ""
	return _build_area_order_feedback_line(fireteam_id, AREA_ORDER_SCRIPT.COMMAND_TYPE_DEFEND, {}, area_order)


func _build_fireteam_area_attack_info_text(fireteam_id: String) -> String:
	var state: Dictionary = Dictionary(_area_attack_execution_by_fireteam.get(fireteam_id, {})).duplicate(true)
	if not state.is_empty():
		var command_type: String = String(state.get("command_type", AREA_ORDER_SCRIPT.COMMAND_TYPE_ENGAGE)).strip_edges().to_lower()
		return _build_area_order_feedback_line(fireteam_id, command_type, state, _area_orders_by_id.get(String(state.get("area_order_id", "")), null))
	var area_order = _find_next_attack_area_order(fireteam_id)
	if area_order == null:
		return ""
	return _build_area_order_feedback_line(fireteam_id, String(area_order.command_type), {}, area_order)


func _build_area_order_feedback_line(fireteam_id: String, command_type: String, state: Dictionary = {}, area_order = null) -> String:
	var normalized_command_type: String = command_type.strip_edges().to_lower()
	var center_position: Vector2 = _resolve_area_feedback_center_position(state, area_order)
	var area_context: Dictionary = _resolve_area_feedback_context(state, area_order, center_position)
	var field_count: int = _resolve_area_feedback_field_count(state, area_order)
	var mode_text: String = _build_area_feedback_mode_text(normalized_command_type, state)
	var size_text: String = _build_area_feedback_size_text(normalized_command_type, field_count, state)
	var security_text: String = _build_area_feedback_security_text(fireteam_id)
	var contact_text: String = _build_area_feedback_contact_text(fireteam_id, area_context, normalized_command_type)
	var detail_parts: PackedStringArray = []
	if not mode_text.is_empty():
		detail_parts.append(mode_text)
	if not security_text.is_empty():
		detail_parts.append(security_text)
	if not contact_text.is_empty():
		detail_parts.append(contact_text)
	detail_parts.append("Ziel %s" % _format_world_position(center_position))
	return "AREA %s | %s | %s" % [
		_get_area_feedback_command_label(normalized_command_type),
		size_text,
		" | ".join(detail_parts),
	]


func _resolve_area_feedback_center_position(state: Dictionary, area_order) -> Vector2:
	if typeof(state.get("center_position", null)) == TYPE_VECTOR2:
		return Vector2(state.get("center_position"))
	if area_order != null and typeof(area_order.center_position) == TYPE_VECTOR2:
		return Vector2(area_order.center_position)
	return Vector2.ZERO


func _resolve_area_feedback_context(state: Dictionary, area_order, center_position: Vector2) -> Dictionary:
	var target_area: Dictionary = Dictionary(state.get("target_area", {})).duplicate(true)
	if not target_area.is_empty():
		return target_area
	if area_order == null:
		return {
			"center_position": center_position,
			"area_radius": 48.0,
		}
	var radius: float = 48.0
	for point_variant in Array(area_order.world_polygon):
		radius = maxf(radius, Vector2(point_variant).distance_to(center_position))
	for point_variant in Array(area_order.tile_world_positions):
		radius = maxf(radius, Vector2(point_variant).distance_to(center_position))
	return {
		"area_order_id": String(area_order.area_order_id),
		"fireteam_id": String(area_order.fireteam_id),
		"command_type": String(area_order.command_type),
		"center_position": center_position,
		"area_radius": radius,
		"tile_positions": Array(area_order.tile_positions).duplicate(true),
		"tile_world_positions": Array(area_order.tile_world_positions).duplicate(true),
		"world_polygon": PackedVector2Array(area_order.world_polygon),
	}


func _resolve_area_feedback_field_count(state: Dictionary, area_order) -> int:
	var target_area: Dictionary = Dictionary(state.get("target_area", {}))
	var tile_positions: Array = Array(target_area.get("tile_positions", []))
	if not tile_positions.is_empty():
		return tile_positions.size()
	if area_order != null:
		tile_positions = Array(area_order.tile_positions)
		if not tile_positions.is_empty():
			return tile_positions.size()
		var tile_world_positions: Array = Array(area_order.tile_world_positions)
		if not tile_world_positions.is_empty():
			return tile_world_positions.size()
	var assignments: Array = Array(state.get("assignments", []))
	return maxi(assignments.size(), 1)


func _build_area_feedback_size_text(command_type: String, field_count: int, state: Dictionary) -> String:
	var normalized_field_count: int = maxi(field_count, 1)
	if command_type == AREA_ORDER_SCRIPT.COMMAND_TYPE_TAKE:
		var secured_count: int = normalized_field_count if String(state.get("status", "")).strip_edges().to_lower() == "secured" else 0
		return "%d/%d Felder gesichert" % [secured_count, normalized_field_count]
	return "%d Felder" % normalized_field_count


func _build_area_feedback_mode_text(command_type: String, state: Dictionary) -> String:
	if state.is_empty():
		return "geplant"
	var status: String = String(state.get("status", "")).strip_edges().to_lower()
	var waiting_for_go: bool = bool(state.get("waiting_for_go", false))
	if waiting_for_go:
		if status == "engaged":
			return "ENGAGED | WARTET AUF GO | HALTET FEUERLINIE"
		if status == "secured":
			return "GESICHERT | WARTET AUF GO | HALTET GEBIET"
		return "WARTET AUF GO | HALTET GEBIET"
	match command_type:
		AREA_ORDER_SCRIPT.COMMAND_TYPE_DEFEND:
			return "verteidigt" if status == "holding" else "bezieht Stellung"
		AREA_ORDER_SCRIPT.COMMAND_TYPE_TAKE:
			return "nimmt Gebiet" if status != "secured" else "GESICHERT | HALTET GEBIET"
		AREA_ORDER_SCRIPT.COMMAND_TYPE_FLANK:
			return _build_area_feedback_approach_text(state, "Flank")
		_:
			return _build_area_feedback_approach_text(state, "Approach")


func _build_area_feedback_approach_text(state: Dictionary, prefix: String) -> String:
	if String(state.get("status", "")).strip_edges().to_lower() == "engaging":
		return "Kontakt suchen"
	if String(state.get("status", "")).strip_edges().to_lower() == "occupying":
		return "rueckt ins Gebiet"
	if String(state.get("status", "")).strip_edges().to_lower() == "secured":
		return "haltet Gebiet"
	if String(state.get("status", "")).strip_edges().to_lower() == "engaged":
		return "haltet Feuerlinie"
	var center_position: Vector2 = Vector2(state.get("center_position", Vector2.ZERO))
	var approach_position: Vector2 = Vector2(state.get("approach_position", center_position))
	return "%s %s" % [prefix, _format_area_approach_direction(approach_position, center_position)]


func _format_area_approach_direction(approach_position: Vector2, center_position: Vector2) -> String:
	var delta: Vector2 = approach_position - center_position
	if delta.length() < 0.001:
		return "-"
	var horizontal: String = "E" if delta.x > 0.0 else "W"
	var vertical: String = "S" if delta.y > 0.0 else "N"
	return "%s%s" % [vertical, horizontal]


func _build_area_feedback_security_text(fireteam_id: String) -> String:
	var security_state: Dictionary = get_fireteam_security_state(fireteam_id)
	if security_state.is_empty() or not bool(security_state.get("is_active", false)):
		return "SEC -"
	var mode: String = String(security_state.get("security_mode", "")).strip_edges().to_lower()
	if mode == "360":
		return "SEC 360"
	if mode == "directional":
		return "SEC DIR"
	return "SEC %s" % mode.to_upper()


func _build_area_feedback_contact_text(fireteam_id: String, area_context: Dictionary, command_type: String) -> String:
	var highest_rank: int = 0
	for contact_variant in get_fireteam_contact_snapshot(fireteam_id):
		var contact: Dictionary = Dictionary(contact_variant)
		var contact_position: Vector2 = Vector2(contact.get("last_known_position", Vector2.ZERO))
		if not area_context.is_empty() and not bool(AREA_ORDER_RESOLVER_SCRIPT.call("is_position_in_area_context", area_context, contact_position)):
			continue
		highest_rank = maxi(highest_rank, _rank_area_feedback_contact_state(String(contact.get("detection_state", ""))))
	if highest_rank >= 4:
		return "Kontakt bestaetigt"
	if highest_rank == 3:
		return "Kontakt gesichtet"
	if highest_rank == 2:
		return "Kontakt verloren"
	if highest_rank == 1:
		return "Kontakt vermutet"
	if command_type == AREA_ORDER_SCRIPT.COMMAND_TYPE_DEFEND:
		return "wartet auf Kontakt"
	return "kein Kontakt"


func _rank_area_feedback_contact_state(detection_state: String) -> int:
	match detection_state.strip_edges().to_lower():
		"confirmed":
			return 4
		"spotted":
			return 3
		"lost":
			return 2
		"suspected":
			return 1
		_:
			return 0


func _get_area_feedback_command_label(command_type: String) -> String:
	match command_type.strip_edges().to_lower():
		AREA_ORDER_SCRIPT.COMMAND_TYPE_DEFEND:
			return "DEFEND"
		AREA_ORDER_SCRIPT.COMMAND_TYPE_ENGAGE:
			return "ENGAGE"
		AREA_ORDER_SCRIPT.COMMAND_TYPE_TAKE:
			return "TAKE"
		AREA_ORDER_SCRIPT.COMMAND_TYPE_FLANK:
			return "FLANK"
		_:
			return "ATTACK"


func _should_display_waypoint_waiting_for_go(fireteam_id: String, waypoint, execution_state: Dictionary) -> bool:
	if waypoint == null or String(waypoint.command_type).strip_edges().to_lower() != FIRETEAM_WAYPOINT_SCRIPT.COMMAND_TYPE_DEFEND:
		return false
	if String(waypoint.status) == FIRETEAM_WAYPOINT_SCRIPT.STATUS_ACTIVE:
		return true
	var anchor := _get_selection_anchor_for_fireteam(fireteam_id)
	if anchor == null:
		return false
	var resolved_target_position: Variant = execution_state.get("resolved_target_position", waypoint.target_position)
	if typeof(resolved_target_position) != TYPE_VECTOR2:
		return false
	return anchor.global_position.distance_to(Vector2(resolved_target_position)) <= PHASE_WAYPOINT_COMPLETE_RADIUS


func _get_waypoint_command_display_name(command_type: String) -> String:
	match command_type.strip_edges().to_lower():
		FIRETEAM_WAYPOINT_SCRIPT.COMMAND_TYPE_DEFEND:
			return "DEFEND"
		FIRETEAM_WAYPOINT_SCRIPT.COMMAND_TYPE_ENGAGE:
			return "ENGAGE"
		FIRETEAM_WAYPOINT_SCRIPT.COMMAND_TYPE_FLANK:
			return "FLANK"
		FIRETEAM_WAYPOINT_SCRIPT.COMMAND_TYPE_TAKE:
			return "TAKE"
		_:
			return "MOVE"


func _build_waypoint_movement_description(movement_state: Dictionary) -> String:
	if movement_state.is_empty():
		return ""
	match String(movement_state.get("effective_style", "")).strip_edges().to_lower():
		"rush":
			return "Bewegung: stuermt"
		"bounding":
			return "Bewegung: gebunden"
		"caterpillar", "creep":
			return "Bewegung: raupenartig"
		_:
			return ""


func _build_selected_command_order_summary(command_type: String, fallback_text: String) -> String:
	var summaries: PackedStringArray = PackedStringArray()
	var target_position: Vector2 = _selected_tile_world_position if _has_selected_tile else _get_target_position()
	for fireteam_id_variant in _selected_fireteam_ids:
		var fireteam_id: String = String(fireteam_id_variant).strip_edges().to_lower()
		if fireteam_id.is_empty():
			continue
		var context: Dictionary = _build_order_decision_context(fireteam_id, command_type, target_position, false, 1)
		var status_text: String = String(context.get("decision_status_text", "")).strip_edges()
		if not status_text.is_empty():
			summaries.append(status_text)
	if summaries.is_empty():
		return "%s (%s)" % [fallback_text, _get_fireteam_name()]
	return " | ".join(summaries)


func _build_go_result_decision_summary(issued_fireteams: PackedStringArray, continued_fireteams: PackedStringArray, already_active_fireteams: PackedStringArray) -> String:
	var fireteam_ids: PackedStringArray = PackedStringArray()
	for issued_variant in issued_fireteams:
		var issued_id: String = String(issued_variant).strip_edges().to_lower()
		if not issued_id.is_empty() and not fireteam_ids.has(issued_id):
			fireteam_ids.append(issued_id)
	for continued_variant in continued_fireteams:
		var continued_id: String = String(continued_variant).strip_edges().to_lower()
		if not continued_id.is_empty() and not fireteam_ids.has(continued_id):
			fireteam_ids.append(continued_id)
	for active_variant in already_active_fireteams:
		var active_id: String = String(active_variant).strip_edges().to_lower()
		if not active_id.is_empty() and not fireteam_ids.has(active_id):
			fireteam_ids.append(active_id)
	var summaries: PackedStringArray = PackedStringArray()
	for fireteam_id in fireteam_ids:
		var context: Dictionary = _resolve_fireteam_current_decision_context(String(fireteam_id), true)
		var status_text: String = String(context.get("decision_status_text", "")).strip_edges()
		if not status_text.is_empty() and status_text != "-":
			summaries.append("%s %s" % [_get_fireteam_display_label(String(fireteam_id)).to_upper(), status_text])
	return " | ".join(summaries)


func _build_selected_decision_status_text() -> String:
	var contexts: Array = _build_selected_decision_context_snapshot()
	if contexts.is_empty():
		return "-"
	var summaries: PackedStringArray = PackedStringArray()
	for context_variant in contexts:
		if typeof(context_variant) != TYPE_DICTIONARY:
			continue
		var context: Dictionary = Dictionary(context_variant)
		var status_text: String = String(context.get("decision_status_text", "")).strip_edges()
		if status_text.is_empty():
			continue
		if contexts.size() > 1:
			status_text = "%s %s" % [String(context.get("fireteam_label", context.get("fireteam_id", ""))).to_upper(), status_text]
		summaries.append(status_text)
	return " | ".join(summaries) if not summaries.is_empty() else "-"


func _build_selected_decision_context_snapshot() -> Array:
	var result: Array = []
	for fireteam_id_variant in _selected_fireteam_ids:
		var fireteam_id: String = String(fireteam_id_variant).strip_edges().to_lower()
		if fireteam_id.is_empty():
			continue
		var context: Dictionary = _resolve_fireteam_current_decision_context(fireteam_id, true)
		if context.is_empty():
			continue
		result.append(context)
	return result


func _build_fireteamleader_feedback_context(fireteam_id: String, feedback_action: String, detail: String = "") -> Dictionary:
	var context: Dictionary = _resolve_fireteam_feedback_order_context(fireteam_id, feedback_action, detail)
	if context.is_empty():
		context = {
			"active_command": feedback_action.strip_edges().to_lower(),
			"feedback_action": feedback_action.strip_edges().to_lower(),
		}
	return context


func _resolve_fireteam_feedback_order_context(fireteam_id: String, feedback_action: String, _detail: String = "") -> Dictionary:
	var normalized_action: String = feedback_action.strip_edges().to_lower()
	if normalized_action == "go":
		var movement_state: Dictionary = get_fireteam_movement_state(fireteam_id)
		if not movement_state.is_empty():
			var movement_target: Vector2 = Vector2(movement_state.get("current_anchor_target_position", movement_state.get("final_target_position", Vector2.ZERO)))
			return _build_order_decision_context(fireteam_id, String(movement_state.get("command_type", "move")), movement_target, false, 1)
		var active_context: Dictionary = _resolve_fireteam_current_decision_context(fireteam_id, true)
		if not active_context.is_empty():
			return active_context
	var target_position: Vector2 = _selected_tile_world_position if _has_selected_tile else _get_target_position()
	return _build_order_decision_context(fireteam_id, normalized_action, target_position, false, 1)


func _resolve_fireteam_current_decision_context(fireteam_id: String, include_planned: bool = false) -> Dictionary:
	var normalized_fireteam_id: String = fireteam_id.strip_edges().to_lower()
	if normalized_fireteam_id.is_empty():
		return {}
	var phase_index: int = _get_live_order_phase_index()
	var execution_state: Dictionary = Dictionary(_phase_execution_by_fireteam.get(normalized_fireteam_id, {}))
	if not execution_state.is_empty():
		phase_index = int(execution_state.get("phase", phase_index))
		var active_plan = _order_plans_by_key.get(_build_order_plan_key(normalized_fireteam_id, phase_index), null)
		var waypoint_index: int = int(execution_state.get("waypoint_index", -1))
		if active_plan != null and waypoint_index >= 0 and waypoint_index < active_plan.waypoints.size():
			var waypoint = active_plan.waypoints[waypoint_index]
			if waypoint != null and typeof(waypoint.target_position) == TYPE_VECTOR2:
				var target_position: Vector2 = Vector2(execution_state.get("resolved_target_position", waypoint.target_position))
				return _build_order_decision_context(normalized_fireteam_id, String(waypoint.command_type), target_position, false, 1)
	var area_defense_state: Dictionary = Dictionary(_area_defense_execution_by_fireteam.get(normalized_fireteam_id, {}))
	if not area_defense_state.is_empty():
		return _build_area_decision_context(normalized_fireteam_id, AREA_ORDER_SCRIPT.COMMAND_TYPE_DEFEND, area_defense_state, _area_orders_by_id.get(String(area_defense_state.get("area_order_id", "")), null))
	var area_attack_state: Dictionary = Dictionary(_area_attack_execution_by_fireteam.get(normalized_fireteam_id, {}))
	if not area_attack_state.is_empty():
		var area_command_type: String = String(area_attack_state.get("command_type", AREA_ORDER_SCRIPT.COMMAND_TYPE_ENGAGE)).strip_edges().to_lower()
		return _build_area_decision_context(normalized_fireteam_id, area_command_type, area_attack_state, _area_orders_by_id.get(String(area_attack_state.get("area_order_id", "")), null))
	var movement_state: Dictionary = get_fireteam_movement_state(normalized_fireteam_id)
	if not movement_state.is_empty():
		var movement_target: Vector2 = Vector2(movement_state.get("current_anchor_target_position", movement_state.get("final_target_position", Vector2.ZERO)))
		return _build_order_decision_context(normalized_fireteam_id, String(movement_state.get("command_type", "move")), movement_target, false, 1)
	if include_planned:
		var planned_plan = _order_plans_by_key.get(_build_order_plan_key(normalized_fireteam_id, phase_index), null)
		if planned_plan != null and not planned_plan.waypoints.is_empty():
			var next_waypoint_index: int = _find_next_executable_waypoint_index(planned_plan)
			if next_waypoint_index >= 0 and next_waypoint_index < planned_plan.waypoints.size():
				var next_waypoint = planned_plan.waypoints[next_waypoint_index]
				if next_waypoint != null and typeof(next_waypoint.target_position) == TYPE_VECTOR2:
					return _build_order_decision_context(normalized_fireteam_id, String(next_waypoint.command_type), Vector2(next_waypoint.target_position), false, 1)
		var defend_area_order = _find_next_defend_area_order(normalized_fireteam_id)
		if defend_area_order != null:
			return _build_area_decision_context(normalized_fireteam_id, AREA_ORDER_SCRIPT.COMMAND_TYPE_DEFEND, {}, defend_area_order)
		var attack_area_order = _find_next_attack_area_order(normalized_fireteam_id)
		if attack_area_order != null:
			return _build_area_decision_context(normalized_fireteam_id, String(attack_area_order.command_type), {}, attack_area_order)
	var security_context: Dictionary = _build_security_decision_context(normalized_fireteam_id, get_fireteam_security_state(normalized_fireteam_id))
	return security_context


func _build_area_decision_context(fireteam_id: String, command_type: String, state: Dictionary = {}, area_order = null) -> Dictionary:
	var center_position: Vector2 = _resolve_area_feedback_center_position(state, area_order)
	var field_count: int = _resolve_area_feedback_field_count(state, area_order)
	return _build_order_decision_context(fireteam_id, command_type, center_position, true, field_count)


func _build_order_decision_context(fireteam_id: String, command_type: String, target_position: Vector2, is_area: bool = false, area_field_count: int = 0) -> Dictionary:
	var normalized_fireteam_id: String = fireteam_id.strip_edges().to_lower()
	var normalized_command_type: String = _normalize_decision_command_type(command_type)
	var anchor = _get_selection_anchor_for_fireteam(normalized_fireteam_id)
	var origin_position: Vector2 = anchor.global_position if anchor is Node2D else target_position
	var direction: Vector2 = target_position - origin_position
	var direction_label: String = _format_compass_direction_label(direction, false)
	var direction_short: String = _format_compass_direction_label(direction, true)
	var tile_distance: int = _estimate_tile_distance_between(origin_position, target_position)
	var command_label: String = _get_decision_command_label(normalized_command_type)
	var scope_text: String = "%dF AREA" % maxi(area_field_count, 1) if is_area else "TILE"
	var effect_text: String = _build_decision_effect_text(normalized_command_type, get_requested_tactical_stance(normalized_fireteam_id))
	var status_parts: PackedStringArray = PackedStringArray([command_label, direction_short, "%dF" % tile_distance])
	if is_area:
		status_parts.append("AREA%d" % maxi(area_field_count, 1))
	if not effect_text.is_empty():
		status_parts.append(effect_text)
	var bubble_line_one: String = "%s %s" % [command_label, direction_label]
	if is_area:
		bubble_line_one = "%s AREA %s" % [command_label, direction_label]
	var bubble_line_two: String = "%dF" % tile_distance
	if not effect_text.is_empty():
		bubble_line_two = "%s | %s" % [bubble_line_two, effect_text]
	return {
		"fireteam_id": normalized_fireteam_id,
		"fireteam_label": _get_fireteam_display_label(normalized_fireteam_id),
		"active_command": normalized_command_type,
		"command_type": normalized_command_type,
		"command_label": command_label,
		"target_position": target_position,
		"origin_position": origin_position,
		"direction_label": direction_label,
		"direction_short": direction_short,
		"distance": "%d Felder" % tile_distance,
		"distance_tiles": tile_distance,
		"scope": "area" if is_area else "tile",
		"scope_text": scope_text,
		"area_field_count": maxi(area_field_count, 1) if is_area else 1,
		"stance": get_requested_tactical_stance(normalized_fireteam_id),
		"effect_text": effect_text,
		"decision_status_text": " ".join(status_parts),
		"decision_detail_text": "%s | %s | %s" % [" ".join(status_parts), scope_text, _format_world_position(target_position)],
		"order_summary_text": "%s\n%s" % [bubble_line_one, bubble_line_two],
		"feedback_text": "%s\n%s" % [bubble_line_one, bubble_line_two],
	}


func _build_security_decision_context(fireteam_id: String, security_state: Dictionary) -> Dictionary:
	if security_state.is_empty() or not bool(security_state.get("is_active", false)):
		return {}
	var direction: Vector2 = Vector2.RIGHT.rotated(float(security_state.get("direction_angle", 0.0)))
	var mode: String = String(security_state.get("security_mode", "directional")).strip_edges().to_lower()
	var mode_text: String = "360" if mode == "360" else _format_compass_direction_label(direction, true)
	var label: String = "DEF"
	var status_text: String = "%s %s" % [label, mode_text]
	return {
		"fireteam_id": fireteam_id,
		"fireteam_label": _get_fireteam_display_label(fireteam_id),
		"active_command": "defend",
		"command_type": "defend",
		"command_label": label,
		"direction_label": _format_compass_direction_label(direction, false),
		"direction_short": mode_text,
		"distance": "",
		"distance_tiles": 0,
		"scope": "security",
		"scope_text": mode,
		"decision_status_text": status_text,
		"decision_detail_text": "%s | sichert" % status_text,
		"order_summary_text": "%s %s\nSektor" % [label, _format_compass_direction_label(direction, false)],
		"feedback_text": "%s %s\nSektor" % [label, _format_compass_direction_label(direction, false)],
	}


func _normalize_decision_command_type(command_type: String) -> String:
	var normalized: String = command_type.strip_edges().to_lower()
	match normalized:
		"attack":
			return "engage"
		"hold", "hold_position", "cover":
			return "defend"
		"objective", "capture":
			return "take"
		"go", "execute":
			return "move"
		_:
			return "move" if normalized.is_empty() else normalized


func _get_decision_command_label(command_type: String) -> String:
	match _normalize_decision_command_type(command_type):
		"defend":
			return "DEFEND"
		"take":
			return "TAKE"
		"engage":
			return "ENGAGE"
		"flank":
			return "FLANK"
		"overwatch":
			return "DEF"
		"security":
			return "DEF"
		_:
			return "MOVE"


func _build_decision_effect_text(command_type: String, tactical_stance: String) -> String:
	match _normalize_decision_command_type(command_type):
		"move":
			match tactical_stance.strip_edges().to_lower():
				"cautious":
					return "C Aim"
				"aggressive":
					return "A Run"
				_:
					return "N Walk"
		"defend":
			match tactical_stance.strip_edges().to_lower():
				"cautious":
					return "C +20S +15CV -3ATK"
				"aggressive":
					return "A +10SPD -15S -10CV +4ATK"
				_:
					return "N DEF"
		"take":
			match tactical_stance.strip_edges().to_lower():
				"cautious":
					return "C -30SPD +15S +10CV"
				"aggressive":
					return "A +20SPD -25S -12CV +6ATK"
				_:
					return "N TAKE"
		"engage":
			match tactical_stance.strip_edges().to_lower():
				"cautious":
					return "C -25SPD +15S +10CV +2ATK"
				"aggressive":
					return "A +15SPD -20S -8CV +8ATK"
				_:
					return "N FIRE"
		"flank":
			return "FLANK"
		_:
			return ""


func _estimate_tile_distance_between(origin_position: Vector2, target_position: Vector2) -> int:
	var origin_grid_variant = _primary_view_bridge.call("world_to_grid_position", get_parent(), origin_position)
	var target_grid_variant = _primary_view_bridge.call("world_to_grid_position", get_parent(), target_position)
	if typeof(origin_grid_variant) == TYPE_VECTOR2I and typeof(target_grid_variant) == TYPE_VECTOR2I:
		var origin_grid: Vector2i = Vector2i(origin_grid_variant)
		var target_grid: Vector2i = Vector2i(target_grid_variant)
		var grid_delta: Vector2i = target_grid - origin_grid
		return maxi(absi(grid_delta.x), absi(grid_delta.y))
	return maxi(int(round(origin_position.distance_to(target_position) / 64.0)), 0)


func _format_compass_direction_label(direction: Vector2, short_label: bool = false) -> String:
	if direction.length_squared() <= 0.0001:
		return "HERE" if short_label else "Hier"
	var abs_x: float = absf(direction.x)
	var abs_y: float = absf(direction.y)
	var horizontal_long: String = "Ost" if direction.x >= 0.0 else "West"
	var horizontal_short: String = "E" if direction.x >= 0.0 else "W"
	var vertical_long: String = "Sued" if direction.y >= 0.0 else "Nord"
	var vertical_short: String = "S" if direction.y >= 0.0 else "N"
	var dominant_threshold: float = 0.42
	if abs_x <= abs_y * dominant_threshold:
		return vertical_short if short_label else vertical_long
	if abs_y <= abs_x * dominant_threshold:
		return horizontal_short if short_label else horizontal_long
	return "%s%s" % [vertical_short, horizontal_short] if short_label else "%s%s" % [vertical_long, horizontal_long]


func _build_strategic_status_text() -> String:
	_note_hud_projection_build_call("_build_strategic_status_text")
	if not _last_planning_state_issue.is_empty():
		return "Alte Planungsdaten erkannt\nBitte Plan im aktuellen\nPhasensystem neu anlegen."
	var selected_card_state: String = ""
	if _has_live_drop_sequence_for_craft(_mission_drop_craft_id) and not _is_active_drop_sequence_for_craft(_mission_drop_craft_id):
		var selected_card: Dictionary = _find_mission_dropship_card_entry(_mission_drop_craft_id)
		selected_card_state = String(selected_card.get("state", "")).strip_edges().to_lower()
	_mission_control_state_snapshot = Dictionary(MISSION_CONTROL_STATE_PRESENTER_SCRIPT.call("build_snapshot", {
		"has_lz": _has_lz_position,
		"lz_text": _format_world_position(_lz_position) if _has_lz_position else "",
		"approach_name": _get_approach_angle_name(),
		"drop_state": _mission_drop_state,
		"eta_seconds": _mission_drop_eta_seconds,
		"preview_mode": preview_mode,
		"drop_requested": _drop_ship_requested,
		"drop_staged": _drop_ship_staged,
		"cooldown_seconds": _drop_ship_cooldown_remaining,
		"sequence_phase": _drop_sequence_phase,
		"unit_index": _drop_sequence_unit_index,
		"unit_count": _drop_sequence_units.size(),
		"has_live_other_craft": _has_live_drop_sequence_for_craft(_mission_drop_craft_id) and not _is_active_drop_sequence_for_craft(_mission_drop_craft_id),
		"other_drop_active": _is_drop_sequence_active() and not _is_active_drop_sequence_for_craft(_mission_drop_craft_id),
		"selected_craft_state": selected_card_state,
	}))
	var lines: PackedStringArray = PackedStringArray(_mission_control_state_snapshot.get("visible_lines", PackedStringArray()))
	var transfer_text: String = _build_meta_transfer_status_text()
	if not transfer_text.is_empty():
		lines.append(transfer_text)
	lines.append(_build_mission_time_limit_text())
	var interaction_density: Dictionary = _build_mission_hud_interaction_density_snapshot()
	var interaction_line: String = String(interaction_density.get("mission_control_line", "")).strip_edges()
	if not interaction_line.is_empty():
		lines.append(interaction_line)
	var frontier_probe_one_screen: Dictionary = _build_frontier_probe_one_screen_playability_readout()
	var frontier_probe_one_screen_line: String = String(frontier_probe_one_screen.get("one_screen_line", "")).strip_edges()
	if bool(frontier_probe_one_screen.get("active", false)) and not frontier_probe_one_screen_line.is_empty():
		lines.append(frontier_probe_one_screen_line)
	var order_preview_threat_overlay: Dictionary = get_order_preview_threat_overlay_f6_hud_snapshot()
	var order_preview_threat_overlay_line: String = String(order_preview_threat_overlay.get("mission_control_choice_line", "")).strip_edges()
	if bool(order_preview_threat_overlay.get("active", false)) and not order_preview_threat_overlay_line.is_empty() and not lines.has(order_preview_threat_overlay_line):
		lines.append(order_preview_threat_overlay_line)
	var next_interaction: Dictionary = _build_frontier_probe_playfeel_next_interaction_snapshot()
	var next_interaction_line: String = String(next_interaction.get("next_interaction_line", "")).strip_edges()
	var one_screen_covers_next: bool = bool(frontier_probe_one_screen.get("active", false)) \
		and not frontier_probe_one_screen_line.is_empty() \
		and String(frontier_probe_one_screen.get("next_token", "")).strip_edges().to_upper() != "DEBRIEF"
	if bool(next_interaction.get("active", false)) and not next_interaction_line.is_empty() and not one_screen_covers_next:
		lines.append(next_interaction_line)
	var combat_hud_density: Dictionary = _build_mission_combat_hud_density_snapshot()
	var combat_hud_line: String = String(combat_hud_density.get("mission_control_line", "")).strip_edges()
	var loop_two_readout: Dictionary = {}
	if bool(combat_hud_density.get("active", false)) and not combat_hud_line.is_empty():
		var combat_status_line: String = "Kampf %s" % combat_hud_line
		if not lines.has(combat_status_line):
			lines.append(combat_status_line)
		var firefight_decision_line: String = _build_release_candidate_firefight_decision_line()
		if not firefight_decision_line.is_empty() and not lines.has(firefight_decision_line):
			lines.append(firefight_decision_line)
		loop_two_readout = _build_strategic_loop_two_readout()
		var loop_two_line: String = String(loop_two_readout.get("loop_line", ""))
		if not loop_two_line.is_empty() and not lines.has(loop_two_line):
			lines.append(loop_two_line)
		var loop_two_polish_line: String = String(loop_two_readout.get("polish_line", ""))
		if not loop_two_polish_line.is_empty() and not lines.has(loop_two_polish_line):
			lines.append(loop_two_polish_line)
	var debrief_handoff: Dictionary = _build_frontier_probe_debrief_handoff_feel_snapshot()
	var debrief_handoff_line: String = String(debrief_handoff.get("handoff_line", "")).strip_edges()
	if bool(debrief_handoff.get("handoff_ready", false)) and not debrief_handoff_line.is_empty():
		lines.append(debrief_handoff_line)
	var station_debrief_handoff: Dictionary = _build_station_scenario_debrief_handoff_cue_snapshot({}, {}, {}, interaction_density)
	var station_debrief_handoff_line: String = String(station_debrief_handoff.get("handoff_line", "")).strip_edges()
	if bool(station_debrief_handoff.get("handoff_ready", false)) and not station_debrief_handoff_line.is_empty() and not lines.has(station_debrief_handoff_line):
		lines.append(station_debrief_handoff_line)
	lines = _prioritize_release_firefight_bottom_dock_lines(lines, combat_hud_density)
	if not _build_release_fire_exchange_contact_fire_primary_hud_line(combat_hud_density).is_empty():
		return "\n".join(lines)
	var compact_player_decision: String = _compact_release_first_exchange_contact_fire_secondary_line(_build_release_candidate_firefight_decision_line())
	var player_decision_visible: bool = not compact_player_decision.is_empty() and lines.has(compact_player_decision)
	if loop_two_readout.is_empty():
		loop_two_readout = _build_strategic_loop_two_readout()
	var loop_two_line_after_priority: String = String(loop_two_readout.get("loop_line", ""))
	if not player_decision_visible and not loop_two_line_after_priority.is_empty() and not lines.has(loop_two_line_after_priority):
		lines.append(loop_two_line_after_priority)
	var loop_two_polish_line_after_priority: String = String(loop_two_readout.get("polish_line", ""))
	if not player_decision_visible and not loop_two_polish_line_after_priority.is_empty() and not lines.has(loop_two_polish_line_after_priority):
		lines.append(loop_two_polish_line_after_priority)
	if not player_decision_visible and bool(order_preview_threat_overlay.get("active", false)) and not order_preview_threat_overlay_line.is_empty() and not lines.has(order_preview_threat_overlay_line):
		lines.append(order_preview_threat_overlay_line)
	return "\n".join(lines)


func _build_strategic_loop_two_readout() -> Dictionary:
	# This value belongs only to one synchronous Strategic RAW assembly. Keep
	# source construction inside the same available helper guard as its first
	# former read, rather than moving a recursive producer outside that guard.
	var readout: Dictionary = {"loop_line": "", "polish_line": ""}
	var hud_depth: int = _release_first_decision_loop_two_hud_build_depth
	var polish_depth: int = _release_first_decision_loop_two_polish_hud_build_depth
	if hud_depth > 0 and polish_depth > 0:
		return readout
	if hud_depth == 0:
		_release_first_decision_loop_two_hud_build_depth += 1
	else:
		_release_first_decision_loop_two_polish_hud_build_depth += 1
	var next_loop: Dictionary = get_release_first_decision_next_playable_loop_snapshot()
	_release_first_decision_loop_two_hud_build_depth = hud_depth
	_release_first_decision_loop_two_polish_hud_build_depth = polish_depth
	# A missing source remains empty instead of triggering the helpers' legacy
	# empty-override fallback and issuing another source read in this assembly.
	if next_loop.is_empty():
		return readout
	readout["loop_line"] = _build_release_first_decision_loop_two_hud_line(next_loop)
	readout["polish_line"] = _build_release_first_decision_loop_two_polish_hud_line(next_loop)
	return readout


func _prioritize_release_firefight_bottom_dock_lines(source_lines: PackedStringArray, combat_hud_density: Dictionary = {}) -> PackedStringArray:
	var decision_line: String = _build_release_candidate_firefight_decision_line()
	var contact_fire_primary_line: String = _build_release_fire_exchange_contact_fire_primary_hud_line(combat_hud_density)
	if decision_line.is_empty() and contact_fire_primary_line.is_empty():
		return source_lines
	var combat_line: String = String(combat_hud_density.get("mission_control_line", "")).strip_edges()
	if combat_line.is_empty():
		combat_line = _build_selected_fireteam_combat_hud_line()
	var prioritized: PackedStringArray = PackedStringArray()
	if not contact_fire_primary_line.is_empty():
		prioritized.append(_compact_release_first_exchange_contact_fire_line(contact_fire_primary_line))
	if not decision_line.is_empty():
		prioritized.append(_compact_release_first_exchange_contact_fire_secondary_line(decision_line))
	if not contact_fire_primary_line.is_empty():
		return prioritized
	for priority_line_variant in source_lines:
		var priority_line: String = String(priority_line_variant).strip_edges()
		var priority_upper: String = priority_line.to_upper()
		if priority_upper.contains("AA ") and priority_upper.contains("COM ") and priority_upper.contains("OBJ") and priority_upper.contains("CARGO"):
			prioritized.append(priority_line)
			break
	if not combat_line.is_empty() and decision_line.is_empty():
		prioritized.append("Kampf %s" % combat_line)
	for line_variant in source_lines:
		var line: String = String(line_variant).strip_edges()
		if line.is_empty() or prioritized.has(line) or line == decision_line:
			continue
		if not decision_line.is_empty() and bool(SELECTED_FIRETEAM_DECISION_PRESENTER_SCRIPT.call("is_raw_combat_diagnostic_line", line)):
			continue
		if not contact_fire_primary_line.is_empty() and line == contact_fire_primary_line:
			continue
		if not combat_line.is_empty() and (line == combat_line or line == "Kampf %s" % combat_line):
			continue
		prioritized.append(line)
		var visible_line_budget: int = 3 if not decision_line.is_empty() else RELEASE_FIREFIGHT_BOTTOM_DOCK_DENSITY_MAX_LINES
		if prioritized.size() >= visible_line_budget:
			break
	return prioritized


func _build_mission_hud_interaction_density_snapshot(station_route_readout_override: Dictionary = {}, station_route_cue_override: Dictionary = {}, interaction_progress_readability_override: Dictionary = {}) -> Dictionary:
	var station_route_readout: Dictionary = station_route_readout_override.duplicate(true) if not station_route_readout_override.is_empty() else _build_station_route_run_readout_snapshot()
	var station_route_line: String = String(station_route_readout.get("compact_line", "")).strip_edges()
	var station_route_cue: Dictionary = station_route_cue_override.duplicate(true) if not station_route_cue_override.is_empty() else get_station_scenario_route_cue_polish_snapshot()
	var station_route_cue_line: String = String(station_route_cue.get("cue_line", "")).strip_edges()
	var station_route_cue_runtime_status: String = String(station_route_cue.get("runtime_status", "")).strip_edges().to_lower()
	var station_route_line_deferred_to_identity: bool = not station_route_line.is_empty() and not station_route_cue_line.is_empty()
	var objective_cargo_deferred_to_route_cue: bool = not station_route_cue_line.is_empty() and station_route_cue_runtime_status != "complete"
	var objective_line: String = _build_mission_objective_interaction_line().strip_edges()
	var cargo_line: String = _build_mission_cargo_extract_line().strip_edges()
	var interaction_progress_readability: Dictionary = interaction_progress_readability_override.duplicate(true) if not interaction_progress_readability_override.is_empty() else _build_mission_interaction_progress_readability_snapshot()
	var interaction_progress_line: String = String(interaction_progress_readability.get("compact_line", "")).strip_edges()
	var interaction_progress_deferred_to_route_cue: bool = not station_route_cue_line.is_empty() and station_route_cue_runtime_status != "in_progress"
	var contact_diagnostics_text: String = _build_mission_control_contact_diagnostics_text().strip_edges()
	var combat_hud_snapshot: Dictionary = _build_mission_combat_hud_density_snapshot()
	var combat_hud_line: String = String(combat_hud_snapshot.get("mission_control_line", "")).strip_edges()
	var combat_or_contact_line: String = combat_hud_line if not combat_hud_line.is_empty() else contact_diagnostics_text
	var combat_deferred_to_complete_route: bool = station_route_cue_runtime_status == "complete" and bool(SELECTED_FIRETEAM_DECISION_PRESENTER_SCRIPT.call("is_raw_combat_diagnostic_line", combat_or_contact_line))
	var fire_rule_text: String = _compact_fire_rule_for_hud(_get_selected_fire_rule_consensus())
	var fire_rule_consequence: Dictionary = get_fire_rule_consequence_readability_snapshot()
	var fire_rule_consequence_token: String = String(fire_rule_consequence.get("hud_token", "")).strip_edges().to_upper()
	var source_lines: PackedStringArray = PackedStringArray()
	if not station_route_line.is_empty():
		source_lines.append(station_route_line)
	if not station_route_cue_line.is_empty():
		source_lines.append(station_route_cue_line)
	if not interaction_progress_line.is_empty():
		source_lines.append(interaction_progress_line)
	if not objective_line.is_empty():
		source_lines.append(objective_line)
	if not cargo_line.is_empty():
		source_lines.append(cargo_line)
	if not combat_or_contact_line.is_empty():
		source_lines.append(combat_or_contact_line)
	var compact_parts: PackedStringArray = PackedStringArray()
	if not station_route_line.is_empty() and not station_route_line_deferred_to_identity:
		compact_parts.append(station_route_line)
	if not station_route_cue_line.is_empty():
		compact_parts.append(station_route_cue_line)
	if not interaction_progress_line.is_empty() and not interaction_progress_deferred_to_route_cue:
		compact_parts.append(interaction_progress_line)
	if not objective_line.is_empty() and not objective_cargo_deferred_to_route_cue:
		compact_parts.append(objective_line)
	if not cargo_line.is_empty() and not objective_cargo_deferred_to_route_cue:
		compact_parts.append(cargo_line)
	if not fire_rule_consequence_token.is_empty():
		compact_parts.append("ROE %s" % fire_rule_consequence_token)
	elif not fire_rule_text.is_empty():
		compact_parts.append("ROE %s" % fire_rule_text)
	if not combat_or_contact_line.is_empty() and not combat_deferred_to_complete_route:
		compact_parts.append(combat_or_contact_line)
	var mission_control_line: String = ""
	if not compact_parts.is_empty():
		mission_control_line = "ACT %s" % " | ".join(compact_parts)
	var line_limit: int = 180
	var visible_lines: PackedStringArray = PackedStringArray()
	if not mission_control_line.is_empty():
		visible_lines.append(mission_control_line)
	return {
		"active": not mission_control_line.is_empty(),
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"source": "objective_cargo_contact_roe_combat_snapshots",
		"mission_control_line": mission_control_line,
		"visible_lines": Array(visible_lines),
		"visible_line_count": visible_lines.size(),
		"max_visible_line_count": 1,
		"source_lines": Array(source_lines),
		"source_line_count": source_lines.size(),
		"line_char_limit": line_limit,
		"max_line_length": _max_string_length(Array(visible_lines)),
		"line_within_limit": _max_string_length(Array(visible_lines)) <= line_limit,
		"objective_line": objective_line,
		"cargo_line": cargo_line,
		"station_route_line": station_route_line,
		"station_route_run_readout": station_route_readout,
		"station_route_cue_line": station_route_cue_line,
		"station_scenario_route_cue_polish": station_route_cue,
		"station_route_line_deferred_to_identity": station_route_line_deferred_to_identity,
		"objective_cargo_deferred_to_route_cue": objective_cargo_deferred_to_route_cue,
		"interaction_progress_deferred_to_route_cue": interaction_progress_deferred_to_route_cue,
		"station_route_density_policy_id": "station_route_identity_body_act_cue_v1",
		"station_route_cue_prioritized": station_route_line_deferred_to_identity,
		"interaction_progress_line": interaction_progress_line,
		"interaction_progress_readability": interaction_progress_readability,
		"combat_line": combat_hud_line,
		"contact_line": contact_diagnostics_text,
		"fire_rule": _get_selected_fire_rule_consensus(),
		"fire_rule_text": fire_rule_text,
		"fire_rule_consequence": fire_rule_consequence,
		"fire_rule_consequence_token": fire_rule_consequence_token,
		"fire_rule_consequence_line": String(fire_rule_consequence.get("consequence_line", "")),
		"combat_hud_density": combat_hud_snapshot,
		"contains_contact_or_combat": not combat_or_contact_line.is_empty(),
		"contains_roe": not fire_rule_text.is_empty(),
		"contains_roe_consequence": not fire_rule_consequence_token.is_empty() and mission_control_line.contains("ROE %s" % fire_rule_consequence_token),
		"contains_suppress": fire_rule_text == "SUP" or mission_control_line.to_upper().contains("SUP"),
		"contains_interaction_progress": not interaction_progress_line.is_empty() and mission_control_line.contains(interaction_progress_line),
		"contains_objective": not objective_line.is_empty() and mission_control_line.contains(objective_line),
		"contains_cargo": not cargo_line.is_empty() and mission_control_line.contains(cargo_line),
		"contains_station_route": not station_route_line.is_empty() and mission_control_line.contains(station_route_line),
		"station_route_source_available": not station_route_line.is_empty(),
		"contains_station_route_cue": not station_route_cue_line.is_empty() and mission_control_line.contains(station_route_cue_line),
	}


func _build_station_route_run_readout_snapshot(objective_gate: Dictionary = {}, object_reaction: Dictionary = {}) -> Dictionary:
	var gate_snapshot: Dictionary = objective_gate if not objective_gate.is_empty() else get_mission_interaction_objective_gate_snapshot()
	var reaction_snapshot: Dictionary = object_reaction if not object_reaction.is_empty() else get_mission_interaction_object_reaction_snapshot()
	var entries: Array = Array(reaction_snapshot.get("entries", []))
	var aa_token: String = _station_route_token_for_kind(entries, "aa")
	var door_token: String = _station_route_token_for_kind(entries, "door")
	var computer_token: String = _station_route_token_for_kind(entries, "computer")
	var cargo_token: String = _station_route_token_for_kind(entries, "cargo")
	var route_has_content: bool = door_token != "DOOR -"
	var next_token: String = _station_route_next_token(gate_snapshot)
	var compact_line: String = ""
	if route_has_content:
		compact_line = "ROUTE %s > %s > %s > %s | NEXT %s" % [aa_token, door_token, computer_token, cargo_token, next_token]
	var line_limit: int = 120
	return {
		"schema": "sternenbuergerchen.station_route_run_readout.v1",
		"active": route_has_content,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"source": "mission_interaction_objective_gate_and_object_reaction",
		"compact_line": compact_line,
		"visible_lines": [compact_line] if not compact_line.is_empty() else [],
		"visible_line_count": 1 if not compact_line.is_empty() else 0,
		"max_visible_line_count": 1,
		"line_char_limit": line_limit,
		"line_length": compact_line.length(),
		"line_within_limit": compact_line.length() <= line_limit,
		"aa_token": aa_token,
		"door_token": door_token,
		"computer_token": computer_token,
		"cargo_token": cargo_token,
		"next_token": next_token,
		"next_step_id": String(gate_snapshot.get("next_step_id", "")),
		"next_interaction_id": String(gate_snapshot.get("next_interaction_id", "")),
		"all_gates_complete": bool(gate_snapshot.get("all_gates_complete", false)),
		"object_reaction_count": int(reaction_snapshot.get("object_reaction_count", entries.size())),
	}


func get_station_scenario_route_cue_polish_snapshot() -> Dictionary:
	var objective_gate: Dictionary = get_mission_interaction_objective_gate_snapshot()
	var use_feedback: Dictionary = get_mission_interaction_use_feedback_snapshot()
	var progress_readability: Dictionary = _build_mission_interaction_progress_readability_snapshot(use_feedback)
	var visual_state: Dictionary = Dictionary(MISSION_INTERACTION_VISUAL_STATE_SCRIPT.call(
		"build_snapshot",
		get_mission_interaction_runtime_use_state_snapshot(),
		objective_gate
	)).duplicate(true)
	var object_reaction: Dictionary = Dictionary(MISSION_INTERACTION_OBJECT_REACTION_SCRIPT.call(
		"build_snapshot",
		visual_state
	)).duplicate(true)
	var route_readout: Dictionary = _build_station_route_run_readout_snapshot(objective_gate, object_reaction)
	return _build_station_scenario_route_cue_polish_snapshot(route_readout, objective_gate, use_feedback, progress_readability)


func _build_station_scenario_debrief_handoff_cue_snapshot(route_readout: Dictionary = {}, station_route_cue: Dictionary = {}, identity_body: Dictionary = {}, interaction_density: Dictionary = {}) -> Dictionary:
	var resolved_route_readout: Dictionary = route_readout.duplicate(true)
	if resolved_route_readout.is_empty():
		resolved_route_readout = _build_station_route_run_readout_snapshot()
	var resolved_station_route_cue: Dictionary = station_route_cue.duplicate(true)
	if resolved_station_route_cue.is_empty():
		resolved_station_route_cue = get_station_scenario_route_cue_polish_snapshot()
	var resolved_identity_body: Dictionary = identity_body.duplicate(true)
	if resolved_identity_body.is_empty():
		resolved_identity_body = build_station_scenario_identity_body_snapshot(resolved_route_readout, [], resolved_station_route_cue)
	var resolved_density: Dictionary = interaction_density.duplicate(true)
	if resolved_density.is_empty():
		resolved_density = _build_mission_hud_interaction_density_snapshot(resolved_route_readout, resolved_station_route_cue)
	var route_line: String = String(resolved_route_readout.get("compact_line", "")).strip_edges()
	var display_route_line: String = String(resolved_identity_body.get("display_route_line", "")).strip_edges()
	var cue_line: String = String(resolved_station_route_cue.get("cue_line", "")).strip_edges()
	var mission_control_line: String = String(resolved_density.get("mission_control_line", "")).strip_edges()
	var route_complete: bool = bool(resolved_route_readout.get("all_gates_complete", false)) and String(resolved_route_readout.get("next_token", "")).strip_edges().to_upper() == "DONE"
	var cue_points_to_debrief: bool = cue_line.contains("Debrief")
	var handoff_ready: bool = bool(resolved_route_readout.get("active", false)) and route_complete and cue_points_to_debrief
	var handoff_line: String = "HANDOFF Debrief bereit | danach Homebase" if handoff_ready else ""
	var chain: PackedStringArray = PackedStringArray(["station_route_complete", "debrief_review", "return_homebase"]) if handoff_ready else PackedStringArray()
	return {
		"schema": "sternenbuergerchen.station_scenario_debrief_handoff_cue.v1",
		"task_id": "TASK_743",
		"active": bool(resolved_route_readout.get("active", false)),
		"style_id": "station_scenario_debrief_handoff_cue_v1",
		"source": "station_route_readout_route_cue_identity_body_density",
		"route_complete": route_complete,
		"handoff_ready": handoff_ready,
		"handoff_line": handoff_line,
		"handoff_line_char_limit": 72,
		"handoff_line_within_limit": handoff_line.length() <= 72,
		"handoff_chain": chain,
		"debrief_action_label": "Debrief pruefen" if handoff_ready else "",
		"homebase_followup_label": "Danach Homebase" if handoff_ready else "",
		"route_line": route_line,
		"display_route_line": display_route_line,
		"cue_line": cue_line,
		"mission_control_line": mission_control_line,
		"identity_body_text": String(resolved_identity_body.get("text", "")),
		"cue_points_to_debrief": cue_points_to_debrief,
		"creates_navigation": false,
		"creates_command": false,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"recommended_next_task": "TASK_727 - Station Scenario F6/Host Client Playtest Notes",
	}


func get_station_scenario_debrief_handoff_cue_snapshot() -> Dictionary:
	var command_feedback: Dictionary = get_command_feedback_snapshot()
	var handoff: Dictionary = Dictionary(command_feedback.get("station_scenario_debrief_handoff_cue", {})).duplicate(true)
	var mission_control_text: String = String(command_feedback.get("mission_control_status_text", "")).strip_edges()
	var handoff_line: String = String(handoff.get("handoff_line", "")).strip_edges()
	if bool(handoff.get("handoff_ready", false)) and not handoff_line.is_empty() and not mission_control_text.contains(handoff_line):
		mission_control_text = _build_strategic_status_text()
	var chain: PackedStringArray = PackedStringArray(Array(handoff.get("handoff_chain", [])))
	var checks: Array = [
		_build_mission_first_move_readability_check(
			"station_route_complete",
			bool(handoff.get("route_complete", false)),
			"Station route is complete before the Debrief handoff appears."
		),
		_build_mission_first_move_readability_check(
			"cue_points_to_debrief",
			bool(handoff.get("cue_points_to_debrief", false)) and String(handoff.get("cue_line", "")).contains("Debrief"),
			"Station cue points to Debrief after Cargo is gone."
		),
		_build_mission_first_move_readability_check(
			"handoff_line_visible",
			bool(handoff.get("handoff_ready", false)) and not handoff_line.is_empty() and mission_control_text.contains(handoff_line),
			"Mission Control shows the Station Debrief/Homebase handoff line."
		),
		_build_mission_first_move_readability_check(
			"handoff_chain_complete",
			chain.has("station_route_complete") and chain.has("debrief_review") and chain.has("return_homebase"),
			"Handoff chain names station route completion, Debrief review and Homebase return."
		),
		_build_mission_first_move_readability_check(
			"identity_body_keeps_route_context",
			String(handoff.get("display_route_line", "")).contains("AA > DOOR > COM > CARGO") and String(handoff.get("identity_body_text", "")).contains(String(handoff.get("cue_line", ""))),
			"Identity body keeps the station route and final cue visible together."
		),
		_build_mission_first_move_readability_check(
			"handoff_line_compact",
			bool(handoff.get("handoff_line_within_limit", false)),
			"Station handoff line stays compact enough for Mission Control."
		),
		_build_mission_first_move_readability_check(
			"read_only",
			bool(handoff.get("read_only", false))
				and not bool(handoff.get("ui_sets_gameplay_truth", true))
				and not bool(handoff.get("creates_navigation", true))
				and not bool(handoff.get("creates_command", true)),
			"Station handoff cue reads existing state and does not navigate or enqueue commands."
		),
	]
	var failed_checks: Array = []
	for check_variant in checks:
		var check: Dictionary = Dictionary(check_variant)
		if not bool(check.get("passed", false)):
			failed_checks.append(String(check.get("id", "")))
	return {
		"schema": "sternenbuergerchen.station_scenario_debrief_handoff_cue.v1",
		"task_id": "TASK_743",
		"handoff": handoff,
		"handoff_line": handoff_line,
		"mission_control_status_text": mission_control_text,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"checks": checks,
		"failed_checks": failed_checks,
		"gate": "pass" if failed_checks.is_empty() else "review",
		"manual_review_required": true,
		"manual_review_done": false,
		"recommended_next_task": "TASK_727 - Station Scenario F6/Host Client Playtest Notes",
	}


