func _build_mission_combat_hud_detail_tooltip_snapshot_from_data(diagnostics: Dictionary, cover_readout: Dictionary, fire_event: Dictionary, compact_line: String) -> Dictionary:
	if diagnostics.is_empty() or compact_line.strip_edges().is_empty():
		return {
			"active": false,
			"tooltip_text": "",
			"detail_lines": [],
			"read_only": true,
			"ui_sets_gameplay_truth": false,
		}
	var primary: Dictionary = Dictionary(cover_readout.get("primary", cover_readout))
	var reason: String = String(diagnostics.get("reason", "")).strip_edges().to_upper()
	var status: String = String(diagnostics.get("status", "")).strip_edges().to_upper()
	var attacker_id: String = String(diagnostics.get("attacker_unit_id", fire_event.get("attacker_unit_id", ""))).strip_edges()
	var target_id: String = String(diagnostics.get("target_unit_id", diagnostics.get("actual_target_id", fire_event.get("target_unit_id", "")))).strip_edges()
	var pair_text: String = "%s -> %s" % [_compact_unit_id_for_diagnostics(attacker_id), _compact_unit_id_for_diagnostics(target_id)]
	var weapon_id: String = String(diagnostics.get("weapon_id", fire_event.get("weapon_id", ""))).strip_edges().to_upper()
	var outcome: String = String(fire_event.get("combat_outcome", diagnostics.get("outcome", ""))).strip_edges().to_upper()
	var state_bits: PackedStringArray = PackedStringArray()
	if not reason.is_empty():
		state_bits.append(reason)
	if not status.is_empty() and status != reason:
		state_bits.append(status)
	var fire_line: String = "Fire: %s" % (" / ".join(state_bits) if not state_bits.is_empty() else "CONTACT")
	if pair_text != "? -> ?":
		fire_line += " | %s" % pair_text
	if not weapon_id.is_empty():
		fire_line += " | %s" % weapon_id
	if not outcome.is_empty():
		fire_line += " | %s" % outcome
	var cover_line: String = "Cover: %s | Range: %s" % [
		_compact_cover_effectiveness_label(String(primary.get("cover_state", "unknown"))),
		_compact_cover_effectiveness_label(String(primary.get("range_state", "unknown"))),
	]
	var sight_line: String = "LOS: %s | Flank: %s" % [
		_compact_cover_effectiveness_label(String(primary.get("los_state", "unknown"))),
		_compact_cover_effectiveness_label(String(primary.get("flank_state", "unknown"))),
	]
	var why_line: String = "Tokens: COV cover, RNG range, LOS sight, FLK flank"
	var detail_lines: PackedStringArray = PackedStringArray([fire_line, cover_line, sight_line, why_line])
	var tooltip_text: String = "\n".join(detail_lines)
	var line_limit: int = 112
	return {
		"active": true,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"compact_line": compact_line,
		"tooltip_text": tooltip_text,
		"detail_lines": Array(detail_lines),
		"detail_line_count": detail_lines.size(),
		"tooltip_line_limit": line_limit,
		"max_tooltip_line_length": _max_string_length(Array(detail_lines)),
		"tooltip_within_limit": _max_string_length(Array(detail_lines)) <= line_limit,
		"contains_fire_state": _combat_hud_line_contains_any(fire_line, ["FIRE", "WAIT", "NO FIRE", "CONTACT", "FIRED", "COOLDOWN"]),
		"contains_cover_detail": cover_line.contains("Cover:"),
		"contains_range_detail": cover_line.contains("Range:"),
		"contains_los_detail": sight_line.contains("LOS:"),
		"contains_flank_detail": sight_line.contains("Flank:"),
	}


func _build_mission_combat_hud_compact_line(diagnostics: Dictionary, cover_readout: Dictionary, fire_event: Dictionary) -> String:
	if diagnostics.is_empty():
		return ""
	var reason: String = String(diagnostics.get("reason", "")).strip_edges().to_lower()
	var status: String = String(diagnostics.get("status", "")).strip_edges().to_lower()
	var attacker_id: String = String(diagnostics.get("attacker_unit_id", fire_event.get("attacker_unit_id", ""))).strip_edges()
	var target_id: String = String(diagnostics.get("target_unit_id", diagnostics.get("actual_target_id", fire_event.get("target_unit_id", "")))).strip_edges()
	var pair_text: String = "%s>%s" % [_compact_unit_id_for_diagnostics(attacker_id), _compact_unit_id_for_diagnostics(target_id)]
	var cover_tokens: String = _build_mission_combat_cover_token_text(cover_readout)
	if reason == "fired" or status == "fired":
		var weapon_id: String = String(diagnostics.get("weapon_id", fire_event.get("weapon_id", ""))).strip_edges().to_upper()
		var outcome: String = String(fire_event.get("combat_outcome", "")).strip_edges().to_upper()
		var fire_bits: PackedStringArray = PackedStringArray(["FIRE", pair_text])
		if bool(diagnostics.get("suppress_intent_active", false)):
			fire_bits.append("SUP")
		if not weapon_id.is_empty():
			fire_bits.append(weapon_id)
		if not outcome.is_empty():
			fire_bits.append(outcome)
		return "%s | %s" % [" ".join(fire_bits), cover_tokens]
	if reason == "cooldown" or status == "waiting":
		var wait_bits: PackedStringArray = PackedStringArray(["WAIT"])
		if bool(diagnostics.get("suppress_intent_active", false)):
			wait_bits.append("SUP")
		wait_bits.append("%dt" % int(diagnostics.get("cooldown_ticks_remaining", 0)))
		wait_bits.append(pair_text)
		return "%s | %s" % [" ".join(wait_bits), cover_tokens]
	if reason == "no_contact_pair":
		var candidate: Dictionary = Dictionary(diagnostics.get("candidate", {}))
		var candidate_reason: String = String(candidate.get("candidate_reason", reason)).strip_edges().to_upper()
		return "NO FIRE %s | F%d/E%d | %s" % [
			candidate_reason,
			int(diagnostics.get("active_friendly_count", 0)),
			int(diagnostics.get("active_enemy_count", 0)),
			cover_tokens,
		]
	if reason == "no_damage_effect" or reason == "invalid_contact_pair":
		return "NO FIRE %s %s | %s" % [reason.to_upper(), pair_text, cover_tokens]
	if not reason.is_empty():
		return "CONTACT %s | F%d/E%d | %s" % [
			reason.to_upper(),
			int(diagnostics.get("active_friendly_count", 0)),
			int(diagnostics.get("active_enemy_count", 0)),
			cover_tokens,
		]
	return ""


func _build_mission_combat_cover_token_text(cover_readout: Dictionary) -> String:
	var primary: Dictionary = Dictionary(cover_readout.get("primary", cover_readout))
	return "COV %s RNG %s LOS %s FLK %s" % [
		_compact_cover_effectiveness_label(String(primary.get("cover_state", "unknown"))),
		_compact_cover_effectiveness_label(String(primary.get("range_state", "unknown"))),
		_compact_cover_effectiveness_label(String(primary.get("los_state", "unknown"))),
		_compact_cover_effectiveness_label(String(primary.get("flank_state", "unknown"))),
	]


func _combat_hud_line_contains_any(line: String, tokens: Array) -> bool:
	var normalized_line: String = line.strip_edges().to_upper()
	for token_variant in tokens:
		if normalized_line.contains(String(token_variant).to_upper()):
			return true
	return false


func _max_string_length(lines: Array) -> int:
	var result: int = 0
	for line_variant in lines:
		result = maxi(result, String(line_variant).length())
	return result


func _build_meta_transfer_status_text() -> String:
	if not preview_mode or _meta_transfer_routes.is_empty():
		return ""
	var operator_count: int = 0
	var craft_count: int = 0
	var next_eta_seconds: int = 0
	for route_variant in _meta_transfer_routes:
		if typeof(route_variant) != TYPE_DICTIONARY:
			continue
		var route: Dictionary = Dictionary(route_variant)
		if String(route.get("entry_type", "team")).strip_edges().to_lower() == "pilot":
			craft_count += 1
		else:
			operator_count += maxi(int(route.get("member_count", 0)), 1)
		var eta_seconds: int = maxi(int(route.get("eta_seconds", 0)), 0)
		if eta_seconds > 0 and (next_eta_seconds <= 0 or eta_seconds < next_eta_seconds):
			next_eta_seconds = eta_seconds
	var summary_bits: PackedStringArray = []
	if operator_count > 0:
		summary_bits.append("%d NPC" % operator_count)
	if craft_count > 0:
		summary_bits.append("%d Craft" % craft_count)
	if summary_bits.is_empty():
		summary_bits.append("%d aktiv" % _meta_transfer_routes.size())
	if next_eta_seconds > 0:
		return "HB->FOB %s | ETA %ds" % [" + ".join(summary_bits), next_eta_seconds]
	return "HB->FOB %s" % " + ".join(summary_bits)


func _build_phase_status_text() -> String:
	if not PHASE_PLANNING_ENABLED:
		return "Direktmodus | GO fuehrt zum naechsten Zielpunkt"
	var phase_controller = _get_phase_controller()
	if phase_controller == null:
		return "Active P0 PRE | Edit %s" % _get_phase_name()
	return "Active %s | Edit %s" % [
		String(phase_controller.call("get_active_phase_name")),
		String(phase_controller.call("get_selected_phase_name")),
	]


func _build_mission_time_limit_text() -> String:
	var combat_driver = _get_combat_loop_driver()
	if combat_driver == null or not combat_driver.has_method("get_remaining_time_limit_seconds"):
		return "Time --:--"
	var remaining_seconds: float = float(combat_driver.call("get_remaining_time_limit_seconds"))
	if remaining_seconds < 0.0:
		return "Time --:--"
	var minutes: int = int(floor(remaining_seconds / 60.0))
	var seconds: int = int(remaining_seconds) % 60
	return "Time %02d:%02d" % [minutes, seconds]


func _is_mission_drop_available() -> bool:
	var air_state: String = str(get_air_asset_status_snapshot().get("state", "intact")).strip_edges().to_lower()
	if bool(AIR_ASSET_STATUS_SCRIPT.call("is_terminal_state", air_state)) or air_state == "recovering" or air_state == "unavailable":
		return false
	var selected_card: Dictionary = _find_mission_dropship_card_entry(_mission_drop_craft_id)
	if not selected_card.is_empty():
		return String(selected_card.get("state", "")).strip_edges().to_lower() == "waiting"
	if _mission_drop_state == "waiting":
		return true
	if _drop_ship_staged and _mission_drop_craft_id.is_empty():
		return true
	return _mission_drop_craft_id.is_empty() and not _embarked_unit_ids.is_empty() and _deployed_unit_ids.is_empty()


