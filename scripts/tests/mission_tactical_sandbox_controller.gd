func _on_fireteam_mini_card_gui_input(event: InputEvent, fireteam_id: String) -> void:
	if event is InputEventMouseButton:
		var mouse_button_event := event as InputEventMouseButton
		if mouse_button_event.button_index != MOUSE_BUTTON_LEFT:
			return
		_cancel_selection_interaction()
		get_viewport().set_input_as_handled()
		if mouse_button_event.pressed:
			_on_fireteam_group_pressed(fireteam_id)


func _on_fireteam_mini_reference_card_pressed(fireteam_id: String) -> void:
	_cancel_selection_interaction()
	var viewport := get_viewport()
	if viewport != null:
		viewport.set_input_as_handled()
	_on_fireteam_group_pressed(fireteam_id)


func _get_mission_fireteam_loadout_id(fireteam_id: String) -> String:
	var definition: Dictionary = _get_mission_fireteam_definition(fireteam_id)
	var loadout_id: String = String(definition.get("loadout", definition.get("loadout_id", "medium"))).strip_edges()
	return loadout_id if not loadout_id.is_empty() else "medium"


func _get_selected_member_cards_fireteam_id() -> String:
	if _selected_fireteam_ids.size() != 1:
		return ""
	var selected_fireteam_id: String = _get_selected_fireteam_id().strip_edges().to_lower()
	if selected_fireteam_id.is_empty():
		return ""
	if _is_fireteam_runtime_active(selected_fireteam_id) or not _filter_ground_fireteam_card_units(_get_fireteam_units(selected_fireteam_id, true)).is_empty():
		return selected_fireteam_id
	if _fireteam_has_embarked_payload(selected_fireteam_id):
		return selected_fireteam_id
	return ""


func _is_selected_member_card_unit(unit: Node, selected_cards_fireteam_id: String) -> bool:
	if unit == null:
		return false
	var normalized_fireteam_id: String = selected_cards_fireteam_id.strip_edges().to_lower()
	if normalized_fireteam_id.is_empty():
		return _is_unit_selected(unit)
	if not unit.has_method("get_fireteam_id"):
		return false
	return String(unit.call("get_fireteam_id")).strip_edges().to_lower() == normalized_fireteam_id


func _apply_fireteam_mini_card_leader_portrait(card: Control, lead) -> void:
	if card == null:
		return
	var native_a5_style: bool = bool(card.get_meta("native_a5_portrait_team_card", false))
	var header_row := card.get_node_or_null("Margin/VBox/HeaderRow") as HBoxContainer
	if header_row == null:
		return
	var portrait_rect := header_row.get_node_or_null("LeaderPortraitRect") as TextureRect
	if lead == null:
		if portrait_rect != null:
			portrait_rect.visible = false
			portrait_rect.set_meta("mission_fireteam_leader_portrait_signature", "none")
		return
	if portrait_rect == null:
		portrait_rect = TextureRect.new()
		portrait_rect.name = "LeaderPortraitRect"
		portrait_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
		portrait_rect.visible = not native_a5_style
		# Identity is carried by the full member row below the team name. Keep
		# this existing leader marker compact rather than duplicating a large face.
		portrait_rect.custom_minimum_size = Vector2(24.0, 24.0)
		portrait_rect.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		portrait_rect.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
		header_row.add_child(portrait_rect)
		header_row.move_child(portrait_rect, 0)
	var profile = _build_profile_from_unit(lead)
	var portrait_id: String = ""
	var portrait_path: String = ""
	if profile != null:
		portrait_id = String(profile.get("portrait_id")).strip_edges()
		portrait_path = String(profile.get("portrait_path")).strip_edges()
	if portrait_path.is_empty() and lead.has_method("get_portrait_path"):
		portrait_path = String(lead.call("get_portrait_path")).strip_edges()
	var lead_id: String = String(lead.call("get_unit_id")).strip_edges() if lead.has_method("get_unit_id") else String(lead.name).strip_edges()
	var portrait_signature: String = "%s|%s|%s" % [lead_id, portrait_id, portrait_path]
	if String(portrait_rect.get_meta("mission_fireteam_leader_portrait_signature", "")) == portrait_signature:
		portrait_rect.visible = not native_a5_style
		return
	portrait_rect.texture = _load_portrait_identity_texture(portrait_id, portrait_path)
	portrait_rect.modulate = Color.WHITE if portrait_rect.texture != null else Color(0.36, 0.39, 0.44, 1.0)
	portrait_rect.set_meta("mission_fireteam_leader_portrait", true)
	portrait_rect.set_meta("mission_fireteam_leader_portrait_signature", portrait_signature)
	portrait_rect.visible = false # Member portraits carry identity in A5, without a duplicate tiny face.


func _apply_fireteam_mini_card_status_context(card: Control, fireteam_id: String, units: Array = []) -> void:
	if card == null:
		return
	var normalized_fireteam_id: String = fireteam_id.strip_edges().to_lower()
	var profile_dict: Dictionary = get_active_behavior_profile(normalized_fireteam_id)
	var contact_context: Dictionary = _build_fireteam_contact_badge_context(normalized_fireteam_id)
	var coordination_context: Dictionary = _build_fireteam_coordination_badge_context(normalized_fireteam_id)
	var status_snapshot: Dictionary = _build_fireteam_status_card_entry(normalized_fireteam_id, units, profile_dict, contact_context)
	var tooltip_parts: PackedStringArray = PackedStringArray()
	var execution_text: String = _build_execution_quality_tooltip_text(profile_dict)
	if not execution_text.is_empty():
		tooltip_parts.append(execution_text)
	var ftl_text: String = _build_ftl_quality_tooltip_text(profile_dict)
	if not ftl_text.is_empty():
		tooltip_parts.append(ftl_text)
	var morale_text: String = _build_morale_tooltip_text(profile_dict)
	if not morale_text.is_empty():
		tooltip_parts.append(morale_text)
	var contact_text: String = _build_fireteam_contact_tooltip_text(contact_context)
	if not contact_text.is_empty():
		tooltip_parts.append(contact_text)
	var coordination_text: String = _build_fireteam_coordination_tooltip_text(coordination_context)
	if not coordination_text.is_empty():
		tooltip_parts.append(coordination_text)
	card.tooltip_text = "\n".join(tooltip_parts)
	card.set_meta("execution_reason", String(profile_dict.get("execution_reason", "")).strip_edges().to_lower())
	card.set_meta("contact_state", String(contact_context.get("state", "")).strip_edges().to_lower())
	card.set_meta("tactical_stance", get_requested_tactical_stance(normalized_fireteam_id))
	card.set_meta("mission_fireteam_status_card_snapshot", status_snapshot.duplicate(true))
	card.set_meta("mission_fireteam_status_selected", bool(status_snapshot.get("selected", false)))
	_apply_fireteam_mini_status_summary(card, status_snapshot)
	_apply_fireteam_mini_suppression_indicator(card, status_snapshot)
	_apply_fireteam_mini_security_coverage_indicator(card, normalized_fireteam_id)
	_apply_fireteam_member_status_row(card, normalized_fireteam_id, units)
	_apply_fireteam_mini_member_portrait_strip(card, normalized_fireteam_id, units)
	_apply_fireteam_mini_readiness_footer(card, status_snapshot)
	_apply_fireteam_mini_contact_badge(card, contact_context)
	_clear_fireteam_mini_ftl_quality_indicator(card)
	_apply_fireteam_mini_morale_indicator(card, profile_dict)
	_apply_fireteam_mini_coordination_badge(card, coordination_context)
	_apply_fireteam_mini_stance_toggle(card, normalized_fireteam_id)


func _apply_fireteam_mini_status_summary(card: Control, status_snapshot: Dictionary) -> void:
	var native_a5_style: bool = bool(card.get_meta("native_a5_portrait_team_card", false))
	var stage_label := card.get_node_or_null("Margin/VBox/StageLabel") as Label
	var member_label := card.get_node_or_null("Margin/VBox/MemberLabel") as Label
	if stage_label != null:
		if not native_a5_style:
			stage_label.text = String(status_snapshot.get("primary_text", "")).strip_edges()
			stage_label.visible = not stage_label.text.is_empty()
		stage_label.tooltip_text = String(status_snapshot.get("tooltip_text", ""))
		stage_label.set_meta("mission_fireteam_status_secondary", true)
		stage_label.set_meta("mission_fireteam_visible_primary_status", true)
		stage_label.set_meta("review_session_fireteam_context_text", String(status_snapshot.get("review_session_context_text", "")))
		stage_label.set_meta("review_session_fireteam_context_visible", bool(status_snapshot.get("review_session_context_visible", false)))
		stage_label.set_meta("review_session_fireteam_context_style_id", String(status_snapshot.get("review_session_context_style_id", "")))
	if member_label != null:
		var lead_summary: String = String(card.get_meta("mission_fireteam_lead_summary", "")).strip_edges()
		member_label.text = _compact_fireteam_mini_identity_text(lead_summary, int(status_snapshot.get("member_count", 0)))
		if not native_a5_style:
			member_label.visible = not member_label.text.is_empty()
		member_label.tooltip_text = String(status_snapshot.get("tooltip_text", ""))
		member_label.set_meta("mission_fireteam_status_primary", true)
		member_label.set_meta("mission_fireteam_visible_identity_summary", true)


func _apply_left_tactical_stack_1280_mini_card_style(card: Control, selected_fireteam: bool) -> void:
	if card == null:
		return
	# Keep the final native fields with their existing presenter. The remaining
	# legacy fonts, hidden detail presentation and compatibility metadata still
	# initialize normally, including on a card's first pass before A5 owns it.
	var native_a5_style: bool = bool(card.get_meta("native_a5_portrait_team_card", false))
	if not native_a5_style:
		card.custom_minimum_size = Vector2(
			maxf(card.custom_minimum_size.x, LEFT_TACTICAL_STACK_1280_CARD_MIN_SIZE.x),
			maxf(card.custom_minimum_size.y, LEFT_TACTICAL_STACK_1280_CARD_MIN_SIZE.y)
		)
	card.set_meta("left_tactical_stack_1280_style_id", LEFT_TACTICAL_STACK_1280_READABILITY_STYLE_ID)
	card.set_meta("left_tactical_stack_1280_focus_style_applied", selected_fireteam)
	card.set_meta("left_tactical_stack_1280_ui_sets_gameplay_truth", false)
	var title_edit := card.get_node_or_null("Margin/VBox/HeaderRow/TitleEdit") as LineEdit
	if title_edit != null:
		var legacy_title_size: int = maxi(16, LEFT_TACTICAL_STACK_1280_TITLE_FONT_SIZE)
		if not native_a5_style:
			title_edit.add_theme_font_size_override("font_size", legacy_title_size)
		var heading_font: Font = TACTICAL_UI_THEME_SCRIPT.get_heading_font()
		if not title_edit.has_theme_font_override("font") or title_edit.get_theme_font("font") != heading_font:
			title_edit.add_theme_font_override("font", heading_font)
		var title_color: Color = TACTICAL_UI_THEME_SCRIPT.COLOR_BORDER_SELECTED if selected_fireteam else TACTICAL_UI_THEME_SCRIPT.COLOR_TEXT
		if not title_edit.has_theme_color_override("font_color") or title_edit.get_theme_color("font_color") != title_color:
			title_edit.add_theme_color_override("font_color", title_color)
		if not native_a5_style:
			title_edit.add_theme_color_override("font_uneditable_color", title_color)
		title_edit.set_meta("left_tactical_stack_1280_font_size", legacy_title_size)
	var stage_label := card.get_node_or_null("Margin/VBox/StageLabel") as Label
	if stage_label != null:
		if not native_a5_style:
			stage_label.add_theme_font_size_override("font_size", LEFT_TACTICAL_STACK_1280_STATUS_FONT_SIZE)
		stage_label.set_meta("left_tactical_stack_1280_font_size", LEFT_TACTICAL_STACK_1280_STATUS_FONT_SIZE)
	var member_label := card.get_node_or_null("Margin/VBox/MemberLabel") as Label
	if member_label != null:
		if not member_label.has_theme_font_size_override("font_size") or member_label.get_theme_font_size("font_size") != LEFT_TACTICAL_STACK_1280_DETAIL_LEAD_FONT_SIZE:
			member_label.add_theme_font_size_override("font_size", LEFT_TACTICAL_STACK_1280_DETAIL_LEAD_FONT_SIZE)
		member_label.set_meta("left_tactical_stack_1280_font_size", LEFT_TACTICAL_STACK_1280_LEAD_FONT_SIZE)
		member_label.set_meta("left_tactical_stack_1280_detail_font_size", LEFT_TACTICAL_STACK_1280_DETAIL_LEAD_FONT_SIZE)
		member_label.set_meta("left_tactical_stack_1280_detail_polish_member_strip", true)
	if not native_a5_style:
		card.custom_minimum_size = Vector2(
			maxf(card.custom_minimum_size.x, LEFT_TACTICAL_STACK_1280_DETAIL_CARD_MIN_SIZE.x),
			maxf(card.custom_minimum_size.y, LEFT_TACTICAL_STACK_1280_DETAIL_CARD_MIN_SIZE.y)
		)
	card.set_meta("left_tactical_stack_1280_detail_polish_style_id", LEFT_TACTICAL_STACK_1280_DETAIL_POLISH_STYLE_ID)
	card.set_meta("left_tactical_stack_1280_detail_polish_style_applied", true)
	if not native_a5_style:
		var stylebox: StyleBoxFlat = TACTICAL_UI_THEME_SCRIPT.build_flat_stylebox(
			TACTICAL_UI_THEME_SCRIPT.COLOR_PANEL_ALT if selected_fireteam else TACTICAL_UI_THEME_SCRIPT.COLOR_PANEL,
			TACTICAL_UI_THEME_SCRIPT.COLOR_BORDER_SELECTED if selected_fireteam else TACTICAL_UI_THEME_SCRIPT.COLOR_BORDER,
			4, LEFT_TACTICAL_STACK_1280_FOCUS_BORDER_WIDTH if selected_fireteam else 2
		)
		card.add_theme_stylebox_override("panel", stylebox)
	card.set_meta("native_r4_portrait_card", true)


func _compact_fireteam_mini_identity_text(lead_summary: String, member_count: int) -> String:
	var normalized_summary := lead_summary.strip_edges()
	var lead_name := "-"
	var lead_marker_index := normalized_summary.find("Lead ")
	if lead_marker_index >= 0:
		lead_name = normalized_summary.substr(lead_marker_index + 5).strip_edges()
	elif normalized_summary.begins_with("Lead"):
		lead_name = normalized_summary.trim_prefix("Lead").strip_edges()
	if lead_name.contains(" |"):
		lead_name = lead_name.get_slice(" |", 0).strip_edges()
	return "Lead %s | %d Ops" % [lead_name, maxi(member_count, 0)]


func _get_fireteam_mini_header_status_row(card: Control) -> HBoxContainer:
	var vbox := card.get_node_or_null("Margin/VBox") as VBoxContainer if card != null else null
	if vbox == null:
