func build_review_session_identity_snapshot(args: Array = []) -> Dictionary:
	var raw_args: Array = args.duplicate()
	var source := "provided_args"
	if raw_args.is_empty():
		raw_args = OS.get_cmdline_user_args()
		source = "OS.get_cmdline_user_args"
	var role := ""
	var team_id := ""
	var peer_id := 0
	for arg_variant in raw_args:
		var arg := String(arg_variant).strip_edges()
		if arg.begins_with("--review-role="):
			role = arg.substr("--review-role=".length()).strip_edges().to_lower()
		elif arg.begins_with("--peer-id="):
			var peer_text := arg.substr("--peer-id=".length()).strip_edges()
			if peer_text.is_valid_int():
				peer_id = int(peer_text)
		elif arg.begins_with("--team="):
			team_id = arg.substr("--team=".length()).strip_edges().to_lower()
	var team_label := _build_review_session_team_label(team_id)
	var display_tokens := PackedStringArray()
	if not role.is_empty():
		display_tokens.append(role.to_upper())
	if peer_id > 0:
		display_tokens.append("P%d" % peer_id)
	if not team_label.is_empty():
		display_tokens.append(team_label)
	var badge_text := " ".join(display_tokens)
	return {
		"active": not badge_text.is_empty(),
		"style_id": REVIEW_SESSION_BADGE_STYLE_ID,
		"source": source,
		"role": role,
		"role_label": role.to_upper(),
		"peer_id": peer_id,
		"peer_label": "P%d" % peer_id if peer_id > 0 else "",
		"team_id": team_id,
		"team_label": team_label,
		"badge_text": badge_text,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
	}


func get_local_command_team_id(args: Array = []) -> String:
	var simulation_root := get_node_or_null("../SimulationRoot")
	var multiplayer_api: MultiplayerAPI = multiplayer
	var peer: MultiplayerPeer = multiplayer_api.multiplayer_peer if multiplayer_api != null else null
	if simulation_root != null and peer != null and not (peer is OfflineMultiplayerPeer) \
			and peer.get_connection_status() != MultiplayerPeer.CONNECTION_DISCONNECTED:
		var peer_id: int = multiplayer_api.get_unique_id()
		if peer_id > 0 and simulation_root.has_method("get_peer_team"):
			var assigned_team_id: String = String(simulation_root.call("get_peer_team", peer_id)).strip_edges().to_lower()
			if not assigned_team_id.is_empty():
				return assigned_team_id
	var session: Dictionary = build_review_session_identity_snapshot(args) if not args.is_empty() else _get_review_session_identity_snapshot()
	var review_team_id: String = String(session.get("team_id", "")).strip_edges().to_lower()
	if bool(session.get("active", false)) and not review_team_id.is_empty():
		return review_team_id
	return FRIENDLY_TEAM_ID


func _build_review_session_team_label(team_id: String) -> String:
	var normalized_team := team_id.strip_edges().to_lower()
	match normalized_team:
		"team_alpha":
			return "ALPHA"
		"team_bravo":
			return "BRAVO"
	if normalized_team.begins_with("team_"):
		normalized_team = normalized_team.substr("team_".length())
	return normalized_team.to_upper()


func _get_review_session_identity_snapshot() -> Dictionary:
	# OS user arguments are immutable for this process. This is startup config,
	# not mission/team authority; get_local_command_team_id still reads peers live.
	if _process_review_identity.is_empty():
		_process_review_identity = build_review_session_identity_snapshot()
	return _process_review_identity.duplicate(true)


func build_station_scenario_identity_body_snapshot(route_readout: Dictionary = {}, args: Array = [], station_route_cue: Dictionary = {}) -> Dictionary:
	var session_snapshot: Dictionary = build_review_session_identity_snapshot(args) if not args.is_empty() else _get_review_session_identity_snapshot()
	var badge_text: String = String(session_snapshot.get("badge_text", "")).strip_edges()
	var resolved_route_readout: Dictionary = route_readout.duplicate(true)
	if resolved_route_readout.is_empty():
		resolved_route_readout = _build_station_route_run_readout_snapshot()
	var route_line: String = String(resolved_route_readout.get("compact_line", "")).strip_edges()
	var display_route_line: String = _build_station_route_sequence_display_line(resolved_route_readout)
	var resolved_station_route_cue: Dictionary = station_route_cue.duplicate(true)
	if resolved_station_route_cue.is_empty():
		resolved_station_route_cue = get_station_scenario_route_cue_polish_snapshot()
	var cue_line: String = String(resolved_station_route_cue.get("cue_line", "")).strip_edges()
	var route_active: bool = bool(resolved_route_readout.get("active", false)) and not route_line.is_empty()
	var base_text: String = "Realtime insertion feed"
	var text := base_text
	var tokens: PackedStringArray = PackedStringArray()
	if not badge_text.is_empty():
		tokens.append(badge_text)
	if not cue_line.is_empty():
		tokens.append(cue_line)
	if route_active:
		tokens.append(display_route_line if not display_route_line.is_empty() else route_line)
	elif badge_text.is_empty():
		tokens.append("live fireteam deployment")
	else:
		tokens.append(base_text)
	if not tokens.is_empty():
		if not cue_line.is_empty() and route_active:
			var first_line_tokens: PackedStringArray = PackedStringArray()
			if not badge_text.is_empty():
				first_line_tokens.append(badge_text)
			first_line_tokens.append(cue_line)
			text = "%s\n%s" % [" | ".join(first_line_tokens), display_route_line if not display_route_line.is_empty() else route_line]
		else:
			text = " | ".join(tokens)
	return {
		"schema": "sternenbuergerchen.station_scenario_identity_body.v1",
		"active": route_active,
		"style_id": "station_scenario_identity_route_body_v2",
		"text": text,
		"display_text": String(Dictionary(TACTICAL_HUD_LANGUAGE_PRESENTER_SCRIPT.call("identity_snapshot", text)).get("display_text", text)),
		"badge_text": badge_text,
		"route_line": route_line,
		"display_route_line": display_route_line,
		"cue_line": cue_line,
		"cue_visible": not cue_line.is_empty() and text.contains(cue_line),
		"future_blocker_hidden_in_display": not text.contains("CARGO BLOCK") and not text.contains("CARGO BLOCKED") and not text.contains("CARGO blockiert"),
		"route_next_token": String(resolved_route_readout.get("next_token", "")),
		"route_cue": resolved_station_route_cue.duplicate(true),
		"line_length": text.length(),
		"line_char_limit": 120,
		"line_within_limit": text.length() <= 120,
		"source": "review_session_and_station_route_run_readout",
		"read_only": true,
		"ui_sets_gameplay_truth": false,
	}


func _build_station_route_sequence_display_line(route_readout: Dictionary) -> String:
	if route_readout.is_empty() or not bool(route_readout.get("active", false)):
		return ""
	var tokens: Array[String] = []
	for key in ["aa_token", "door_token", "computer_token", "cargo_token"]:
		var token: String = String(route_readout.get(key, "")).strip_edges()
		if token.is_empty():
			continue
		var primary: String = token.split(" ", false, 1)[0].strip_edges()
		if primary.is_empty() or primary == "-":
			continue
		tokens.append(primary)
	if tokens.is_empty():
		return ""
	var next_token: String = String(route_readout.get("next_token", "")).strip_edges()
	var next_suffix: String = " | NEXT %s" % next_token if not next_token.is_empty() else ""
	return "ROUTE %s%s" % [" > ".join(tokens), next_suffix]


func _build_fireteam_review_session_card_context(fireteam_id: String = "", fireteam_team_id: String = "", session_snapshot: Dictionary = {}) -> Dictionary:
	var resolved_session: Dictionary = session_snapshot.duplicate(true) if not session_snapshot.is_empty() else _get_review_session_identity_snapshot()
	var context: Dictionary = Dictionary(STATION_REENTRY_HOST_CLIENT_FIRETEAM_CARD_CONTEXT_SCRIPT.call("build_context", resolved_session, {
		"fireteam_id": fireteam_id.strip_edges().to_lower(),
		"fireteam_team_id": fireteam_team_id.strip_edges().to_lower(),
		"fireteam_team_label": _build_review_session_team_label(fireteam_team_id),
	}))
	if not bool(resolved_session.get("active", false)):
		context["visible"] = false
		context["text"] = ""
		context["tooltip_text"] = ""
		context["inactive_session_hidden"] = true
	return context


func _with_review_session_badge(team_chip_snapshot: Dictionary) -> Dictionary:
	var result := team_chip_snapshot.duplicate(true)
	var session_snapshot: Dictionary = _get_review_session_identity_snapshot()
	var badge_text: String = String(session_snapshot.get("badge_text", "")).strip_edges()
	var authority_visual: Dictionary = Dictionary(result.get("authority_visual", {})).duplicate(true)
	var authority_compact_text: String = String(authority_visual.get("compact_text", result.get("authority_compact_text", ""))).strip_edges()
	var authority_visible_feedback_text: String = String(authority_visual.get("visible_feedback_text", result.get("authority_visible_feedback_text", ""))).strip_edges()
	var authority_visible_action_text: String = String(authority_visual.get("visible_action_text", result.get("authority_visible_action_text", ""))).strip_edges()
	var authority_tooltip_text: String = String(authority_visual.get("tooltip_text", result.get("authority_tooltip_text", ""))).strip_edges()
	var authority_visible: bool = bool(authority_visual.get("visible", result.get("authority_visible", false))) and not authority_compact_text.is_empty()
	var base_text: String = String(result.get("display_text", result.get("compact_status_text", result.get("status_text", "")))).strip_edges()
	var display_text := base_text
	var display_tokens: PackedStringArray = PackedStringArray()
	if not badge_text.is_empty():
		display_tokens.append(badge_text)
	if authority_visible:
		display_tokens.append(authority_compact_text)
	if authority_visible and not authority_visible_feedback_text.is_empty():
		display_tokens.append(authority_visible_feedback_text)
	if authority_visible and not authority_visible_action_text.is_empty():
		display_tokens.append(authority_visible_action_text)
	if not base_text.is_empty():
		display_tokens.append(base_text)
	if not display_tokens.is_empty():
		display_text = " | ".join(display_tokens)
	var base_tooltip: String = String(result.get("tooltip_text", result.get("status_text", ""))).strip_edges()
	var display_tooltip := base_tooltip
	var tooltip_tokens: PackedStringArray = PackedStringArray()
	if not badge_text.is_empty():
		tooltip_tokens.append("Review Session: %s" % badge_text)
	if authority_visible and not authority_tooltip_text.is_empty():
		tooltip_tokens.append(authority_tooltip_text)
	if not base_tooltip.is_empty():
		tooltip_tokens.append(base_tooltip)
	if not tooltip_tokens.is_empty():
		display_tooltip = "\n".join(tooltip_tokens)
	result["review_session"] = session_snapshot
	result["review_session_badge_text"] = badge_text
	result["review_session_badge_visible"] = not badge_text.is_empty()
	result["review_session_badge_style_id"] = REVIEW_SESSION_BADGE_STYLE_ID
	result["authority_visual"] = authority_visual
	result["authority_visible"] = authority_visible
	result["authority_compact_text"] = authority_compact_text
	result["authority_visible_feedback_text"] = authority_visible_feedback_text
	result["authority_visible_action_text"] = authority_visible_action_text
	result["authority_next_action_text"] = String(authority_visual.get("next_action_text", ""))
	result["authority_next_action_detail"] = String(authority_visual.get("next_action_detail", ""))
	result["authority_tooltip_text"] = authority_tooltip_text
	result["display_text"] = display_text
	result["display_tooltip_text"] = display_tooltip
	result["read_only"] = true
	result["ui_sets_gameplay_truth"] = false
	return result


