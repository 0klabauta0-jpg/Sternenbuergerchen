# Campaign pilot is a real sortie member. Assignment alone never authorizes flight.
func get_campaign_pilot_flight_guard(craft_id: String) -> Dictionary:
	if not get_parent().has_meta("campaign_ground_pilot_id"):
		return {"ok": true}
	var card: Dictionary = _find_mission_dropship_card_entry(craft_id)
	var pilot_id: String = String(card.get("pilot_unit_id", ""))
	if pilot_id.is_empty():
		return {"ok": false, "reason": "pilot_presence_unknown", "message": "Zugewiesener Pilot fehlt am Schiff"}
	var pilot = _get_campaign_sortie_unit(pilot_id)
	if pilot == null or not pilot.has_method("get_health") or int(pilot.call("get_health")) <= 0:
		return {"ok": false, "reason": "pilot_unavailable", "message": "Pilot ist nicht flugfaehig"}
	if _deployed_unit_ids.has(pilot_id) or not bool(pilot.get_meta("dropship_embarked", false)):
		return {"ok": false, "reason": "pilot_not_aboard", "message": "Pilot muss zum Schiff zurueck und wieder einsteigen"}
	var simulation: Node = get_node_or_null("../SimulationRoot")
	for effect: Dictionary in Array(simulation.get("effects_queue")) if simulation != null else []:
		if String(effect.get("unit_id", "")) == pilot_id and String(effect.get("effect_type", "")) in ["dropship_deploy_unit", "dropship_embark_unit"]:
			return {"ok": false, "reason": "pilot_boarding_pending", "message": "Pilot steigt ein"}
	return {"ok": true, "pilot_unit_id": pilot_id}


func _get_campaign_sortie_unit(unit_id: String) -> Node:
	var simulation: Node = get_node_or_null("../SimulationRoot")
	if simulation != null:
		var unit: Node = simulation.call("_resolve_known_unit", unit_id)
		if unit != null: return unit
	return null


func _get_campaign_sortie_units() -> Array:
	var result: Array = []
	var setup: Node = get_node_or_null("../MissionSetup")
	if setup == null: return result
	for id in PackedStringArray(setup.get("selected_team_unit_ids")):
		var unit = _get_campaign_sortie_unit(String(id))
		if unit != null: result.append(unit)
	return result


func assign_campaign_pilot(craft_id: String, unit_id: String) -> Dictionary:
	if not get_parent().has_meta("campaign_ground_pilot_id") or not _is_parked_campaign_dropship(craft_id):
		return {"ok": false, "reason": "craft_not_landed"}
	var unit = _get_campaign_sortie_unit(unit_id)
	var setup: Node = get_node_or_null("../MissionSetup")
	if setup == null or not PackedStringArray(setup.get("selected_team_unit_ids")).has(unit_id) or unit == null or int(unit.call("get_health")) <= 0:
		return {"ok": false, "reason": "unknown_pilot", "message": "Nur eine reale einsatzfaehige Person kann den Pilotenposten uebernehmen"}
	_update_mission_dropship_card_fields(craft_id, {"pilot_unit_id": unit_id, "pilot_display_name": String(unit.call("get_display_name")), "pilot_portrait_path": String(unit.call("get_portrait_path")), "pilot_text": "Pilot: " + String(unit.call("get_display_name"))})
	if craft_id == _mission_drop_craft_id:
		_mission_drop_pilot_unit_id = unit_id
		_mission_drop_pilot_display_name = String(unit.call("get_display_name"))
		_mission_drop_pilot_portrait_path = String(unit.call("get_portrait_path"))
		_mission_drop_pilot_text = "Pilot: " + _mission_drop_pilot_display_name
	_store_selected_mission_dropship_plan()
	_emit_planning_state_changed()
	_refresh_mission_dropship_panel()
	return {"ok": true, "pilot_unit_id": unit_id}


func _refresh_campaign_pilot_selector(card_panel: Control, card: Dictionary) -> void:
	if not get_parent().has_meta("campaign_ground_pilot_id"): return
	var host: Node = card_panel.get_node("MarginContainer/VBox")
	var selector := host.get_node_or_null("CampaignPilotSeat") as OptionButton
	if selector == null:
		selector = OptionButton.new()
		selector.name = "CampaignPilotSeat"
		selector.tooltip_text = "Pilotenposten: Jede reale Person kann ihn uebernehmen; vor Abflug wieder einsteigen."
		host.add_child(selector)
		selector.item_selected.connect(func(index: int): assign_campaign_pilot(String(card.get("craft_id", "")), String(selector.get_item_metadata(index))))
	var assigned_id: String = String(card.get("pilot_unit_id", ""))
	var candidates: Array = _get_campaign_sortie_units()
	var signature: String = assigned_id + ":" + str(candidates.size())
	if String(selector.get_meta("pilot_signature", "")) != signature:
		selector.clear()
		for unit in candidates:
			if unit == null or not unit.has_method("get_unit_id"): continue
			var id: String = String(unit.call("get_unit_id"))
			selector.add_item("Pilot: " + String(unit.call("get_display_name")))
			selector.set_item_metadata(selector.item_count - 1, id)
			if id == assigned_id: selector.select(selector.item_count - 1)
		selector.set_meta("pilot_signature", signature)
	selector.disabled = not _is_parked_campaign_dropship(String(card.get("craft_id", "")))
	selector.mouse_filter = Control.MOUSE_FILTER_STOP


func request_campaign_crew_boarding(craft_id: String) -> Dictionary:
	if not get_parent().has_meta("campaign_ground_pilot_id"): return {"ok": true}
	var pilot_id: String = String(_find_mission_dropship_card_entry(craft_id).get("pilot_unit_id", ""))
	var flight_guard: Dictionary = get_campaign_pilot_flight_guard(craft_id)
	if String(flight_guard.get("reason", "")) == "pilot_unavailable": return flight_guard
	var has_ground_crew := false
	for unit in _get_campaign_sortie_units():
		has_ground_crew = has_ground_crew or _deployed_unit_ids.has(String(unit.call("get_unit_id")))
	if bool(flight_guard.get("ok", false)) and not has_ground_crew: return flight_guard
	if not _is_parked_campaign_dropship(craft_id):
		return {"ok": false, "reason": "craft_not_landed", "message": "Schiff muss zum Einsteigen gelandet sein"}
	var ship_position: Vector2 = _drop_sequence_position if _is_active_drop_sequence_for_craft(craft_id) else _coerce_vector2_value(Dictionary(_parallel_drop_sequences_by_craft.get(craft_id, {})).get("position", Vector2.INF), Vector2.INF)
	var crew: Array = []
	for unit in _get_campaign_sortie_units():
		if unit == null or not unit.has_method("get_unit_id"): continue
		var id: String = String(unit.call("get_unit_id"))
		if not _deployed_unit_ids.has(id): continue
		if not unit is Node2D or int(unit.call("get_health")) <= 0:
			return {"ok": false, "reason": "crew_unavailable", "message": "Bodenteam ist nicht boardingbereit"}
		if (unit as Node2D).global_position.distance_to(ship_position) > 128.0:
			return {"ok": false, "reason": "pilot_not_at_ship" if id == pilot_id else "crew_not_at_ship", "message": "Alle Bodenpersonen muessen zuerst zum Schiff zuruecklaufen"}
		crew.append(unit)
	if crew.is_empty(): return flight_guard
	# Validate the whole group before any mutation. SimulationRoot commits presence.
	for unit in crew:
		var id: String = String(unit.call("get_unit_id"))
		_enqueue_dropship_embark_effect(unit, id, ship_position)
		_deployed_unit_ids.erase(id)
		_deployed_unit_positions.erase(id)
		_embarked_unit_ids[id] = true
		if _is_active_drop_sequence_for_craft(craft_id):
			_drop_sequence_embarked_unit_ids[id] = true
	_mission_drop_passenger_count = _embarked_unit_ids.size()
	_store_active_drop_sequence_card()
	_store_selected_mission_dropship_plan()
	_emit_planning_state_changed()
	return {"ok": false, "reason": "pilot_boarding_pending", "message": "Team steigt ein; Pilot uebernimmt seinen Posten"}


func _can_request_mission_dropship_return(card: Dictionary) -> bool:
	var craft_id: String = String(card.get("craft_id", "")).strip_edges()
	if craft_id.is_empty():
		return false
	if _is_parked_campaign_dropship(craft_id):
		return true
	if _has_live_drop_sequence_for_craft(craft_id):
		return false
	return String(card.get("state", "")).strip_edges().to_lower() == "waiting"


func _should_keep_campaign_dropship_landed() -> bool:
	# Explicit content opt-in only. A peaceful filename or an absent enemy is
	# not permission to change legacy combat or connected multiplayer transport.
	var peer: MultiplayerPeer = multiplayer.multiplayer_peer if is_inside_tree() else null
	if peer != null and not peer is OfflineMultiplayerPeer and peer.get_connection_status() != MultiplayerPeer.CONNECTION_DISCONNECTED:
		return false
	if get_parent().has_meta("campaign_ground_pilot_id"):
		return true
	var setup: Node = get_node_or_null("../MissionSetup")
	if setup == null:
		return false
	var scenario: Variant = setup.get("_mission_scenario")
	return scenario != null and scenario.has_method("is_noncombat_singleplayer") and bool(scenario.call("is_noncombat_singleplayer"))


func _is_parked_campaign_dropship(craft_id: String) -> bool:
	if not _should_keep_campaign_dropship_landed():
		return false
	if _is_active_drop_sequence_for_craft(craft_id):
		return _drop_sequence_phase == DROP_SEQUENCE_COMPLETE and _drop_sequence_position.is_equal_approx(_drop_sequence_lz_position)
	var sequence: Dictionary = Dictionary(_parallel_drop_sequences_by_craft.get(craft_id, {}))
	return String(sequence.get("phase", "")) == DROP_SEQUENCE_COMPLETE and _coerce_vector2_value(sequence.get("position", Vector2.ZERO), Vector2.ZERO).is_equal_approx(_coerce_vector2_value(sequence.get("lz_position", Vector2.ZERO), Vector2.ZERO))


func _get_authored_campaign_pad_position() -> Variant:
	if not _should_keep_campaign_dropship_landed():
		return null
	var map = _get_active_mission_terrain_map_data_for_readability()
	if map == null or not bool(map.call("has_marker", "spawn_alpha")):
		return null
	return Vector2(map.call("get_marker_position", "spawn_alpha"))


func _is_authored_campaign_pad_occupied(craft_id: String) -> bool:
	if typeof(_get_authored_campaign_pad_position()) != TYPE_VECTOR2:
		return false
	# These locations author one pad. Existing live sequences already describe
	# its use; keep a second craft waiting until the first clears its map flight.
	if _is_drop_sequence_active() and _drop_sequence_craft_id != craft_id:
		return true
	for id in _parallel_drop_sequences_by_craft:
		if String(id) != craft_id and _is_drop_sequence_dict_active(Dictionary(_parallel_drop_sequences_by_craft[id])):
			return true
	return false


func is_campaign_return_craft_at_authored_pad(craft_id: String) -> bool:
	# Compatibility name retained; return truth follows the actual bound craft.
	return _is_parked_campaign_dropship(craft_id)


func _can_request_mission_dropship_card_lz(card: Dictionary) -> bool:
	var craft_id: String = String(card.get("craft_id", "")).strip_edges()
	if craft_id.is_empty() or _is_mission_dropship_card_in_transit(card):
		return false
	if _has_live_drop_sequence_for_craft(craft_id):
		return false
	return String(card.get("state", "")).strip_edges().to_lower() == "waiting"


func _can_request_mission_dropship_card_drop(card: Dictionary) -> bool:
	if not _can_request_mission_dropship_card_lz(card):
		return false
	if not bool(card.get("has_lz_position", false)):
		return false
	if Array(card.get("embarked_unit_ids", [])).is_empty() and int(card.get("passenger_count", 0)) <= 0:
		return false
	return true


func _build_mission_dropship_card_drop_button_label(card: Dictionary) -> String:
	var state: String = String(card.get("state", "")).strip_edges().to_lower()
	match state:
		DROP_SEQUENCE_INBOUND:
			return "In"
		DROP_SEQUENCE_LANDED:
			return "TD"
		DROP_SEQUENCE_UNLOADING:
			return "Out"
		DROP_SEQUENCE_OUTBOUND:
			return "RTB"
		DROP_SEQUENCE_COMPLETE:
			return "Done"
		_:
			return "Drop"


func _restore_mission_dropship_action_button_mouse_filters(card_panel: PanelContainer) -> void:
	if card_panel == null:
		return
	for button_path in [
		"MarginContainer/VBox/HeaderRow/PrimaryActionButton",
		"MarginContainer/VBox/HeaderRow/SecondaryActionButton",
	]:
		var button := card_panel.get_node_or_null(button_path) as Button
		if button == null or not button.visible:
			continue
		button.mouse_filter = Control.MOUSE_FILTER_STOP
	for node in _collect_node_tree(card_panel):
		var payload_card := node as Control
		if payload_card != null and bool(payload_card.get_meta("mission_dropship_fireteam_payload_card", false)):
			payload_card.mouse_filter = Control.MOUSE_FILTER_STOP
			payload_card.focus_mode = Control.FOCUS_ALL
		var command_button := node as Button
		if command_button != null and bool(command_button.get_meta("mission_dropship_card_command_button", false)):
			command_button.mouse_filter = Control.MOUSE_FILTER_STOP


func _on_mission_dropship_fireteam_payload_gui_input(event: InputEvent, craft_id: String, fireteam_id: String) -> void:
	var should_select := false
	if event is InputEventMouseButton:
		var mouse_event := event as InputEventMouseButton
		should_select = mouse_event.button_index == MOUSE_BUTTON_LEFT and mouse_event.pressed
	elif event is InputEventKey:
		var key_event := event as InputEventKey
		should_select = key_event.pressed and (key_event.keycode == KEY_ENTER or key_event.keycode == KEY_SPACE)
	if not should_select:
		return
	if select_mission_dropship_fireteam(craft_id, fireteam_id):
		var viewport := get_viewport()
		if viewport != null:
			viewport.set_input_as_handled()


func _collect_node_tree(root_node: Node) -> Array:
	var result: Array = []
	if root_node == null:
		return result
	result.append(root_node)
	for child in root_node.get_children():
		result.append_array(_collect_node_tree(child))
	return result


func _ensure_mission_control_craft_summary() -> PanelContainer:
	var action_row := get_node_or_null("../TacticalUI/BottomDock/BottomMargin/BottomRow/StrategicPanel/StrategicMargin/StrategicScroll/StrategicVBox/StrategicActionRow") as HBoxContainer
	if action_row == null:
		return null
	var existing_panel := action_row.get_node_or_null("MissionCraftSummary") as PanelContainer
	if existing_panel != null:
		return existing_panel
	var panel := PanelContainer.new()
	panel.name = "MissionCraftSummary"
	panel.custom_minimum_size = Vector2(126.0, 48.0)
	panel.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	panel.set_meta("mission_control_selected_craft_summary", true)
	META_UI_SKIN_SCRIPT.style_tactical_panel(panel, "thin_frame")
	action_row.add_child(panel)
	var drop_button := action_row.get_node_or_null("CallDropshipButton") as Button
	if drop_button != null:
		action_row.move_child(panel, drop_button.get_index() + 1)

	var margin := MarginContainer.new()
	margin.name = "Margin"
	margin.add_theme_constant_override("margin_left", 4)
	margin.add_theme_constant_override("margin_top", 3)
	margin.add_theme_constant_override("margin_right", 4)
	margin.add_theme_constant_override("margin_bottom", 3)
	panel.add_child(margin)

	var row := HBoxContainer.new()
	row.name = "Row"
	row.add_theme_constant_override("separation", 4)
	margin.add_child(row)

	var ship_texture := TextureRect.new()
	ship_texture.name = "ShipTexture"
	ship_texture.custom_minimum_size = Vector2(36.0, 28.0)
	ship_texture.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	ship_texture.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	ship_texture.mouse_filter = Control.MOUSE_FILTER_IGNORE
	row.add_child(ship_texture)

	var info := VBoxContainer.new()
	info.name = "Info"
	info.add_theme_constant_override("separation", 0)
	info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(info)

	for label_name in ["NameLabel", "PilotLabel", "PlanLabel"]:
		var label := Label.new()
		label.name = label_name
		label.clip_text = true
		label.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
		label.add_theme_font_size_override("font_size", 7 if label_name != "NameLabel" else 8)
		META_UI_SKIN_SCRIPT.style_body_label(label, 7 if label_name != "NameLabel" else 8)
		info.add_child(label)
	return panel


func _refresh_mission_control_craft_summary() -> void:
	var panel := _ensure_mission_control_craft_summary()
	if panel == null:
		return
	var selected_craft_id: String = _mission_drop_craft_id.strip_edges()
	panel.visible = not selected_craft_id.is_empty() or not _mission_drop_display_name.is_empty()
	panel.set_meta("mission_drop_craft_id", selected_craft_id)
	if not panel.visible:
		return
	var selected_card: Dictionary = _find_mission_dropship_card_entry(selected_craft_id)
	var ship_texture := panel.get_node_or_null("Margin/Row/ShipTexture") as TextureRect
	if ship_texture != null:
		ship_texture.texture = _get_mission_dropship_card_texture(selected_card)
	var name_label := panel.get_node_or_null("Margin/Row/Info/NameLabel") as Label
	if name_label != null:
		name_label.text = _mission_drop_display_name if not _mission_drop_display_name.is_empty() else String(selected_card.get("display_name", "Dropship")).strip_edges()
	var pilot_name: String = _mission_drop_pilot_display_name
	if pilot_name.is_empty():
		pilot_name = String(selected_card.get("pilot_display_name", "")).strip_edges()
	if pilot_name.is_empty():
		pilot_name = "Pilot: none"
	var pilot_label := panel.get_node_or_null("Margin/Row/Info/PilotLabel") as Label
	if pilot_label != null:
		pilot_label.text = pilot_name
	var plan_label := panel.get_node_or_null("Margin/Row/Info/PlanLabel") as Label
	if plan_label != null:
		plan_label.text = "%s | %s" % [_get_approach_angle_name(), "LZ OK" if _has_lz_position else "LZ offen"]


func _ensure_mission_evacuation_button() -> Button:
	var action_row := get_node_or_null("../TacticalUI/BottomDock/BottomMargin/BottomRow/StrategicPanel/StrategicMargin/StrategicScroll/StrategicVBox/StrategicActionRow") as HBoxContainer
	if action_row == null:
		return null
	var button := action_row.get_node_or_null(MISSION_EVACUATION_BUTTON_NAME) as Button
	if button == null:
		button = Button.new()
		button.name = MISSION_EVACUATION_BUTTON_NAME
		button.text = "EVAC"
		button.custom_minimum_size = Vector2(42.0, 42.0)
		button.tooltip_text = "Evacuate selected Ground-Fireteam from LZ."
		button.set_meta("mission_evacuation_action", true)
		action_row.add_child(button)
		var drop_button := action_row.get_node_or_null("CallDropshipButton") as Button
		if drop_button != null:
			action_row.move_child(button, drop_button.get_index() + 1)
		if not button.pressed.is_connected(_on_mission_evacuation_pressed):
			button.pressed.connect(_on_mission_evacuation_pressed)
	return button


func _refresh_mission_evacuation_button() -> void:
	var button := _ensure_mission_evacuation_button()
	if button == null:
		return
	var snapshot: Dictionary = get_mission_evacuation_snapshot()
	button.visible = int(snapshot.get("ground_fireteam_count", 0)) > 0
	button.disabled = not bool(snapshot.get("eligible", false))
	var reason: String = String(snapshot.get("reason", ""))
	match reason:
		"ready":
			button.tooltip_text = "End this host mission through the existing Debrief path."
		"lz_missing":
			button.tooltip_text = "Set an LZ before evacuation."
		"fireteam_outside_lz":
			button.tooltip_text = "Regroup selected Ground-Fireteam at the LZ before evacuation."
		"not_authority":
			button.tooltip_text = "Only host authority can evacuate the shared mission."
		_:
			button.tooltip_text = "Evacuation unavailable: %s." % reason.replace("_", " ")
	META_UI_SKIN_SCRIPT.style_tactical_button(button, bool(snapshot.get("eligible", false)))


func _on_mission_evacuation_pressed() -> void:
	request_selected_fireteam_evacuation()


func _on_mission_dropship_card_gui_input(event: InputEvent, craft_id: String, card_panel: Control = null) -> void:
	if event is InputEventMouseButton:
		var mouse_event := event as InputEventMouseButton
		if mouse_event.button_index == MOUSE_BUTTON_LEFT and mouse_event.pressed:
			if _is_mission_dropship_card_command_hit(card_panel, mouse_event.position):
				return
			if _select_mission_dropship_craft(craft_id, true):
				get_viewport().set_input_as_handled()
			return
	if event is InputEventKey:
		var key_event := event as InputEventKey
		if key_event.pressed and (key_event.keycode == KEY_ENTER or key_event.keycode == KEY_SPACE):
			if _select_mission_dropship_craft(craft_id, true):
				get_viewport().set_input_as_handled()


func _is_mission_dropship_card_command_hit(card_panel: Control, local_position: Vector2) -> bool:
	if card_panel == null:
		return false
	var global_position: Vector2 = card_panel.get_global_transform_with_canvas() * local_position
	for node in _collect_node_tree(card_panel):
		var button := node as Button
		if button == null or not button.visible or button.disabled:
			continue
		if bool(button.get_meta("mission_dropship_card_command_button", false)) or String(button.name) == "PrimaryActionButton" or String(button.name) == "SecondaryActionButton":
			if button.get_global_rect().has_point(global_position):
				return true
	return false


func _on_mission_dropship_card_set_lz_pressed(craft_id: String) -> void:
	var normalized_craft_id: String = craft_id.strip_edges()
	if normalized_craft_id.is_empty():
		return
	var card := _find_mission_dropship_card_entry(normalized_craft_id)
	if card.is_empty() or _is_network_dropship_command_pending(normalized_craft_id) or not _can_request_mission_dropship_card_lz(card):
		return
	if not _select_mission_dropship_craft(normalized_craft_id, false, false):
		return
	if not _can_edit_planning():
		_last_command_text = "OBSERVER MODE"
		_refresh_button_state()
		_update_ui()
		return
	_is_lz_placement_armed = true
	_lz_placement_craft_id = normalized_craft_id
	_last_command_text = "CLICK MAP FOR LZ TILE: %s" % _mission_drop_display_name
	var popup := get_node_or_null("../TacticalUI/A5DropshipDetailsPopup") as PopupPanel
	if popup != null:
		# Successful arming requires the next input on the map. Reject/pending
		# branches above leave the details view open and do not pretend success.
		popup.hide()
	_refresh_button_state()
	_update_ui()


func _on_mission_dropship_card_approach_pressed(craft_id: String, angle_name: String) -> void:
	var normalized_craft_id: String = craft_id.strip_edges()
	if normalized_craft_id.is_empty():
		return
	if not _select_mission_dropship_craft(normalized_craft_id, false):
		return
	if _should_route_dropship_command_through_network_authority():
		request_network_authoritative_dropship_command("set_dropship_approach", normalized_craft_id, _get_dropship_command_fireteam_id(normalized_craft_id), {"approach_angle": _sanitize_approach_angle_name(angle_name)})
		return
	_select_approach_angle(angle_name)


func _on_mission_dropship_card_drop_pressed(craft_id: String) -> void:
	var normalized_craft_id: String = craft_id.strip_edges()
	if normalized_craft_id.is_empty():
		return
	if not _select_mission_dropship_craft(normalized_craft_id, false):
		return
	_request_selected_mission_dropship_drop(true)


func _on_mission_dropship_return_pressed(craft_id: String) -> void:
	var normalized_craft_id: String = craft_id.strip_edges()
	if normalized_craft_id.is_empty():
		return
	var selected_card: Dictionary = _find_mission_dropship_card_entry(normalized_craft_id)
	if selected_card.is_empty() or not _can_request_mission_dropship_return(selected_card):
		return
	if _should_route_dropship_command_through_network_authority():
		request_network_authoritative_dropship_command("return_dropship", normalized_craft_id, _get_dropship_command_fireteam_id(normalized_craft_id))
		return
	_apply_selected_mission_dropship_return(normalized_craft_id)


func _apply_selected_mission_dropship_return(craft_id: String) -> bool:
	var normalized_craft_id: String = craft_id.strip_edges()
	var boarding: Dictionary = request_campaign_crew_boarding(normalized_craft_id)
	if not bool(boarding.get("ok", false)):
		_last_command_text = String(boarding.get("message", "Pilot fehlt"))
		_set_mission_dropship_card_feedback(normalized_craft_id, _last_command_text)
		return false
	var selected_card: Dictionary = _find_mission_dropship_card_entry(normalized_craft_id)
	if selected_card.is_empty() or not _can_request_mission_dropship_return(selected_card):
		return false
	if _is_parked_campaign_dropship(normalized_craft_id):
		_select_mission_dropship_craft(normalized_craft_id, false)
		if _is_active_drop_sequence_for_craft(normalized_craft_id):
			_begin_drop_sequence_outbound()
		else:
			var sequence: Dictionary = Dictionary(_parallel_drop_sequences_by_craft[normalized_craft_id]).duplicate(true)
			_begin_drop_sequence_outbound_for_sequence(sequence)
			_parallel_drop_sequences_by_craft[normalized_craft_id] = sequence
			_update_mission_dropship_card_fields(normalized_craft_id, _build_drop_sequence_card_fields(sequence))
			_store_selected_mission_dropship_plan()
			_emit_planning_state_changed()
			_update_ui()
			_refresh_world_overlays()
		return true
	_select_mission_dropship_craft(normalized_craft_id, false)
	_drop_ship_requested = false
	_drop_ship_staged = false
	_mission_drop_state = _get_mission_drop_return_state(normalized_craft_id)
	_mission_drop_progress = 0.0
	_mission_drop_eta_seconds = 0
	_mission_drop_return_requested = true
	_last_command_text = "%s RTB HOMEBASE" % _mission_drop_display_name if _mission_drop_state == "to_homebase" else "%s RTB FOB" % _mission_drop_display_name
	_store_selected_mission_dropship_plan()
	_emit_planning_state_changed()
	_refresh_button_state()
	_update_ui()
	_refresh_world_overlays()
	return true


func _clear_mission_dropship_panel_cards(panel: Control) -> void:
	for child in panel.get_children():
		panel.remove_child(child)
		child.queue_free()


func _sanitize_node_name(value: String) -> String:
	var safe_name: String = value.strip_edges()
	if safe_name.is_empty():
		return "dropship"
	for token in [" ", "/", "\\", ":", "|", ".", ","]:
		safe_name = safe_name.replace(token, "_")
	return safe_name


func _is_mission_dropship_card_in_transit(card: Dictionary) -> bool:
	var state: String = String(card.get("state", "")).strip_edges().to_lower()
	return state == "to_mission" or state == "to_fob" or state == "to_homebase"


func _should_show_mission_dropship_card_progress(card: Dictionary) -> bool:
	var state: String = String(card.get("state", "")).strip_edges().to_lower()
	return state == "to_mission" or state == "to_fob" or state == "to_homebase" or state == DROP_SEQUENCE_INBOUND or state == DROP_SEQUENCE_LANDED or state == DROP_SEQUENCE_UNLOADING or state == DROP_SEQUENCE_OUTBOUND


func _get_mission_dropship_card_feedback_text(card: Dictionary) -> String:
	var craft_id: String = String(card.get("craft_id", "")).strip_edges()
	var pending: Dictionary = Dictionary(_pending_network_dropship_commands_by_craft.get(craft_id, {}))
	if not pending.is_empty():
		return String(pending.get("compact_line", "WARTE AUF HOST")).strip_edges()
	var feedback: Dictionary = Dictionary(_network_dropship_feedback_by_craft.get(craft_id, {}))
	if not feedback.is_empty():
		return String(feedback.get("compact_line", "")).strip_edges()
	return String(card.get("card_feedback_text", "")).strip_edges()


func _get_mission_dropship_card_feedback_tone(card: Dictionary) -> String:
	var craft_id: String = String(card.get("craft_id", "")).strip_edges()
	if _pending_network_dropship_commands_by_craft.has(craft_id):
		return "pending"
	var feedback: Dictionary = Dictionary(_network_dropship_feedback_by_craft.get(craft_id, {}))
	return String(feedback.get("tone", "neutral")).strip_edges().to_lower()


func _apply_mission_dropship_card_feedback_style(label: Label, tone: String) -> void:
	if label == null:
		return
	var normalized_tone: String = tone.strip_edges().to_lower()
	var style_key: String = _build_network_mission_interaction_tone_style_key(normalized_tone)
	var tone_color: Color = TACTICAL_UI_THEME_SCRIPT.call("status_color", style_key)
	label.add_theme_color_override("font_color", tone_color)
	label.add_theme_color_override("font_outline_color", Color(0.0, 0.0, 0.0, 0.9))
	label.add_theme_constant_override("outline_size", 2)
	label.set_meta("mission_dropship_feedback_tone", normalized_tone)
	label.set_meta("mission_dropship_feedback_style_key", style_key)
	label.set_meta("mission_dropship_feedback_font_color", tone_color.to_html(true))


func _refresh_legacy_mission_dropship_panel() -> void:
	var panel := get_node_or_null("../TacticalUI/MissionDropshipPanel") as PanelContainer
	if panel == null:
		return
	var is_transit: bool = _mission_drop_state == "to_mission" or _mission_drop_state == "to_fob" or _mission_drop_state == "to_homebase"
