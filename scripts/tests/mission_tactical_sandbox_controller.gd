func _place_lz_from_screen_position(screen_position: Vector2) -> bool:
	var profile_enabled: bool = _lz_drop_timing_debug_enabled
	var started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
	var scopes_usec: Dictionary = {}
	var scope_started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
	var armed_craft_id: String = _lz_placement_craft_id.strip_edges()
	if not armed_craft_id.is_empty() and armed_craft_id != _mission_drop_craft_id.strip_edges():
		_select_mission_dropship_craft(armed_craft_id, false)
	if profile_enabled:
		scopes_usec["craft_selection_usec"] = Time.get_ticks_usec() - scope_started_usec
		scope_started_usec = Time.get_ticks_usec()
	var tile_context: Dictionary = _build_tile_context_from_screen_position(screen_position)
	if profile_enabled:
		scopes_usec["tile_context_usec"] = Time.get_ticks_usec() - scope_started_usec
		scope_started_usec = Time.get_ticks_usec()
	if _has_primary_grid_for_command_selection() and tile_context.is_empty():
		_last_command_text = "NO TILE UNDER CURSOR"
		_update_ui()
		return false
	var candidate_lz_position: Vector2 = Vector2(tile_context.get("world_position", _snap_world_position_to_primary_tile(_clamp_world_position_to_viewport(_screen_to_world_position(screen_position))))) if not tile_context.is_empty() else _snap_world_position_to_primary_tile(_clamp_world_position_to_viewport(_screen_to_world_position(screen_position)))
	if _should_keep_campaign_dropship_landed():
		var validation: Dictionary = _validate_campaign_field_lz(candidate_lz_position)
		if not bool(validation.ok):
			_last_command_text = String(validation.get("message", "Landezone ist blockiert"))
			_update_ui()
			return false
	if not tile_context.is_empty():
		_set_selected_tile_context(tile_context, "", false, false)
	if _should_route_dropship_command_through_network_authority():
		_is_lz_placement_armed = false
		_lz_placement_craft_id = ""
		return request_network_authoritative_dropship_command(
			"set_lz",
			_mission_drop_craft_id,
			_get_dropship_command_fireteam_id(_mission_drop_craft_id),
			{"lz_position": candidate_lz_position, "approach_angle": _get_approach_angle_name()}
		)
	_lz_position = candidate_lz_position
	_has_lz_position = true
	_is_lz_placement_armed = false
	_lz_placement_craft_id = ""
	if profile_enabled:
		scopes_usec["lz_position_and_selection_usec"] = Time.get_ticks_usec() - scope_started_usec
		scope_started_usec = Time.get_ticks_usec()
	var lz_label: String = _build_mission_dropship_lz_name(_mission_drop_craft_id, _mission_drop_display_name, _get_mission_dropship_card_order_number(_mission_drop_craft_id))
	_last_command_text = "%s SET %s @ %s" % [lz_label, _get_approach_angle_name(), _format_world_position(_lz_position)]
	_store_selected_mission_dropship_plan()
	if profile_enabled:
		scopes_usec["store_plan_usec"] = Time.get_ticks_usec() - scope_started_usec
		scope_started_usec = Time.get_ticks_usec()
	_refresh_button_state()
	_refresh_world_overlays()
	if profile_enabled:
		scopes_usec["button_and_world_refresh_usec"] = Time.get_ticks_usec() - scope_started_usec
		scope_started_usec = Time.get_ticks_usec()
	_update_ui()
	if profile_enabled:
		scopes_usec["update_ui_usec"] = Time.get_ticks_usec() - scope_started_usec
		scope_started_usec = Time.get_ticks_usec()
	_emit_planning_state_changed()
	if profile_enabled:
		scopes_usec["planning_emit_usec"] = Time.get_ticks_usec() - scope_started_usec
		_lz_drop_timing_debug_snapshot = {
			"enabled": true,
			"total_usec": Time.get_ticks_usec() - started_usec,
			"scopes_usec": scopes_usec.duplicate(true),
			"read_only": true,
			"sets_gameplay_truth": false,
			"creates_command": false,
			"creates_movement": false,
			"creates_fire_event": false,
			"creates_damage_event": false,
			"sets_multiplayer_truth": false,
		}
	return true


func _issue_command(command_type: String, display_text: String) -> bool:
	if not _can_issue_local_commands():
		_last_command_text = "OBSERVER MODE"
		_record_fireteamleader_feedback_for_selected_fireteams(command_type, "blocked", "observer")
		_refresh_order_visuals()
		_update_ui()
		return false

	if _selected_fireteam_ids.is_empty():
		_last_command_text = "NO FIRETEAM SELECTED"
		_update_ui()
		return false
	var inactive_fireteams: PackedStringArray = []
	for fireteam_id in _selected_fireteam_ids:
		if not _is_fireteam_runtime_active(String(fireteam_id)):
			inactive_fireteams.append(String(fireteam_id).to_upper())
	if not inactive_fireteams.is_empty():
		_last_command_text = "WAIT FOR INSERTION: %s" % ", ".join(inactive_fireteams)
		_record_fireteamleader_feedback_for_selected_fireteams(command_type, "blocked", "inactive")
		_refresh_order_visuals()
		_update_ui()
		return false

	var requires_tile: bool = _requires_selected_tile_for_command(command_type) and _has_primary_grid_for_command_selection()
	if requires_tile and not _has_selected_tile:
		_last_command_text = "SELECT TILE FIRST"
		_record_fireteamleader_feedback_for_selected_fireteams(command_type, "blocked", "no_tile")
		_refresh_button_state()
		_refresh_order_visuals()
		_update_ui()
		return false
	if requires_tile:
		_apply_selected_tile_to_target_marker()
	if _is_connected_network_snapshot_client():
		return _plan_connected_client_fireteam_command(command_type, display_text, _selected_tile_world_position if requires_tile else _get_target_position())

	var issued_count: int = 0
	for driver in _get_active_flow_drivers():
		if driver == null or (not driver.has_method("issue_command") and not driver.has_method("issue_command_at_position")):
			continue

		var did_issue: bool = false
		if requires_tile and driver.has_method("issue_command_at_position"):
			did_issue = bool(driver.call("issue_command_at_position", _selected_tile_world_position, command_type, _get_live_order_phase_index()))
		elif driver.has_method("issue_command"):
			did_issue = bool(driver.call("issue_command", command_type, _get_live_order_phase_index()))
		if did_issue:
			issued_count += 1

	if issued_count == 0:
		_last_command_text = "%s FAILED" % display_text
		_record_fireteamleader_feedback_for_selected_fireteams(command_type, "blocked", "failed")
		_refresh_order_visuals()
		_update_ui()
		return false

	_last_command_text = _build_selected_command_order_summary(command_type, display_text)
	_record_fireteamleader_feedback_for_selected_fireteams(command_type, "accepted", "accepted")
	_refresh_order_visuals()
	_update_ui()
	return true


func _plan_connected_client_fireteam_command(command_type: String, display_text: String, target_position: Vector2) -> bool:
	var phase_index: int = _get_live_order_phase_index()
	var waypoint_refs: Array = _create_waypoints_for_selected_fireteams(target_position, true, false, false)
	if waypoint_refs.is_empty():
		_last_command_text = "%s FAILED" % display_text
		_update_ui()
		return false
	for ref_variant in waypoint_refs:
		if typeof(ref_variant) != TYPE_DICTIONARY:
			continue
		var ref: Dictionary = Dictionary(ref_variant)
		var fireteam_id: String = String(ref.get("fireteam_id", "")).strip_edges().to_lower()
		var waypoint_id: String = String(ref.get("waypoint_id", "")).strip_edges()
		var plan = _order_plans_by_key.get(_build_order_plan_key(fireteam_id, phase_index), null)
		if plan == null:
			continue
		for waypoint in plan.waypoints:
			if waypoint != null and String(waypoint.waypoint_id) == waypoint_id:
				waypoint.command_type = command_type.strip_edges().to_lower()
				break
	_last_command_text = "%s GEPLANT | GO" % display_text
	_record_fireteamleader_feedback_for_selected_fireteams(command_type, "accepted", "planned_network")
	_refresh_button_state()
	_refresh_order_visuals()
	_update_ui()
	_emit_planning_state_changed()
	return true


func _change_fireteam(delta: int) -> void:
	var selection_options: Array = _get_fireteam_selection_options()
	if selection_options.is_empty():
		return
	var next_index: int = wrapi(_current_fireteam_index + delta, 0, selection_options.size())
	_set_selected_fireteams(_selection_ids_for_index(next_index))


func _change_phase(delta: int) -> void:
	if not PHASE_PLANNING_ENABLED:
		_current_phase_index = _get_live_order_phase_index()
		_last_command_text = "DIREKTMODUS: PHASEN AUS"
		_update_ui()
		return
	var phase_controller = _get_phase_controller()
	if phase_controller == null or not phase_controller.has_method("cycle_selected_phase"):
		_current_phase_index = maxi(_current_phase_index + delta, 1)
	else:
		_current_phase_index = int(phase_controller.call("cycle_selected_phase", delta))
	_refresh_order_visuals()
	_update_ui()
	_emit_planning_state_changed()


