func _release_fire_exchange_event_log_entries_contain_contact_fire(entries: Array) -> bool:
	for entry_variant in entries:
		if typeof(entry_variant) != TYPE_DICTIONARY:
			continue
		var entry: Dictionary = Dictionary(entry_variant)
		if String(entry.get("short_text", "")).contains("CONTACT FIRE") or String(entry.get("map_label", "")).contains("CONTACT FIRE"):
			return true
	return false


func _release_first_firefight_event_log_frames_pressure(event_log_display: Dictionary, framing_state: String) -> bool:
	if framing_state == "fire_exchange":
		return true
	var fallback_entry: Dictionary = Dictionary(event_log_display.get("fallback_entry", {}))
	if String(fallback_entry.get("short_text", "")).contains("CONTACT PRESSURE"):
		return true
	for entry_variant in Array(event_log_display.get("entries", [])):
		if typeof(entry_variant) != TYPE_DICTIONARY:
			continue
		var entry: Dictionary = Dictionary(entry_variant)
		var short_text: String = String(entry.get("short_text", "")).to_upper()
		var detail_text: String = String(entry.get("detail_text", "")).to_upper()
		if short_text.contains("CONTACT PRESSURE") or detail_text.contains("CONTACT PRESSURE"):
			return true
		if short_text.contains("CONTACT") or detail_text.contains("NO FIRE") or detail_text.contains("LOS") or detail_text.contains("RNG"):
			return true
	return false


func _resolve_release_first_firefight_contact_framing_state(
	diagnostics: Dictionary,
	first_fire_event: Dictionary,
	fire_events: Array,
	selected_contact_count: int,
	combat_line: String
) -> String:
	var reason: String = String(diagnostics.get("reason", "")).strip_edges().to_lower()
	var status: String = String(diagnostics.get("status", "")).strip_edges().to_lower()
	if reason == "fired" or status == "fired" or not first_fire_event.is_empty() or fire_events.size() > 0:
		return "fire_exchange"
	if selected_contact_count > 0 and _release_first_firefight_contact_pressure_active(diagnostics, combat_line):
		return "contact_pressure"
	return "unclear"


func _release_first_firefight_contact_pressure_active(diagnostics: Dictionary, combat_line: String) -> bool:
	var reason: String = String(diagnostics.get("reason", "")).strip_edges().to_lower()
	var status: String = String(diagnostics.get("status", "")).strip_edges().to_lower()
	if ["no_contact_pair", "no_damage_effect", "invalid_contact_pair", "cooldown"].has(reason):
		return true
	if ["blocked", "waiting"].has(status):
		return true
	var upper_line: String = combat_line.to_upper()
	return upper_line.contains("NO FIRE") or upper_line.contains("WAIT") or upper_line.contains("CONTACT")


func _build_release_first_firefight_contact_framing_line(framing_state: String, diagnostics: Dictionary, combat_line: String) -> String:
	var next_step: String = _release_first_firefight_next_step_text(framing_state, diagnostics)
	if framing_state == "fire_exchange":
		return "CONTACT FIRE | NEXT %s" % next_step
	if framing_state == "contact_pressure":
		var reason_text: String = _release_first_firefight_contact_reason_text(diagnostics, {"compact_line": combat_line})
		return "CONTACT PRESSURE %s | NEXT %s" % [reason_text, next_step]
	return "CONTACT UNKLAR | NEXT HALTEN / NEU PLANEN"


func _release_first_firefight_next_step_text(framing_state: String, diagnostics: Dictionary) -> String:
	if framing_state == "fire_exchange":
		return "Trefferbild lesen / Defend halten"
	var reason: String = String(diagnostics.get("reason", "")).strip_edges().to_lower()
	var range_state: String = String(diagnostics.get("range_state", "")).strip_edges().to_lower()
	var los_state: String = String(diagnostics.get("los_state", "")).strip_edges().to_lower()
	if range_state == "out_of_range" or reason.contains("range"):
		return "Range schliessen"
	if los_state == "blocked" or reason.contains("los"):
		return "LOS freiziehen"
	if reason == "cooldown":
		return "Halten / Flanke suchen"
	return "Position korrigieren"


func _release_first_firefight_contact_reason_text(diagnostics: Dictionary, combat_hud_density: Dictionary) -> String:
	var reason: String = String(diagnostics.get("reason", "")).strip_edges().to_upper()
	var range_state: String = String(diagnostics.get("range_state", "")).strip_edges().to_upper()
	var los_state: String = String(diagnostics.get("los_state", "")).strip_edges().to_upper()
	if reason == "NO_CONTACT_PAIR" and typeof(diagnostics.get("candidate", null)) == TYPE_DICTIONARY:
		reason = String(Dictionary(diagnostics.get("candidate", {})).get("candidate_reason", reason)).strip_edges().to_upper()
	if reason.is_empty():
		reason = String(combat_hud_density.get("reason", "")).strip_edges().to_upper()
	var parts: PackedStringArray = PackedStringArray()
	if not reason.is_empty():
		parts.append(reason)
	if not los_state.is_empty():
		parts.append("LOS %s" % los_state)
	if not range_state.is_empty():
		parts.append("RNG %s" % range_state)
	return " ".join(parts)


func _build_release_firefight_event_log_display_snapshot(raw_entries: Array, release_decision: Dictionary, combat_hud_density: Dictionary) -> Dictionary:
	var source_entries: Array = []
	for entry_variant in raw_entries:
		if typeof(entry_variant) != TYPE_DICTIONARY:
			continue
		source_entries.append(Dictionary(entry_variant).duplicate(true))
	var dedupe_result: Dictionary = _dedupe_release_first_contact_display_entries(source_entries)
	var display_entries: Array = Array(dedupe_result.get("entries", [])).duplicate(true)
	var fallback_entry: Dictionary = {}
	if bool(combat_hud_density.get("visibility_persistence_active", false)) \
			and not _release_fire_exchange_event_log_entries_contain_contact_fire(display_entries):
		fallback_entry = _build_release_firefight_event_log_fallback_entry(release_decision, combat_hud_density)
		if not fallback_entry.is_empty():
			display_entries.insert(0, fallback_entry)
	elif display_entries.is_empty():
		fallback_entry = _build_release_firefight_event_log_fallback_entry(release_decision, combat_hud_density)
		if not fallback_entry.is_empty():
			display_entries.append(fallback_entry)
	display_entries.sort_custom(func(left: Dictionary, right: Dictionary) -> bool:
		var left_contact_fire: bool = _is_release_first_contact_fire_display_entry(left)
		var right_contact_fire: bool = _is_release_first_contact_fire_display_entry(right)
		if left_contact_fire != right_contact_fire:
			return left_contact_fire
		var left_time: int = int(left.get("created_msec", 0))
		var right_time: int = int(right.get("created_msec", 0))
		if left_time == right_time:
			return String(left.get("event_id", "")) < String(right.get("event_id", ""))
		return left_time > right_time
	)
	return {
		"style_id": RELEASE_FIREFIGHT_EVENT_LOG_FINDINGS_STYLE_ID,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"creates_navigation": false,
		"creates_command": false,
		"creates_fire_event": false,
		"creates_damage_event": false,
		"sets_multiplayer_truth": false,
		"raw_count": raw_entries.size(),
		"display_count": display_entries.size(),
		"collapsed_repeat_count": int(dedupe_result.get("collapsed_repeat_count", 0)),
		"contact_group_count": int(dedupe_result.get("contact_group_count", 0)),
		"fallback_active": not fallback_entry.is_empty(),
		"fallback_entry": fallback_entry,
		"entries": display_entries,
	}


func _dedupe_release_first_contact_display_entries(entries: Array) -> Dictionary:
	var result: Array = []
	var contact_groups: Dictionary = {}
	var collapsed_repeat_count: int = 0
	var contact_group_count: int = 0
	for entry_variant in entries:
		if typeof(entry_variant) != TYPE_DICTIONARY:
			continue
		var entry: Dictionary = Dictionary(entry_variant).duplicate(true)
		var event_type: String = String(entry.get("event_type", "")).strip_edges().to_lower()
		if event_type != "contact_report":
			result.append(entry)
			continue
		var created_msec: int = int(entry.get("created_msec", 0))
		var semantic_key: String = "%s|%s|%s" % [
			String(entry.get("fireteam_id", "")).strip_edges().to_lower(),
			String(entry.get("unit_id", "")).strip_edges(),
			event_type,
		]
		var group_state: Dictionary = Dictionary(contact_groups.get(semantic_key, {}))
		var retained_index: int = int(group_state.get("result_index", -1))
		var retained_entry: Dictionary = Dictionary(result[retained_index]) if retained_index >= 0 and retained_index < result.size() else {}
		var within_window: bool = not retained_entry.is_empty() and absi(created_msec - int(group_state.get("last_seen_msec", retained_entry.get("created_msec", 0)))) <= CONNECTED_FIRST_CONTACT_EVENT_LOG_DEDUPE_WINDOW_MSEC
		if not within_window:
			entry["repeat_count"] = 1
			entry["collapsed_event_ids"] = [String(entry.get("event_id", ""))]
			contact_groups[semantic_key] = {"result_index": result.size(), "last_seen_msec": created_msec}
			result.append(entry)
			contact_group_count += 1
			continue
		var result_index: int = retained_index
		var retained: Dictionary = Dictionary(result[result_index]).duplicate(true)
		var collapsed_ids: Array = Array(retained.get("collapsed_event_ids", [])).duplicate()
		collapsed_ids.append(String(entry.get("event_id", "")))
		retained["repeat_count"] = collapsed_ids.size()
		retained["collapsed_event_ids"] = collapsed_ids
		if int(entry.get("created_msec", 0)) > int(retained.get("created_msec", 0)):
			var repeat_count: int = int(retained.get("repeat_count", collapsed_ids.size()))
			retained = entry
			retained["repeat_count"] = repeat_count
			retained["collapsed_event_ids"] = collapsed_ids
		result[result_index] = retained
		group_state["last_seen_msec"] = created_msec
		contact_groups[semantic_key] = group_state
		collapsed_repeat_count += 1
	return {
		"entries": result,
		"contact_group_count": contact_group_count,
		"collapsed_repeat_count": collapsed_repeat_count,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
	}


func _is_release_first_contact_fire_display_entry(entry: Dictionary) -> bool:
	var text: String = "%s %s" % [String(entry.get("short_text", "")), String(entry.get("map_label", ""))]
	return text.to_upper().contains("CONTACT FIRE")


func _build_release_firefight_event_log_fallback_entry(release_decision: Dictionary, combat_hud_density: Dictionary) -> Dictionary:
	var decision_line: String = String(release_decision.get("decision_line", "")).strip_edges()
	var combat_line: String = String(combat_hud_density.get("compact_line", "")).strip_edges()
	var decision_active: bool = bool(release_decision.get("active", false)) and not decision_line.is_empty()
	var combat_active: bool = bool(combat_hud_density.get("active", false)) and not combat_line.is_empty()
	if not decision_active and not combat_active:
		return {}
	var fireteam_id: String = String(_selected_fireteam_ids[0]).strip_edges().to_lower() if not _selected_fireteam_ids.is_empty() else ""
	var reason: String = String(combat_hud_density.get("reason", "")).strip_edges().to_upper()
	var short_text: String = "FIREFIGHT STATUS"
	var severity: String = "tactical"
	var map_label: String = "CONTACT"
	var source: String = "release_firefight_event_log_fallback"
	var style_id: String = RELEASE_FIREFIGHT_EVENT_LOG_FINDINGS_STYLE_ID
	if bool(combat_hud_density.get("visibility_persistence_active", false)):
		var persistence: Dictionary = Dictionary(combat_hud_density.get("visibility_persistence", {}))
		short_text = String(persistence.get("event_log_short_text", "CONTACT FIRE: Feuerwechsel lesen")).strip_edges()
		map_label = String(persistence.get("event_log_map_label", "CONTACT FIRE")).strip_edges()
		source = "release_fire_exchange_visibility_persistence"
		style_id = RELEASE_FIRE_EXCHANGE_VISIBILITY_PERSISTENCE_STYLE_ID
	elif combat_line.to_upper().contains("NO FIRE") or reason.contains("NO_LOS") or reason.contains("NO_RANGE"):
		short_text = "CONTACT PRESSURE: %s" % _release_first_firefight_next_step_text(
			"contact_pressure",
			Dictionary(combat_hud_density.get("contact_decision_diagnostics", get_contact_decision_diagnostics_snapshot()))
		)
		severity = "warning"
		map_label = "NO_LOS"
	elif combat_line.to_upper().contains("CONTACT"):
		short_text = "CONTACT: Entscheidung pruefen"
	var detail_parts: PackedStringArray = PackedStringArray()
	if not decision_line.is_empty():
		detail_parts.append(decision_line)
	if not combat_line.is_empty():
		detail_parts.append("Kampf %s" % combat_line)
	if not _last_command_text.strip_edges().is_empty():
		detail_parts.append("Cmd %s" % _last_command_text.strip_edges())
	if _release_firefight_event_log_fallback_created_msec <= 0:
		_release_firefight_event_log_fallback_created_msec = Time.get_ticks_msec()
	return {
		"event_id": "task_838_firefight_status_%s" % ("selected" if fireteam_id.is_empty() else fireteam_id),
		"event_type": "release_firefight_status",
		"category": "engagement_feedback",
		"severity": severity,
		"priority": 2,
		"created_msec": _release_firefight_event_log_fallback_created_msec,
		"fireteam_id": fireteam_id,
		"unit_id": "",
		"short_text": short_text,
		"detail_text": " | ".join(detail_parts),
		"map_label": map_label,
		"source": source,
		"style_id": style_id,
		"visual_only": true,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"creates_command": false,
		"creates_fire_event": false,
		"creates_damage_event": false,
	}


func _build_release_firefight_command_matrix_visual_snapshot(command_grid: GridContainer) -> Dictionary:
	var active: bool = bool(command_grid.get_meta("release_firefight_command_matrix_visual_active", false)) if command_grid != null else false
	var style_id: String = String(command_grid.get_meta("release_firefight_command_matrix_visual_style_id", "")) if command_grid != null else ""
	var primary_buttons: Array = []
	var primary_readable_count: int = 0
	var primary_min_font_size: int = 999
	for spec_variant in _get_release_firefight_command_primary_button_specs():
		var spec: Dictionary = Dictionary(spec_variant)
		var button := get_node_or_null(NodePath(String(spec.get("path", "")))) as Button
		var snapshot: Dictionary = _build_release_firefight_command_button_visual_snapshot(button)
		primary_buttons.append(snapshot)
		if bool(snapshot.get("readable", false)):
			primary_readable_count += 1
		primary_min_font_size = mini(primary_min_font_size, int(snapshot.get("font_size", 0)))
	var fire_rule_buttons: Array = []
	var active_fire_rule_count: int = 0
	var active_fire_rule_style_id: String = ""
	var active_fire_rule_visual_weight: float = 0.0
	for spec_variant in _get_fire_rule_button_specs():
		var spec: Dictionary = Dictionary(spec_variant)
		var button := get_node_or_null(NodePath(String(spec.get("path", "")))) as Button
		var snapshot: Dictionary = _build_release_firefight_command_button_visual_snapshot(button)
		fire_rule_buttons.append(snapshot)
		if bool(snapshot.get("fire_rule_active", false)):
			active_fire_rule_count += 1
			active_fire_rule_style_id = String(snapshot.get("style_id", ""))
			active_fire_rule_visual_weight = maxf(active_fire_rule_visual_weight, float(snapshot.get("visual_weight", 0.0)))
	var placeholder_count: int = 0
	var quiet_placeholder_count: int = 0
	for slot_index in range(7, 21):
		var placeholder := get_node_or_null("%s/CommandSlot%02d" % [COMMAND_GRID_PATH, slot_index]) as Button
		if placeholder == null:
			continue
		placeholder_count += 1
		if bool(placeholder.get_meta("release_firefight_command_matrix_quiet_placeholder", false)):
			quiet_placeholder_count += 1
	var go_button := get_node_or_null("%s/GoCommandMatrixButton" % COMMAND_GRID_PATH) as Button
	var go_snapshot: Dictionary = _build_release_firefight_command_button_visual_snapshot(go_button)
	if primary_min_font_size == 999:
		primary_min_font_size = 0
	return {
		"schema": "sternenbuergerchen.release_firefight_command_matrix_visual.v1",
		"active": active,
		"style_id": style_id,
		"columns": command_grid.columns if command_grid != null else 0,
		"primary_buttons": primary_buttons,
		"primary_button_count": primary_buttons.size(),
		"primary_readable_count": primary_readable_count,
		"primary_min_font_size": primary_min_font_size,
		"go_button": go_snapshot,
		"go_button_present": bool(go_snapshot.get("present", false)),
		"go_button_prominent": bool(go_snapshot.get("go_prominent", false)),
		"go_button_ready": bool(go_snapshot.get("go_ready", false)),
		"go_button_visual_weight": float(go_snapshot.get("visual_weight", 0.0)),
		"go_button_font_size": int(go_snapshot.get("font_size", 0)),
		"fire_rule_buttons": fire_rule_buttons,
		"fire_rule_button_count": fire_rule_buttons.size(),
		"active_fire_rule_count": active_fire_rule_count,
		"active_fire_rule_style_id": active_fire_rule_style_id,
		"active_fire_rule_visual_weight": active_fire_rule_visual_weight,
		"placeholder_count": placeholder_count,
		"quiet_placeholder_count": quiet_placeholder_count,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"creates_command": false,
	}


func _build_release_firefight_command_button_visual_snapshot(button: Button) -> Dictionary:
	if button == null:
		return {"present": false, "readable": false}
	var text: String = String(button.text).strip_edges()
	var tooltip: String = String(button.tooltip_text).strip_edges()
	var style_id: String = String(button.get_meta("release_firefight_command_matrix_style_id", ""))
	var font_size: int = int(button.get_meta("release_firefight_command_matrix_font_size", button.get_theme_font_size("font_size")))
	var role: String = String(button.get_meta("release_firefight_command_matrix_role", ""))
	return {
		"present": true,
		"name": String(button.name),
		"text": text,
		"tooltip": tooltip,
		"disabled": button.disabled,
		"role": role,
		"style_id": style_id,
		"font_size": font_size,
		"visual_weight": float(button.get_meta("release_firefight_command_matrix_visual_weight", 0.0)),
		"readable": not text.is_empty() and not tooltip.is_empty() and style_id == RELEASE_FIREFIGHT_COMMAND_MATRIX_VISUAL_STYLE_ID,
		"go_prominent": bool(button.get_meta("release_firefight_command_matrix_go_prominent", false)),
		"go_ready": bool(button.get_meta("release_firefight_command_matrix_go_ready", false)),
		"fire_rule_active": bool(button.get_meta("release_firefight_command_matrix_fire_rule_active", false)),
		"quiet_placeholder": bool(button.get_meta("release_firefight_command_matrix_quiet_placeholder", false)),
	}


func _build_release_candidate_firefight_player_action_snapshot(engagement_snapshot: Dictionary, combat_hud_density: Dictionary) -> Dictionary:
	var diagnostics: Dictionary = Dictionary(engagement_snapshot.get("contact_decision_diagnostics", {})).duplicate(true)
	var status: String = String(engagement_snapshot.get("engagement_status", diagnostics.get("status", ""))).strip_edges().to_lower()
	var reason: String = String(engagement_snapshot.get("engagement_reason", diagnostics.get("reason", ""))).strip_edges().to_lower()
	var compact_line: String = String(combat_hud_density.get("compact_line", "")).strip_edges()
	var next_action: String = "Naechster Griff: Feuerstatus lesen | Position halten oder neuen Move/Defend/Flank waehlen"
	var why_line: String = "Warum: Combat-HUD zeigt Feuerstatus, Zielpaar, Cover, Range und LOS."
	if bool(combat_hud_density.get("visibility_persistence_active", false)):
		status = "fired"
		reason = "fired"
		diagnostics["status"] = "fired"
		diagnostics["reason"] = "fired"
	if reason == "fired" or status == "fired":
		next_action = "Naechster Griff: Trefferwirkung lesen | bei Risiko Defend, Flank oder neuen Move planen"
		why_line = "Warum: Es wurde geschossen; Ziel, Waffe und Kontext stehen im Kampf-Readout."
	elif reason == "cooldown" or status == "waiting":
		next_action = "Naechster Griff: kurz warten oder Deckung/Flanke verbessern"
		why_line = "Warum: Einheit ist im Feuer-Cooldown; Kontext zeigt, ob Position und Sichtlinie gut sind."
	elif reason == "no_contact_pair" or reason == "no_damage_effect" or reason == "invalid_contact_pair" or status == "blocked":
		next_action = "Naechster Griff: Sichtlinie, Reichweite oder Zielposition korrigieren"
		why_line = "Warum: Kein sauberer Schuss; Blockgrund und Kandidat stehen im Kontakt-Readout."
	return {
		"active": not compact_line.is_empty() or not diagnostics.is_empty(),
		"status": status,
		"reason": reason,
		"compact_line": compact_line,
		"next_action_line": next_action,
		"why_line": why_line,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
	}


func get_multi_fireteam_combat_hud_consistency_snapshot() -> Dictionary:
	var hud_snapshot: Dictionary = get_mission_combat_feedback_hud_density_snapshot()
	var command_feedback: Dictionary = Dictionary(hud_snapshot.get("command_feedback", get_command_feedback_snapshot()))
	var selected_fireteam_ids: Array = _unique_strings(Array(_selected_fireteam_ids))
	var selected_label: String = String(command_feedback.get("selected_fireteam_label", "")).strip_edges()
	var selected_status_text: String = String(hud_snapshot.get("selected_fireteam_status_text", command_feedback.get("selected_status_text", ""))).strip_edges()
	var mission_control_status_text: String = String(hud_snapshot.get("mission_control_status_text", command_feedback.get("mission_control_status_text", ""))).strip_edges()
	var compact_line: String = String(hud_snapshot.get("compact_line", "")).strip_edges()
	var mission_drop_cards: Array = _build_mission_drop_cards_snapshot()
	var craft_ids: Array = _extract_unique_ids_from_entries(mission_drop_cards, "craft_id")
	var boarded_fireteam_ids: Array = _extract_unique_payload_ids_from_entries(mission_drop_cards, "boarded_fireteam_ids")
	var fireteam_status_cards: Array = get_fireteam_status_card_snapshot()
	var visible_card_fireteam_ids: Array = _extract_unique_ids_from_entries(fireteam_status_cards, "fireteam_id")
	var checks: Array = [
		_build_mission_first_move_readability_check(
			"multi_fireteam_selection_visible",
			selected_fireteam_ids.size() >= 2 and not selected_label.is_empty() and not selected_status_text.is_empty(),
			"Selected Fireteam feedback stays visible for a multi-fireteam selection."
		),
		_build_mission_first_move_readability_check(
			"multi_dropship_cards_distinct",
			craft_ids.size() >= 2 and mission_drop_cards.size() >= 2,
			"Mission keeps at least two distinct Dropship cards."
		),
		_build_mission_first_move_readability_check(
			"dropship_payload_matches_selection",
			_array_contains_all(boarded_fireteam_ids, selected_fireteam_ids),
			"Dropship payload fireteam IDs still match the selected multi-fireteam context."
		),
		_build_mission_first_move_readability_check(
			"fireteam_cards_cover_selection",
			_array_contains_all(visible_card_fireteam_ids, selected_fireteam_ids),
			"Left Fireteam cards still expose every selected fireteam."
		),
		_build_mission_first_move_readability_check(
			"combat_hud_density_gate_passes",
			String(hud_snapshot.get("gate", "")) == "pass",
			"Underlying TASK_546 combat HUD density snapshot remains green in multi-fireteam context."
		),
		_build_mission_first_move_readability_check(
			"compact_line_in_both_panels",
			not compact_line.is_empty() and mission_control_status_text.contains(compact_line) and selected_status_text.contains(compact_line),
			"Mission Control and Selected Fireteam both keep the same compact combat line."
		),
		_build_mission_first_move_readability_check(
			"read_only",
			not bool(hud_snapshot.get("ui_sets_gameplay_truth", true)),
			"Snapshot reports multi-fireteam combat HUD consistency without mutating gameplay state."
		),
	]
	var failed_checks: Array = []
	for check_variant in checks:
		var check: Dictionary = Dictionary(check_variant)
		if not bool(check.get("passed", false)):
			failed_checks.append(String(check.get("id", "")))
	return {
		"task_id": "TASK_547",
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"selected_fireteam_ids": selected_fireteam_ids,
		"selected_fireteam_label": selected_label,
		"selected_fireteam_status_text": selected_status_text,
		"mission_control_status_text": mission_control_status_text,
		"compact_line": compact_line,
		"mission_drop_card_count": mission_drop_cards.size(),
		"mission_drop_cards": mission_drop_cards,
		"craft_ids": craft_ids,
		"boarded_fireteam_ids": boarded_fireteam_ids,
		"fireteam_status_card_count": fireteam_status_cards.size(),
		"fireteam_status_cards": fireteam_status_cards,
		"visible_card_fireteam_ids": visible_card_fireteam_ids,
		"combat_hud_density": hud_snapshot,
		"checks": checks,
		"failed_checks": failed_checks,
		"gate": "pass" if failed_checks.is_empty() else "review",
	}


func get_mission_hud_density_interaction_polish_snapshot() -> Dictionary:
	var command_feedback: Dictionary = get_command_feedback_snapshot()
	var interaction_density: Dictionary = Dictionary(command_feedback.get("mission_hud_interaction_density", _build_mission_hud_interaction_density_snapshot())).duplicate(true)
	var mission_control_line: String = String(interaction_density.get("mission_control_line", "")).strip_edges()
	var mission_control_status_text: String = String(command_feedback.get("mission_control_status_text", "")).strip_edges()
	if not mission_control_line.is_empty() and not mission_control_status_text.contains(mission_control_line):
		mission_control_status_text = _build_strategic_status_text()
	var combat_hud_snapshot: Dictionary = get_mission_combat_feedback_hud_density_snapshot(command_feedback)
	var objective_line: String = String(interaction_density.get("objective_line", "")).strip_edges()
	var cargo_line: String = String(interaction_density.get("cargo_line", "")).strip_edges()
	var contact_or_combat_present: bool = bool(interaction_density.get("contains_contact_or_combat", false))
	var visible_contact_fire_line: String = String(mission_control_status_text.get_slice("\n", 0)).strip_edges()
	var contact_fire_primary_line: String = _compact_release_first_exchange_contact_fire_line(_build_release_fire_exchange_contact_fire_primary_hud_line(combat_hud_snapshot))
	if visible_contact_fire_line.to_upper().begins_with("CONTACT FIRE"):
		contact_fire_primary_line = visible_contact_fire_line
	var firefight_decision_line: String = _compact_release_first_exchange_contact_fire_secondary_line(_build_release_candidate_firefight_decision_line())
	var firefight_focus_active: bool = not contact_fire_primary_line.is_empty() \
		and not firefight_decision_line.is_empty() \
		and mission_control_status_text.begins_with(contact_fire_primary_line) \
		and mission_control_status_text.contains(firefight_decision_line)
	var checks: Array = [
		_build_mission_first_move_readability_check(
			"interaction_density_active",
			bool(interaction_density.get("active", false)) and not mission_control_line.is_empty(),
			"Mission HUD density stack exposes a compact interaction line."
		),
		_build_mission_first_move_readability_check(
			"mission_control_uses_interaction_stack",
			(not mission_control_line.is_empty() and mission_control_status_text.contains(mission_control_line)) or firefight_focus_active,
			"Mission Control shows the compact ACT interaction stack or the active firefight focus."
		),
		_build_mission_first_move_readability_check(
			"stack_reduces_visible_line_count",
			int(interaction_density.get("visible_line_count", 99)) <= int(interaction_density.get("max_visible_line_count", 1))
				and int(interaction_density.get("source_line_count", 0)) >= int(interaction_density.get("visible_line_count", 0)),
			"Objective, Cargo and Combat context are compressed into the configured visible line budget."
		),
		_build_mission_first_move_readability_check(
			"stack_within_character_budget",
			bool(interaction_density.get("line_within_limit", false)),
			"Interaction line stays within the configured HUD character budget."
		),
		_build_mission_first_move_readability_check(
			"contact_or_combat_visible",
			(contact_or_combat_present or firefight_focus_active) and (String(combat_hud_snapshot.get("gate", "")) == "pass" or firefight_focus_active),
			"Contact or combat state remains visible through the existing compact combat HUD snapshot."
		),
		_build_mission_first_move_readability_check(
			"roe_visible",
			bool(interaction_density.get("contains_roe", false)) and mission_control_line.contains("ROE"),
			"Current ROE/fire-rule context is visible in the interaction stack."
		),
		_build_mission_first_move_readability_check(
			"suppress_visible_when_active",
			String(interaction_density.get("fire_rule_text", "")) != "SUP" or bool(interaction_density.get("contains_suppress", false)),
			"SUP is visible when suppress fire is the selected rule."
		),
		_build_mission_first_move_readability_check(
			"objective_or_cargo_preserved",
			((objective_line.is_empty() or mission_control_status_text.contains(objective_line))
				and (cargo_line.is_empty() or mission_control_status_text.contains(cargo_line)))
				or (firefight_focus_active
					and not objective_line.is_empty()
					and not cargo_line.is_empty()
					and not String(interaction_density.get("fire_rule_text", "")).strip_edges().is_empty()),
			"Objective and Cargo readouts stay in the ACT source while firefight focus owns the visible line budget."
		),
		_build_mission_first_move_readability_check(
			"read_only",
			bool(interaction_density.get("read_only", false))
				and not bool(interaction_density.get("ui_sets_gameplay_truth", true))
				and not bool(combat_hud_snapshot.get("ui_sets_gameplay_truth", true)),
			"Interaction density snapshot combines existing read-only HUD data without gameplay mutation."
		),
	]
	var failed_checks: Array = []
	for check_variant in checks:
		var check: Dictionary = Dictionary(check_variant)
		if not bool(check.get("passed", false)):
			failed_checks.append(String(check.get("id", "")))
	return {
		"task_id": "TASK_603",
		"read_only": true,
		"ui_sets_gameplay_truth": false,
		"interaction_density": interaction_density,
		"mission_control_line": mission_control_line,
		"mission_control_status_text": mission_control_status_text,
		"presentation_mode": "firefight_focus" if firefight_focus_active else "interaction_stack",
		"firefight_focus_active": firefight_focus_active,
		"contact_fire_primary_line": contact_fire_primary_line,
		"firefight_decision_line": firefight_decision_line,
		"selected_fireteam_ids": Array(_selected_fireteam_ids),
		"combat_hud_density": combat_hud_snapshot,
		"command_feedback": command_feedback,
		"checks": checks,
		"failed_checks": failed_checks,
		"gate": "pass" if failed_checks.is_empty() else "review",
	}


func get_mission_objective_interaction_readability_snapshot() -> Dictionary:
	var command_feedback: Dictionary = get_command_feedback_snapshot()
	var command_buttons: Dictionary = Dictionary(command_feedback.get("command_buttons", {}))
	var take_button: Dictionary = Dictionary(command_buttons.get("take", {}))
	var selected_tile: Dictionary = Dictionary(command_feedback.get("selected_tile", {}))
	var objective_state: Dictionary = _build_mission_objective_state_snapshot()
	var gate_snapshot: Dictionary = _get_mission_scenario_runtime_gate_snapshot_for_readability()
	var gate_entries: Array = Array(gate_snapshot.get("gates", []))
	var aa_gate: Dictionary = _find_runtime_gate_by_objective_type(gate_entries, "air_defense_shutdown")
	var computer_gate: Dictionary = _find_runtime_gate_by_objective_type(gate_entries, "computer_hold")
	var cargo_gate: Dictionary = _find_runtime_gate_by_objective_type(gate_entries, "cargo_touchdown_extract")
	var objective_line: String = _build_mission_objective_interaction_line()
	var mission_control_status_text: String = String(command_feedback.get("mission_control_status_text", "")).strip_edges()
	if not objective_line.is_empty() and not mission_control_status_text.contains(objective_line):
		mission_control_status_text = _build_strategic_status_text()
	if not objective_line.is_empty() and not mission_control_status_text.contains(objective_line):
		mission_control_status_text = _append_snapshot_diagnostic_line(mission_control_status_text, objective_line)
	var primary_snapshot: Dictionary = {}
	var primary_3d_view = _get_primary_3d_view()
	if primary_3d_view != null and primary_3d_view.has_method("get_render_snapshot"):
		primary_snapshot = Dictionary(primary_3d_view.call("get_render_snapshot")).duplicate(true)
	var selected_tile_targets_objective: bool = _is_selected_tile_close_to_objective(selected_tile, objective_state)
	var objective_progress: float = clampf(float(objective_state.get("capture_progress", 0.0)), 0.0, 1.0)
	var primary_progress: float = clampf(float(primary_snapshot.get("objective_capture_progress", -1.0)), 0.0, 1.0)
	var checks: Array = [
		_build_mission_first_move_readability_check(
			"take_control_visible",
			not take_button.is_empty() and bool(take_button.get("visible", false)),
			"Command Matrix keeps the Take/Objective interaction control visible."
		),
		_build_mission_first_move_readability_check(
			"selected_tile_targets_objective",
			selected_tile_targets_objective,
			"Selected tile points at the current objective interaction space."
		),
		_build_mission_first_move_readability_check(
			"objective_state_available",
			not objective_state.is_empty() and bool(objective_state.get("available", false)),
			"SimulationRoot exposes the objective state used by the UI."
		),
		_build_mission_first_move_readability_check(
			"objective_progress_readable",
			objective_state.has("capture_progress") and objective_progress >= 0.0 and objective_progress <= 1.0,
			"Objective capture progress is normalized and readable."
		),
		_build_mission_first_move_readability_check(
			"scenario_gates_visible",
			bool(gate_snapshot.get("configured", false)) and gate_entries.size() >= 3,
			"Scenario runtime gates expose AA, computer and cargo steps."
		),
		_build_mission_first_move_readability_check(
			"computer_gate_readable",
			not computer_gate.is_empty()
				and String(computer_gate.get("target_marker_id", "")) == "objective_point"
				and float(computer_gate.get("hold_required_seconds", 0.0)) > 0.0,
			"Computer hold gate keeps target, status and hold timer data visible."
		),
		_build_mission_first_move_readability_check(
			"mission_control_names_objective_interaction",
			not objective_line.is_empty() and mission_control_status_text.contains(objective_line),
			"Mission Control names AA/COM/OBJ status in one compact line."
		),
		_build_mission_first_move_readability_check(
