func _apply_command_grid_hierarchy_order(command_grid: GridContainer) -> void:
	var ordered_names: PackedStringArray = PackedStringArray([
		"MoveButton",
		"TakeButton",
		"HoldButton",
		"FlankButton",
		"TargetButton",
		"ClearTargetButton",
	])
	for index in range(ordered_names.size()):
		var child := command_grid.get_node_or_null(ordered_names[index])
		if child == null:
			continue
		command_grid.move_child(child, index)
	command_grid.set_meta("command_hierarchy_order", PackedStringArray(["move", "take", "defend", "flank", "engage", "clear_target", "delete_order", "breach_door", "sort_fireteam", "fire_rule_hold", "fire_rule_return", "fire_rule_free", "fire_rule_suppress", "go", "waypoint_erase"]))
	command_grid.set_meta("command_hierarchy_columns", command_grid.columns)


func _ensure_command_grid_placeholder_buttons(command_grid: GridContainer) -> void:
	if command_grid == null:
		return
	var action_button_size: Vector2i = DROP_LIGHT_LAYOUT_CONTRACT_SCRIPT.get("ACTION_BUTTON_SIZE")
	for slot_index in range(7, 21):
		if slot_index == 7:
			_ensure_command_grid_action_button(command_grid, "DeleteOrderButton", "LOE", "Ausgewaehlten Wegpunkt oder Flaechenbefehl loeschen.", Callable(self, "_on_delete_order_pressed"), slot_index)
			continue
		if slot_index == 8:
			_ensure_door_interaction_command_button(command_grid, slot_index)
			continue
		if slot_index == 10:
			_ensure_command_grid_action_button(command_grid, "SortCommandMatrixButton", "ORD", "Ausgewaehltes Fireteam zentrieren und Plan ordnen.", Callable(self, "_on_sort_fireteam_pressed"), slot_index)
			continue
		var fire_rule_spec: Dictionary = _find_fire_rule_button_spec_for_slot(slot_index)
		if not fire_rule_spec.is_empty():
			_ensure_fire_rule_command_button(command_grid, fire_rule_spec)
			continue
		if slot_index == 15:
			_ensure_command_grid_action_button(command_grid, "GoCommandMatrixButton", "GO", "Execute selected orders", Callable(self, "_on_go_phase_pressed"), slot_index)
			continue
		if slot_index == 20:
			var stale_plan_button := command_grid.get_node_or_null("PlanCommandMatrixButton") as Button
			if stale_plan_button != null:
				command_grid.remove_child(stale_plan_button)
				stale_plan_button.queue_free()
			_ensure_command_grid_action_button(command_grid, "WaypointEraseButton", "WP-", "Punkt/Wegpunkt loeschen", Callable(self, "_on_delete_order_pressed"), slot_index)
			continue
		var slot_name := "CommandSlot%02d" % slot_index
		var button := command_grid.get_node_or_null(slot_name) as Button
		if button == null:
			button = Button.new()
			button.name = slot_name
			button.focus_mode = Control.FOCUS_NONE
			button.text = ""
			button.tooltip_text = "Reserve command slot"
			button.disabled = true
			button.set_meta("drop_light_command_placeholder", true)
			button.mouse_filter = Control.MOUSE_FILTER_IGNORE
			command_grid.add_child(button)
		button.set_meta("drop_light_command_placeholder", true)
		button.disabled = true
		_configure_square_hud_button(button, action_button_size)
		META_UI_SKIN_SCRIPT.style_tactical_button(button, false)
		command_grid.move_child(button, slot_index - 1)
	command_grid.set_meta("command_placeholder_slots", 6)


func _ensure_command_grid_action_button(command_grid: GridContainer, button_name: String, text: String, tooltip: String, callback: Callable, slot_index: int) -> void:
	var stale_placeholder := command_grid.get_node_or_null("CommandSlot%02d" % slot_index) as Button
	if stale_placeholder != null:
		command_grid.remove_child(stale_placeholder)
		stale_placeholder.queue_free()
	var button := command_grid.get_node_or_null(button_name) as Button
	if button == null:
		button = Button.new()
		button.name = button_name
		button.focus_mode = Control.FOCUS_ALL
		command_grid.add_child(button)
	button.text = text
	button.tooltip_text = tooltip
	button.disabled = false
	button.mouse_filter = Control.MOUSE_FILTER_STOP
	button.set_meta("drop_light_command_placeholder", false)
	button.set_meta("command_matrix_slot_id", "16.%d" % slot_index)
	if callback.is_valid() and not button.pressed.is_connected(callback):
		button.pressed.connect(callback)
	_configure_square_hud_button(button, DROP_LIGHT_LAYOUT_CONTRACT_SCRIPT.get("ACTION_BUTTON_SIZE"))
	META_UI_SKIN_SCRIPT.style_tactical_button(button, false)
	command_grid.move_child(button, slot_index - 1)


func _ensure_door_interaction_command_button(command_grid: GridContainer, slot_index: int = 8) -> void:
	if command_grid == null:
		return
	var stale_placeholder := command_grid.get_node_or_null("CommandSlot%02d" % slot_index) as Button
	if stale_placeholder != null:
		command_grid.remove_child(stale_placeholder)
		stale_placeholder.queue_free()
	var button := command_grid.get_node_or_null("DoorBreachButton") as Button
	if button == null:
		button = Button.new()
		button.name = "DoorBreachButton"
		button.focus_mode = Control.FOCUS_ALL
		command_grid.add_child(button)
	button.text = "Breach"
	button.tooltip_text = "Breach usable door [B]"
	button.mouse_filter = Control.MOUSE_FILTER_STOP
	button.set_meta("drop_light_command_placeholder", false)
	button.set_meta("command_matrix_slot_id", "16.%d" % slot_index)
	var callback := Callable(self, "_on_door_breach_button_pressed")
