func _process(delta: float) -> void:
	_ensure_plan_mode_switch()
	_advance_campaign_extraction(delta)
	var profile_enabled: bool = _mission_visible_frame_timing_debug_enabled
	var frame_started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
	var scopes_usec: Dictionary = {}
	var scope_started_usec: int = 0
	if profile_enabled:
		scope_started_usec = Time.get_ticks_usec()
	if _drop_ship_cooldown_remaining > 0.0:
		_drop_ship_cooldown_remaining = maxf(_drop_ship_cooldown_remaining - delta, 0.0)
	_advance_network_dropship_pending(delta)
	_update_drop_sequence(delta)
	_update_fireteam_suppression(delta)
	_update_leader_initiated_flanks()
	_update_ad_hoc_execution(delta)
	_update_active_phase_execution(delta)
	_update_area_defense_execution(delta)
	_update_area_attack_execution(delta)
	_update_npc_thought_peek_visuals()
	if profile_enabled:
		scopes_usec["execution_updates_usec"] = Time.get_ticks_usec() - scope_started_usec
		scope_started_usec = Time.get_ticks_usec()
	if _prune_fireteamleader_feedback_bubbles():
		_refresh_order_visuals()
	_flush_pending_drop_runtime_phase_starts()
	_refresh_fireteam_runtime_ui_if_pending()
	if not _default_fireteam_selection_initialized:
		_ensure_default_fireteam_selection()
	_fireteam_security_refresh_time_remaining -= delta
	if _fireteam_security_refresh_time_remaining <= 0.0:
		_fireteam_security_refresh_time_remaining = FIRETEAM_SECURITY_REFRESH_INTERVAL_SECONDS
		refresh_fireteam_security_state()
	if profile_enabled:
		scopes_usec["feedback_and_security_usec"] = Time.get_ticks_usec() - scope_started_usec
		scopes_usec["hud_light_usec"] = scopes_usec["feedback_and_security_usec"]
		scope_started_usec = Time.get_ticks_usec()
	if not _tactical_ui_visible: return
	_card_refresh_time_remaining -= delta
	_runtime_hud_heavy_refresh_time_remaining -= delta
	if _card_refresh_time_remaining > 0.0:
		if profile_enabled:
			scopes_usec["ui_refresh_usec"] = 0
			scopes_usec["hud_heavy_usec"] = 0
			_record_mission_visible_frame_timing_snapshot(frame_started_usec, scopes_usec, false)
		return
	_card_refresh_time_remaining = CARD_REFRESH_INTERVAL_SECONDS
	var command_refresh_due: bool = _runtime_hud_command_refresh_pending
	var heavy_refresh_due: bool = command_refresh_due or _runtime_hud_heavy_refresh_time_remaining <= 0.0
	if heavy_refresh_due:
		_runtime_hud_heavy_refresh_time_remaining = RUNTIME_HUD_HEAVY_REFRESH_INTERVAL_SECONDS
		_request_periodic_hud_projection(command_refresh_due)
	else:
		_update_ui(false, false)
	if profile_enabled:
		scopes_usec["ui_refresh_usec"] = Time.get_ticks_usec() - scope_started_usec
		scopes_usec["hud_heavy_usec"] = scopes_usec["ui_refresh_usec"] if heavy_refresh_due else 0
		_record_mission_visible_frame_timing_snapshot(frame_started_usec, scopes_usec, true)
		if heavy_refresh_due:
			_mission_visible_frame_timing_debug_snapshot["periodic_hud_request_only"] = _periodic_hud_last_request_external
			_mission_visible_frame_timing_debug_snapshot["periodic_hud_work_timing_owner"] = "UpdateManager.refresh_hud" if _periodic_hud_last_request_external else "controller_synchronous_manager_fallback"


func _advance_mission_dropship_runtime_feedback_timer(delta: float) -> void:
	if _mission_dropship_runtime_ui_refresh_remaining <= 0.0:
		return
	_mission_dropship_runtime_ui_refresh_remaining = maxf(_mission_dropship_runtime_ui_refresh_remaining - maxf(delta, 0.0), 0.0)


func _flush_mission_dropship_runtime_feedback(force: bool = false, refresh_world_when_deferred: bool = true) -> bool:
	if not force and _mission_dropship_runtime_ui_refresh_remaining > 0.0:
		if refresh_world_when_deferred:
			_refresh_world_overlays()
		return false
	_mission_dropship_runtime_ui_refresh_remaining = MISSION_DROPSHIP_RUNTIME_UI_REFRESH_SECONDS
	_store_selected_mission_dropship_plan()
	_mission_dropship_runtime_planning_emit_count += 1
	_emit_planning_state_changed()
	_mission_dropship_runtime_feedback_flush_count += 1
	_update_ui(true, false)
	return true


