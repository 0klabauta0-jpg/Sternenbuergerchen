func _on_door_breach_button_pressed() -> void:
	issue_primary_mission_interaction()


func _refresh_door_interaction_button_state(feedback_snapshot: Dictionary = {}) -> void:
	var button := get_node_or_null(DOOR_BREACH_BUTTON_PATH) as Button
	if button == null:
		return
	var feedback: Dictionary = feedback_snapshot
	if feedback.is_empty():
		feedback = get_mission_interaction_use_feedback_snapshot()
	var interaction_feedback: Dictionary = _resolve_primary_mission_interaction_feedback(feedback)
	var interaction_type: String = String(interaction_feedback.get("interaction_type", "")).strip_edges().to_lower()
	var is_door: bool = interaction_type == "door"
	var has_usable_interaction: bool = bool(interaction_feedback.get("can_prompt_use", false)) and String(interaction_feedback.get("status", "")).strip_edges().to_lower() == "usable"
	var enabled: bool = not preview_mode and _can_issue_local_commands() and not _selected_fireteam_ids.is_empty() and has_usable_interaction
	var display_token: String = String(interaction_feedback.get("display_token", "USE")).strip_edges().to_upper()
	if display_token.is_empty():
		display_token = "USE"
	button.visible = true
	button.disabled = not enabled
	var usable_door_feedback: Dictionary = interaction_feedback if is_door and has_usable_interaction else {}
	var authority_ui_feedback: Dictionary = build_mission_interaction_door_authority_ui_feedback({}, _build_door_authority_button_context(feedback, usable_door_feedback)) if is_door else {}
	if is_door:
		button.text = _build_door_interaction_button_text(String(authority_ui_feedback.get("status", "")).strip_edges(), enabled)
		button.tooltip_text = String(authority_ui_feedback.get("tooltip_text", "")).strip_edges()
		if button.tooltip_text.is_empty():
			button.tooltip_text = "Breach %s [B] -> GO" % display_token if enabled else _build_door_interaction_button_disabled_tooltip(has_usable_interaction)
	else:
		var player_token: String = _get_player_interaction_button_token(display_token)
		button.text = "%s->GO" % player_token if enabled else player_token
		button.tooltip_text = "%s -> GO" % String(interaction_feedback.get("feedback_line", "interaction unavailable")).strip_edges()
	button.set_meta("door_interaction_button_enabled", enabled)
	button.set_meta("door_interaction_id", String(interaction_feedback.get("interaction_id", "")).strip_edges())
	button.set_meta("door_interaction_display_token", display_token)
	button.set_meta("mission_interaction_button", true)
	button.set_meta("mission_interaction_type", interaction_type)
	button.set_meta("mission_interaction_required_order", String(interaction_feedback.get("required_order", "")).strip_edges().to_lower())
	button.set_meta("mission_interaction_requires_go", enabled)
	button.set_meta("help_id", _get_primary_mission_interaction_help_id(interaction_feedback))
	button.set_meta("door_interaction_shortcut", "B" if is_door else "")
	button.set_meta("door_authority_ui_status", String(authority_ui_feedback.get("status", "")).strip_edges())
	button.set_meta("door_authority_ui_summary_line", String(authority_ui_feedback.get("summary_line", "")).strip_edges())
	button.set_meta("door_authority_ui_compact_line", String(authority_ui_feedback.get("compact_line", "")).strip_edges())
	button.set_meta("door_authority_ui_detail_line", String(authority_ui_feedback.get("detail_line", "")).strip_edges())
	button.set_meta("door_authority_ui_player_hint", String(authority_ui_feedback.get("player_hint", "")).strip_edges())
	button.set_meta("door_authority_ui_next_action", String(authority_ui_feedback.get("next_action", "")).strip_edges())
	button.set_meta("door_authority_ui_severity", String(authority_ui_feedback.get("severity", "")).strip_edges())
	button.set_meta("door_authority_ui_reject_reason_label", String(authority_ui_feedback.get("reject_reason_label", "")).strip_edges())
	button.set_meta("door_authority_ui_requires_go", bool(authority_ui_feedback.get("requires_go", false)))
	button.set_meta("door_authority_ui_read_only", bool(authority_ui_feedback.get("read_only", false)))
	button.set_meta("command_hierarchy_disabled_reason", "" if enabled else _resolve_primary_mission_interaction_button_disabled_reason(interaction_feedback, is_door))
	META_UI_SKIN_SCRIPT.style_tactical_button(button, enabled)
	_apply_door_authority_button_affordance(button, String(authority_ui_feedback.get("severity", "action" if enabled else "warning")).strip_edges())


func _get_player_interaction_button_token(display_token: String) -> String:
	return "NUTZ" if display_token.strip_edges().to_upper() == "USE" else display_token.strip_edges().to_upper()


func get_primary_mission_interaction_button_snapshot() -> Dictionary:
	var feedback: Dictionary = get_mission_interaction_use_feedback_snapshot()
	var interaction_feedback: Dictionary = _resolve_primary_mission_interaction_feedback(feedback)
	var interaction_type: String = String(interaction_feedback.get("interaction_type", "")).strip_edges().to_lower()
	var is_door: bool = interaction_type == "door"
	var usable: bool = bool(interaction_feedback.get("can_prompt_use", false)) and String(interaction_feedback.get("status", "")).strip_edges().to_lower() == "usable"
	var enabled: bool = not preview_mode and _can_issue_local_commands() and not _selected_fireteam_ids.is_empty() and usable
	var display_token: String = String(interaction_feedback.get("display_token", "USE")).strip_edges().to_upper()
	if display_token.is_empty():
		display_token = "USE"
	var usable_door_feedback: Dictionary = interaction_feedback if is_door and usable else {}
	var door_authority: Dictionary = build_mission_interaction_door_authority_ui_feedback({}, _build_door_authority_button_context(feedback, usable_door_feedback)) if is_door else {}
	var tooltip_text: String = String(door_authority.get("tooltip_text", "")).strip_edges() if is_door else "%s -> GO" % String(interaction_feedback.get("feedback_line", "interaction unavailable")).strip_edges()
	if tooltip_text.is_empty() and is_door:
		tooltip_text = "Breach %s [B] -> GO" % display_token if enabled else _build_door_interaction_button_disabled_tooltip(usable)
	return {
		"schema": "sternenbuergerchen.mission_primary_interaction_button.v1",
		"button_path": DOOR_BREACH_BUTTON_PATH,
		"visible": true,
		"disabled": not enabled,
		"text": _build_door_interaction_button_text(String(door_authority.get("status", "")).strip_edges(), enabled) if is_door else ("%s->GO" % display_token if enabled else display_token),
		"tooltip_text": tooltip_text,
		"interaction_id": String(interaction_feedback.get("interaction_id", "")).strip_edges(),
		"interaction_type": interaction_type,
		"required_order": String(interaction_feedback.get("required_order", "")).strip_edges().to_lower(),
		"status": String(interaction_feedback.get("status", "unknown")).strip_edges().to_lower(),
		"display_token": display_token,
		"help_id": _get_primary_mission_interaction_help_id(interaction_feedback),
		"shortcut": "B" if is_door else "",
		"requires_go": enabled,
		"disabled_reason": "" if enabled else _resolve_primary_mission_interaction_button_disabled_reason(interaction_feedback, is_door),
		"uses_door_breach_bridge": is_door,
		"read_only": true,
		"ui_sets_gameplay_truth": false,
	}


func _resolve_primary_mission_interaction_button_disabled_reason(interaction_feedback: Dictionary, is_door: bool) -> String:
	if preview_mode:
		return "preview mode"
	if not _can_issue_local_commands():
		return "host controls mission commands"
	if _selected_fireteam_ids.is_empty():
		return "select fireteam"
	if is_door:
		return _resolve_door_interaction_button_disabled_reason(false)
	var status: String = String(interaction_feedback.get("status", "")).strip_edges().to_lower()
	if status == "out_of_range":
		return "move selected fireteam into interaction range"
	if status == "blocked":
		return "complete the previous route step"
	if String(interaction_feedback.get("interaction_id", "")).strip_edges().is_empty():
		return "no mission interaction available"
	return "interaction not usable"


func _build_door_interaction_button_text(status: String, enabled: bool) -> String:
	match status.strip_edges().to_lower():
		"ready":
			return "B->GO" if enabled else "Door"
		"accepted":
			return "Host"
		"open":
			return "Open"
		"blocked":
			return "Block"
		_:
			return "Door"


func _apply_door_authority_button_affordance(button: Button, severity: String) -> void:
	if button == null:
		return
	var normalized_severity: String = severity.strip_edges().to_lower()
	var style_id: String = DOOR_AUTHORITY_NEUTRAL_AFFORDANCE_STYLE_ID
	var tone: String = "neutral"
	var visual_weight: float = 0.0
	var modulate_color: Color = Color(1.0, 1.0, 1.0, 1.0)
	var font_color: Color = Color(0.0, 0.0, 0.0, 1.0)
	var use_font_override: bool = true
	match normalized_severity:
		"action":
			style_id = DOOR_AUTHORITY_READY_AFFORDANCE_STYLE_ID
			tone = "action"
			visual_weight = 1.2
			modulate_color = Color(0.72, 0.95, 1.0, 1.0)
			font_color = Color(0.04, 0.07, 0.08, 1.0)
		"success":
			style_id = DOOR_AUTHORITY_OPEN_AFFORDANCE_STYLE_ID
			tone = "success"
			visual_weight = 1.35
			modulate_color = Color(0.70, 1.0, 0.82, 1.0)
			font_color = Color(0.03, 0.08, 0.045, 1.0)
		"warning":
			style_id = DOOR_AUTHORITY_BLOCKED_AFFORDANCE_STYLE_ID
			tone = "warning"
			visual_weight = 1.15
			modulate_color = Color(1.0, 0.84, 0.42, 1.0)
			font_color = Color(0.10, 0.07, 0.02, 1.0)
		_:
			use_font_override = false
	button.set_meta("door_authority_affordance_style_id", style_id)
	button.set_meta("door_authority_affordance_tone", tone)
	button.set_meta("door_authority_affordance_visual_weight", visual_weight)
	# Keep the complete authority receipt; the existing native context presenter
	# owns the final colors and modulation instead of resetting them afterward.
	if _native_a5_owns_interaction_button_presentation(button):
		return
	button.self_modulate = modulate_color
	if use_font_override:
		button.add_theme_color_override("font_color", font_color)
		button.add_theme_color_override("font_pressed_color", font_color)
		button.add_theme_color_override("font_hover_color", font_color)
		button.add_theme_color_override("font_focus_color", font_color)


func _build_door_authority_button_context(feedback_snapshot: Dictionary = {}, door_feedback: Dictionary = {}) -> Dictionary:
	var feedback: Dictionary = feedback_snapshot
	if feedback.is_empty():
		feedback = get_mission_interaction_use_feedback_snapshot()
	var resolved_door_feedback: Dictionary = door_feedback
	if resolved_door_feedback.is_empty():
		resolved_door_feedback = _resolve_usable_door_interaction_feedback(feedback)
	var has_usable_door: bool = not resolved_door_feedback.is_empty()
	var enabled: bool = not preview_mode and _can_issue_local_commands() and not _selected_fireteam_ids.is_empty() and has_usable_door
	var display_token: String = String(resolved_door_feedback.get("display_token", "DOOR")).strip_edges().to_upper()
	if display_token.is_empty():
		display_token = "DOOR"
	return {
		"button_enabled": enabled,
		"has_usable_door": has_usable_door,
		"display_token": display_token,
		"shortcut": "B",
	}


func _build_door_interaction_button_disabled_tooltip(has_usable_door: bool) -> String:
	return "Breach door [B]: %s" % _resolve_door_interaction_button_disabled_reason(has_usable_door)


func _resolve_door_interaction_button_disabled_reason(has_usable_door: bool) -> String:
	if preview_mode:
		return "preview mode"
	if not _can_issue_local_commands():
		return "host controls mission commands"
	if _selected_fireteam_ids.is_empty():
		return "select fireteam"
	if not has_usable_door:
		return "no usable door nearby"
	return ""


func _find_fire_rule_button_spec_for_slot(slot_index: int) -> Dictionary:
	for spec_variant in _get_fire_rule_button_specs():
		var spec: Dictionary = Dictionary(spec_variant)
		if int(spec.get("slot", -1)) == slot_index:
			return spec
	return {}


func _ensure_fire_rule_command_button(command_grid: GridContainer, spec: Dictionary) -> void:
	if command_grid == null or spec.is_empty():
		return
	var slot_index: int = int(spec.get("slot", -1))
	if slot_index <= 0:
		return
	var stale_placeholder := command_grid.get_node_or_null("CommandSlot%02d" % slot_index) as Button
	if stale_placeholder != null:
		command_grid.remove_child(stale_placeholder)
		stale_placeholder.queue_free()
	var button_name: String = String(spec.get("name", "")).strip_edges()
	if button_name.is_empty():
		return
	var button := command_grid.get_node_or_null(button_name) as Button
	if button == null:
		button = Button.new()
		button.name = button_name
		button.focus_mode = Control.FOCUS_ALL
		button.toggle_mode = true
		command_grid.add_child(button)
	button.text = String(spec.get("text", ""))
	button.tooltip_text = String(spec.get("tooltip", ""))
	button.disabled = false
	button.mouse_filter = Control.MOUSE_FILTER_STOP
	button.toggle_mode = true
	button.set_meta("drop_light_command_placeholder", false)
	button.set_meta("command_matrix_slot_id", "16.%d" % slot_index)
	button.set_meta("fire_rule_control", true)
	button.set_meta("fire_rule", String(spec.get("rule", "")))
	button.set_meta("help_id", String(spec.get("help_id", "")))
	var callback := Callable(self, "_on_fire_rule_button_pressed").bind(String(spec.get("rule", "")))
	if not bool(button.get_meta("fire_rule_button_connected", false)):
		button.pressed.connect(callback)
		button.set_meta("fire_rule_button_connected", true)
	_configure_square_hud_button(button, DROP_LIGHT_LAYOUT_CONTRACT_SCRIPT.get("ACTION_BUTTON_SIZE"), 7)
	META_UI_SKIN_SCRIPT.style_tactical_button(button, false)
	command_grid.move_child(button, slot_index - 1)


func _apply_compact_fireteam_info_text_contract() -> void:
	var info_vbox := get_node_or_null(FIRETEAM_INFO_VBOX_PATH) as Control
	if info_vbox != null:
		info_vbox.custom_minimum_size = Vector2.ZERO
		info_vbox.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	for path in [
		command_feedback_label_path,
		hotkey_legend_label_path,
		NodePath("%s/TacticalStancePanel/MarginContainer/VBoxContainer/SummaryLabel" % FIRETEAM_INFO_VBOX_PATH),
