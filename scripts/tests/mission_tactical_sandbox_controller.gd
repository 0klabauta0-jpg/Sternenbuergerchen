func _selected_fireteams_have_embarked_payload() -> bool:
	for fireteam_id_variant in _selected_fireteam_ids:
		if _fireteam_has_embarked_payload(String(fireteam_id_variant)):
			return true
	return false


func _fireteam_has_embarked_payload(fireteam_id: String) -> bool:
	var normalized_fireteam_id: String = fireteam_id.strip_edges().to_lower()
	if normalized_fireteam_id.is_empty():
		return false
	return _mission_fireteam_runtime_state.fireteam_has_embarked_payload(_get_fireteam_units(normalized_fireteam_id, true), _build_hud_embarked_unit_state(), _deployed_unit_ids)


func _build_hud_embarked_unit_state() -> Dictionary:
	var result: Dictionary = _embarked_unit_ids.duplicate(true)
	for card_variant in _mission_drop_cards:
		if typeof(card_variant) != TYPE_DICTIONARY:
			continue
		for unit_id_variant in Array(Dictionary(card_variant).get("embarked_unit_ids", [])):
			var unit_id: String = String(unit_id_variant).strip_edges()
			if not unit_id.is_empty():
				result[unit_id] = true
	if _is_drop_sequence_active():
		for unit_id_variant in _drop_sequence_embarked_unit_ids.keys():
			result[String(unit_id_variant)] = true
	for sequence_variant in _parallel_drop_sequences_by_craft.values():
		if typeof(sequence_variant) != TYPE_DICTIONARY:
			continue
		for unit_id_variant in Dictionary(Dictionary(sequence_variant).get("embarked_unit_ids", {})).keys():
			result[String(unit_id_variant)] = true
	for deployed_unit_id_variant in _deployed_unit_ids.keys():
		result.erase(String(deployed_unit_id_variant))
	return result


func _refresh_fireteam_mini_cards() -> void:
	var card_host := get_node_or_null(FIRETEAM_MINI_CARDS_VBOX_PATH) as VBoxContainer
	if card_host == null:
		return
	var runtime_signature: String = _build_fireteam_mini_cards_runtime_signature()
	if runtime_signature == _last_fireteam_mini_cards_runtime_signature:
		_increment_mission_hud_runtime_surface_guard_count(_mission_hud_runtime_surface_guard_skip_counts, "mini_cards")
		return
	_last_fireteam_mini_cards_runtime_signature = runtime_signature
	_increment_mission_hud_runtime_surface_guard_count(_mission_hud_runtime_surface_guard_apply_counts, "mini_cards")

	var fireteam_panel := get_node_or_null(FIRETEAM_MINI_PANEL_PATH) as Control
	var existing_cards_by_id: Dictionary = {}
	for child in card_host.get_children():
		var child_control := child as Control
		if child_control == null:
			continue
		var existing_fireteam_id: String = String(child_control.get_meta("fireteam_id", "")).strip_edges().to_lower()
		if existing_fireteam_id.is_empty():
			continue
		existing_cards_by_id[existing_fireteam_id] = child_control

	var available_fireteam_ids: PackedStringArray = _get_displayable_fireteam_ids()
	if fireteam_panel != null:
		fireteam_panel.visible = not available_fireteam_ids.is_empty()
	if available_fireteam_ids.is_empty():
		for child in card_host.get_children():
			card_host.remove_child(child)
			child.queue_free()
		return

	var active_fireteam_ids: Dictionary = {}
	var desired_index: int = 0
	var primary_focus_fireteam_id: String = _get_left_tactical_stack_primary_focus_fireteam_id(available_fireteam_ids)
	for fireteam_id in available_fireteam_ids:
		var normalized_fireteam_id: String = String(fireteam_id).strip_edges().to_lower()
		var units: Array = _filter_ground_fireteam_card_units(_get_fireteam_units(normalized_fireteam_id, not _use_visible_units_for_fireteam_ui()))
		if units.is_empty():
			continue
		active_fireteam_ids[normalized_fireteam_id] = true
		var card: FOBFireteamCard = existing_cards_by_id.get(normalized_fireteam_id, null) as FOBFireteamCard
		var is_new_card: bool = card == null
		if card == null:
			card = FOB_FIRETEAM_CARD_SCRIPT.new()
			card.name = "FireteamMiniCard_%s" % normalized_fireteam_id.capitalize()
			card_host.add_child(card)
		card.set_meta("fireteam_id", normalized_fireteam_id)

		var lead = _resolve_fireteam_leader_for_behavior(normalized_fireteam_id)
		var selected_fireteam: bool = _selected_fireteam_ids.has(normalized_fireteam_id)
		var runtime_inactive: bool = not preview_mode and not _is_fireteam_runtime_active(normalized_fireteam_id)
		var lead_name: String = String(lead.call("get_display_name")) if lead != null and lead.has_method("get_display_name") else "Kein Lead"
		var lead_summary: String = _build_mission_fireteam_reference_summary(normalized_fireteam_id, lead_name, units)
		var static_signature: String = _build_fireteam_mini_card_static_signature(normalized_fireteam_id, lead, lead_summary)
		var static_configuration_changed: bool = is_new_card or String(card.get_meta("mission_fireteam_mini_card_static_signature", "")) != static_signature
		if static_configuration_changed:
			card.custom_minimum_size = Vector2(0.0, 110.0)
			card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			card.mouse_filter = Control.MOUSE_FILTER_STOP
			card.set_meta("mission_fireteam_mini_card", true)
			card.set_meta("fob_fireteam_reference_card", true)
			card.call(
				"setup_card",
				normalized_fireteam_id,
				_get_fireteam_display_label(normalized_fireteam_id),
				selected_fireteam,
				false,
				_get_mission_fireteam_loadout_id(normalized_fireteam_id),
				lead_summary,
				"mission_mini"
			)
			card.set_meta("mission_fireteam_lead_summary", lead_summary)
			card.set_meta("station_route_hud_visual_polish_task", "TASK_722")
			card.set_meta("station_route_hud_compact_mini_card", true)
			card.set_meta("mission_fireteam_mini_card_static_signature", static_signature)
			_increment_mission_fireteam_card_delta_rendering_count("static_apply")
		else:
			_increment_mission_fireteam_card_delta_rendering_count("static_skip")
		if bool(card.get_meta("mission_fireteam_mini_card_selected", selected_fireteam)) != selected_fireteam:
			card.call("set_selected", selected_fireteam)
		card.set_meta("mission_fireteam_mini_card_selected", selected_fireteam)
		_apply_fireteam_mini_card_status_context(card, normalized_fireteam_id, units)
		_apply_left_tactical_stack_1280_mini_card_style(card, normalized_fireteam_id == primary_focus_fireteam_id)
		_increment_mission_fireteam_card_delta_rendering_count("runtime_status_apply")
		_apply_fireteam_mini_card_leader_portrait(card, lead)
		_apply_native_a5_fireteam_card(card, normalized_fireteam_id, units, selected_fireteam, runtime_inactive)
		card.modulate = Color(1.0, 1.0, 1.0, 0.58) if runtime_inactive else Color.WHITE
		if is_new_card:
			var input_callable := Callable(self, "_on_fireteam_mini_card_gui_input").bind(normalized_fireteam_id)
			if not card.gui_input.is_connected(input_callable):
				card.gui_input.connect(input_callable)
			if not card.card_pressed.is_connected(_on_fireteam_mini_reference_card_pressed):
				card.card_pressed.connect(_on_fireteam_mini_reference_card_pressed)
		card.z_as_relative = false
		card.z_index = FIRETEAM_MINI_CARD_Z_INDEX
		card.set_meta("mission_fireteam_mini_card_z_index", FIRETEAM_MINI_CARD_Z_INDEX)
		card_host.move_child(card, desired_index)
		desired_index += 1

	for child in card_host.get_children():
		var stale_id: String = String(child.get_meta("fireteam_id", "")).strip_edges().to_lower()
		if stale_id.is_empty() or active_fireteam_ids.has(stale_id):
			continue
		card_host.remove_child(child)
		child.queue_free()
	if fireteam_panel != null:
		fireteam_panel.visible = desired_index > 0


func _apply_native_a5_fireteam_card(card: Control, fireteam_id: String, units: Array, selected: bool, inactive: bool) -> void:
	# Reuse the existing card/portraits and confirmed status projection. Only the
	# A5 identity row and one primary status stay on this compact tactical surface.
	var box := card.get_node_or_null("Margin/VBox") as VBoxContainer
	var header := card.get_node_or_null("Margin/VBox/HeaderRow") as HBoxContainer
	if box == null or header == null:
		return
	var metrics: Dictionary = DROP_LIGHT_LAYOUT_CONTRACT_SCRIPT.get_mission_hud_layout(Vector2i(get_viewport().get_visible_rect().size))
	card.custom_minimum_size = Vector2(metrics.card_width, int(metrics.portrait_height) + int(metrics.body_font_size) * 3 + 32)
	card.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	card.set_meta("native_a5_portrait_team_card", true)
	TACTICAL_UI_THEME_SCRIPT._override_stylebox(card, "panel", TACTICAL_UI_THEME_SCRIPT.build_flat_stylebox(
		TACTICAL_UI_THEME_SCRIPT.COLOR_PANEL_SELECTED if selected else TACTICAL_UI_THEME_SCRIPT.COLOR_PANEL,
		TACTICAL_UI_THEME_SCRIPT.COLOR_BORDER_SELECTED if selected else TACTICAL_UI_THEME_SCRIPT.COLOR_BORDER, 6, 4 if selected else 1))
	var margin := card.get_node("Margin") as MarginContainer
	for side in ["margin_left", "margin_right"]:
		TACTICAL_UI_THEME_SCRIPT._override_constant(margin, side, 10)
	for side in ["margin_top", "margin_bottom"]:
		TACTICAL_UI_THEME_SCRIPT._override_constant(margin, side, 5)
	TACTICAL_UI_THEME_SCRIPT._override_constant(box, "separation", 4)
	for child in box.get_children():
		if child is Control:
			(child as Control).visible = child.name in ["HeaderRow", "FireteamMemberPortraitStrip", "StageLabel"]
	for child in header.get_children():
		if child is Control:
			(child as Control).visible = child.name in ["TitleEdit", "A5MemberCount", "A5SelectionMarker"]
	var title := header.get_node("TitleEdit") as LineEdit
	title.custom_minimum_size = Vector2(0, 24)
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	TACTICAL_UI_THEME_SCRIPT._override_font_size(title, "font_size", int(metrics.heading_font_size))
	TACTICAL_UI_THEME_SCRIPT._override_color(title, "font_uneditable_color", TACTICAL_UI_THEME_SCRIPT.COLOR_BORDER_SELECTED if selected else TACTICAL_UI_THEME_SCRIPT.COLOR_TEXT)
	TACTICAL_UI_THEME_SCRIPT._override_stylebox(title, "normal", TACTICAL_UI_THEME_SCRIPT.build_flat_stylebox(Color.TRANSPARENT, Color.TRANSPARENT, 0, 0))
	TACTICAL_UI_THEME_SCRIPT._override_stylebox(title, "read_only", TACTICAL_UI_THEME_SCRIPT.build_flat_stylebox(Color.TRANSPARENT, Color.TRANSPARENT, 0, 0))
	var count := header.get_node_or_null("A5MemberCount") as Label
	if count == null:
		count = Label.new()
		count.name = "A5MemberCount"
		count.mouse_filter = Control.MOUSE_FILTER_IGNORE
		header.add_child(count)
	var total := _get_fireteam_units(fireteam_id, true).size()
	count.text = "%d/%d" % [units.size(), maxi(total, units.size())]
	count.visible = true
	TACTICAL_UI_THEME_SCRIPT.style_label(count, false, int(metrics.body_font_size) + 2)
	var selected_marker := header.get_node_or_null("A5SelectionMarker") as Label
	if selected_marker == null:
		selected_marker = Label.new()
		selected_marker.name = "A5SelectionMarker"
		selected_marker.mouse_filter = Control.MOUSE_FILTER_IGNORE
		header.add_child(selected_marker)
		header.move_child(selected_marker, 0)
	selected_marker.text = "◆"
	selected_marker.visible = selected
	TACTICAL_UI_THEME_SCRIPT._override_color(selected_marker, "font_color", TACTICAL_UI_THEME_SCRIPT.COLOR_BORDER_SELECTED)
	TACTICAL_UI_THEME_SCRIPT._override_font_size(selected_marker, "font_size", int(metrics.body_font_size))
	var snapshot: Dictionary = card.get_meta("mission_fireteam_status_card_snapshot", {})
	var status := card.get_node("Margin/VBox/StageLabel") as Label
	status.text = _native_a5_team_status(snapshot, inactive)
	status.visible = true
	status.max_lines_visible = 1
	status.clip_text = true
	status.autowrap_mode = TextServer.AUTOWRAP_OFF
	# Project the final warning/text color directly; a normal-color intermediate
	# would invalidate this label twice on every unchanged contact refresh.
	TACTICAL_UI_THEME_SCRIPT._override_font_size(status, "font_size", int(metrics.body_font_size))
	TACTICAL_UI_THEME_SCRIPT._override_color(status, "font_color", TACTICAL_UI_THEME_SCRIPT.COLOR_WARNING if int(snapshot.get("contact_count", 0)) > 0 else TACTICAL_UI_THEME_SCRIPT.COLOR_TEXT)
	var legacy_tooltip := card.tooltip_text
	card.tooltip_text = "%s\n%s\n\n%s\n%s\nPortrait doppelklicken: Charakter ansehen" % [
		_get_fireteam_display_label(fireteam_id), String(card.get_meta("mission_fireteam_lead_summary", "")), String(snapshot.get("tooltip_text", "")), legacy_tooltip]
	var details_label := card.get_node_or_null("Margin/VBox/MemberLabel") as Label
	if details_label != null:
		details_label.tooltip_text = card.tooltip_text
	_resize_native_a5_fireteam_card(card)
	# Compact styling can lower the native minimum while an old larger size
	# survives. End-aligned lists must fit the actual cards to the same minimum
	# used for their positions and scroll range.
	if not card.size.is_equal_approx(card.get_combined_minimum_size()):
		card.reset_size()
		var card_container := card.get_parent() as Container
		if card_container != null:
			card_container.queue_sort()
	if selected and not bool(card.get_meta("native_a5_selected_scroll_seen", false)):
		call_deferred("_ensure_native_a5_selected_card_visible", weakref(card), fireteam_id)
	card.set_meta("native_a5_selected_scroll_seen", selected)


func _ensure_native_a5_selected_card_visible(card_reference: WeakRef, fireteam_id: String) -> bool:
	# Re-resolve the live presentation owner after container layout. Multiplayer
	# activation can replace/reparent cards between scheduling and execution.
	if not is_inside_tree() or not _selected_fireteam_ids.has(fireteam_id):
		return false
	var scroll := get_node_or_null("../TacticalUI/FireteamMiniPanel/MiniMargin/MiniVBox/MiniCardsScroll") as ScrollContainer
	if not is_instance_valid(scroll) or not scroll.is_inside_tree():
		return false
	var card: Control = card_reference.get_ref() as Control if card_reference != null else null
	if not is_instance_valid(card) or not card.is_inside_tree() or not scroll.is_ancestor_of(card):
		card = null
		var host := scroll.get_node_or_null("MiniCardsVBox")
		if host != null:
			for candidate in host.get_children():
				if candidate is Control and String(candidate.get_meta("fireteam_id", "")) == fireteam_id:
					card = candidate as Control
					break
	if not is_instance_valid(card) or not card.is_inside_tree() or not scroll.is_ancestor_of(card):
		return false
	if not card.is_visible_in_tree():
		return false
	scroll.ensure_control_visible(card)
	return true


func _resize_native_a5_fireteam_card(card: Control) -> void:
	# Geometry-only projection on viewport/card changes; no roster or order writes.
	var metrics: Dictionary = DROP_LIGHT_LAYOUT_CONTRACT_SCRIPT.get_mission_hud_layout(Vector2i(get_viewport().get_visible_rect().size))
	var strip := card.get_node_or_null("Margin/VBox/FireteamMemberPortraitStrip") as HBoxContainer
	var count: int = strip.get_child_count() if strip != null else 0
	var signature: String = "%s:%d" % [get_viewport().get_visible_rect().size, count]
	if String(card.get_meta("native_a5_readable_geometry", "")) == signature:
		return
	card.set_meta("native_a5_readable_geometry", signature)
	card.custom_minimum_size = Vector2(metrics.card_width, int(metrics.portrait_height) + int(metrics.body_font_size) * 3 + 32)
	card.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	var margin := card.get_node_or_null("Margin") as MarginContainer
	if margin != null:
		TACTICAL_UI_THEME_SCRIPT._override_constant(margin, "margin_left", 10)
		TACTICAL_UI_THEME_SCRIPT._override_constant(margin, "margin_right", 10)
	var title := card.get_node_or_null("Margin/VBox/HeaderRow/TitleEdit") as LineEdit
	if title != null:
		TACTICAL_UI_THEME_SCRIPT._override_font_size(title, "font_size", int(metrics.heading_font_size))
	var occupancy := card.get_node_or_null("Margin/VBox/HeaderRow/A5MemberCount") as Label
	if occupancy != null:
		TACTICAL_UI_THEME_SCRIPT._override_font_size(occupancy, "font_size", int(metrics.body_font_size) + 2)
	var status := card.get_node_or_null("Margin/VBox/StageLabel") as Label
	if status != null:
		TACTICAL_UI_THEME_SCRIPT._override_font_size(status, "font_size", int(metrics.body_font_size))
	if strip != null:
		var edge: float = floorf((float(metrics.card_width) - 20.0 - float(maxi(0, count - 1)) * 4.0) / maxf(1.0, float(count)))
		strip.custom_minimum_size.y = float(metrics.portrait_height)
		for portrait in strip.get_children():
			if portrait is TextureRect:
				portrait.custom_minimum_size = Vector2(edge, metrics.portrait_height)


func _native_a5_team_status(snapshot: Dictionary, inactive: bool) -> String:
	if inactive:
		return "Nicht aktiv"
	var suppression := String(snapshot.get("suppression_state", "ready"))
	if suppression in ["pinned", "suppressed"]:
		return "Festgesetzt" if suppression == "pinned" else "Unter Beschuss"
	var contacts := int(snapshot.get("contact_count", 0))
	if contacts > 0:
		return "%d Feindkontakt%s" % [contacts, "e" if contacts != 1 else ""]
	var counts := Dictionary(Dictionary(snapshot.get("member_status", {})).get("counts", {}))
	if int(counts.get("busy", 0)) > 0:
		return "Auftrag wird ausgeführt"
	if int(counts.get("down", 0)) > 0:
		return "Verluste im Trupp"
	if String(snapshot.get("readiness_state", "unavailable")) in ["high", "medium"]:
		return "Bereit"
	return "Im Einsatz"


func _on_native_member_portrait_gui_input(event: InputEvent, unit_id: String, fireteam_id: String) -> void:
	if event is InputEventMouseButton:
		var mouse := event as InputEventMouseButton
		if mouse.button_index == MOUSE_BUTTON_LEFT and mouse.pressed:
			_cancel_selection_interaction()
			_on_fireteam_group_pressed(fireteam_id)
			if mouse.double_click:
				_open_character_overlay(unit_id)
			get_viewport().set_input_as_handled()


func _build_fireteam_mini_card_static_signature(fireteam_id: String, lead, lead_summary: String) -> String:
