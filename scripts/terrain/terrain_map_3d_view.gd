func _build_order_visual_signature(order_payload: Dictionary) -> String:
	var parts: PackedStringArray = PackedStringArray()
	parts.append(var_to_str(_build_order_visual_signature_payload(order_payload)))
	var orientation_fireteam_ids: PackedStringArray = _get_valid_fireteam_orientation_payload_ids(order_payload)
	if not orientation_fireteam_ids.is_empty():
		parts.append("orientation:%s" % _build_live_fireteam_orientation_signature(orientation_fireteam_ids))
	if bool(order_payload.get("fire_sector_overlay_enabled", false)):
		var selected_fireteam_ids: PackedStringArray = _get_string_array_from_variant(order_payload.get("selected_fireteam_ids", PackedStringArray()))
		var unit_parts: Array = []
		for unit in _unit_nodes:
			if unit == null or not (unit is Node2D):
				continue
			var fireteam_id: String = _get_unit_fireteam_id(unit)
			if fireteam_id.is_empty() or not selected_fireteam_ids.has(fireteam_id):
				continue
			if not _is_unit_world_visible(unit):
				continue
			var weapon_id: String = _get_unit_active_attack_weapon_id(unit)
			if weapon_id.is_empty():
				continue
			var unit_position: Vector2 = (unit as Node2D).global_position
			var aim_direction: Vector2 = _resolve_unit_aim_direction(unit, unit_position)
			var grid_position: Vector2i = _world_to_grid_position(unit_position)
			unit_parts.append("%s:%d,%d:%s:%.2f" % [
				_get_unit_id(unit),
				grid_position.x,
				grid_position.y,
				weapon_id,
				aim_direction.angle() if aim_direction.length_squared() > 0.0001 else 0.0,
			])
		unit_parts.sort()
		parts.append("fire:%s" % "|".join(unit_parts))
	if bool(order_payload.get("los_debug_overlay_enabled", false)):
		var los_selected_fireteam_ids: PackedStringArray = _get_string_array_from_variant(order_payload.get("selected_fireteam_ids", PackedStringArray()))
		var debug_unit_parts: Array = []
		for unit in _unit_nodes:
			if unit == null or not (unit is Node2D):
				continue
			var fireteam_id: String = _get_unit_fireteam_id(unit)
			if fireteam_id.is_empty() or not los_selected_fireteam_ids.has(fireteam_id):
				continue
			if not _is_unit_world_visible(unit):
				continue
			var unit_position: Vector2 = (unit as Node2D).global_position
			var grid_position: Vector2i = _world_to_grid_position(unit_position)
			debug_unit_parts.append("%s:%d,%d" % [_get_unit_id(unit), grid_position.x, grid_position.y])
		debug_unit_parts.sort()
		parts.append("los_debug:%s:%d" % ["|".join(debug_unit_parts), _contact_payload_apply_count])
	return "\n".join(parts)


func _build_order_visual_signature_payload(order_payload: Dictionary) -> Dictionary:
	var signature_payload: Dictionary = {}
	for key_variant in order_payload.keys():
		var key: String = String(key_variant)
		match key:
			"fire_event_dicts":
				signature_payload[key] = _build_fire_event_visual_signature_array(Array(order_payload.get(key, [])))
			"feedback_bubble_dicts":
				signature_payload[key] = _build_feedback_bubble_visual_signature_array(Array(order_payload.get(key, [])))
			"tactical_communication_event_dicts":
				signature_payload[key] = _build_tactical_communication_visual_signature_array(Array(order_payload.get(key, [])))
			_:
				signature_payload[key] = order_payload.get(key_variant)
	return signature_payload


func _build_fire_event_visual_signature_array(fire_events: Array) -> Array:
	var signature_entries: Array = []
	var selected_events: Array = _slice_last_dictionary_entries(fire_events, WEAPON_FIRE_VISIBLE_EVENT_LIMIT)
	for event_variant in selected_events:
		var event: Dictionary = Dictionary(event_variant)
		signature_entries.append({
			"event_id": String(event.get("event_id", "")),
			"attacker_unit_id": String(event.get("attacker_unit_id", "")),
			"target_unit_id": String(event.get("target_unit_id", "")),
			"weapon_id": String(event.get("weapon_id", "")),
			"combat_outcome": String(event.get("combat_outcome", "")),
			"damage_resolved": int(event.get("damage_resolved", 0)),
			"attacker_position": event.get("attacker_position", Vector2.ZERO),
			"target_position": event.get("target_position", Vector2.ZERO),
			"is_friendly_fire": bool(event.get("is_friendly_fire", false)),
		})
	return signature_entries


func _build_feedback_bubble_visual_signature_array(feedback_bubbles: Array) -> Array:
	var signature_entries: Array = []
	var selected_bubbles: Array = _slice_last_dictionary_entries(feedback_bubbles, 6)
	for bubble_variant in selected_bubbles:
		var bubble: Dictionary = Dictionary(bubble_variant)
		signature_entries.append({
			"bubble_id": String(bubble.get("bubble_id", "")),
			"fireteam_id": String(bubble.get("fireteam_id", "")),
			"unit_id": String(bubble.get("unit_id", "")),
			"text": String(bubble.get("text", "")),
			"category": String(bubble.get("category", "")),
			"purpose": String(bubble.get("purpose", "")),
			"anchor_space": String(bubble.get("anchor_space", "")),
			"anchor_position": bubble.get("anchor_position", Vector2.ZERO),
			"hud_anchor_position": bubble.get("hud_anchor_position", Vector2.ZERO),
		})
	return signature_entries


func _build_tactical_communication_visual_signature_array(communication_events: Array) -> Array:
	var signature_entries: Array = []
	var selected_events: Array = _slice_last_dictionary_entries(communication_events, TACTICAL_COMMUNICATION_EVENT_VISIBLE_LIMIT)
	for event_variant in selected_events:
		var event: Dictionary = Dictionary(event_variant)
		signature_entries.append({
			"event_id": String(event.get("event_id", "")),
			"unit_id": String(event.get("unit_id", "")),
			"fireteam_id": String(event.get("fireteam_id", "")),
			"event_type": String(event.get("event_type", "")),
			"text": String(event.get("text", "")),
			"priority": int(event.get("priority", 0)),
			"anchor_position": event.get("anchor_position", Vector2.ZERO),
		})
	return signature_entries


func _slice_last_dictionary_entries(entries: Array, limit: int) -> Array:
	var normalized_limit: int = maxi(limit, 0)
	if normalized_limit == 0:
		return []
	var filtered: Array = []
	for entry_variant in entries:
		if typeof(entry_variant) == TYPE_DICTIONARY:
			filtered.append(entry_variant)
	if filtered.size() <= normalized_limit:
		return filtered
	return filtered.slice(filtered.size() - normalized_limit)


func _refresh_dynamic_order_visuals_if_needed() -> void:
	if _order_payload.is_empty() or _order_root == null:
		return
	if not _dynamic_sources_dirty:
		_dynamic_order_skip_count += 1
		return
	var selected_fireteam_ids: PackedStringArray = _get_string_array_from_variant(_order_payload.get("selected_fireteam_ids", PackedStringArray()))
	var orientation_fireteam_ids: PackedStringArray = _get_valid_fireteam_orientation_payload_ids(_order_payload)
	if (
		selected_fireteam_ids.is_empty()
		and orientation_fireteam_ids.is_empty()
		and not bool(_order_payload.get("fire_sector_overlay_enabled", false))
		and not bool(_order_payload.get("los_debug_overlay_enabled", false))
		):
		_dynamic_sources_dirty = false
		return
	var now_msec: int = Time.get_ticks_msec()
	if now_msec - _last_dynamic_order_visual_refresh_msec < DYNAMIC_ORDER_VISUAL_REFRESH_INTERVAL_MSEC:
		return
	_last_dynamic_order_visual_refresh_msec = now_msec
	var next_signature: String = _build_order_dynamic_visual_signature()
	_dynamic_sources_dirty = false
	if next_signature == _order_dynamic_visual_signature:
		return
	_order_dynamic_visual_signature = next_signature
	_rebuild_order_visuals()
	_request_viewport_redraw()


func _build_order_dynamic_visual_signature() -> String:
	_dynamic_signature_build_count += 1
	var selected_fireteam_ids: PackedStringArray = _get_string_array_from_variant(_order_payload.get("selected_fireteam_ids", PackedStringArray()))
	var orientation_fireteam_ids: PackedStringArray = _get_valid_fireteam_orientation_payload_ids(_order_payload)
	if selected_fireteam_ids.is_empty() and orientation_fireteam_ids.is_empty():
		_dynamic_sources_dirty = false
		return ""
	var parts: PackedStringArray = PackedStringArray()
	if not selected_fireteam_ids.is_empty():
		parts.append("selected:%s" % ",".join(selected_fireteam_ids))
	parts.append("fire:%s:%s" % [str(bool(_order_payload.get("fire_sector_overlay_enabled", false))), _get_fire_sector_visual_mode()])
	parts.append("los_debug:%s:%d" % [str(bool(_order_payload.get("los_debug_overlay_enabled", false))), _contact_payload_apply_count])
	var orientation_position_sums: Dictionary = {}
	var orientation_directions: Dictionary = {}
	var orientation_counts: Dictionary = {}
	for unit_id_variant in _dynamic_relevant_unit_ids:
		_dynamic_signature_unit_scan_count += 1
		var unit = _dynamic_relevant_unit_by_id.get(String(unit_id_variant), null)
		if unit == null or not (unit is Node2D):
			continue
		var fireteam_id: String = _get_unit_fireteam_id(unit)
		if fireteam_id.is_empty() or (not selected_fireteam_ids.has(fireteam_id) and not orientation_fireteam_ids.has(fireteam_id)):
			continue
		if not _is_unit_world_visible(unit):
			continue
		var unit_id: String = _get_unit_id(unit)
		var unit_position: Vector2 = (unit as Node2D).global_position
		var proxy := _unit_proxies_by_id.get(unit_id, null) as Node3D
		var rotation_y: float = float(proxy.rotation_degrees.y) if proxy != null and is_instance_valid(proxy) else 0.0
		parts.append("%s:%s:%.1f,%.1f:%.1f" % [unit_id, fireteam_id, unit_position.x, unit_position.y, rotation_y])
		if orientation_fireteam_ids.has(fireteam_id):
			orientation_position_sums[fireteam_id] = Vector2(orientation_position_sums.get(fireteam_id, Vector2.ZERO)) + unit_position
			if not orientation_directions.has(fireteam_id):
				var facing_direction: Vector2 = _resolve_unit_explicit_facing_direction(unit)
				if facing_direction.length_squared() <= 0.0001:
					facing_direction = _resolve_unit_motion_or_target_direction(proxy, unit, unit_position)
				if facing_direction.length_squared() > 0.0001:
					orientation_directions[fireteam_id] = facing_direction.normalized()
			orientation_counts[fireteam_id] = int(orientation_counts.get(fireteam_id, 0)) + 1
	if not orientation_fireteam_ids.is_empty():
		for orientation_id in orientation_fireteam_ids:
			var count: int = int(orientation_counts.get(String(orientation_id), 0))
			if count <= 0:
				parts.append("orientation:%s:none" % String(orientation_id))
				continue
			var centroid: Vector2 = Vector2(orientation_position_sums[String(orientation_id)]) / float(count)
			var heading: Vector2 = Vector2(orientation_directions.get(String(orientation_id), Vector2.ZERO))
			parts.append("orientation:%s:%.1f,%.1f:%.4f" % [String(orientation_id), centroid.x, centroid.y, heading.angle() if heading.length_squared() > 0.0001 else 0.0])
	parts.sort()
	return "|".join(parts)


func _rebuild_dynamic_relevant_index() -> void:
	_dynamic_relevant_unit_ids.clear()
	_dynamic_relevant_unit_by_id.clear()
	_dynamic_unit_source_signatures.clear()
	var relevant_fireteams: Dictionary = {}
	var seen_unit_ids: Dictionary = {}
	for fireteam_id_variant in _get_string_array_from_variant(_order_payload.get("selected_fireteam_ids", PackedStringArray())):
		relevant_fireteams[String(fireteam_id_variant).strip_edges().to_lower()] = true
	for fireteam_id_variant in _get_valid_fireteam_orientation_payload_ids(_order_payload):
		relevant_fireteams[String(fireteam_id_variant).strip_edges().to_lower()] = true
	for unit in _unit_nodes:
		if unit == null or not is_instance_valid(unit):
			continue
		var unit_id: String = _get_unit_id(unit)
		var fireteam_id: String = _get_unit_fireteam_id(unit)
		if unit_id.is_empty() or seen_unit_ids.has(unit_id) or not relevant_fireteams.has(fireteam_id):
			continue
		seen_unit_ids[unit_id] = true
		_dynamic_relevant_unit_by_id[unit_id] = unit
		_dynamic_relevant_unit_ids.append(unit_id)
	_dynamic_relevant_unit_ids.sort()


func _get_valid_fireteam_orientation_payload_ids(order_payload: Dictionary) -> PackedStringArray:
	var result: PackedStringArray = PackedStringArray()
	var seen: Dictionary = {}
	for anchor_variant in Array(order_payload.get("fireteam_anchors", [])):
		if typeof(anchor_variant) != TYPE_DICTIONARY:
			continue
		var anchor_dict: Dictionary = Dictionary(anchor_variant)
		var fireteam_id: String = String(anchor_dict.get("fireteam_id", "")).strip_edges().to_lower()
		if fireteam_id.is_empty() or seen.has(fireteam_id):
			continue
		if typeof(anchor_dict.get("position", null)) != TYPE_VECTOR2:
			continue
		if _get_fireteam_orientation_payload_direction(anchor_dict).length_squared() <= 0.0001:
			continue
		seen[fireteam_id] = true
		result.append(fireteam_id)
	result.sort()
	return result


func _build_live_fireteam_orientation_signature(fireteam_ids: PackedStringArray) -> String:
	var normalized_ids: PackedStringArray = fireteam_ids.duplicate()
	normalized_ids.sort()
	var parts: PackedStringArray = PackedStringArray()
	for fireteam_id in normalized_ids:
		var live_state: Dictionary = _resolve_live_fireteam_orientation_state(String(fireteam_id))
		if live_state.is_empty():
			parts.append("%s:none" % String(fireteam_id))
			continue
		var position: Vector2 = Vector2(live_state.get("position", Vector2.ZERO))
		var direction: Vector2 = Vector2(live_state.get("heading_direction", Vector2.ZERO))
		parts.append("%s:%.1f,%.1f:%.4f" % [
			String(fireteam_id),
			position.x,
			position.y,
			direction.angle() if direction.length_squared() > 0.0001 else 0.0,
		])
	return "|".join(parts)


