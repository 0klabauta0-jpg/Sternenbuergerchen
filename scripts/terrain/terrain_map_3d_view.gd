		var tile_data = _terrain_map_data.call("get_tile_at_grid", grid_position)
		if tile_data != null and typeof(tile_data.world_position) == TYPE_VECTOR2:
			return Vector2(tile_data.world_position)
	return _grid_float_to_world(Vector2(grid_position))


func screen_rect_to_tile_world_positions(screen_rect: Rect2) -> Array:
	var result: Array = []
	if _terrain_map_data == null or _camera == null:
		return result
	for tile_data in _get_screen_rect_tile_candidates(screen_rect):
		if tile_data == null or typeof(tile_data.world_position) != TYPE_VECTOR2:
			continue
		var screen_position: Vector2 = world_to_screen_position(Vector2(tile_data.world_position))
		if screen_rect.has_point(screen_position):
			result.append(Vector2(tile_data.world_position))
	return result


func _get_screen_rect_tile_candidates(screen_rect: Rect2) -> Array:
	if not screen_rect.has_area():
		return []
	if _camera.projection != Camera3D.PROJECTION_ORTHOGONAL or _render_tile_by_grid.is_empty():
		return Array(_terrain_map_data.call("get_tiles"))
	var min_grid := Vector2(INF, INF)
	var max_grid := Vector2(-INF, -INF)
	for screen_corner in [
		screen_rect.position,
		Vector2(screen_rect.end.x, screen_rect.position.y),
		screen_rect.end,
		Vector2(screen_rect.position.x, screen_rect.end.y),
	]:
		var ray_origin: Vector3 = _camera.project_ray_origin(screen_corner)
		var ray_direction: Vector3 = _camera.project_ray_normal(screen_corner)
		if absf(ray_direction.y) <= 0.000001:
			return Array(_terrain_map_data.call("get_tiles"))
		for height_level in range(3):
			# The old center projection includes off-screen centers behind the ray
			# origin, so intersect the infinite line instead of a forward-only ray.
			var surface_y: float = float(height_level) * _get_3d_height_step()
			var intersection: Vector3 = ray_origin + ray_direction * ((surface_y - ray_origin.y) / ray_direction.y)
			var grid: Vector2 = _world_to_grid_float(_position_3d_to_world(intersection))
			min_grid = min_grid.min(grid)
			max_grid = max_grid.max(grid)
	var first_grid := Vector2i(floori(min_grid.x) - 1, floori(min_grid.y) - 1)
	var last_grid := Vector2i(ceili(max_grid.x) + 1, ceili(max_grid.y) + 1)
	var candidate_area: float = float(last_grid.x - first_grid.x + 1) * float(last_grid.y - first_grid.y + 1)
	# Large selections already need the exhaustive result. This fallback also
	# prevents enormous empty grid loops for large or unusual screen rectangles.
	if candidate_area >= float(_render_tile_by_grid.size()):
		return Array(_terrain_map_data.call("get_tiles"))
	var candidates: Array = []
	for x in range(first_grid.x, last_grid.x + 1):
		for y in range(first_grid.y, last_grid.y + 1):
			var tile_data = _render_tile_by_grid.get(Vector2i(x, y), null)
			if tile_data != null:
				candidates.append(tile_data)
	# Public selection returns source order, including maps loaded out of grid order.
	candidates.sort_custom(func(a, b) -> bool:
		return int(_render_tile_order_by_grid.get(a.grid_position, 0)) < int(_render_tile_order_by_grid.get(b.grid_position, 0))
	)
	return candidates


func _pick_tile_at_screen_position(viewport_position: Vector2):
	if _terrain_map_data == null or _camera == null:
		return null
	var best_tile = null
	var best_score: float = INF
	var camera_origin: Vector3 = _camera.global_position
	var camera_forward: Vector3 = -_camera.global_transform.basis.z.normalized()
	for tile_data in _get_tile_pick_candidates(viewport_position):
		if tile_data == null:
			continue
		var screen_quad: Array[Vector2] = _get_tile_top_screen_quad(tile_data)
		if screen_quad.size() < 3 or not _screen_point_is_inside_convex_quad(viewport_position, screen_quad):
			continue
		var surface_y: float = (float(tile_data.height_level) * _get_3d_height_step()) + TILE_SELECTION_SURFACE_Y_OFFSET
		var tile_center_3d: Vector3 = _grid_to_3d_position(Vector2(tile_data.grid_position), surface_y)
		var camera_depth: float = (tile_center_3d - camera_origin).dot(camera_forward)
		var center_screen: Vector2 = _camera.unproject_position(tile_center_3d)
		var score: float = camera_depth + (viewport_position.distance_squared_to(center_screen) * 0.0001)
		if score < best_score:
			best_score = score
			best_tile = tile_data
	return best_tile


func _rebuild_render_tile_index(tiles: Array) -> void:
	_render_tile_by_grid.clear()
	_render_tile_order_by_grid.clear()
	for tile_data in tiles:
		if tile_data != null:
			_render_tile_order_by_grid[tile_data.grid_position] = _render_tile_by_grid.size()
			_render_tile_by_grid[tile_data.grid_position] = tile_data


func _get_tile_pick_candidates(viewport_position: Vector2) -> Array:
	var result: Array = []
	var seen: Dictionary = {}
	var ray_origin: Vector3 = _camera.project_ray_origin(viewport_position)
	var ray_direction: Vector3 = _camera.project_ray_normal(viewport_position)
	# TerrainTileData's legal H0/H1/H2 surfaces. Intersect each top plane so
	# raised tiles can win even when their ground-plane grid coordinate differs.
	for height_level in range(3):
		var top_y: float = float(height_level) * _get_3d_height_step() + TILE_GRID_LINE_SURFACE_Y_OFFSET
		var hit = Plane(Vector3.UP, top_y).intersects_ray(ray_origin, ray_direction)
		if typeof(hit) != TYPE_VECTOR3:
			continue
		var grid_position: Vector2i = _world_to_grid_position(_position_3d_to_world(Vector3(hit)))
		var nearby: Array[Vector2i] = [grid_position]
		if _uses_hex_grid():
			nearby.append_array(HEX_GRID_SCRIPT.neighbors(grid_position))
		else:
			for x in range(-1, 2):
				for y in range(-1, 2):
					if x != 0 or y != 0:
						nearby.append(grid_position + Vector2i(x, y))
		# Neighbor candidates retain the existing polygon tolerance on tile edges.
		for candidate_grid in nearby:
			if seen.has(candidate_grid):
				continue
			var tile_data = _render_tile_by_grid.get(candidate_grid, null)
			if tile_data == null or int(tile_data.height_level) != height_level:
				continue
			seen[candidate_grid] = true
			result.append(tile_data)
	# The former exhaustive scan resolved exact score ties in source tile order.
	# Preserve that boundary behavior while sorting only the bounded candidate set.
	result.sort_custom(func(a, b) -> bool:
		return int(_render_tile_order_by_grid.get(a.grid_position, 0)) < int(_render_tile_order_by_grid.get(b.grid_position, 0))
	)
	return result


func _get_tile_top_screen_quad(tile_data) -> Array[Vector2]:
	var result: Array[Vector2] = []
	if tile_data == null or _camera == null:
		return result
	var cell_size: float = _get_3d_cell_size()
	var half_size: float = cell_size * 0.5
	var top_y: float = (float(tile_data.height_level) * _get_3d_height_step()) + TILE_GRID_LINE_SURFACE_Y_OFFSET
	var center: Vector3 = _grid_to_3d_position(Vector2(tile_data.grid_position), top_y)
	if _uses_hex_grid():
		for corner in HEX_GRID_SCRIPT.corners(Vector2.ZERO, cell_size / sqrt(3.0)):
			result.append(_camera.unproject_position(center + Vector3(corner.x, 0.0, corner.y)))
		return result
	for corner in [
		center + Vector3(-half_size, 0.0, -half_size),
		center + Vector3(half_size, 0.0, -half_size),
		center + Vector3(half_size, 0.0, half_size),
		center + Vector3(-half_size, 0.0, half_size),
	]:
		result.append(_camera.unproject_position(corner))
	return result


func _screen_point_is_inside_convex_quad(point: Vector2, quad: Array[Vector2]) -> bool:
	if quad.size() < 3:
		return false
	var saw_positive: bool = false
	var saw_negative: bool = false
	for index in range(quad.size()):
		var a: Vector2 = quad[index]
		var b: Vector2 = quad[(index + 1) % quad.size()]
		var edge: Vector2 = b - a
		var to_point: Vector2 = point - a
		var cross: float = edge.cross(to_point)
		if cross > 0.001:
			saw_positive = true
		elif cross < -0.001:
			saw_negative = true
		if saw_positive and saw_negative:
			return false
	return true


