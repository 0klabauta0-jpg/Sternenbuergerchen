func _get_visual_streaming_active_chunk_entries() -> Array:
	var chunk_ids: Array = _visual_streaming_active_chunks.keys()
	chunk_ids.sort_custom(func(a, b) -> bool:
		var chunk_a: Vector2i = Vector2i(a)
		var chunk_b: Vector2i = Vector2i(b)
		if chunk_a.x == chunk_b.x:
			return chunk_a.y < chunk_b.y
		return chunk_a.x < chunk_b.x
	)
	var entries: Array = []
	for chunk_variant in chunk_ids:
		var chunk_position: Vector2i = Vector2i(chunk_variant)
		entries.append({
			"chunk_position": chunk_position,
			"min_grid": Vector2i(chunk_position.x * GROUND_MULTIMESH_CHUNK_SIZE, chunk_position.y * GROUND_MULTIMESH_CHUNK_SIZE),
			"max_grid": Vector2i((chunk_position.x + 1) * GROUND_MULTIMESH_CHUNK_SIZE - 1, (chunk_position.y + 1) * GROUND_MULTIMESH_CHUNK_SIZE - 1),
		})
	return entries


func _build_editor_light_snapshot() -> Dictionary:
	var light: DirectionalLight3D = null
	if _world_root != null:
		light = _world_root.get_node_or_null(LIGHT_NAME) as DirectionalLight3D
	var environment: Environment = null
	if _environment != null:
		environment = _environment.environment
	return {
		"rotation_degrees": light.rotation_degrees if light != null else EDITOR_LIGHT_ROTATION_DEGREES,
		"energy": float(light.light_energy) if light != null else EDITOR_LIGHT_ENERGY,
		"shadow_enabled": bool(light.shadow_enabled) if light != null else _editor_light_shadows_enabled,
		"shadow_opacity": float(light.shadow_opacity) if light != null else EDITOR_LIGHT_SHADOW_OPACITY,
		"shadow_blur": float(light.shadow_blur) if light != null else EDITOR_LIGHT_SHADOW_BLUR,
		"ambient_light_color": environment.ambient_light_color.to_html(true) if environment != null else EDITOR_AMBIENT_LIGHT_COLOR.to_html(true),
		"ambient_light_energy": float(environment.ambient_light_energy) if environment != null else EDITOR_AMBIENT_LIGHT_ENERGY,
		"background_color": environment.background_color.to_html(true) if environment != null else EDITOR_EMPTY_BACKGROUND_COLOR.to_html(true),
		"tonemap_enabled": environment != null and environment.tonemap_mode != Environment.TONE_MAPPER_LINEAR,
		"tonemap_mode": "filmic" if environment != null and environment.tonemap_mode == Environment.TONE_MAPPER_FILMIC else ("aces" if environment != null and environment.tonemap_mode == Environment.TONE_MAPPER_ACES else "other"),
		"adjustment_enabled": bool(environment.adjustment_enabled) if environment != null else true,
		"adjustment_brightness": float(environment.adjustment_brightness) if environment != null else EDITOR_ADJUSTMENT_BRIGHTNESS,
		"adjustment_contrast": float(environment.adjustment_contrast) if environment != null else EDITOR_ADJUSTMENT_CONTRAST,
		"adjustment_saturation": float(environment.adjustment_saturation) if environment != null else EDITOR_ADJUSTMENT_SATURATION,
	}


func _get_tile_grid_material_for_snapshot() -> StandardMaterial3D:
	if _material_cache.has(TILE_GRID_LINE_MATERIAL_KEY):
		return _material_cache[TILE_GRID_LINE_MATERIAL_KEY] as StandardMaterial3D
	var grid_node: MeshInstance3D = null
	if _map_root != null:
		grid_node = _map_root.get_node_or_null("TileGridLines3D") as MeshInstance3D
	if grid_node != null and grid_node.mesh != null and grid_node.mesh.get_surface_count() > 0:
		return grid_node.mesh.surface_get_material(0) as StandardMaterial3D
	return null


