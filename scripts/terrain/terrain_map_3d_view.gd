func _update_dynamic_source_dirty_state() -> void:
	for unit_id_variant in _dynamic_relevant_unit_ids:
		var unit_id: String = String(unit_id_variant)
		var unit = _dynamic_relevant_unit_by_id.get(unit_id, null)
		if unit == null or not is_instance_valid(unit) or not (unit is Node2D):
			continue
		var proxy := _unit_proxies_by_id.get(unit_id, null) as Node3D
		var source_signature: String = "%s|%.2f,%.2f|%.2f|%s" % [unit_id, (unit as Node2D).global_position.x, (unit as Node2D).global_position.y, float(proxy.rotation_degrees.y) if proxy != null and is_instance_valid(proxy) else 0.0, str(_is_unit_world_visible(unit))]
		var previous_signature: String = String(_dynamic_unit_source_signatures.get(unit_id, ""))
		if not previous_signature.is_empty() and previous_signature != source_signature:
			_dynamic_sources_dirty = true
		_dynamic_unit_source_signatures[unit_id] = source_signature


func _get_unit_runtime_posture_snapshot(unit: Node) -> Dictionary:
	var result: Dictionary = {
		"movement_posture": "idle",
		"weapon_posture": "lowered",
		"posture_policy_id": "",
		"sight_range_factor": 1.0,
		"aim_readiness_percent": 0.0,
	}
	if unit == null or not unit.has_method("get_runtime_status"):
		return result
	var runtime_status = unit.call("get_runtime_status")
	if runtime_status == null or not runtime_status.has_method("get"):
		return result
	result["movement_posture"] = _normalize_unit_movement_posture(String(runtime_status.get("movement_posture")))
	result["weapon_posture"] = _normalize_unit_weapon_posture(String(runtime_status.get("weapon_posture")))
	result["posture_policy_id"] = String(runtime_status.get("posture_policy_id")).strip_edges().to_lower()
	result["sight_range_factor"] = maxf(float(runtime_status.get("sight_range_factor")), 0.0)
	result["aim_readiness_percent"] = clampf(float(runtime_status.get("aim_readiness_percent")), 0.0, 100.0)
	return result


func _resolve_displayed_weapon_posture_from_readiness(active_fire_event: Dictionary, weapon_posture: String, aim_readiness_percent: float) -> String:
	if not active_fire_event.is_empty():
		return "aimed"
	var normalized_weapon_posture: String = _normalize_unit_weapon_posture(weapon_posture)
	var normalized_readiness: float = clampf(aim_readiness_percent, 0.0, 100.0)
	if normalized_weapon_posture == "lowered" and normalized_readiness >= 70.0:
		return "aimed"
	if normalized_weapon_posture == "lowered" and normalized_readiness >= 50.0:
		return "ready"
	return normalized_weapon_posture


func _build_unit_visual_signature(unit: Node) -> String:
	var unit_visual_entry: Dictionary = _get_unit_visual_entry(unit)
	var parts: PackedStringArray = PackedStringArray()
	parts.append(_get_unit_id(unit))
	parts.append(_get_unit_team_id(unit))
	parts.append(String(unit_visual_entry.get("visual_id", "")))
	parts.append(String(unit_visual_entry.get("model_path", "")))
	parts.append(String(unit_visual_entry.get("skin_path", "")))
	parts.append(String(unit_visual_entry.get("resolved_visual_archetype_id", unit_visual_entry.get("visual_archetype_id", ""))))
	parts.append(String(unit_visual_entry.get("resolved_visual_loadout_id", unit_visual_entry.get("visual_loadout_id", ""))))
	parts.append("%.4f" % float(unit_visual_entry.get("scale", 0.0)))
	parts.append("%.2f" % float(unit_visual_entry.get("rotation_degrees_y", 0.0)))
	for weapon_id in _get_unit_visual_weapon_ids(unit):
		parts.append("weapon:%s" % String(weapon_id))
	return "|".join(parts)


func _build_unit_visual_input_signature(unit: Node) -> String:
	var parts: PackedStringArray = PackedStringArray([
		_get_unit_id(unit),
		_get_unit_team_id(unit),
		String(unit.call("get_weapon_1_id")) if unit != null and unit.has_method("get_weapon_1_id") else "",
		String(unit.call("get_weapon_2_id")) if unit != null and unit.has_method("get_weapon_2_id") else "",
	])
	if unit != null:
		for meta_key in ["visual_archetype_id", "enemy_visual_archetype_id", "visual_archetype", "enemy_visual_archetype"]:
			if unit.has_meta(meta_key):
				parts.append("%s:%s" % [meta_key, var_to_str(unit.get_meta(meta_key))])
		if unit.has_meta("enemy_tactics_config"):
			var tactics_variant: Variant = unit.get_meta("enemy_tactics_config")
			if typeof(tactics_variant) == TYPE_DICTIONARY:
				parts.append("enemy_tactics_config.visual_archetype:%s" % String(Dictionary(tactics_variant).get("visual_archetype", "")).strip_edges().to_lower())
	return "|".join(parts)


func _build_unit_proxy_visual_payload_signature(unit: Node, active_fire_event: Dictionary, weapon_posture: String, movement_posture: String, weapon_pose_direction: Vector2, proxy_rotation_y: float) -> String:
	var damage_context: Dictionary = _get_unit_last_damage_context(unit)
	return "%s|%d|%d|%s|%s|%s|%.3f|%.3f|%.2f|%s|%s|%s" % [
		_get_unit_vital_state(unit),
		_get_unit_health_points(unit),
		_get_unit_max_health_points(unit),
		String(damage_context.get("fire_event_id", damage_context.get("event_id", ""))).strip_edges(),
		String(active_fire_event.get("event_id", "")).strip_edges(),
		weapon_posture,
		weapon_pose_direction.x,
		weapon_pose_direction.y,
		proxy_rotation_y,
		movement_posture,
		str(unit.get_meta("overwatch_ready", false)) if unit != null and unit.has_meta("overwatch_ready") else "false",
		str(unit.get_meta("security_facing_angle", "")) if unit != null and unit.has_meta("security_facing_angle") else "",
	]


func _normalize_unit_movement_posture(value: String) -> String:
	match value.strip_edges().to_lower():
		"travel", "walk", "move", "march":
			return "travel"
		"run", "sprint", "fast":
			return "run"
		"tactical", "ready", "m_position", "m-position":
			return "tactical"
		"engage", "engaging", "aim", "aimed":
			return "engage"
		"overwatch", "hold", "watch":
			return "overwatch"
		"crouch", "crouched", "duck":
			return "crouch"
		"crouch_walk", "crouch-walk", "crouchwalk", "duck_walk", "duck-walk":
			return "crouch_walk"
		"crouch_run", "crouch-run", "crouchrun", "duck_run", "duck-run":
			return "crouch_run"
		_:
			return "idle"


func _normalize_unit_weapon_posture(value: String) -> String:
	match value.strip_edges().to_lower():
		"ready", "ready_low", "ready-low", "m_position", "m-position":
			return "ready"
		"aim", "aimed", "firing", "shooting":
			return "aimed"
		_:
			return "lowered"


func _update_unit_vital_visual(proxy: Node3D, unit: Node, cached_model_root: Node3D = null) -> bool:
	if proxy == null:
		return false
	var vital_state: String = _get_unit_vital_state(unit)
	var health_points: int = _get_unit_health_points(unit)
	var max_health_points: int = _get_unit_max_health_points(unit)
	var health_percent: float = 1.0
	if max_health_points > 0:
		health_percent = clampf(float(health_points) / float(max_health_points), 0.0, 1.0)
	var last_damage_context: Dictionary = _get_unit_last_damage_context(unit)
	var down_pose_active: bool = vital_state == "down" or vital_state == "bleedout" or vital_state == "respawning"
	var damaged_visual_active: bool = health_percent < UNIT_DAMAGE_BADGE_HEALTH_THRESHOLD or not last_damage_context.is_empty()
	var changed: bool = false
	changed = _set_proxy_int_meta(proxy, "unit_health_points", health_points) or changed
	changed = _set_proxy_int_meta(proxy, "unit_max_health_points", max_health_points) or changed
	if absf(float(proxy.get_meta("unit_health_percent", 1.0)) - health_percent) > 0.0001:
		proxy.set_meta("unit_health_percent", health_percent)
		changed = true
	changed = _set_proxy_bool_meta(proxy, "unit_damage_visual_active", damaged_visual_active) or changed
	changed = _set_proxy_bool_meta(proxy, "unit_down_pose_active", down_pose_active) or changed
	changed = _set_proxy_string_meta(proxy, "unit_last_damage_event_id", String(last_damage_context.get("fire_event_id", last_damage_context.get("event_id", ""))).strip_edges()) or changed
	var model_root: Node3D = cached_model_root if cached_model_root != null and is_instance_valid(cached_model_root) else _find_unit_model_root(proxy)
	changed = _set_proxy_bool_meta(proxy, "unit_vital_visual_target_node_available", model_root != null) or changed
	if model_root == null:
		return changed
	if not model_root.has_meta("unit_vital_visual_base_rotation_degrees"):
		model_root.set_meta("unit_vital_visual_base_rotation_degrees", model_root.rotation_degrees)
	if not model_root.has_meta("unit_vital_visual_base_position"):
		model_root.set_meta("unit_vital_visual_base_position", model_root.position)
	var base_rotation: Vector3 = _get_vector3_meta(model_root, "unit_vital_visual_base_rotation_degrees", model_root.rotation_degrees)
	var base_position: Vector3 = _get_vector3_meta(model_root, "unit_vital_visual_base_position", model_root.position)
	var desired_rotation: Vector3 = base_rotation
	var desired_position: Vector3 = base_position
	if vital_state == "down":
		desired_rotation = base_rotation + UNIT_DOWN_POSE_ROTATION_DEGREES
		desired_position = base_position + Vector3(0.0, -0.16, 0.0)
	elif vital_state == "bleedout" or vital_state == "respawning":
		desired_rotation = base_rotation + UNIT_BLEEDOUT_POSE_ROTATION_DEGREES
		desired_position = base_position + Vector3(0.0, -0.20, 0.0)
	if model_root.rotation_degrees.distance_squared_to(desired_rotation) > 0.0001:
		model_root.rotation_degrees = desired_rotation
		changed = true
	if model_root.position.distance_squared_to(desired_position) > 0.000001:
		model_root.position = desired_position
		changed = true
	return changed


func _find_unit_model_root(node: Node) -> Node3D:
	if node == null:
		return null
	var node_3d := node as Node3D
	if node_3d != null and String(node.name).begins_with("UnitModel_"):
		return node_3d
	for child in node.get_children():
		var found: Node3D = _find_unit_model_root(child)
		if found != null:
			return found
	return null


func _build_unit_status_badge_signature(proxy: Node3D, unit: Node) -> String:
	var badge_text: String = _get_unit_status_badge_text(unit)
	return "%s|%s|%s|%s|%s" % [
		badge_text,
		_get_unit_status_badge_color(unit).to_html(true),
		_get_unit_status_badge_style(unit, badge_text),
		str(_should_suppress_release_firefight_unit_badge(badge_text)),
		str(proxy.visible),
	]


func _update_unit_status_badge(proxy: Node3D, unit: Node, cached_label: Label3D = null, unit_id: String = "") -> bool:
	if proxy == null:
		return false
	var label: Label3D = cached_label if cached_label != null and is_instance_valid(cached_label) else null
	var badge_text: String = _get_unit_status_badge_text(unit)
	var suppressed_by_declutter: bool = _should_suppress_release_firefight_unit_badge(badge_text)
	proxy.set_meta("unit_status_badge_suppressed_by_declutter", suppressed_by_declutter)
	if badge_text.is_empty() or not proxy.visible or suppressed_by_declutter:
		if label != null:
			label.visible = false
		if suppressed_by_declutter:
			proxy.set_meta("unit_status_badge_text", badge_text)
			proxy.set_meta("unit_status_badge_style", "suppressed_release_firefight_declutter")
		return false
	if label == null:
		label = _add_label3d(proxy, badge_text, Vector3(0.0, 0.98, 0.0), "UnitStateBadge", _get_unit_status_badge_color(unit), 13)
		label.pixel_size = 0.014
		label.outline_size = 3
		_unit_proxy_badge_rebuild_count += 1
		_set_cached_unit_proxy_status_badge(unit_id, label)
	else:
		label.text = badge_text
		label.modulate = _get_unit_status_badge_color(unit)
		label.visible = true
	var badge_color: Color = _get_unit_status_badge_color(unit)
	proxy.set_meta("unit_status_badge_text", badge_text)
	proxy.set_meta("unit_status_badge_color_hex", badge_color.to_html(true))
	proxy.set_meta("unit_status_badge_style", _get_unit_status_badge_style(unit, badge_text))
	return true


func _get_unit_status_badge_text(unit: Node) -> String:
	if unit == null:
		return ""
	var vital_state: String = ""
	if unit.has_method("get_vital_state"):
		vital_state = String(unit.call("get_vital_state")).strip_edges().to_lower()
	if not vital_state.is_empty() and vital_state != "fit":
		if vital_state == "respawning":
			var respawn_seconds: int = _get_unit_respawn_remaining_seconds(unit)
			return "RESPAWN %ds" % respawn_seconds if respawn_seconds > 0 else "RESPAWN"
		return vital_state.to_upper()
	var health_points: int = _get_unit_health_points(unit)
	var max_health_points: int = _get_unit_max_health_points(unit)
	if max_health_points > 0 and health_points < max_health_points:
		return "HP %d/%d" % [health_points, max_health_points]
	if unit.has_method("is_in_contact") and bool(unit.call("is_in_contact")):
		return "CONTACT"
	if bool(unit.get_meta("overwatch_ready", false)):
		return "DEF"
	var runtime_status = unit.call("get_runtime_status") if unit.has_method("get_runtime_status") else null
	var status_text: String = ""
	var source_command: String = ""
	if runtime_status != null:
		status_text = String(runtime_status.get("status")).strip_edges().to_lower() if runtime_status.has_method("get") else ""
		source_command = String(runtime_status.get("source_command_type")).strip_edges().to_lower() if runtime_status.has_method("get") else ""
	if source_command == "move":
		return "MOVE"
	if source_command == "engage":
		return "ENGAGE"
	if source_command == "take":
		return "TAKE"
	if source_command == "defend":
		return "DEF"
	if source_command == "flank":
		return "FLANK"
	match status_text:
		"pending_move":
			return "MOVE"
		"engaging":
			return "ENGAGE"
		"holding":
			return "HOLD"
		"assigned":
			return "READY"
		"idle":
			return "IDLE"
		_:
			return ""


func _get_unit_status_badge_color(unit: Node) -> Color:
	var vital_state: String = String(unit.call("get_vital_state")).strip_edges().to_lower() if unit != null and unit.has_method("get_vital_state") else ""
	match vital_state:
		"down", "bleedout":
			return Color(1.0, 0.42, 0.38, 1.0)
		"respawning":
			return Color(0.72, 0.9, 1.0, 1.0)
	var health_points: int = _get_unit_health_points(unit)
	var max_health_points: int = _get_unit_max_health_points(unit)
	if max_health_points > 0 and health_points < max_health_points:
		return Color(1.0, 0.68, 0.28, 1.0)
	if unit != null and unit.has_method("get_team_id") and String(unit.call("get_team_id")).strip_edges() != "team_alpha":
		return Color(1.0, 0.56, 0.46, 1.0)
	if unit != null and unit.has_method("is_in_contact") and bool(unit.call("is_in_contact")):
		return Color(1.0, 0.78, 0.34, 1.0)
	if unit != null and bool(unit.get_meta("overwatch_ready", false)):
		if not bool(unit.get_meta("overwatch_shot_ready", true)):
			return Color(0.48, 0.72, 0.78, 0.9)
		return Color(0.46, 0.98, 0.92, 1.0)
	return Color(0.62, 0.92, 1.0, 1.0)


func _get_unit_status_badge_style(unit: Node, badge_text: String = "") -> String:
	var normalized_text: String = badge_text.strip_edges().to_upper()
	if ["DOWN", "BLEEDOUT"].has(normalized_text):
		return "critical"
	if normalized_text.begins_with("HP ") or normalized_text.begins_with("RESPAWN"):
		return "wounded"
	if normalized_text == "CONTACT" or normalized_text == "ENGAGE":
		return "engagement"
	var overwatch_ready: bool = bool(unit.get_meta("overwatch_ready", false)) if unit != null else false
	if normalized_text == "DEF" or overwatch_ready:
		return "covering"
	if normalized_text == "MOVE" or normalized_text == "FLANK":
		return "movement"
	if normalized_text == "HOLD":
		return "holding"
	return "ready"


func _get_unit_respawn_remaining_seconds(unit: Node) -> int:
	if unit == null:
		return 0
	if unit.has_method("get_respawn_remaining_seconds"):
		return maxi(int(unit.call("get_respawn_remaining_seconds")), 0)
	if unit.has_meta("respawn_remaining_seconds"):
		return maxi(int(unit.get_meta("respawn_remaining_seconds", 0)), 0)
	return 0


func _get_unit_proxy_rotation_y(proxy: Node3D, unit: Node, current_world_position: Vector2, active_fire_event: Dictionary = {}, visible_contact_direction: Vector2 = Vector2.ZERO) -> float:
	var fallback_yaw: float = proxy.rotation_degrees.y if proxy != null else 0.0
	if not active_fire_event.is_empty():
		var fire_direction: Vector2 = _get_fire_event_direction_for_unit(active_fire_event, current_world_position)
		if fire_direction.length_squared() > 0.0001:
			return _get_unit_world_direction_yaw(current_world_position, current_world_position + fire_direction, fallback_yaw)
	var contact_direction: Vector2 = visible_contact_direction if visible_contact_direction.length_squared() > 0.0001 else _resolve_unit_visible_contact_direction(unit, current_world_position)
	if contact_direction.length_squared() > 0.0001:
		return _get_unit_world_direction_yaw(current_world_position, current_world_position + contact_direction, fallback_yaw)
	var motion_or_target_direction: Vector2 = _resolve_unit_motion_or_target_direction(proxy, unit, current_world_position)
	if motion_or_target_direction.length_squared() > 0.0001:
		return _get_unit_world_direction_yaw(current_world_position, current_world_position + motion_or_target_direction, fallback_yaw)
	var explicit_facing_direction: Vector2 = _resolve_unit_explicit_facing_direction(unit)
	if explicit_facing_direction.length_squared() > 0.0001:
		return _get_unit_world_direction_yaw(current_world_position, current_world_position + explicit_facing_direction, fallback_yaw)
	var target_position: Variant = unit.call("get_target_position") if unit != null and unit.has_method("get_target_position") else null
	if typeof(target_position) == TYPE_VECTOR2:
		var target_world_position: Vector2 = Vector2(target_position)
		if current_world_position.distance_squared_to(target_world_position) > 0.25:
			return _get_unit_world_direction_yaw(current_world_position, target_world_position, fallback_yaw)

	if proxy != null and proxy.has_meta("last_world_position"):
		var previous_position: Variant = proxy.get_meta("last_world_position")
		if typeof(previous_position) == TYPE_VECTOR2:
			var previous_world_position: Vector2 = Vector2(previous_position)
			if previous_world_position.distance_squared_to(current_world_position) > 0.01:
				return _get_unit_world_direction_yaw(previous_world_position, current_world_position, fallback_yaw)

	return fallback_yaw


func _get_active_fire_event_for_unit(unit_id: String) -> Dictionary:
	_ensure_unit_proxy_payload_indexes()
	return _get_indexed_active_fire_event_for_unit(unit_id).duplicate(true)


func _get_fire_event_direction_for_unit(fire_event: Dictionary, current_world_position: Vector2) -> Vector2:
	var target_position: Vector2 = _get_vector2_from_variant(fire_event.get("target_position", current_world_position), current_world_position)
	if current_world_position.distance_squared_to(target_position) > 0.0001:
		return (target_position - current_world_position).normalized()
	var attacker_position: Vector2 = _get_vector2_from_variant(fire_event.get("attacker_position", current_world_position), current_world_position)
	if attacker_position.distance_squared_to(target_position) > 0.0001:
		return (target_position - attacker_position).normalized()
	return Vector2.ZERO


func _get_vector2_from_variant(value: Variant, fallback: Vector2) -> Vector2:
	if typeof(value) == TYPE_VECTOR2:
		return Vector2(value)
	if typeof(value) == TYPE_VECTOR2I:
		var vector2i_value: Vector2i = value
		return Vector2(vector2i_value.x, vector2i_value.y)
	if typeof(value) == TYPE_ARRAY:
		var values: Array = Array(value)
		if values.size() >= 2:
			return Vector2(float(values[0]), float(values[1]))
	if typeof(value) == TYPE_DICTIONARY:
		var dict: Dictionary = Dictionary(value)
		return Vector2(float(dict.get("x", fallback.x)), float(dict.get("y", fallback.y)))
	return fallback


func _get_world_direction_yaw(from_world_position: Vector2, to_world_position: Vector2, fallback_yaw: float = 0.0) -> float:
	var delta_grid: Vector2 = _world_to_grid_float(to_world_position) - _world_to_grid_float(from_world_position)
	if _uses_hex_grid():
		delta_grid = HEX_GRID_SCRIPT.axial_to_plane(delta_grid)
	if delta_grid.length_squared() <= 0.0001:
		return fallback_yaw
	return wrapf(rad_to_deg(atan2(delta_grid.x, -delta_grid.y)), 0.0, 360.0)


func _get_unit_world_direction_yaw(from_world_position: Vector2, to_world_position: Vector2, fallback_yaw: float = 0.0) -> float:
	var delta_grid: Vector2 = _world_to_grid_float(to_world_position) - _world_to_grid_float(from_world_position)
	if _uses_hex_grid():
		delta_grid = HEX_GRID_SCRIPT.axial_to_plane(delta_grid)
	if delta_grid.length_squared() <= 0.0001:
		return fallback_yaw
	return wrapf(rad_to_deg(atan2(delta_grid.y, -delta_grid.x)), 0.0, 360.0)


func _create_unit_proxy(unit: Node) -> Node3D:
	var root := Node3D.new()
	var unit_visual_entry: Dictionary = _get_unit_visual_entry(unit)
	var model_scene := _get_unit_model_scene(unit, unit_visual_entry)
	if model_scene != null:
		var model_instance := model_scene.instantiate() as Node3D
		if model_instance != null:
			_normalize_asset_model_instance(model_instance)
			var model_root := Node3D.new()
			model_root.name = "UnitModel_%s" % _get_unit_visual_name(unit, unit_visual_entry)
			var model_scale: float = _get_unit_model_scale(unit_visual_entry)
			model_root.scale = Vector3.ONE * model_scale
			model_root.rotation_degrees.y = _get_unit_model_root_rotation_y(unit_visual_entry)
			root.set_meta("unit_model_scale", model_scale)
			root.set_meta("unit_model_root_rotation_y_degrees", model_root.rotation_degrees.y)
			var material_applied: bool = _apply_unit_visual_material(model_instance, unit_visual_entry)
			if not material_applied and _unit_visual_entry_has_skin(unit_visual_entry):
				_add_runtime_missing_asset_marker(
					root,
					Vector3(0.0, 0.72, 0.0),
					"MissingAsset_unit_skin_%s" % _sanitize_node_name(_get_unit_visual_name(unit, unit_visual_entry))
				)
				root.set_meta("unit_visual_error", true)
			model_root.add_child(model_instance)
			if not unit_visual_entry.is_empty():
				var visual_archetype_id: String = String(unit_visual_entry.get("resolved_visual_archetype_id", unit_visual_entry.get("visual_archetype_id", ""))).strip_edges()
				if not visual_archetype_id.is_empty():
					root.set_meta("unit_visual_archetype_id", visual_archetype_id)
				var faction_id: String = String(unit_visual_entry.get("faction_id", "")).strip_edges()
				if not faction_id.is_empty():
					root.set_meta("unit_visual_faction_id", faction_id)
				var visual_loadout_id: String = String(unit_visual_entry.get("resolved_visual_loadout_id", "")).strip_edges()
				if not visual_loadout_id.is_empty():
					root.set_meta("unit_visual_loadout_available", true)
					root.set_meta("unit_visual_loadout_id", visual_loadout_id)
				if bool(unit_visual_entry.get("visual_loadout_error", false)):
					root.set_meta("unit_visual_loadout_error", true)
					root.set_meta("unit_visual_error", true)
				if _setup_unit_visual_animation(root, model_root, model_instance, unit_visual_entry):
					root.set_meta("unit_animation_player_available", true)
				else:
					root.set_meta("unit_animation_error", true)
					root.set_meta("unit_visual_error", true)
				_setup_unit_visual_sockets(root, model_root, model_instance, unit_visual_entry)
				if _attach_unit_helmet(root, model_root, model_instance, unit_visual_entry):
					root.set_meta("unit_helmet_attachment_available", true)
				elif _unit_visual_entry_has_helmet(unit_visual_entry):
					root.set_meta("unit_helmet_error", true)
					root.set_meta("unit_visual_error", true)
				if _attach_unit_blaster(root, model_root, model_instance, unit_visual_entry):
					root.set_meta("unit_blaster_attachment_available", true)
				elif _unit_visual_entry_has_blaster(unit_visual_entry):
					root.set_meta("unit_blaster_error", true)
					root.set_meta("unit_visual_error", true)
			root.add_child(model_root)
			root.set_meta("uses_kenney_model", true)
			root.set_meta("unit_body_visual_visible", true)
			root.set_meta("unit_body_visual_kind", "animated_model")
			if not unit_visual_entry.is_empty():
				root.set_meta("uses_animated_character_model", true)
				if _get_unit_team_id(unit) != "team_alpha":
					_add_unit_body_readability_core(root, unit)

	if not bool(root.get_meta("uses_kenney_model", false)) and _uses_strict_3d_asset_mapping():
		_add_runtime_missing_asset_marker(
			root,
			Vector3(0.0, 0.42, 0.0),
			"MissingAsset_unit_model_%s" % _sanitize_node_name(_get_unit_visual_name(unit, unit_visual_entry))
		)
		root.set_meta("missing_unit_model", true)
		if not unit_visual_entry.is_empty():
			root.set_meta("unit_visual_error", true)
	elif not bool(root.get_meta("uses_kenney_model", false)):
		var unit_texture := _get_unit_visual_texture(unit)
		if unit_texture != null:
			var unit_card := _add_texture_card(root, unit_texture, Vector3(0.0, 0.34, 0.0), "UnitTexture", UNIT_TEXTURE_PIXEL_SIZE)
			if unit_card != null:
				root.set_meta("uses_unit_texture", true)
				root.set_meta("unit_body_visual_visible", true)
				root.set_meta("unit_body_visual_kind", "texture_card")
				var weapon_texture := _get_unit_weapon_visual_texture(unit)
				if weapon_texture != null:
					_add_texture_card(root, weapon_texture, Vector3(0.0, 0.36, 0.0), "UnitWeaponTexture", UNIT_TEXTURE_PIXEL_SIZE, _get_unit_weapon_visual_offset(unit))

	if not bool(root.get_meta("uses_kenney_model", false)) and not bool(root.get_meta("uses_unit_texture", false)) and not bool(root.get_meta("missing_unit_model", false)):
		var body := MeshInstance3D.new()
		var mesh := CapsuleMesh.new()
		mesh.radius = UNIT_FALLBACK_BODY_RADIUS
		mesh.height = UNIT_FALLBACK_BODY_HEIGHT
		body.mesh = mesh
		body.material_override = _make_material(_get_unit_color(unit))
		root.add_child(body)
		root.set_meta("unit_body_visual_visible", true)
		root.set_meta("unit_body_visual_kind", "fallback_capsule")
	if _get_unit_team_id(unit) != "team_alpha" and root.get_node_or_null("UnitBodyReadabilityCore") == null:
		_add_unit_body_readability_core(root, unit)
		if String(root.get_meta("unit_body_visual_kind", "")).strip_edges().is_empty():
			root.set_meta("unit_body_visual_kind", "hostile_readability_core")
	var base := MeshInstance3D.new()
	var base_mesh := CylinderMesh.new()
	var is_hostile_base: bool = _get_unit_team_id(unit) != "team_alpha"
	var base_radius: float = UNIT_BASE_RADIUS * (HOSTILE_UNIT_BASE_RADIUS_FACTOR if is_hostile_base else 1.0)
	var base_height: float = UNIT_BASE_HEIGHT * (HOSTILE_UNIT_BASE_HEIGHT_FACTOR if is_hostile_base else 1.0)
	var base_color: Color = _get_unit_base_color(unit)
	if is_hostile_base:
		base_color = Color(base_color.r, base_color.g, base_color.b, HOSTILE_UNIT_BASE_ALPHA)
	base_mesh.top_radius = base_radius
	base_mesh.bottom_radius = base_radius
	base_mesh.height = base_height
	base_mesh.radial_segments = 16
	base.mesh = base_mesh
	base.material_override = _make_material(base_color, true)
	base.position.y = HOSTILE_UNIT_BASE_Y if is_hostile_base else -0.02
	root.add_child(base)
	root.set_meta("unit_team_base_visible", true)
	root.set_meta("unit_team_base_radius", base_radius)
	root.set_meta("unit_team_base_height", base_height)
	root.set_meta("unit_team_base_alpha", base_color.a)
	root.set_meta("unit_team_base_y", base.position.y)
	return root


func _add_unit_body_readability_core(root: Node3D, unit: Node) -> void:
	if root == null:
		return
	var body := MeshInstance3D.new()
	var mesh := CapsuleMesh.new()
	var is_hostile: bool = _get_unit_team_id(unit) != "team_alpha"
	var radius_factor: float = HOSTILE_READABILITY_BODY_RADIUS_FACTOR if is_hostile else 0.46
	var height_factor: float = HOSTILE_READABILITY_BODY_HEIGHT_FACTOR if is_hostile else 0.72
	var alpha: float = HOSTILE_READABILITY_BODY_ALPHA if is_hostile else 0.62
	mesh.radius = UNIT_FALLBACK_BODY_RADIUS * radius_factor
	mesh.height = UNIT_FALLBACK_BODY_HEIGHT * height_factor
	body.name = "UnitBodyReadabilityCore"
	body.mesh = mesh
	var color: Color = _get_unit_color(unit)
	body.material_override = _make_material(Color(color.r, color.g, color.b, alpha), true)
	body.position = Vector3(0.0, HOSTILE_READABILITY_BODY_HEIGHT_OFFSET if is_hostile else 0.38, 0.0)
	root.add_child(body)
	root.set_meta("unit_body_readability_core_visible", true)
	root.set_meta("unit_body_readability_core_radius", mesh.radius)
	root.set_meta("unit_body_readability_core_height", mesh.height)
	root.set_meta("unit_body_readability_core_alpha", alpha)
	root.set_meta("unit_body_visual_visible", true)


func _setup_unit_visual_animation(proxy_root: Node3D, model_root: Node3D, model_instance: Node3D, unit_visual_entry: Dictionary) -> bool:
	var animation_paths: Dictionary = _get_unit_animation_paths(unit_visual_entry)
	proxy_root.set_meta("unit_animation_heading_sanitized_track_count", 0)
	proxy_root.set_meta("unit_animation_raw_imported_count", 0)
	proxy_root.set_meta("unit_animation_combat_case_imported_count", 0)
	proxy_root.set_meta("unit_animation_combat_case_expected_count", 0)
	proxy_root.set_meta("unit_animation_shoot_pose_track_override_count", 0)
	if animation_paths.is_empty():
		return true
	var animation_player := AnimationPlayer.new()
	animation_player.name = "UnitVisualAnimationPlayer"
	animation_player.set("callback_mode_process", AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_MANUAL)
	var library := AnimationLibrary.new()
	var expected_count: int = 0
	var imported_count: int = 0
	var heading_sanitized_track_count: int = 0
	for animation_name_variant in animation_paths.keys():
		var animation_name: String = String(animation_name_variant).strip_edges()
		var animation_path: String = String(animation_paths[animation_name_variant]).strip_edges()
		if animation_name.is_empty() or animation_path.is_empty():
			continue
		expected_count += 1
		var animation: Animation = _load_animation_from_scene(animation_path, animation_name)
		if animation == null:
			continue
		var duplicated := animation.duplicate(true) as Animation
		if duplicated == null:
			continue
		duplicated.loop_mode = Animation.LOOP_LINEAR
		heading_sanitized_track_count += _sanitize_unit_locomotion_heading_tracks(duplicated, animation_name)
		duplicated.set_meta("unit_animation_catalog_name", animation_name)
		animation_player.set_meta("source_animation_%s" % animation_name, String(duplicated.get_meta("source_animation_name", "")))
		library.add_animation(animation_name, duplicated)
		imported_count += 1
	var combat_case_result: Dictionary = _add_unit_visual_combat_animation_cases(library, unit_visual_entry)
	var combat_case_expected_count: int = int(combat_case_result.get("expected_count", 0))
	var combat_case_imported_count: int = int(combat_case_result.get("imported_count", 0))
	var shoot_pose_track_override_count: int = int(combat_case_result.get("shoot_pose_track_override_count", 0))
	heading_sanitized_track_count += int(combat_case_result.get("heading_sanitized_track_count", 0))
	if imported_count > 0:
		proxy_root.set_meta("unit_animation_heading_sanitized_track_count", heading_sanitized_track_count)
		proxy_root.set_meta("unit_animation_raw_imported_count", imported_count)
		proxy_root.set_meta("unit_animation_combat_case_imported_count", combat_case_imported_count)
		proxy_root.set_meta("unit_animation_combat_case_expected_count", combat_case_expected_count)
		proxy_root.set_meta("unit_animation_shoot_pose_track_override_count", shoot_pose_track_override_count)
		animation_player.set_meta("unit_animation_heading_sanitized_track_count", heading_sanitized_track_count)
		animation_player.set_meta("unit_animation_raw_imported_count", imported_count)
		animation_player.set_meta("unit_animation_combat_case_imported_count", combat_case_imported_count)
		animation_player.set_meta("unit_animation_combat_case_expected_count", combat_case_expected_count)
		animation_player.set_meta("unit_animation_shoot_pose_track_override_count", shoot_pose_track_override_count)
		animation_player.add_animation_library("", library)
		model_root.add_child(animation_player)
		animation_player.root_node = animation_player.get_path_to(model_instance)
		model_root.set_meta("unit_animation_player_node", String(animation_player.name))
		if animation_player.has_animation("idle"):
			animation_player.play("idle")
	if expected_count == 0 or imported_count < expected_count:
		_add_runtime_missing_asset_marker(
			proxy_root,
			Vector3(0.0, 0.64, 0.0),
			"MissingAsset_unit_animation_%s" % _sanitize_node_name(_get_unit_visual_name(null, unit_visual_entry))
		)
		return false
	return true


func _load_animation_from_scene(animation_scene_path: String, preferred_animation_name: String = "") -> Animation:
	if not ResourceLoader.exists(animation_scene_path):
		return null
	var animation_scene := _get_asset_model_scene_by_path(animation_scene_path)
	if animation_scene == null:
		return null
	var animation_root := animation_scene.instantiate()
	if animation_root == null:
		return null
	var animation: Animation = _find_best_animation(animation_root, preferred_animation_name)
	animation_root.free()
	return animation


func _find_best_animation(node: Node, preferred_animation_name: String = "") -> Animation:
	var animation_player := node as AnimationPlayer
	if animation_player != null:
		var preferred_text: String = preferred_animation_name.strip_edges().to_lower()
		if not preferred_text.is_empty():
			for animation_name in animation_player.get_animation_list():
				var name_text: String = String(animation_name)
				var normalized_name: String = name_text.strip_edges().to_lower()
				if normalized_name == "reset" or normalized_name.find("targeting pose") >= 0:
					continue
				if normalized_name.find(preferred_text) >= 0:
					var preferred_animation := animation_player.get_animation(name_text)
					if preferred_animation != null:
						preferred_animation.set_meta("source_animation_name", name_text)
						return preferred_animation
		for animation_name in animation_player.get_animation_list():
			var name_text: String = String(animation_name)
			var normalized_name: String = name_text.strip_edges().to_lower()
			if normalized_name.is_empty() or normalized_name == "reset" or normalized_name.find("targeting pose") >= 0:
				continue
			var animation := animation_player.get_animation(name_text)
			if animation != null:
				animation.set_meta("source_animation_name", name_text)
				return animation
	for child in node.get_children():
		var child_animation: Animation = _find_best_animation(child, preferred_animation_name)
		if child_animation != null:
			return child_animation
	return null


func _add_unit_visual_combat_animation_cases(library: AnimationLibrary, unit_visual_entry: Dictionary) -> Dictionary:
	var result: Dictionary = {
		"expected_count": 0,
		"imported_count": 0,
		"heading_sanitized_track_count": 0,
		"shoot_pose_track_override_count": 0,
	}
	if library == null:
		return result
	var combat_cases: Dictionary = _get_unit_animation_combat_cases(unit_visual_entry)
	if combat_cases.is_empty():
		return result
	result["expected_count"] = combat_cases.size()
	for case_name_variant in combat_cases.keys():
		var case_name: String = String(case_name_variant).strip_edges()
		var case_entry: Dictionary = Dictionary(combat_cases.get(case_name_variant, {}))
		var base_animation_name: String = String(case_entry.get("base_animation", "")).strip_edges()
		if case_name.is_empty() or base_animation_name.is_empty():
			continue
		if not library.has_animation(base_animation_name):
			continue
		var base_animation: Animation = library.get_animation(base_animation_name)
		if base_animation == null:
			continue
		var duplicated := base_animation.duplicate(true) as Animation
		if duplicated == null:
			continue
		duplicated.loop_mode = Animation.LOOP_LINEAR
		var upper_body_pose_name: String = String(case_entry.get("upper_body_pose_animation", "")).strip_edges()
		var pose_scope: String = String(case_entry.get("pose_track_scope", "")).strip_edges().to_lower()
		var override_count: int = 0
		if not upper_body_pose_name.is_empty() and library.has_animation(upper_body_pose_name):
			var pose_animation: Animation = library.get_animation(upper_body_pose_name)
			override_count = _override_unit_animation_pose_tracks(duplicated, pose_animation, pose_scope, upper_body_pose_name)
		result["shoot_pose_track_override_count"] = int(result.get("shoot_pose_track_override_count", 0)) + override_count
		result["heading_sanitized_track_count"] = int(result.get("heading_sanitized_track_count", 0)) + _sanitize_unit_locomotion_heading_tracks(duplicated, case_name)
		duplicated.set_meta("unit_animation_catalog_name", case_name)
		duplicated.set_meta("unit_animation_base_name", base_animation_name)
		duplicated.set_meta("unit_animation_pose_source", upper_body_pose_name)
		duplicated.set_meta("unit_animation_pose_scope", pose_scope if not pose_scope.is_empty() else UNIT_COMBAT_POSE_SCOPE_IMPORTED_CLIP)
		duplicated.set_meta("unit_animation_pose_track_override_count", override_count)
		library.add_animation(case_name, duplicated)
		result["imported_count"] = int(result.get("imported_count", 0)) + 1
	return result


func _override_unit_animation_pose_tracks(base_animation: Animation, pose_animation: Animation, pose_track_scope: String, pose_source_name: String) -> int:
	if base_animation == null or pose_animation == null:
		return 0
	var normalized_scope: String = pose_track_scope.strip_edges().to_lower()
	if normalized_scope.is_empty() or normalized_scope == UNIT_COMBAT_POSE_SCOPE_IMPORTED_CLIP:
		return 0
	var target_length: float = maxf(base_animation.length, 0.001)
	var source_length: float = maxf(pose_animation.length, 0.001)
	var use_static_hold_pose: bool = normalized_scope == UNIT_COMBAT_POSE_SCOPE_SHOOT_UPPER_BODY
	var hold_pose_rotations: Dictionary = _get_unit_weapon_upper_body_pose_rotations(pose_animation) if use_static_hold_pose else {}
	for track_index in range(base_animation.get_track_count() - 1, -1, -1):
		if base_animation.track_get_type(track_index) != Animation.TYPE_ROTATION_3D:
			continue
		var base_bone_name: String = _get_bone_name_from_animation_track_path(String(base_animation.track_get_path(track_index)))
		if not _matches_unit_animation_pose_scope(base_bone_name, normalized_scope):
			continue
		base_animation.remove_track(track_index)
	var override_count: int = 0
	for track_index in range(pose_animation.get_track_count()):
		if pose_animation.track_get_type(track_index) != Animation.TYPE_ROTATION_3D:
			continue
		var pose_track_path: String = String(pose_animation.track_get_path(track_index))
		var pose_bone_name: String = _get_bone_name_from_animation_track_path(pose_track_path)
		if not _matches_unit_animation_pose_scope(pose_bone_name, normalized_scope):
			continue
		if pose_animation.track_get_key_count(track_index) <= 0:
			continue
		var new_track_index: int = base_animation.add_track(Animation.TYPE_ROTATION_3D)
		base_animation.track_set_path(new_track_index, NodePath(pose_track_path))
		base_animation.track_set_interpolation_type(new_track_index, pose_animation.track_get_interpolation_type(track_index))
		if use_static_hold_pose and hold_pose_rotations.has(pose_bone_name):
			var hold_value: Variant = hold_pose_rotations.get(pose_bone_name)
			if typeof(hold_value) != TYPE_QUATERNION:
				base_animation.remove_track(new_track_index)
				continue
			base_animation.track_insert_key(new_track_index, 0.0, Quaternion(hold_value))
			base_animation.track_insert_key(new_track_index, target_length, Quaternion(hold_value))
			override_count += 1
			continue
		for key_index in range(pose_animation.track_get_key_count(track_index)):
			var key_time: float = pose_animation.track_get_key_time(track_index, key_index)
			var key_value: Variant = pose_animation.track_get_key_value(track_index, key_index)
			if typeof(key_value) != TYPE_QUATERNION:
				continue
			var mapped_key_time: float = clampf(key_time / source_length * target_length, 0.0, target_length)
			base_animation.track_insert_key(new_track_index, mapped_key_time, Quaternion(key_value))
		override_count += 1
	base_animation.set_meta("unit_animation_pose_track_override_count", override_count)
	base_animation.set_meta("unit_animation_pose_scope", normalized_scope)
	base_animation.set_meta("unit_animation_pose_source", pose_source_name)
	base_animation.set_meta("unit_animation_pose_static_hold", use_static_hold_pose)
	if use_static_hold_pose:
		base_animation.set_meta("unit_animation_pose_hold_sample_ratio", UNIT_AIM_POSE_HOLD_SAMPLE_RATIO)
		base_animation.set_meta("unit_animation_pose_hold_sample_time", _get_unit_weapon_upper_body_pose_sample_time(pose_animation))
	return override_count


func _matches_unit_animation_pose_scope(bone_name: String, pose_track_scope: String) -> bool:
	var normalized_scope: String = pose_track_scope.strip_edges().to_lower()
	if normalized_scope == UNIT_COMBAT_POSE_SCOPE_SHOOT_UPPER_BODY:
		return _bone_name_matches_any_hint(bone_name, UNIT_SHOOT_UPPER_BODY_BONE_HINTS)
	return false


func _bone_name_matches_any_hint(bone_name: String, hints: PackedStringArray) -> bool:
	var normalized_name: String = bone_name.strip_edges().to_lower()
	if normalized_name.is_empty():
		return false
	for hint in hints:
		if normalized_name.find(String(hint)) >= 0:
			return true
	return false


func _sanitize_unit_locomotion_heading_tracks(animation: Animation, animation_name: String) -> int:
	if animation == null:
		return 0
	var normalized_animation_name: String = animation_name.strip_edges().to_lower()
	if not UNIT_LOCOMOTION_HEADING_ANIMATION_NAMES.has(normalized_animation_name):
		return 0
	var removed_count: int = 0
	for track_index in range(animation.get_track_count() - 1, -1, -1):
		if animation.track_get_type(track_index) != Animation.TYPE_ROTATION_3D:
			continue
		var track_path: String = String(animation.track_get_path(track_index))
		if not _is_unit_locomotion_heading_control_track(track_path):
			continue
		animation.remove_track(track_index)
		removed_count += 1
	if removed_count > 0:
		animation.set_meta("unit_animation_heading_sanitized_track_count", removed_count)
	return removed_count


func _is_unit_locomotion_heading_control_track(track_path: String) -> bool:
	for bone_name in UNIT_LOCOMOTION_HEADING_CONTROL_BONES:
		if track_path.ends_with(":%s" % String(bone_name)):
			return true
	return false


func _update_unit_visual_animation(proxy: Node3D, is_moving: bool, is_firing: bool = false, delta: float = -1.0, weapon_posture: String = "", movement_posture: String = "", cached_animation_player: AnimationPlayer = null) -> bool:
	var animation_player: AnimationPlayer = cached_animation_player if cached_animation_player != null and is_instance_valid(cached_animation_player) else _find_unit_visual_animation_player(proxy)
	if animation_player == null:
		return false
	var normalized_weapon_posture: String = _normalize_unit_weapon_posture(weapon_posture)
	var normalized_movement_posture: String = _normalize_unit_movement_posture(movement_posture)
	var desired_animation: String = _resolve_unit_visual_animation_name(animation_player, is_moving, is_firing, normalized_weapon_posture, normalized_movement_posture)
	if not animation_player.has_animation(desired_animation):
		proxy.set_meta("unit_visual_animation_name", "")
		return false
	var changed: bool = false
	if animation_player.current_animation != desired_animation or not animation_player.is_playing():
		animation_player.play(desired_animation)
		changed = true
	if String(proxy.get_meta("unit_visual_animation_name", "")) != desired_animation:
		proxy.set_meta("unit_visual_animation_name", desired_animation)
		changed = true
	var previous_animation_position: float = animation_player.current_animation_position
	animation_player.advance(maxf(delta, 0.0))
	# UPDATE_ONCE also needs a new frame when a stable clip advances its pose.
	# Frozen/zero-delta or hidden animations must not cause recurring redraws.
	if proxy.is_visible_in_tree() and not is_equal_approx(previous_animation_position, animation_player.current_animation_position):
		changed = true
	return changed


func _resolve_unit_visual_animation_name(animation_player: AnimationPlayer, is_moving: bool, is_firing: bool, weapon_posture: String, movement_posture: String) -> String:
	if animation_player == null:
		return ""
	var normalized_weapon_posture: String = _normalize_unit_weapon_posture(weapon_posture)
	var normalized_movement_posture: String = _normalize_unit_movement_posture(movement_posture)
	var should_hold_aim: bool = is_firing or normalized_weapon_posture == "aimed"
	var candidates: PackedStringArray = []
	if normalized_movement_posture == "crouch":
		candidates = ["crouchShoot", "crouchIdle", "crouch", "shoot", "idle"] if should_hold_aim else ["crouchIdle", "crouch", "idle"]
	elif normalized_movement_posture == "crouch_walk":
		if should_hold_aim:
			candidates = ["crouchWalkShoot", "crouchShoot", "crouchWalk", "walkShoot", "walk"]
		else:
			candidates = ["crouchWalk", "crouchIdle", "walk", "idle"] if is_moving else ["crouchIdle", "crouch", "idle"]
	elif normalized_movement_posture == "crouch_run":
		if should_hold_aim:
			candidates = ["crouchRunShoot", "crouchWalkShoot", "crouchShoot", "runShoot", "crouchWalk", "run"]
		else:
			candidates = ["crouchWalk", "run", "walk", "idle"] if is_moving else ["crouchIdle", "crouch", "idle"]
	elif should_hold_aim:
		if is_moving and normalized_movement_posture == "run":
			candidates = ["runShoot", "walkShoot", "shoot", "run", "walk"]
		elif is_moving and normalized_movement_posture == "travel":
			candidates = ["runShoot", "walkShoot", "shoot", "run", "walk"]
		elif is_moving:
			candidates = ["walkShoot", "runShoot", "shoot", "walk", "run"]
		else:
			candidates = ["standShoot", "shoot", "idle"]
	elif is_moving and normalized_movement_posture == "run":
		candidates = ["run", "walk", "idle"]
	elif is_moving and normalized_movement_posture == "travel":
		candidates = ["run", "walk", "idle"]
	elif is_moving:
		candidates = ["walk", "run", "idle"]
	else:
		candidates = ["idle", "walk"]
	for candidate in candidates:
		if animation_player.has_animation(candidate):
			return candidate
	var animation_list: PackedStringArray = animation_player.get_animation_list()
	return String(animation_list[0]) if animation_list.size() > 0 else ""


func _update_unit_weapon_aim_pose(proxy: Node3D, active_fire_event: Dictionary, weapon_posture: String = "lowered", aim_direction: Vector2 = Vector2.ZERO, cached_weapon_node: Node3D = null, cached_skeleton: Skeleton3D = null, cached_animation_player: AnimationPlayer = null) -> bool:
	if proxy == null:
		return false
	var normalized_weapon_posture: String = _normalize_unit_weapon_posture("aimed" if not active_fire_event.is_empty() else weapon_posture)
	var is_active: bool = normalized_weapon_posture == "aimed"
	var is_ready: bool = normalized_weapon_posture == "ready"
	var changed: bool = false
	var weapon_node: Node3D = cached_weapon_node if cached_weapon_node != null and is_instance_valid(cached_weapon_node) else _find_unit_blaster_visual_node(proxy)
	proxy.set_meta("unit_aim_pose_weapon_node_available", weapon_node != null)
	var aim_yaw_delta_degrees: float = 0.0
	var has_aim_yaw: bool = false
	if (is_active or is_ready) and aim_direction.length_squared() > 0.0001:
		var aim_yaw_degrees: float = _get_unit_world_direction_yaw(Vector2.ZERO, aim_direction.normalized(), proxy.rotation_degrees.y)
		aim_yaw_delta_degrees = wrapf(aim_yaw_degrees - proxy.rotation_degrees.y, -180.0, 180.0)
		has_aim_yaw = true
	if absf(float(proxy.get_meta("unit_aim_pose_yaw_delta_degrees", 0.0)) - aim_yaw_delta_degrees) > 0.01:
		proxy.set_meta("unit_aim_pose_yaw_delta_degrees", aim_yaw_delta_degrees)
		changed = true
	if bool(proxy.get_meta("unit_aim_pose_yaw_active", false)) != has_aim_yaw:
		proxy.set_meta("unit_aim_pose_yaw_active", has_aim_yaw)
		changed = true
	if _update_unit_weapon_upper_body_pose(proxy, normalized_weapon_posture, cached_skeleton, cached_animation_player):
		changed = true
	if weapon_node == null:
		return changed
	if not weapon_node.has_meta("unit_aim_pose_base_rotation_degrees"):
		weapon_node.set_meta("unit_aim_pose_base_rotation_degrees", weapon_node.rotation_degrees)
	if not weapon_node.has_meta("unit_aim_pose_base_position"):
		weapon_node.set_meta("unit_aim_pose_base_position", weapon_node.position)
	var base_rotation: Vector3 = _get_vector3_meta(weapon_node, "unit_aim_pose_base_rotation_degrees", weapon_node.rotation_degrees)
	var base_position: Vector3 = _get_vector3_meta(weapon_node, "unit_aim_pose_base_position", weapon_node.position)
	var desired_rotation: Vector3 = base_rotation
	var desired_position: Vector3 = base_position
	if is_active:
		desired_rotation = base_rotation + Vector3(UNIT_AIM_POSE_WEAPON_PITCH_DEGREES, 0.0, 0.0)
	elif is_ready:
		desired_rotation = base_rotation + Vector3(UNIT_READY_POSE_WEAPON_PITCH_DEGREES, 0.0, 0.0)
	if weapon_node.rotation_degrees.distance_squared_to(desired_rotation) > 0.0001:
		weapon_node.rotation_degrees = desired_rotation
		changed = true
	if weapon_node.position.distance_squared_to(desired_position) > 0.000001:
		weapon_node.position = desired_position
		changed = true
	if bool(weapon_node.get_meta("unit_aim_pose_applied", false)) != is_active:
		weapon_node.set_meta("unit_aim_pose_applied", is_active)
		changed = true
	if bool(weapon_node.get_meta("unit_ready_pose_applied", false)) != is_ready:
		weapon_node.set_meta("unit_ready_pose_applied", is_ready)
		changed = true
	if String(weapon_node.get_meta("unit_weapon_posture_applied", "")) != normalized_weapon_posture:
		weapon_node.set_meta("unit_weapon_posture_applied", normalized_weapon_posture)
		changed = true
	if _update_unit_weapon_child_aim_yaw(weapon_node, aim_yaw_delta_degrees, has_aim_yaw):
		changed = true
	return changed


func _update_unit_weapon_upper_body_pose(proxy: Node3D, weapon_posture: String, cached_skeleton: Skeleton3D = null, cached_animation_player: AnimationPlayer = null) -> bool:
	if proxy == null:
		return false
	var normalized_weapon_posture: String = _normalize_unit_weapon_posture(weapon_posture)
	var should_apply_pose: bool = normalized_weapon_posture == "aimed"
	var skeleton: Skeleton3D = cached_skeleton if cached_skeleton != null and is_instance_valid(cached_skeleton) else _find_first_skeleton(proxy)
	var animation_player: AnimationPlayer = cached_animation_player if cached_animation_player != null and is_instance_valid(cached_animation_player) else _find_unit_visual_animation_player(proxy)
	var pose_animation: Animation = _get_unit_weapon_upper_body_pose_animation(animation_player)
	var changed: bool = false
	if skeleton == null or animation_player == null or pose_animation == null:
		changed = _reset_unit_weapon_upper_body_pose(proxy, skeleton) or changed
		changed = _set_proxy_bool_meta(proxy, "unit_weapon_upper_body_pose_animation_available", false) or changed
		changed = _set_proxy_int_meta(proxy, "unit_weapon_upper_body_pose_bone_count", 0) or changed
		changed = _set_proxy_string_meta(proxy, "unit_weapon_upper_body_pose_source_animation", "") or changed
		return changed
	changed = _set_proxy_bool_meta(proxy, "unit_weapon_upper_body_pose_animation_available", true) or changed
	if not should_apply_pose:
		changed = _reset_unit_weapon_upper_body_pose(proxy, skeleton) or changed
		changed = _set_proxy_int_meta(proxy, "unit_weapon_upper_body_pose_bone_count", 0) or changed
		changed = _set_proxy_string_meta(proxy, "unit_weapon_upper_body_pose_source_animation", _get_unit_weapon_upper_body_pose_source_name(pose_animation)) or changed
		return changed
	var applied_count: int = _apply_unit_weapon_upper_body_pose_from_animation(skeleton, pose_animation)
	changed = _set_proxy_bool_meta(proxy, "unit_weapon_upper_body_pose_active", applied_count > 0) or changed
	changed = _set_proxy_int_meta(proxy, "unit_weapon_upper_body_pose_bone_count", applied_count) or changed
	changed = _set_proxy_string_meta(proxy, "unit_weapon_upper_body_pose_source_animation", _get_unit_weapon_upper_body_pose_source_name(pose_animation)) or changed
	return changed


func _get_unit_weapon_upper_body_pose_animation(animation_player: AnimationPlayer) -> Animation:
	if animation_player == null or not animation_player.has_animation(UNIT_AIM_POSE_ANIMATION_NAME):
		return null
	return animation_player.get_animation(UNIT_AIM_POSE_ANIMATION_NAME)


func _get_unit_weapon_upper_body_pose_source_name(pose_animation: Animation) -> String:
	if pose_animation == null:
		return ""
	return String(pose_animation.get_meta("unit_animation_catalog_name", UNIT_AIM_POSE_ANIMATION_NAME)).strip_edges()


func _apply_unit_weapon_upper_body_pose_from_animation(skeleton: Skeleton3D, pose_animation: Animation) -> int:
	if skeleton == null or pose_animation == null:
		return 0
	var pose_rotations: Dictionary = _get_unit_weapon_upper_body_pose_rotations(pose_animation)
	var applied_count: int = 0
	for bone_name_variant in pose_rotations.keys():
		var bone_name: String = String(bone_name_variant)
		var bone_index: int = skeleton.find_bone(bone_name)
		if bone_index < 0:
			continue
		var rotation_value: Variant = pose_rotations.get(bone_name_variant)
		if typeof(rotation_value) != TYPE_QUATERNION:
			continue
		skeleton.set_bone_pose_rotation(bone_index, Quaternion(rotation_value))
		applied_count += 1
	if applied_count > 0 and skeleton.has_method("force_update_all_bone_transforms"):
		skeleton.call("force_update_all_bone_transforms")
	return applied_count


func _get_unit_weapon_upper_body_pose_rotations(pose_animation: Animation) -> Dictionary:
	if pose_animation == null:
		return {}
	if pose_animation.has_meta("unit_weapon_upper_body_pose_rotations"):
		var cached_value: Variant = pose_animation.get_meta("unit_weapon_upper_body_pose_rotations")
		if typeof(cached_value) == TYPE_DICTIONARY:
			return Dictionary(cached_value)
	var pose_rotations: Dictionary = {}
	var sample_time: float = _get_unit_weapon_upper_body_pose_sample_time(pose_animation)
	for track_index in range(pose_animation.get_track_count()):
		if pose_animation.track_get_type(track_index) != Animation.TYPE_ROTATION_3D:
			continue
		if pose_animation.track_get_key_count(track_index) <= 0:
			continue
		var bone_name: String = _get_bone_name_from_animation_track_path(String(pose_animation.track_get_path(track_index)))
		if not UNIT_AIM_POSE_UPPER_BODY_BONES.has(bone_name):
			continue
		var key_value: Variant = _get_rotation_track_value_near_time(pose_animation, track_index, sample_time)
		if typeof(key_value) != TYPE_QUATERNION:
			continue
		pose_rotations[bone_name] = Quaternion(key_value)
	pose_animation.set_meta("unit_weapon_upper_body_pose_rotations", pose_rotations)
	pose_animation.set_meta("unit_weapon_upper_body_pose_sample_ratio", UNIT_AIM_POSE_HOLD_SAMPLE_RATIO)
	pose_animation.set_meta("unit_weapon_upper_body_pose_sample_time", sample_time)
	return pose_rotations


func _get_unit_weapon_upper_body_pose_sample_time(pose_animation: Animation) -> float:
	if pose_animation == null:
		return 0.0
	return clampf(maxf(pose_animation.length, 0.0) * UNIT_AIM_POSE_HOLD_SAMPLE_RATIO, 0.0, maxf(pose_animation.length, 0.0))


func _get_rotation_track_value_near_time(animation: Animation, track_index: int, sample_time: float) -> Variant:
	if animation == null:
		return null
	var key_count: int = animation.track_get_key_count(track_index)
	if key_count <= 0:
		return null
	var best_key_index: int = 0
	var best_distance: float = INF
	for key_index in range(key_count):
		var key_time: float = animation.track_get_key_time(track_index, key_index)
		var distance: float = absf(key_time - sample_time)
		if distance < best_distance:
			best_distance = distance
			best_key_index = key_index
	return animation.track_get_key_value(track_index, best_key_index)


func _reset_unit_weapon_upper_body_pose(proxy: Node3D, skeleton: Skeleton3D) -> bool:
	var changed: bool = false
	var was_active: bool = bool(proxy.get_meta("unit_weapon_upper_body_pose_active", false)) if proxy != null else false
	if skeleton != null and was_active:
		for bone_name in UNIT_AIM_POSE_UPPER_BODY_BONES:
			var bone_index: int = skeleton.find_bone(String(bone_name))
			if bone_index < 0:
				continue
			if skeleton.has_method("reset_bone_pose"):
				skeleton.call("reset_bone_pose", bone_index)
		if skeleton.has_method("force_update_all_bone_transforms"):
			skeleton.call("force_update_all_bone_transforms")
		changed = true
	if proxy != null:
		changed = _set_proxy_bool_meta(proxy, "unit_weapon_upper_body_pose_active", false) or changed
	return changed


func _get_bone_name_from_animation_track_path(track_path: String) -> String:
	var separator_index: int = track_path.rfind(":")
	if separator_index < 0:
		return track_path.get_file().strip_edges()
	return track_path.substr(separator_index + 1).strip_edges()


func _set_proxy_bool_meta(proxy: Node, meta_name: String, value: bool) -> bool:
	if proxy == null:
		return false
	if bool(proxy.get_meta(meta_name, false)) == value:
		return false
	proxy.set_meta(meta_name, value)
	return true


func _set_proxy_int_meta(proxy: Node, meta_name: String, value: int) -> bool:
	if proxy == null:
		return false
	if int(proxy.get_meta(meta_name, 0)) == value:
		return false
	proxy.set_meta(meta_name, value)
	return true


func _set_proxy_string_meta(proxy: Node, meta_name: String, value: String) -> bool:
	if proxy == null:
		return false
	if String(proxy.get_meta(meta_name, "")) == value:
		return false
	proxy.set_meta(meta_name, value)
	return true


func _update_unit_weapon_child_aim_yaw(weapon_node: Node3D, aim_yaw_delta_degrees: float, apply_aim_yaw: bool) -> bool:
	if weapon_node == null:
		return false
	var changed: bool = false
	var desired_yaw_delta: float = aim_yaw_delta_degrees if apply_aim_yaw else 0.0
	for child in weapon_node.get_children():
		var child_3d := child as Node3D
		if child_3d == null:
			continue
		if not child_3d.has_meta("unit_aim_pose_base_rotation_degrees"):
			child_3d.set_meta("unit_aim_pose_base_rotation_degrees", child_3d.rotation_degrees)
		var base_rotation: Vector3 = _get_vector3_meta(child_3d, "unit_aim_pose_base_rotation_degrees", child_3d.rotation_degrees)
		var desired_rotation: Vector3 = base_rotation + Vector3(0.0, desired_yaw_delta, 0.0)
		if child_3d.rotation_degrees.distance_squared_to(desired_rotation) > 0.0001:
			child_3d.rotation_degrees = desired_rotation
			changed = true
	return changed


func _find_unit_blaster_visual_node(node: Node) -> Node3D:
	if node == null:
		return null
	var node_3d := node as Node3D
	if node_3d != null and String(node.name).begins_with("BlasterVisual_"):
		return node_3d
	for child in node.get_children():
		var found: Node3D = _find_unit_blaster_visual_node(child)
		if found != null:
			return found
	return null


func _get_vector3_meta(node: Node, meta_name: String, fallback: Vector3) -> Vector3:
	if node == null or not node.has_meta(meta_name):
		return fallback
	var value: Variant = node.get_meta(meta_name)
	if typeof(value) == TYPE_VECTOR3:
		return Vector3(value)
	return fallback


func _find_unit_visual_animation_player(node: Node) -> AnimationPlayer:
	if node == null:
		return null
	var animation_player := node as AnimationPlayer
	if animation_player != null and animation_player.name == "UnitVisualAnimationPlayer":
		return animation_player
	for child in node.get_children():
		var found: AnimationPlayer = _find_unit_visual_animation_player(child)
		if found != null:
			return found
	return null


func _setup_unit_visual_sockets(proxy_root: Node3D, model_root: Node3D, model_instance: Node3D, unit_visual_entry: Dictionary) -> void:
	var socket_entries: Dictionary = _get_unit_socket_entries(unit_visual_entry)
	if socket_entries.is_empty():
		return
	var skeleton: Skeleton3D = _find_first_skeleton(model_instance)
	if skeleton != null:
		proxy_root.set_meta("unit_skeleton_available", true)
		model_root.set_meta("unit_skeleton_bone_count", skeleton.get_bone_count())

	var socket_count: int = 0
	var fallback_count: int = 0
	var head_socket_available: bool = false
	var right_hand_socket_available: bool = false
	for socket_name_variant in socket_entries.keys():
		var socket_name: String = String(socket_name_variant).strip_edges()
		if socket_name.is_empty():
			continue
		var socket_entry: Dictionary = Dictionary(socket_entries.get(socket_name_variant, {}))
		var socket_node: Node3D = _create_unit_visual_socket(model_root, skeleton, socket_name, socket_entry)
		if socket_node == null:
			continue
		socket_count += 1
		if bool(socket_node.get_meta("socket_uses_fallback", false)):
			fallback_count += 1
		if socket_name == "HeadSocket":
			head_socket_available = true
		elif socket_name == "RightHandSocket":
			right_hand_socket_available = true

	proxy_root.set_meta("unit_socket_count", socket_count)
	proxy_root.set_meta("unit_socket_fallback_count", fallback_count)
	proxy_root.set_meta("unit_head_socket_available", head_socket_available)
	proxy_root.set_meta("unit_right_hand_socket_available", right_hand_socket_available)
	proxy_root.set_meta("unit_animation_retarget_fallback_count", 0)


func _create_unit_visual_socket(model_root: Node3D, skeleton: Skeleton3D, socket_name: String, socket_entry: Dictionary) -> Node3D:
	var bone_name: String = _find_matching_socket_bone_name(skeleton, _get_socket_bone_names(socket_entry), socket_name)
	var socket_node: Node3D = null
	var fallback_anchor: Vector3 = _get_vector3_from_variant(socket_entry.get("fallback_anchor", Vector3.ZERO), Vector3.ZERO)
	if skeleton != null and not bone_name.is_empty():
		var bone_attachment := BoneAttachment3D.new()
		bone_attachment.name = socket_name
		bone_attachment.bone_name = bone_name
		bone_attachment.set_meta("socket_mode", "bone:%s" % bone_name)
		skeleton.add_child(bone_attachment)
		socket_node = bone_attachment
		_apply_unit_socket_transform(socket_node, socket_entry, Vector3.ZERO)
	else:
		var fallback_socket := Node3D.new()
		fallback_socket.name = socket_name
		fallback_socket.set_meta("socket_mode", "fallback_anchor")
		fallback_socket.set_meta("socket_uses_fallback", true)
		model_root.add_child(fallback_socket)
		socket_node = fallback_socket
		_apply_unit_socket_transform(socket_node, socket_entry, fallback_anchor)
	return socket_node


func _apply_unit_socket_transform(socket_node: Node3D, socket_entry: Dictionary, base_position: Vector3) -> void:
	if socket_node == null:
		return
	var socket_offset: Vector3 = _get_vector3_from_variant(socket_entry.get("offset", Vector3.ZERO), Vector3.ZERO)
	socket_node.position = base_position + socket_offset
	socket_node.rotation_degrees = _get_vector3_from_variant(socket_entry.get("rotation_degrees", Vector3.ZERO), Vector3.ZERO)


func _find_unit_visual_socket(node: Node, socket_name: String) -> Node3D:
	if node == null:
		return null
	if String(node.name) == socket_name:
		return node as Node3D
	for child in node.get_children():
		var found: Node3D = _find_unit_visual_socket(child, socket_name)
		if found != null:
			return found
	return null


func _attach_unit_helmet(proxy_root: Node3D, model_root: Node3D, model_instance: Node3D, unit_visual_entry: Dictionary) -> bool:
	var helmet_path: String = _get_unit_helmet_path(unit_visual_entry)
	if helmet_path.is_empty():
		return true
	if not ResourceLoader.exists(helmet_path):
		_mark_unit_visual_loadout_error(proxy_root, unit_visual_entry)
		_add_runtime_missing_asset_marker(
			proxy_root,
			Vector3(0.0, 0.56, 0.0),
			"MissingAsset_unit_helmet_%s" % _sanitize_node_name(_get_unit_visual_name(null, unit_visual_entry))
		)
		return false
	var helmet_scene := _get_asset_model_scene_by_path(helmet_path)
	if helmet_scene == null:
		_mark_unit_visual_loadout_error(proxy_root, unit_visual_entry)
		return false
	var helmet_instance := helmet_scene.instantiate() as Node3D
	if helmet_instance == null:
		_mark_unit_visual_loadout_error(proxy_root, unit_visual_entry)
		return false
	_normalize_asset_model_instance(helmet_instance)
	helmet_instance.name = "HelmetVisual_%s" % helmet_path.get_file().get_basename()
	var attachment_entry: Dictionary = _get_unit_helmet_attachment_entry(unit_visual_entry)
	_apply_unit_helmet_transform(helmet_instance, attachment_entry, model_instance)
	var socket_name: String = String(attachment_entry.get("socket_name", "HeadSocket")).strip_edges()
	var socket: Node3D = _find_unit_visual_socket(model_root, socket_name)
	if socket != null:
		socket.add_child(helmet_instance)
		model_root.set_meta("helmet_attachment_mode", "socket:%s" % socket_name)
		helmet_instance.set_meta("attachment_socket", socket_name)
		return true

	var skeleton: Skeleton3D = _find_first_skeleton(model_instance)
	var bone_name: String = _find_matching_bone_name(skeleton, _get_helmet_bone_names(attachment_entry))
	if skeleton != null and not bone_name.is_empty():
		var bone_attachment := BoneAttachment3D.new()
		bone_attachment.name = "HelmetAttachment"
		bone_attachment.bone_name = bone_name
		skeleton.add_child(bone_attachment)
		bone_attachment.add_child(helmet_instance)
		model_root.set_meta("helmet_attachment_mode", "bone:%s" % bone_name)
		return true

	var head_anchor := Node3D.new()
	head_anchor.name = "HeadAnchor"
	head_anchor.position = _get_vector3_from_variant(attachment_entry.get("fallback_anchor", Vector3(0.0, 1.38, 0.0)), Vector3(0.0, 1.38, 0.0))
	model_root.add_child(head_anchor)
	head_anchor.add_child(helmet_instance)
	model_root.set_meta("helmet_attachment_mode", "head_anchor")
	return true


func _attach_unit_blaster(proxy_root: Node3D, model_root: Node3D, _model_instance: Node3D, unit_visual_entry: Dictionary) -> bool:
	var blaster_path: String = _get_unit_blaster_path(unit_visual_entry)
	if blaster_path.is_empty():
		return false
	if not ResourceLoader.exists(blaster_path):
		_mark_unit_visual_loadout_error(proxy_root, unit_visual_entry)
		_add_runtime_missing_asset_marker(
			proxy_root,
			Vector3(0.0, 0.50, 0.0),
			"MissingAsset_unit_blaster_%s" % _sanitize_node_name(_get_unit_visual_name(null, unit_visual_entry))
		)
		return false
	var blaster_scene := _get_asset_model_scene_by_path(blaster_path)
	if blaster_scene == null:
		_mark_unit_visual_loadout_error(proxy_root, unit_visual_entry)
		return false
	var blaster_instance := blaster_scene.instantiate() as Node3D
	if blaster_instance == null:
		_mark_unit_visual_loadout_error(proxy_root, unit_visual_entry)
		return false
	_normalize_asset_model_instance(blaster_instance)
	blaster_instance.name = "BlasterVisual_%s" % blaster_path.get_file().get_basename()
	var attachment_entry: Dictionary = _get_unit_blaster_attachment_entry(unit_visual_entry)
	_apply_unit_blaster_transform(blaster_instance, attachment_entry)
	if not _apply_unit_blaster_material(blaster_instance, attachment_entry):
		_mark_unit_visual_loadout_error(proxy_root, unit_visual_entry)
		return false
	var socket_name: String = String(attachment_entry.get("socket_name", "RightHandSocket")).strip_edges()
	var socket: Node3D = _find_unit_visual_socket(model_root, socket_name)
	if socket != null:
		socket.add_child(blaster_instance)
		model_root.set_meta("blaster_attachment_mode", "socket:%s" % socket_name)
		blaster_instance.set_meta("attachment_socket", socket_name)
		return true

	var hand_anchor := Node3D.new()
	hand_anchor.name = "RightHandAnchor"
	hand_anchor.position = _get_vector3_from_variant(attachment_entry.get("fallback_anchor", Vector3(0.22, 0.84, 0.10)), Vector3(0.22, 0.84, 0.10))
	model_root.add_child(hand_anchor)
	hand_anchor.add_child(blaster_instance)
	model_root.set_meta("blaster_attachment_mode", "right_hand_anchor")
	return true


func _mark_unit_visual_loadout_error(proxy_root: Node3D, unit_visual_entry: Dictionary) -> void:
	if proxy_root == null:
		return
	if String(unit_visual_entry.get("resolved_visual_loadout_id", "")).strip_edges().is_empty():
		return
	proxy_root.set_meta("unit_visual_loadout_error", true)


func _find_first_skeleton(node: Node) -> Skeleton3D:
	var skeleton := node as Skeleton3D
	if skeleton != null:
		return skeleton
	for child in node.get_children():
		var found: Skeleton3D = _find_first_skeleton(child)
		if found != null:
			return found
	return null


func _find_matching_bone_name(skeleton: Skeleton3D, candidate_names: PackedStringArray) -> String:
	if skeleton == null:
		return ""
	for candidate in candidate_names:
		var candidate_text: String = String(candidate).strip_edges()
		if candidate_text.is_empty():
			continue
		var bone_index: int = skeleton.find_bone(candidate_text)
		if bone_index >= 0:
			return candidate_text
	var bone_count: int = skeleton.get_bone_count()
	for index in range(bone_count):
		var bone_name: String = skeleton.get_bone_name(index)
		if bone_name.to_lower().find("head") >= 0:
			return bone_name
	return ""


func _find_matching_socket_bone_name(skeleton: Skeleton3D, candidate_names: PackedStringArray, socket_name: String) -> String:
	if skeleton == null:
		return ""
	for candidate in candidate_names:
		var candidate_text: String = String(candidate).strip_edges()
		if candidate_text.is_empty():
			continue
		var bone_index: int = skeleton.find_bone(candidate_text)
		if bone_index >= 0:
			return candidate_text
	var best_match: String = ""
	var bone_count: int = skeleton.get_bone_count()
	for index in range(bone_count):
		var bone_name: String = skeleton.get_bone_name(index)
		if _bone_name_matches_socket(bone_name, socket_name):
			if best_match.is_empty() or bone_name.length() < best_match.length():
				best_match = bone_name
	return best_match


func _bone_name_matches_socket(bone_name: String, socket_name: String) -> bool:
	var bone_text: String = bone_name.strip_edges().to_lower()
	if bone_text.is_empty() or bone_text.find("_end") >= 0 or bone_text.ends_with("end"):
		return false
	var socket_text: String = socket_name.strip_edges().to_lower()
	if socket_text == "headsocket":
		return bone_text.find("head") >= 0
	if socket_text == "righthandsocket":
		return bone_text.find("righthand") >= 0 or (bone_text.find("right") >= 0 and bone_text.find("hand") >= 0)
	if socket_text == "lefthandsocket":
		return bone_text.find("lefthand") >= 0 or (bone_text.find("left") >= 0 and bone_text.find("hand") >= 0)
	if socket_text == "backsocket":
		return bone_text.find("spine") >= 0 or bone_text.find("chest") >= 0
	return false


func _get_unit_proxy_ids(visible_only: bool) -> Array:
	var unit_ids: Array = []
	for unit_id_variant in _unit_proxies_by_id.keys():
		var unit_id: String = String(unit_id_variant).strip_edges()
		if unit_id.is_empty():
			continue
		var proxy := _unit_proxies_by_id.get(unit_id_variant, null) as Node3D
		if proxy == null or not is_instance_valid(proxy):
			continue
		if visible_only and not proxy.visible:
			continue
		unit_ids.append(unit_id)
	unit_ids.sort()
	return unit_ids


func _get_unit_proxy_ids_with_meta(meta_name: String) -> Array:
	var unit_ids: Array = []
	var normalized_meta_name: String = meta_name.strip_edges()
	if normalized_meta_name.is_empty():
		return unit_ids
	for unit_id_variant in _unit_proxies_by_id.keys():
		var unit_id: String = String(unit_id_variant).strip_edges()
		if unit_id.is_empty():
			continue
		var proxy := _unit_proxies_by_id.get(unit_id_variant, null) as Node3D
		if proxy == null or not is_instance_valid(proxy):
			continue
		if bool(proxy.get_meta(normalized_meta_name, false)):
			unit_ids.append(unit_id)
	unit_ids.sort()
	return unit_ids


