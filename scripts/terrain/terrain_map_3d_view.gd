func _build_mission_status_payload_signature(payload: Dictionary) -> String:
	var visual_payload: Dictionary = {}
	for key in [
		"objective_position",
		"objective_capture_radius",
		"objective_capture_progress",
		"objective_owner_team_id",
		"objective_capturing_team_id",
		"objective_contested",
		"mission_resolved",
		"result",
		"win_condition_type",
		"winning_team_id",
		"route_callouts",
		"mission_interaction_object_reactions",
		"mission_interaction_visual_states",
	]:
		if payload.has(key):
			visual_payload[key] = payload[key]
	return _serialize_mission_status_signature_value(visual_payload)


func _serialize_mission_status_signature_value(value: Variant) -> String:
	match typeof(value):
		TYPE_DICTIONARY:
			var dictionary: Dictionary = Dictionary(value)
			var keys: PackedStringArray = PackedStringArray()
			for key_variant in dictionary.keys():
				keys.append(String(key_variant))
			keys.sort()
			var tokens: PackedStringArray = PackedStringArray()
			for key in keys:
				tokens.append("%s=%s" % [key, _serialize_mission_status_signature_value(dictionary.get(key, null))])
			return "{%s}" % ",".join(tokens)
		TYPE_ARRAY:
			var array_tokens: PackedStringArray = PackedStringArray()
			for entry_variant in Array(value):
				array_tokens.append(_serialize_mission_status_signature_value(entry_variant))
			return "[%s]" % ",".join(array_tokens)
		TYPE_VECTOR2:
			var vector: Vector2 = Vector2(value)
			return "v2(%.5f,%.5f)" % [vector.x, vector.y]
		TYPE_VECTOR2I:
			var vector_i: Vector2i = Vector2i(value)
			return "v2i(%d,%d)" % [vector_i.x, vector_i.y]
		TYPE_VECTOR3:
			var vector3: Vector3 = Vector3(value)
			return "v3(%.5f,%.5f,%.5f)" % [vector3.x, vector3.y, vector3.z]
		TYPE_COLOR:
			var color: Color = Color(value)
			return "color(%.5f,%.5f,%.5f,%.5f)" % [color.r, color.g, color.b, color.a]
		_:
			return str(value)


func focus_world_position(world_position: Vector2) -> void:
	_focus_grid_position = _world_to_grid_float(world_position)
	_update_camera_transform()


func frame_world_positions(world_positions: Array, padding: float = 6.0, minimum_size: float = 18.0, maximum_size: float = CAMERA_DEFAULT_SIZE) -> Dictionary:
	var grid_positions: Array[Vector2] = []
	for position_variant in world_positions:
		if typeof(position_variant) != TYPE_VECTOR2:
			continue
		grid_positions.append(_world_to_grid_float(Vector2(position_variant)))
	if grid_positions.is_empty():
		return {"framed": false, "reason": "no_world_positions"}
	var min_grid: Vector2 = grid_positions[0]
	var max_grid: Vector2 = grid_positions[0]
	for grid_position in grid_positions:
		min_grid.x = minf(min_grid.x, grid_position.x)
		min_grid.y = minf(min_grid.y, grid_position.y)
		max_grid.x = maxf(max_grid.x, grid_position.x)
		max_grid.y = maxf(max_grid.y, grid_position.y)
	_focus_grid_position = (min_grid + max_grid) * 0.5
	_clamp_focus_to_map()
	var normalized_minimum: float = clampf(minimum_size, CAMERA_MIN_SIZE, CAMERA_MAX_SIZE)
	var normalized_maximum: float = clampf(maximum_size, normalized_minimum, CAMERA_MAX_SIZE)
	var span: Vector2 = max_grid - min_grid
	_camera_size = clampf(maxf(span.x, span.y) + maxf(padding, 0.0), normalized_minimum, normalized_maximum)
	_update_camera_transform()
	_request_viewport_redraw(true)
	return {
		"framed": true,
		"focus_grid_position": _focus_grid_position,
		"camera_size": _camera_size,
		"point_count": grid_positions.size(),
		"read_only": true,
		"sets_gameplay_truth": false,
	}


func focus_map_center() -> void:
	if _grid_size == Vector2i.ZERO:
		_focus_grid_position = Vector2.ZERO
	else:
		_focus_grid_position = Vector2(maxf(float(_grid_size.x - 1), 0.0) * 0.5, maxf(float(_grid_size.y - 1), 0.0) * 0.5)
	_update_camera_transform()


func _get_map_center_world_position() -> Vector2:
	if _terrain_map_data != null and _terrain_map_data.has_method("grid_to_world") and _grid_size != Vector2i.ZERO:
		var center_grid := Vector2i(int(floor(float(maxi(_grid_size.x - 1, 0)) * 0.5)), int(floor(float(maxi(_grid_size.y - 1, 0)) * 0.5)))
		return Vector2(_terrain_map_data.call("grid_to_world", center_grid))
	return _grid_float_to_world(_focus_grid_position)


func pan_camera(input_direction: Vector2, delta_seconds: float = 1.0) -> void:
	if input_direction == Vector2.ZERO:
		return
	var yaw_rad: float = deg_to_rad(_camera_yaw_degrees)
	var right := Vector2(cos(yaw_rad), -sin(yaw_rad))
	var forward := Vector2(sin(yaw_rad), cos(yaw_rad))
	var grid_delta: Vector2 = (right * input_direction.x + forward * input_direction.y) * CAMERA_PAN_UNITS_PER_SECOND * delta_seconds
	_focus_grid_position += grid_delta
	_clamp_focus_to_map()
	_update_camera_transform()
	_request_viewport_redraw(true)


func pan_camera_pixels(pixel_delta: Vector2) -> void:
	if pixel_delta == Vector2.ZERO:
		return
	var viewport_height: float = maxf(float(_get_viewport_size().y), 1.0)
	var drag_scale: float = _camera_size / viewport_height
	pan_camera(pixel_delta * CAMERA_DRAG_PAN_FACTOR * drag_scale, 1.0)


func rotate_camera(delta_degrees: float) -> void:
	_camera_yaw_degrees = wrapf(_camera_yaw_degrees + delta_degrees, 0.0, 360.0)
	_update_camera_transform()
	_request_viewport_redraw(true)


func zoom_camera(delta_steps: float) -> void:
	_camera_size = clampf(_camera_size - (delta_steps * CAMERA_ZOOM_STEP), CAMERA_MIN_SIZE, CAMERA_MAX_SIZE)
	_update_camera_transform()
	_request_viewport_redraw(true)


