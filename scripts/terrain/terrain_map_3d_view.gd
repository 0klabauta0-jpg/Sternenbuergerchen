func _ready() -> void:
	layer = -100
	_update_frontier_art_profile()
	_ensure_nodes()
	_resize_subviewport()
	_update_camera_transform()
	_request_viewport_redraw(true, CONTINUOUS_REDRAW_AFTER_BOOTSTRAP_MSEC)
	set_process(true)


func _process(delta: float) -> void:
	var profile_enabled: bool = _runtime_frame_timing_debug_enabled
	var frame_started_usec: int = Time.get_ticks_usec() if profile_enabled else 0
	var scopes_usec: Dictionary = {}
	var scope_started_usec: int = 0
	_process_pending_fow_overlay_full_rebuild()
	if profile_enabled:
		scope_started_usec = Time.get_ticks_usec()
	_resize_subviewport()
	if profile_enabled:
		scopes_usec["resize_subviewport_usec"] = Time.get_ticks_usec() - scope_started_usec
		scope_started_usec = Time.get_ticks_usec()
	_sync_unit_proxies(false, delta)
	if profile_enabled:
		scopes_usec["unit_proxy_sync_usec"] = Time.get_ticks_usec() - scope_started_usec
		scope_started_usec = Time.get_ticks_usec()
	_refresh_dynamic_order_visuals_if_needed()
	if profile_enabled:
		scopes_usec["dynamic_order_visuals_usec"] = Time.get_ticks_usec() - scope_started_usec
	if _subviewport != null and _subviewport.render_target_update_mode == SubViewport.UPDATE_ALWAYS and Time.get_ticks_msec() > _continuous_redraw_until_msec:
		_subviewport.render_target_update_mode = SubViewport.UPDATE_ONCE
	if profile_enabled:
		_runtime_frame_timing_debug_snapshot = {
			"enabled": _runtime_frame_timing_debug_enabled,
			"total_usec": Time.get_ticks_usec() - frame_started_usec,
			"scopes_usec": scopes_usec.duplicate(true),
			"conditional_scopes_usec": {"fow_work_usec": _last_fow_work_usec},
			"counters": {"fow_work_invocation_count": _fow_work_invocation_count},
			"read_only": true,
			"ui_sets_gameplay_truth": false,
			"sets_gameplay_truth": false,
			"creates_command": false,
			"creates_fire_event": false,
			"creates_damage_event": false,
			"creates_movement": false,
			"sets_multiplayer_truth": false,
		}


func set_frontier_art_enabled(enabled: bool) -> void:
	# Store intent even when the effective value already matches. A later map
	# change must not silently discard an explicit preview choice.
	_frontier_art_override = 1 if enabled else 0
	_refresh_frontier_art_override()


func clear_frontier_art_override() -> void:
	_frontier_art_override = -1
	_refresh_frontier_art_override()


func _update_frontier_art_profile() -> bool:
	var enabled: bool = _frontier_art_override == 1 if _frontier_art_override >= 0 else (
		OS.get_cmdline_user_args().has("--frontier-art-v1")
		or _active_terrain_visual_theme_id == FRONTIER_ART_PROFILE_SCRIPT.PROFILE_ID
	)
	if _frontier_art_enabled == enabled:
		return false
	_frontier_art_enabled = enabled
	_ground_batch_source_cache.clear()
	return true


func _refresh_frontier_art_override() -> void:
	if not _update_frontier_art_profile():
		return
	if _terrain_map_data != null:
		render_map()
	else:
		_ensure_nodes()
	_request_viewport_redraw(true)


func set_external_terrain_object_visuals(owners: Dictionary) -> void:
	# A scene may render a multi-cell rock/building itself. This visual-only map
	# avoids duplicate fallback boxes while the explicit owner remains alive.
	_external_terrain_object_visuals.clear()
	for grid in owners:
		var owner: Node3D = owners[grid] as Node3D
		if is_instance_valid(owner):
			_external_terrain_object_visuals[grid] = weakref(owner)
	if _terrain_map_data != null:
		render_map()


func set_flat_ground_visual_owner(owner: MeshInstance3D) -> void:
	# Explicit ownership of the flat visual surface prevents coplanar AO/shadow
	# artifacts. Raised terrain, tile facts and Hex picking keep their own paths.
	_flat_ground_visual_owner = weakref(owner) if is_instance_valid(owner) else null
	if _terrain_map_data != null:
		render_map()


func set_hex_grid_visible(enabled: bool) -> void:
	if _hex_grid_visible == enabled:
		return
	_hex_grid_visible = enabled
	if _terrain_map_data != null:
		render_map()


func _uses_hex_grid() -> bool:
	return _active_grid_topology == "hex_axial_v1"


