# Godot 4+ specific ignores
.godot/
/android/
*.uid

# Root-level Unity editor artifacts created by accidental repo-root opens.
/Library/
/Temp/
/Obj/
/Logs/
/UserSettings/
/ProjectSettings/
/Packages/
/tmp/
/Assets/**/*.meta

# Temporary native plugin files from local editor sessions.
addons/**/bin/~*

# Local raw source asset packs; commit curated subsets under Assets/used or Assets/curated.
Assets/Weapon Pack/

# Unity sidecar spikes
spikes/**/Library/
spikes/**/Temp/
spikes/**/Obj/
spikes/**/Logs/
spikes/**/UserSettings/
spikes/**/Builds/
spikes/*/*.csproj
spikes/**/*.sln
spikes/**/*.user
spikes/**/bin/
spikes/**/obj/
