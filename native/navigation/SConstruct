import os

cpp_dir = os.environ.get("GODOT_CPP_DIR")
if not cpp_dir:
    raise RuntimeError("Set GODOT_CPP_DIR to the pinned godot-cpp checkout (see README).")
env = Environment(tools=["default"], PLATFORM="")
env["build_profile"] = File("build_profile.json").abspath
env = SConscript(os.path.join(cpp_dir, "SConstruct"), exports={"env": env})
env.Append(CPPPATH=["src"])
if env.get("is_msvc"):
    env.Append(CCFLAGS=["/fp:strict"])
else:
    env.Append(CCFLAGS=["-ffp-contract=off", "-fno-fast-math"])
library = env.SharedLibrary("bin/native_navigation" + env["suffix"] + env["SHLIBSUFFIX"], Glob("src/*.cpp"))
Default(library)
